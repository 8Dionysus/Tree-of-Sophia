екающим выгоды свои из всякого мусора с холодными глазами и похотливыми мыслями, к этой черни, от которой подымается к небу зловоние.","forms":["каторжникам"],"status":"text"}],"excluded_search_candidates":[],"translation_keyword_absent":[{"cite":{"w":"also-sprach-zarathustra","c":"I.17","u":["tos.text-unit.sid-f48512263377ab51fdd46c9397cb9c5d","tos.text-unit.sid-f48512263377ab51fdd46c9397cb9c5d"]},"lang":"ru","status":"text"},{"cite":{"w":"also-sprach-zarathustra","c":"II.17","u":["tos.text-unit.sid-9e57d43355a6607870542fa6f9cacedc","tos.text-unit.sid-9e57d43355a6607870542fa6f9cacedc"]},"lang":"ru","status":"text"},{"cite":{"w":"also-sprach-zarathustra","c":"II.17","u":["tos.text-unit.sid-9e57d43355a6607870542fa6f9cacedc","tos.text-unit.sid-9e57d43355a6607870542fa6f9cacedc"]},"lang":"en","status":"text"},{"cite":{"w":"also-sprach-zarathustra","c":"III.12","u":["tos.text-unit.sid-3a60e76f8f2922ea9377927d008c2630","tos.text-unit.sid-3a60e76f8f2922ea9377927d008c2630"]},"lang":"en","status":"text"},{"cite":{"w":"also-sprach-zarathustra","c":"III.12","u":["tos.text-unit.sid-a87adaea7f39e98e9693d9f563c75183","tos.text-unit.sid-a87adaea7f39e98e9693d9f563c75183"]},"lang":"ru","status":"text"},{"cite":{"w":"also-sprach-zarathustra","c":"III.16","u":["tos.text-unit.sid-3357f5220d0b72b1bc05bea8e79719ee","tos.text-unit.sid-3357f5220d0b72b1bc05bea8e79719ee"]},"lang":"ru","status":"text"}],"morphology_source":{"path":"tos/access/public-corpus/morphology.de.v1.json","analysisVersion":"dwdsmor-open-0.18.0-public-20261026-v1","role":"lookup-candidates-only"},"refrain_search":{"output":"out/graph-words/concepts-support/refrains/wheel.txt","sha256":"c12dac27321ea2fb95bd012f439123c8a34d70633fa209291b677ded465d57da","command":["python3","graph-words/refrains.py","\\b(?:Rad|Rade|Rades|Räder\\w*|roll\\w*|geroll\\w*)\\b"],"selected_threads":[{"normalized_words":"ein aus sich rollendes rad","occurrences":3,"chapters":3,"cite":[{"w":"also-sprach-zarathustra","c":"I.02","u":["tos.text-unit.s