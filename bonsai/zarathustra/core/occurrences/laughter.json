17","u":["tos.text-unit.sid-22b5ab9d6d149721268246ed3083774f","tos.text-unit.sid-22b5ab9d6d149721268246ed3083774f"]},"form":"lachen","speaker":"zarathustra","addressee":"zarathustra","mode":"speech","use":"image","group":"scene-laughter","neighbours":["joy-lust","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.17","u":["tos.text-unit.sid-6df85383e8679f4c25e19d7d33a6fb8b","tos.text-unit.sid-6df85383e8679f4c25e19d7d33a6fb8b"]},"form":"lachen","speaker":"zarathustra","addressee":"zarathustra","mode":"speech","use":"image","group":"scene-laughter","neighbours":["becoming","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.17","u":["tos.text-unit.sid-51bbc2f51f647b9de6e4e90335251a55","tos.text-unit.sid-51bbc2f51f647b9de6e4e90335251a55"]},"form":"Gelächter","speaker":"narrator","addressee":"","mode":"narration","use":"narration","group":"scene-laughter"},{"cite":{"w":"also-sprach-zarathustra","c":"IV.17","u":["tos.text-unit.sid-b91a8af95a255d1a34c86acec29138d0","tos.text-unit.sid-b91a8af95a255d1a34c86acec29138d0"]},"form":"lachen","speaker":"zarathustra","addressee":"zarathustra","mode":"speech","use":"question","group":"scene-laughter","neighbours":["identity","attention","bite","spirit-of-gravity","zarathustra"],"line":{"ru":"Приманка срабатывает: гости учатся смеяться над собой.","en":"The bait works: the guests learn to laugh at themselves."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.17","u":["tos.text-unit.sid-9d825a4d34b88ef4cc3b693f5fd1f5e5","tos.text-unit.sid-9d825a4d34b88ef4cc3b693f5fd1f5e5"]},"form":"Gelächters","speaker":"narrator","addressee":"","mode":"narration","use":"narration","group":"scene-laughter","neighbours":["becoming"],"line":{"ru":"Тишина и запах ладана предупреждают учителя о перемене гостей.","en":"Silence and incense warn the teacher of the guests’ change."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.18","u":["tos.text-unit.sid-d371c5f6748ace50d06e418055bf9e4a","tos.text-unit.sid-d371c5f6748ace50d06e418055b