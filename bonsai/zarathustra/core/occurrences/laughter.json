ra","c":"IV.19","u":["tos.text-unit.sid-d5459c06fa445700657c01a30bdc30d0","tos.text-unit.sid-d5459c06fa445700657c01a30bdc30d0"]},"form":"lacht","speaker":"zarathustra","addressee":"higher-men","mode":"song","use":"song","group":"scene-laughter","neighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.20","u":["tos.text-unit.sid-ba797774fad857d0e28e995f8c6dcf5c","tos.text-unit.sid-ba797774fad857d0e28e995f8c6dcf5c"]},"form":"lachte","speaker":"narrator","addressee":"","mode":"narration","use":"narration","group":"transforming-laughter","neighbours":["will","lion","becoming","identity","agency","zarathustra"],"line":{"ru":"Смех льва и нежность голубей приносят обещанный знак.","en":"The lion’s laughter and the doves’ tenderness bring the promised sign."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.20","u":["tos.text-unit.sid-bd98b5b59ac1ac86455e981a2222c0ea","tos.text-unit.sid-bd98b5b59ac1ac86455e981a2222c0ea"]},"form":"lachte","speaker":"narrator","addressee":"","mode":"narration","use":"narration","group":"transforming-laughter","neighbours":["zarathustra"]}]}
