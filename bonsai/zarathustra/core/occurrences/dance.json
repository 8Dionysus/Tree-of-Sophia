eighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"III.15","u":["tos.text-unit.sid-74ea87fb8c7726f974112eb45a0f890a","tos.text-unit.sid-74ea87fb8c7726f974112eb45a0f890a"]},"form":"tanzen","speaker":"zarathustra","addressee":"life","mode":"song","use":"song","group":"dance-teaching","neighbours":["memory","zarathustra"],"line":{"ru":"Учитель говорит Жизни плясать под такт его плётки.","en":"The teacher demands dancing to his whip’s rhythm."}},{"cite":{"w":"also-sprach-zarathustra","c":"III.16","u":["tos.text-unit.sid-7bca57116e5b84b9ec79a8822fca4985","tos.text-unit.sid-7bca57116e5b84b9ec79a8822fca4985"]},"form":"tanzen","speaker":"zarathustra","addressee":"eternity","mode":"song","use":"song","group":"dance-teaching","neighbours":["necessity","creation","zarathustra"],"line":{"ru":"Творческий порыв заставляет случайности танцевать звёздный хоровод.","en":"Creative impulse makes chances dance a round of stars."}},{"cite":{"w":"also-sprach-zarathustra","c":"III.16","u":["tos.text-unit.sid-fa02b841750993c61618111d272a18aa","tos.text-unit.sid-fa02b841750993c61618111d272a18aa"]},"form":"Tänzers","speaker":"zarathustra","addressee":"eternity","mode":"song","use":"song","group":"dance-teaching","neighbours":["laughter","zarathustra"],"line":{"ru":"Заратустра говорит о добродетели танцора и о своей смеющейся злобе.","en":"Zarathustra speaks of a dancer’s virtue and of his laughing malice."}},{"cite":{"w":"also-sprach-zarathustra","c":"III.16","u":["tos.text-unit.sid-187d71e13bc9881187035bebd261de0c","tos.text-unit.sid-187d71e13bc9881187035bebd261de0c"]},"form":"Tänzer","speaker":"zarathustra","addressee":"eternity","mode":"song","use":"song","group":"dance-teaching","neighbours":["becoming","body-self","zarathustra"],"line":{"ru":"Для Заратустры всё тяжёлое должно стать лёгким, всякое тело — танцором, всякий дух — птицей.","en":"For Zarathustra everything heavy should become light, every body a dancer, every spirit a bird."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.02","u":["tos.text-unit.sid-2cab919a71564a7d593da82b3935539f","tos.text-unit.sid-2cab919a71564a7d593da82b3935539f"]},"form":"tanzen","speaker":"soothsayer","addressee":"zarathustra","mode":"speech","use":"image","group":"dance-scene","neighbours":["becoming","soothsayer"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.02","u":["tos.text-unit.sid-e03703b1a187980e1d321f490eb2eea5","tos.text-unit.sid-e03703b1a187980e1d321f490eb2eea5"]},"form":"tanzen","speaker":"soothsayer","addressee":"zarathustra","mode":"speech","use":"image","group":"dance-scene","neighbours":["will","soothsayer"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.02","u":["tos.text-unit.sid-4a64218c25800477aa365d0251b120a5","tos.text-unit.sid-4a64218c25800477aa365d0251b120a5"]},"form":"Tanzbär","speaker":"zarathustra","addressee":"soothsayer","mode":"speech","use":"image","group":"dance-scene","neighbours":["identity","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.09","u":["tos.text-unit.sid-35f9a3e976392f16635ad7ad91eabd0a","tos.text-unit.sid-35f9a3e976392f16635ad7ad91eabd0a"]},"form":"getanzt","speaker":"zarathustra","addressee":"shadow","mode":"speech","use":"image","group":"dance-scene","neighbours":["will","becoming","joy-lust","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.10","u":["tos.text-unit.sid-61faebf1f06cc1a4f69c5814f3135f32","tos.text-unit.sid-61faebf1f06cc1a4f69c5814f3135f32"]},"form":"tanzt","speaker":"zarathustra","addressee":"zarathustra-soul","mode":"dream","use":"image","group":"dance-scene","neighbours":["zarathustra"],"line":{"ru":"Лёгкость сна уподоблена танцу ветра.","en":"Sleep’s lightness is likened to wind’s dance."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.11","u":["tos.text-unit.sid-0fc85022ddceda7c288ab234f1701aa5","tos.text-unit.sid-0fc85022ddceda7c288ab234f1701aa5"]},"form":"Tänzer","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"question","group":"dance-scene","neighbours":["laughter","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-9029b86a96f9af92f840cee7c0629005","tos.text-unit.sid-9029b86a96f9af92f840cee7c0629005"]},"form":"Seiltänzer","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["identity","rope-bridge","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-a0f8391968381229282388e9cde6041c","tos.text-unit.sid-a0f8391968381229282388e9cde6041c"]},"form":"tanzen","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["earth","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-c9e95d2eea8cdba9a5463efa29aea317","tos.text-unit.sid-c9e95d2eea8cdba9a5463efa29aea317"]},"form":"tanzt","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["zarathustra"],"line":{"ru":"Близость цели узнаётся танцующим шагом.","en":"Nearness to the aim is recognized through a dancing step."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-0244ea149929c5673dfecdb631f27f79","tos.text-unit.sid-0244ea149929c5673dfecdb631f27f79"]},"form":"tanzt","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["earth","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-af6f3d62898e311038d465ad67e1f802","tos.text-unit.sid-af6f3d62898e311038d465ad67e1f802"]},"form":"Tänzer","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["memory","zarathustra"],"line":{"ru":"Поднятые сердца должны вспомнить танцующие ноги.","en":"Raised hearts are to remember dancing feet."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-2e564021ebf1efc87ec223de0a750703","tos.text-unit.sid-2e564021ebf1efc87ec223de0a750703"]},"form":"Tänzer","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-14ab65c90417c9aef524b3987b2db74c","tos.text-unit.sid-14ab65c90417c9aef524b3987b2db74c"]},"form":"Tänzer","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["memory","zarathustra"],"line":{"ru":"Призыв поднять сердца повторён вместе с призывом поднять ноги.","en":"The call to raise hearts is repeated with the call to raise feet."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-fa5456d889254f070de1877bb4c8bdad","tos.text-unit.sid-fa5456d889254f070de1877bb4c8bdad"]},"form":"tanzen","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["zarathustra"],"line":{"ru":"Лучше неуклюже танцевать, чем ходить хромая.","en":"It is better to dance awkwardly than to walk lamely."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-9382a04a2854e0404922cc2f9286d7c3","tos.text-unit.sid-9382a04a2854e0404922cc2f9286d7c3"]},"form":"Tanzbeine","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["body-self","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-ab3faf9490a8502be9d0469fe755e771","tos.text-unit.sid-ab3faf9490a8502be9d0469fe755e771"]},"form":"tanzen","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["will","identity","agency","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-434e8de54c342363657b753bb5675491","tos.text-unit.sid-090b6dc18e16b37e61206b4ed569fa7b"]},"form":"tanzt","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["lion","zarathustra"],"line":{"ru":"Свободный дух славится способностью танцевать на печали.","en":"The free spirit is praised for dancing on sorrow."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-4b2c8cbc62ead137aa4f8bc5182cfc02","tos.text-unit.sid-4b2c8cbc62ead137aa4f8bc5182cfc02"]},"form":"tanzen","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["zarathustra"],"line":{"ru":"Высшим людям надо научиться танцевать выше себя.","en":"The higher men are charged with learning to dance beyond themselves."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-fa16e1802680816c74c483dc3db5a534","tos.text-unit.sid-fa16e1802680816c74c483dc3db5a534"]},"form":"Tänzer","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"image","group":"dance-teaching","neighbours":["memory","laughter","zarathustra"],"line":{"ru":"Учитель соединяет поднятые сердца, ноги и смех.","en":"The teacher joins raised hearts, feet and laughter."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.15","u":["tos.text-unit.sid-f24214c75763f38793283ab4dbc94874","tos.text-unit.sid-f24214c75763f38793283ab4dbc94874"]},"form":"tanzenden","speaker":"conscientious","addressee":"higher-men","mode":"speech","use":"image","group":"dance-scene","neighbours":["identity","conscientious"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.16","u":["tos.text-unit.sid-c1d739d58e206d50f8ecfc9bb8443df3","tos.text-unit.sid-c1d739d58e206d50f8ecfc9bb8443df3"]},"form":"tanzten","speaker":"shadow","addressee":"zarathustra","mode":"speech","use":"image","group":"dance-scene","neighbours":["shadow"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.16","u":["tos.text-unit.sid-560c8e1bc5e590cf6443e36f4cc8d830","tos.text-unit.sid-560c8e1bc5e590cf6443e36f4cc8d830"]},"form":"umtänzelt","speaker":"shadow","addressee":"daughters","mode":"song","use":"song","group":"dance-scene","neighbours":["courage","will","lion","affirmation","identity","memory","difference","agency","bite","loneliness","shadow"],"line":{"ru":"Тень поёт о льве и обезьяне — ревуне морали, называя себя европейцем.","en":"The shadow sings of the lion and the ape, a moral howler, calling himself a European."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.19","u":["tos.text-unit.sid-506672d69d74c231eab0ee3056459a6a","tos.text-unit.sid-506672d69d74c231eab0ee3056459a6a"]},"form":"tanzte","speaker":"narrator","addressee":"","mode":"narration","use":"narration","group":"dance-scene","neighbours":["becoming","identity","difference","counterfactual","attention","laughter"],"line":{"ru":"Услышанный вопрос открывает гостям собственное выздоровление.","en":"The heard question reveals their own recovery to the guests."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.19","u":["tos.text-unit.sid-6d924f9e8234ec842f263fa47fa4ac2e","tos.text-unit.sid-6d924f9e8234ec842f263fa47fa4ac2e"]},"form":"tanzt","speaker":"zarathustra","addressee":"higher-men","mode":"song","use":"song","group":"dance-scene","neighbours":["earth","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.19","u":["tos.text-unit.sid-d03cf6663349f2f170baa1c55bbfcbe5","tos.text-unit.sid-d03cf6663349f2f170baa1c55bbfcbe5"]},"form":"tanztet","speaker":"zarathustra","addressee":"higher-men","mode":"song","use":"song","group":"dance-scene","neighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.19","u":["tos.text-unit.sid-e58cbbb3e8f3085bfbf86350cd8d31a7","tos.text-unit.sid-e58cbbb3e8f3085bfbf86350cd8d31a7"]},"form":"Tänzer","speaker":"zarathustra","addressee":"higher-men","mode":"song","use":"song","group":"dance-scene","neighbours":["becoming","joy-lust","zarathustra"]}]}
