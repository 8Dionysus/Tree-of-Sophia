,"tos.text-unit.sid-ceaa2d6e4215ca83da6d7918d309d899"]},"form":"Tanze","speaker":"zarathustra","addressee":"","mode":"song","use":"song","group":"dance-scene","neighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"III.04","u":["tos.text-unit.sid-a1b5df136d54777ec46e7016d0cef48f","tos.text-unit.sid-a1b5df136d54777ec46e7016d0cef48f"]},"form":"tanzen","speaker":"zarathustra","addressee":"","mode":"speech","use":"image","group":"dance-scene","neighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"III.04","u":["tos.text-unit.sid-9ea2d9559262aedbb9e1629a4c92d126","tos.text-unit.sid-9ea2d9559262aedbb9e1629a4c92d126"]},"form":"Tanzboden","speaker":"zarathustra","addressee":"","mode":"speech","use":"image","group":"dance-scene","neighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"III.05","u":["tos.text-unit.sid-73c6790cdc3088782842c41ae8c5d9c6","tos.text-unit.sid-73c6790cdc3088782842c41ae8c5d9c6"]},"form":"tanzen","speaker":"zarathustra","addressee":"","mode":"speech","use":"image","group":"dance-scene","neighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"III.08","u":["tos.text-unit.sid-99eaf5babf23d89283b5a8b1a7ca4064","tos.text-unit.sid-99eaf5babf23d89283b5a8b1a7ca4064"]},"form":"Tänzer","speaker":"zarathustra","addressee":"","mode":"speech","use":"image","group":"dance-scene","neighbours":["circle","laughter","zarathustra"],"line":{"ru":"Прежний танцор сгибается перед крестом.","en":"The former dancer bends before the cross."}},{"cite":{"w":"also-sprach-zarathustra","c":"III.10","u":["tos.text-unit.sid-50973bd1cfd852b86708460f7da92bb3","tos.text-unit.sid-50973bd1cfd852b86708460f7da92bb3"]},"form":"Tänzer","speaker":"zarathustra","addressee":"","mode":"speech","use":"image","group":"dance-scene","neighbours":["identity","body-self","joy-lust","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"III.11","u":["tos.text-unit.sid-772a8c63e358860903fa566ccfb808e4","tos.text-unit.sid-772a8c63e3