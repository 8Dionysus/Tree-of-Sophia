semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.9a82affe8f61884e"},{"cite":{"w":"also-sprach-zarathustra","c":"II.09","u":["tos.text-unit.sid-c245a4e237adfdd27ef9593ef422ea31","tos.text-unit.sid-c245a4e237adfdd27ef9593ef422ea31"]},"form":"Beschenkten","speaker":"zarathustra","addressee":"","mode":"song","use":"song","group":"source-use","neighbours":["zarathustra"],"line":{"ru":"Полнота дарящего рождает желание отнять дар.","en":"The giver’s fullness breeds a desire to take the gift away."}},{"cite":{"w":"also-sprach-zarathustra","c":"II.09","u":["tos.text-unit.sid-915d67c26466773986f97d75173e94e4","tos.text-unit.sid-915d67c26466773986f97d75173e94e4"]},"form":"Schenken","speaker":"zarathustra","addressee":"","mode":"song","use":"song","group":"source-use","neighbours":["becoming","identity","zarathustra"],"line":{"ru":"Счастье дарения истощается собственным избытком.","en":"The happiness of giving exhausts itself through excess."},"voice_group":{"mode":"song","use":"song","group":"source-use"},"semantic_use":{"group_id":"schenken-weariness","label":{"ru":"Усталость постоянного дарения","en":"Weariness of constant giving"},"meaning":{"ru":"В Ночной песни счастье Заратустры умирает в самом дарении, а добродетель устаёт от своего избытка.","en":"In the Night Song Zarathustra says that his happiness in giving died in the act of giving, and that his virtue grew weary of its abundance."},"grounds":[{"w":"also-sprach-zarathustra","c":"II.09","u":["tos.text-unit.sid-915d67c26466773986f97d75173e94e4","tos.text-unit.sid-915d67c26466773986f97d75173e94e4"],"q":"Schenken"}],"review_status":"stand-proposal","scope":{"ru":"Самооценка дарящего в песне; не общий закон всякого дара.","en":"The giver’s self-assessment in a song, not a general law of every gift."},"independent_review":{"reviewer":"p4-independent-review","model":"gpt-6.1-terra","effort":"xhigh","date":"2026-11-01","scope":"exact units, adjacent German context, group sense, voice, RU/EN and grouping grounds; not native admission or rights","verdict":"revise","reason":{"ru":"Английская формулировка уточняет, что умерло счастье в дарении, а не что счастье само дарит.","en":"The English states that happiness in giving died, rather than that happiness gives itself."}},"proposed":{"meaning":{"ru":"В Ночной песни счастье Заратустры умирает в самом дарении, а добродетель устаёт от своего избытка.","en":"In the Night Song Zarathustra’s happiness dies in giving itself, and virtue grows weary of its abundance."}}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.b7e8b3ce74ced2f1"},{"cite":{"w":"also-sprach-zarathustra","c":"II.09","u":["tos.text-unit.sid-2164fb8a5ad05ece977ae7ce37b3badc","tos.text-unit.sid-2164fb8a5ad05ece977ae7ce37b3badc"]},"form":"schenkt","speaker":"zarathustra","addressee":"","mode":"song","use":"song","group":"source-use","neighbours":["zarathustra"],"line":{"ru":"Непрерывное дарение грозит потерей стыда и огрубением.","en":"Continual giving risks losing shame and becoming callous."},"voice_group":{"mode":"song","use":"song","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.6686d78c115624da"},{"cite":{"w":"also-sprach-zarathustra","c":"II.09","u":["tos.text-unit.sid-600e6ab99f37af138840458f18fb74b8","tos.text-unit.sid-600e6ab99f37af138840458f18fb74b8"]},"form":"Schenkenden","speaker":"zarathustra","addressee":"","mode":"song","use":"song","group":"source-use","neighbours":["loneliness","zarathustra"],"line":{"ru":"Дарящий поёт одиночество светящих.","en":"The giver sings the shining ones’ solitude."},"voice_group":{"mode":"song","use":"song","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.70cd68caa21ac1d5"},{"cite":{"w":"also-sprach-zarathustra","c":"II.10","u":["tos.text-unit.sid-6f8984c5f6461bc117ffce7e071553e9","tos.text-unit.sid-6f8984c5f6461bc117ffce7e071553e9"]},"form":"beschenkt","speaker":"zarathustra","addressee":"life","mode":"song","use":"song","group":"source-use","neighbours":["zarathustra","life"],"line":{"ru":"Жизнь замечает, что мужчины дарят ей собственные добродетели.","en":"Life observes that men give it their own virtues."}},{"cite":{"w":"also-sprach-zarathustra","c":"III.05","u":["tos.text-unit.sid-c109d41739a0996c3ff2df40bfd28f15","tos.text-unit.sid-c109d41739a0996c3ff2df40bfd28f15"]},"form":"beschenkt","speaker":"zarathustra","addressee":"","mode":"speech","use":"teaching","group":"source-use","neighbours":["will","zarathustra"],"line":{"ru":"Похвала раскрывается желанием получить новые дары.","en":"Praise unfolds as a desire to receive new gifts."}},{"cite":{"w":"also-sprach-zarathustra","c":"III.09","u":["tos.text-unit.sid-d8a9c07bd114fa00407eee4645c5ba32","tos.text-unit.sid-d8a9c07bd114fa00407eee4645c5ba32"]},"form":"schenkend","speaker":"loneliness","addressee":"zarathustra","mode":"quoted","use":"teaching","group":"source-use","neighbours":["loneliness"],"line":{"ru":"Одиночество вспоминает дарящий источник среди пустых сосудов.","en":"Solitude recalls the bestowing spring among empty vessels."},"voice_group":{"mode":"quoted","use":"teaching","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.421f6a96df83532b"},{"cite":{"w":"also-sprach-zarathustra","c":"III.10","u":["tos.text-unit.sid-b69d82eaac6c528f99194ce43bae671c","tos.text-unit.sid-b69d82eaac6c528f99194ce43bae671c"]},"form":"Schenkende","speaker":"zarathustra","addressee":"","mode":"speech","use":"teaching","group":"source-use","neighbours":["zarathustra"],"line":{"ru":"Нисхождение одинокой высоты получает имя дарящей добродетели.","en":"The descent of the solitary height receives the name bestowing virtue."},"voice_group":{"mode":"speech","use":"teaching","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.6289af7005fde87c"},{"cite":{"w":"also-sprach-zarathustra","c":"III.13","u":["tos.text-unit.sid-c8e9e850b816f1db51f391e81ec26f51","tos.text-unit.sid-c8e9e850b816f1db51f391e81ec26f51"]},"form":"geschenkt","speaker":"zarathustra","addressee":"animals","mode":"speech","use":"question","group":"source-use","neighbours":["dance","zarathustra"],"line":{"ru":"Имена и звуки дарят отдых, речь танцует над вещами.","en":"Names and sounds give refreshment; speech dances over things."},"voice_group":{"mode":"speech","use":"question","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.cf6674cf7cf2614c"},{"cite":{"w":"also-sprach-zarathustra","c":"III.14","u":["tos.text-unit.sid-c0f42aa81160c9dadc492a1cef5dd98f","tos.text-unit.sid-c0f42aa81160c9dadc492a1cef5dd98f"]},"form":"Schenken","speaker":"zarathustra","addressee":"zarathustra-soul","mode":"speech","use":"question","group":"source-use","neighbours":["necessity","zarathustra","zarathustra-soul"],"line":{"ru":"Дарение спрашивается как нужда, принятие как милосердие.","en":"Giving is questioned as a need, receiving as mercy."},"voice_group":{"mode":"speech","use":"question","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.64383c8dbe0a3e11"},{"cite":{"w":"also-sprach-zarathustra","c":"IV.01","u":["tos.text-unit.sid-6078c820db50344df425ea10af89abe9","tos.text-unit.sid-6078c820db50344df425ea10af89abe9"]},"form":"geschenkt","speaker":"zarathustra","addressee":"zarathustra","mode":"speech","use":"teaching","group":"source-use","neighbours":["becoming","zarathustra"],"line":{"ru":"Учитель расточает полученные дары тысячей рук.","en":"The teacher lavishes received gifts with a thousand hands."},"voice_group":{"mode":"speech","use":"teaching","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.c2149920590695a4"},{"cite":{"w":"also-sprach-zarathustra","c":"IV.07","u":["tos.text-unit.sid-3ae37eee5307bc533e112969700d2b11","tos.text-unit.sid-3ae37eee5307bc533e112969700d2b11"]},"form":"schenkte","speaker":"narrator","addressee":"","mode":"narration","use":"narration","group":"source-use","neighbours":["will","necessity"],"line":{"ru":"Поиск страдающего сопровождается благодарностью дарам дня.","en":"The search for the suffering one is accompanied by gratitude for the day’s gifts."},"voice_group":{"mode":"narration","use":"narration","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.f33fe17e92b731b5"},{"cite":{"w":"also-sprach-zarathustra","c":"IV.08","u":["tos.text-unit.sid-b1ffddc7cedb5d25fff4d1e6e37ad47c","tos.text-unit.sid-b1ffddc7cedb5d25fff4d1e6e37ad47c"]},"form":"Geschenk","speaker":"narrator","addressee":"","mode":"narration","use":"narration","group":"source-use","line":{"ru":"Нищий принимает узнавание учителя как драгоценный дар.","en":"The beggar receives recognition of the teacher as a precious gift."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.08","u":["tos.text-unit.sid-8d6093cbded780ddbfe1f48e8018e5db","tos.text-unit.sid-8d6093cbded780ddbfe1f48e8018e5db"]},"form":"schenke","speaker":"zarathustra","addressee":"beggar","mode":"speech","use":"question","group":"source-use","neighbours":["zarathustra"],"line":{"ru":"Дар богатого сердца встречает отказ бедных.","en":"The wealthy heart’s gift meets the poor people’s refusal."},"voice_group":{"mode":"speech","use":"question","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.a685ed5ac9076d1a"},{"cite":{"w":"also-sprach-zarathustra","c":"IV.08","u":["tos.text-unit.sid-7213f771ff84cbf039682ea79414fa06","tos.text-unit.sid-7213f771ff84cbf039682ea79414fa06"]},"form":"schenken","speaker":"zarathustra","addressee":"beggar","mode":"speech","use":"teaching","group":"source-use","neighbours":["zarathustra"],"line":{"ru":"Хорошее дарение названо последним искусством доброты.","en":"Good giving is named goodness’s final art."},"voice_group":{"mode":"speech","use":"teaching","group":"source-use"},"semantic_use":{"group_id":"schenken-art","label":{"ru":"Искусство хорошо дарить","en":"The art of giving well"},"meaning":{"ru":"После рассказа нищего Заратустра говорит, что правильно отдавать труднее, чем правильно принимать, а хорошо дарить называет искусством.","en":"After the beggar’s account, Zarathustra says that giving rightly is harder than receiving rightly, and calls giving well an art."},"grounds":[{"w":"also-sprach-zarathustra","c":"IV.08","u":["tos.text-unit.sid-7213f771ff84cbf039682ea79414fa06","tos.text-unit.sid-7213f771ff84cbf039682ea79414fa06"],"q":"schenken"}],"review_status":"stand-proposal","scope":{"ru":"Речь Заратустры в ответ нищему; текст не доказывает, что нищий овладел искусством.","en":"Zarathustra’s response to the beggar; the text does not show that the beggar mastered the art."},"independent_review":{"reviewer":"p4-independent-review","model":"gpt-6.1-terra","effort":"xhigh","date":"2026-11-01","scope":"exact units, adjacent German context, group sense, voice, RU/EN and grouping grounds; not native admission or rights","verdict":"revise","reason":{"ru":"Сравнение относится к правильному отдаванию и принятию; хорошо дарить отдельно названо искусством.","en":"The comparison concerns giving and receiving rightly; giving well is separately called an art."}},"proposed":{"meaning":{"ru":"После рассказа нищего об отказе бедных Заратустра говорит, что хорошо дарить — искусство и труднее, чем хорошо принимать.","en":"After the beggar tells of the poor refusing him, Zarathustra says that giving well is an art and harder than receiving well."}}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.bbfa2c73897218b0"},{"cite":{"w":"also-sprach-zarathustra","c":"IV.11","u":["tos.text-unit.sid-51349b585c67c1f2128a54d5a7842e63","tos.text-unit.sid-51349b585c67c1f2128a54d5a7842e63"]},"form":"Gastgeschenk","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["identity","zarathustra"],"line":{"ru":"Гости сами дарят учителю силу ответного дара.","en":"The guests themselves give the teacher power to give in return."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.11","u":["tos.text-unit.sid-09dbfa04d6f16c6b8baeec9d7cbae247","tos.text-unit.sid-09dbfa04d6f16c6b8baeec9d7cbae247"]},"form":"Gastgeschenk","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["child","becoming","zarathustra"],"line":{"ru":"Разговор о детях становится желанным гостевым даром.","en":"Speaking of the children becomes the desired guest-gift."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.19","u":["tos.text-unit.sid-fb48fa3c5d1243c0b134ec22b32b2230","tos.text-unit.sid-fb48fa3c5d1243c0b134ec22b32b2230"]},"form":"schenkt","speaker":"zarathustra","addressee":"higher-men","mode":"song","use":"song","group":"source-use","neighbours":["will","zarathustra"],"line":{"ru":"Избыток радости дарит и благодарит принимающего.","en":"Joy’s excess gives and thanks the recipient."},"voice_group":{"mode":"song","use":"song","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.99644af9acf5c97b"},{"cite":{"w":"also-sprach-zarathustra","c":"IV.20","u":["tos.text-unit.sid-72fc1a4a9dd64e76fa68ff0558ac73e5","tos.text-unit.sid-72fc1a4a9dd64e76fa68ff0558ac73e5"]},"form":"schenkst","speaker":"zarathustra","addressee":"sun","mode":"speech","use":"teaching","group":"source-use","neighbours":["zarathustra"],"line":{"ru":"Учитель спрашивает о стыде солнца, раздающего свет спящим.","en":"The teacher asks about the shame of a sun giving light to sleepers."},"voice_group":{"mode":"speech","use":"teaching","group":"source-use"},"semantic_use":{"group_id":null,"label":null,"meaning":null,"grounds":[],"review_status":"unknown","scope":{"ru":"Контекстное значение ещё не разобрано.","en":"The contextual meaning has not yet been assessed."}},"lexical_use_ref":"tos.bonsai.lexical-use.schenken.3e23cf842c55c34d"}]}
