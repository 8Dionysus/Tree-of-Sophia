rce-use","neighbours":["zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-5ef6072c56c5d0f857f1d35267c0fa7c","tos.text-unit.sid-5ef6072c56c5d0f857f1d35267c0fa7c"]},"form":"thut","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["becoming","identity","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-8d693c9b411e71c9c12cd990db694ac3","tos.text-unit.sid-8d693c9b411e71c9c12cd990db694ac3"]},"form":"handelt","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["creation","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-9f447f3e22c2fb74752cea85bb46110b","tos.text-unit.sid-9f447f3e22c2fb74752cea85bb46110b"]},"form":"thut","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["will","creation","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-368e36fce3e8ec56bb13b15d784a7c49","tos.text-unit.sid-368e36fce3e8ec56bb13b15d784a7c49"]},"form":"that","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["identity","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.13","u":["tos.text-unit.sid-ab3faf9490a8502be9d0469fe755e771","tos.text-unit.sid-ab3faf9490a8502be9d0469fe755e771"]},"form":"thut","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["will","identity","dance","zarathustra"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.15","u":["tos.text-unit.sid-ee720c43290dabbf4e9d946e36c099bc","tos.text-unit.sid-0cc46bea184b9acff14c97c46ec65b25"]},"form":"thun","speaker":"magician","addressee":"conscientious","mode":"speech","use":"teaching","group":"source-use","neighbours":["difference","magician"]},{"cite":{"w":"also-sprach-zarathustra","c":"IV.15","u":["tos.text-unit.sid-2369e3cf893c1a124843eacbf80697cf","tos.text-unit.sid-2369e3cf893c1a124843eacbf80697cf"]},"form":"thun","speaker":"magician","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["magician"],"line":{"ru":"Чародей ждёт, что Заратустра снова станет любить и хвалить его.","en":"The magician expects the teacher’s love and praise again."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.16","u":["tos.text-unit.sid-560c8e1bc5e590cf6443e36f4cc8d830","tos.text-unit.sid-560c8e1bc5e590cf6443e36f4cc8d830"]},"form":"That","speaker":"shadow","addressee":"daughters","mode":"song","use":"song","group":"source-use","neighbours":["courage","will","lion","affirmation","identity","memory","difference","bite","dance","loneliness","shadow"],"line":{"ru":"Тень поёт о льве и обезьяне — ревуне морали, называя себя европейцем.","en":"The shadow sings of the lion and the ape, a moral howler, calling himself a European."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.18","u":["tos.text-unit.sid-a5afd356c51025b4b9a064ec14874bb9","tos.text-unit.sid-a5afd356c51025b4b9a064ec14874bb9"]},"form":"thatest","speaker":"zarathustra","addressee":"magician","mode":"speech","use":"teaching","group":"source-use","neighbours":["zarathustra"],"line":{"ru":"Учитель спрашивает, кто поверит чародею, если тот верит в таких богов-ослов.","en":"The teacher asks who will believe the magician if he believes in such godly ass-foolery."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.18","u":["tos.text-unit.sid-14a37ae01737e3188609ec1ebbf8b184","tos.text-unit.sid-14a37ae01737e3188609ec1ebbf8b184"]},"form":"thatest","speaker":"zarathustra","addressee":"magician","mode":"speech","use":"teaching","group":"source-use","neighbours":["counterfactual","zarathustra"],"line":{"ru":"Учитель спрашивает чародея о его участии в нелепом поклонении.","en":"The teacher asks the magician about his part in absurd worship."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.18","u":["tos.text-unit.sid-8a7bf8c9e1035c656af8483dd2dfdd23","tos.text-unit.sid-8a7bf8c9e1035c656af8483dd2dfdd23"]},"form":"thatest","speaker":"zarathustra","addressee":"ugliest-man","mode":"speech","use":"question","group":"source-use","neighbours":["zarathustra"],"line":{"ru":"Преображённый взгляд безобразного вызывает вопрос о его деле.","en":"The ugly one’s transformed gaze prompts a question about his deed."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.18","u":["tos.text-unit.sid-be6320068980f849b42931e704ccf943","tos.text-unit.sid-be6320068980f849b42931e704ccf943"]},"form":"thatest","speaker":"zarathustra","addressee":"ugliest-man","mode":"speech","use":"question","group":"source-use","neighbours":["identity","zarathustra"],"line":{"ru":"Учитель спрашивает, что безобразный перевернул и во что обратился.","en":"The teacher asks what the ugly one overturned and turned into."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.18","u":["tos.text-unit.sid-d7adfe1b113501cc818295b3cf28532f","tos.text-unit.sid-d7adfe1b113501cc818295b3cf28532f"]},"form":"thatet","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["child","zarathustra"],"line":{"ru":"Возвращённая детскость гостей выражается молитвой.","en":"The guests’ recovered childishness is expressed through prayer."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.18","u":["tos.text-unit.sid-bbcdb5cd65db398f9004d45fce1b7719","tos.text-unit.sid-bbcdb5cd65db398f9004d45fce1b7719"]},"form":"thun","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["becoming","necessity","zarathustra"],"line":{"ru":"Заново расцветшим гостям предложены новые праздники.","en":"Freshly flowering guests are offered new festivals."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.18","u":["tos.text-unit.sid-aa5bef7c21a89f5118d279c3a48dc5fb","tos.text-unit.sid-aa5bef7c21a89f5118d279c3a48dc5fb"]},"form":"thut","speaker":"zarathustra","addressee":"higher-men","mode":"speech","use":"teaching","group":"source-use","neighbours":["memory","zarathustra"],"line":{"ru":"Повтор праздника предложен в память учителя.","en":"Repeating the festival is proposed in the teacher’s memory."}},{"cite":{"w":"also-sprach-zarathustra","c":"IV.20","u":["tos.text-unit.sid-ba797774fad857d0e28e995f8c6dcf5c","tos.text-unit.sid-ba797774fad857d0e28e995f8c6dcf5c"]},"form":"that","speaker":"narrator","addressee":"","mode":"narration","use":"narration","group":"source-use","neighbours":["will","lion","becoming","identity","laughter","zarathustra"],"line":{"ru":"Смех льва и нежность голубей приносят обещанный знак.","en":"The lion’s laughter and the doves’ tenderness bring the promised sign."}}]}
