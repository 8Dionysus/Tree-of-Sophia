__pycache__/
.pytest_cache/
*.pyc
dist/
/target/
/access/web/node_modules/
/access/deploy/cloudflare-tunnel/site.env
/access/deploy/cloudflare-tunnel/*.token
/access/deploy/cloudflare-worker/node_modules
/access/deploy/cloudflare-worker/dist-public-research/
/access/deploy/cloudflare-worker/.wrangler/
/access/deploy/cloudflare-worker/.dev.vars*
/access/deploy/cloudflare-worker/runtime/
/access/deploy/cloudflare-worker/generated
/access/deploy/cloudflare-worker/worker-configuration.d.ts

# The bulk of the public corpus snapshot lives in R2; access/public-corpus/layers.json
# is its digest manifest and the snapshot's manifest.json, retained.json, revisions/
# and mappings/ stay tracked (`node bonsai/lib/layers.mjs fetch access/public-corpus`).
/access/web/public/public-corpus/analyses/
/access/web/public/public-corpus/documents/
/access/web/public/public-corpus/indexes/
/access/web/public/public-corpus/pages/

# Runtime locks of the native canonical HumanForms writer are not corpus data.
# Source nodes, adjacent form sets, their histories and reviews remain tracked.
/ToS/canon/..canonical-human-forms-lock.writer.lock
/ToS/canon/**/.node.human-forms.json.writer.lock

# Local immutable corpus bytes. Catalogs, manifests, fixity, provenance,
# rights, forensic reports, review state, and rights-safe alignments remain
# tracked; restricted source or derivative text remains local.
/ToS/source-witnesses/works/**/items/*/payload/*
/ToS/source-witnesses/collections/**/items/*/payload/*
/ToS/source-witnesses/scholarly-composites/*/*/*/representations/*/payload/*
/ToS/source-witnesses/works/**/gold-sets/*/local-content/*
!/ToS/source-witnesses/works/**/gold-sets/*/local-content/README.md

# First-person lived-witness records are private by default. The route card,
# protocol, form, and storage boundary remain tracked; authored bodies and
# capture artifacts do not enter Git without a separate explicit decision.
/ToS/zarathustra/lived-witness/local-content/*
!/ToS/zarathustra/lived-witness/local-content/README.md

# Private access-request correspondence and personal/confidential attachments.
# Only the boundary route card remains tracked.
/ToS/source-witnesses/access-requests/private/*
!/ToS/source-witnesses/access-requests/private/README.md

# Explicitly compiled access query artifact; authored projection manifests remain tracked.
/ToS/derived-exports/runtime/knowledge.sqlite3
/ToS/derived-exports/runtime/knowledge.sqlite3.*.building*

# Independent KAG releases are built in an explicitly selected external root.
# Authored export routes belong in this checkout; consumer indexes do not.
/kag/manifest.json
/kag/nodes/
/kag/edges/
/kag/indexes/
/kag/projections/
/kag/receipts/

# Generated data is built from an explicitly admitted corpus revision.
# Authored route cards remain source files.
/ToS/derived-exports/**
!/ToS/derived-exports/**/
!/ToS/derived-exports/**/*.md
/ToS/source-witnesses/catalog/**
!/ToS/source-witnesses/catalog/**/
!/ToS/source-witnesses/catalog/**/*.md

