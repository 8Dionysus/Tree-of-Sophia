      "definition": "Предметная сверка наблюдения, библиографического сведения или исследовательского сообщения с точным источником для исследовательского использования.",
      "assertion_layers": ["forensic_observation", "bibliographic_assertion", "textual_observation", "scholarly_report"],
      "risk_tiers": ["low", "moderate"],
      "languages": ["*"], "uses": ["research"], "reviewer_kinds": ["human", "agent", "mixed"],
      "min_reviewers": 1, "min_independence_groups": 1, "min_supporting_origins": 1,
      "require_counterevidence_search": true, "allow_self_review": false
    },
    {
      "profile_id": "interpretation",
      "label": "Оценка прочтения и интерпретации",
      "definition": "Компетентная оценка языкового анализа, перевода, исторической или философской интерпретации и её человеческой формулировки без устранения конкурирующих прочтений.",
      "assertion_layers": ["linguistic_analysis", "translation_alignment", "translation_judgment", "semantic_interpretation", "historical_assertion", "human_projection"],
      "risk_tiers": ["low", "moderate"],
      "languages": ["*"], "uses": ["research"], "reviewer_kinds": ["human", "agent", "mixed"],
      "min_reviewers": 1, "min_independence_groups": 1, "min_supporting_origins": 1,
      "require_counterevidence_search": true, "allow_self_review": false
    },
    {
      "profile_id": "identity",
      "label": "Проверка тождества",
      "definition": "Проверка тождества с раздельными основаниями и независимой оценкой; сама по себе не выполняет объединение сущностей.",
      "assertion_layers": ["identity_assertion"], "risk_tiers": ["high"],
      "languages": ["*"], "uses": ["research"], "reviewer_kinds": ["human", "agent", "mixed"],
      "min_reviewers": 2, "min_independence_groups": 2, "min_supporting_origins": 2,
      "require_counterevidence_search": true, "allow_self_review": false
    },
    {
      "profile_id": "high-consequence",
      "label": "Усиленная содержательная проверка",
      "definition": "Независимая повторная проверка содержательного суждения с существенными последствиями, без автоматического права публикации или изменения канона.",
      "assertion_layers": ["forensic_observation", "bibliographic_assertion", "textual_observation", "scholarly_report", "linguistic_analysis", "translation_alignment", "translation_judgment", "semantic_interpretation", "historical_assertion", "human_projection"],
      "risk_tiers": ["high"],
      "languages": ["*"], "uses": ["research"], "reviewer_kinds": ["human", "agent", "mixed"],
      "min_reviewers": 2, "min_independence_groups": 2, "min_supporting_origins": 1,
      "require_counterevidence_search": true, "allow_self_review": false
    }
  ]
