    "field_rules": [
      {
        "field": "identity_status",
        "targets": [
          "record",
          "assertion"
        ],
        "category": "governing",
        "label": {
          "ru": "Статус идентификации",
          "en": "Identification status"
        },
        "explanation": {
          "ru": "Статус объявлен исходной записью; это не текущий допуск предмета.",
          "en": "The source record declares this status; it is not a current admission of the subject."
        },
        "value_labels": {
          "provisional": {
            "ru": "Предварительная идентификация",
            "en": "Provisional identification"
          },
          "verified": {
            "ru": "В записи отмечено: идентификация проверена",
            "en": "Source declaration: identification verified"
          },
          "disputed": {
            "ru": "Идентификация оспаривается",
            "en": "Identification disputed"
          },
          "superseded": {
            "ru": "В записи отмечено: заменена последующей",
            "en": "Source declaration: superseded"
          }
        }
      },
      {
        "field": "same_as_posture",
        "targets": [
          "record",
          "assertion"
        ],
        "category": "governing",
        "label": {
          "ru": "Статус отождествления",
          "en": "Equivalence posture"
        },
        "explanation": {
          "ru": "Отсутствие заявления об эквивалентности не доказывает различность предметов.",
          "en": "No equivalence claim does not establish that subjects are distinct."
        },
        "value_labels": {
          "not_assessed": {
            "ru": "Не оценивалось",
            "en": "Not assessed"
          },
          "no_equivalence_claim": {
            "ru": "Эквивалентность не заявлена",
            "en": "No equivalence claim"
          },
          "candidate_equivalence": {
            "ru": "Предложена эквивалентность",
            "en": "Candidate equivalence"
          },
          "reviewed_equivalence": {
            "ru": "В записи отмечено: эквивалентность рассмотрена",
            "en": "Source declaration: reviewed equivalence"
          },
          "reviewed_distinct": {
            "ru": "В записи отмечено: различность рассмотрена",
            "en": "Source declaration: reviewed distinction"
          }
        }
      },
      {
        "field": "polarity",
        "targets": [
          "record",
          "assertion"
        ],
        "category": "governing",
        "label": {
          "ru": "Полярность утверждения",
          "en": "Assertion polarity"
        },
        "explanation": {
          "ru": "Полярность не заменяет исходную формулировку, оговорки или оценку; отсутствие поля не означает положительность.",
          "en": "Polarity does not replace source wording, qualifications or assessment; an absent field is not positive."
        },
        "value_labels": {
          "positive": {
            "ru": "Положительная",
            "en": "Positive"
          },
          "negative": {
            "ru": "Отрицательная",
            "en": "Negative"
          },
          "unknown": {
            "ru": "Неизвестна",
            "en": "Unknown"
          }
        }
      },
