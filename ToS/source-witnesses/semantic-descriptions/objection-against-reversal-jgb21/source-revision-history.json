          "version": 1
        },
        "fields": {
          "notes": "§21 требует не ограничиваться отказом от метафизически свободной воли и оспаривает механистически несвободную волю, связывая её с овеществлением причин и действий. Возражение адресовано переходу от критики одной трактовки к принятию другой.",
          "semantic_content": {
            "challenge_account": "The rejection of metaphysical free will does not warrant accepting its mechanistic opposite. JGB 21 also criticizes the unfree will and the reification of cause and effect. The objection addresses this specific reversal.",
            "language": "en",
            "script": "Latn"
          }
        },
