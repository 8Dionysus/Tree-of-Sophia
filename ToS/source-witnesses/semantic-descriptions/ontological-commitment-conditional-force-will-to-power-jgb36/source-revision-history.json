        "fields": {
          "notes": "Финал §36 допускает определение действующей силы как воли к власти при условии, что жизнь влечений и органические функции удастся объяснить из этой основной формы воли. Реконструкция сохраняет эту условность; успех объяснения остаётся открытым.",
          "semantic_content": {
            "commitment_account": "Characterize all effective force, and the world considered from within, as will to power if the proposed reductions of drives and organic functions succeed.",
            "commitment_force": "Conditional on the successful explanatory reductions stated in JGB 36; their success remains an open condition.",
            "language": "en",
            "script": "Latn"
          },
          "semantic_scope": {
            "identity_criterion": "Retain this commitment while its characterization and antecedent conditions remain those of the passage; unconditional adoption would require a separately scoped account and evidence.",
            "language": "en",
            "scope_note": "The ontological characterization proposed at the conditional end of JGB 36.",
            "script": "Latn"
          }
        },
