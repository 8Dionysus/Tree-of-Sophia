        "fields": {
          "notes": "Ограниченная позиция, реконструируемая по §21: критика самопричинения не ведёт к принятию механистически несвободной воли. Область реконструкции — этот двойной отказ.",
          "semantic_content": {
            "language": "en",
            "script": "Latn",
            "stance_account": "Reject the metaphysical self-origination demand while also refusing to substitute a reified mechanistic opposite. The reconstruction concerns this passage’s double refusal."
          },
          "semantic_scope": {
            "identity_criterion": "Identity follows this bounded double refusal; a different stance or comprehensive theory has a separate referent.",
            "language": "en",
            "scope_note": "The two critical moves within JGB 21, without a claim about Nietzsche's complete or unchanging position.",
            "script": "Latn"
          }
        },
