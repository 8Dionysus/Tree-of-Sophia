        "fields": {
          "notes": "Проблема исследователя: как §21 связывает требование последней ответственности с самопричинением и что именно отрицается этой критикой. Формулировка выделяет трудность чтения данного фрагмента.",
          "semantic_content": {
            "inquiry_stakes": "Avoid confusing a critique of a specified metaphysical requirement with denial of every sense of agency or responsibility.",
            "language": "en",
            "problem_statement": "How the demand for ultimate personal responsibility is connected to self-origination in JGB 21, and the scope of the resulting criticism.",
            "script": "Latn"
          },
          "semantic_scope": {
            "identity_criterion": "Identity follows the inquiry into this passage’s relation between ultimate responsibility and self-origination, including its limits.",
            "language": "en",
