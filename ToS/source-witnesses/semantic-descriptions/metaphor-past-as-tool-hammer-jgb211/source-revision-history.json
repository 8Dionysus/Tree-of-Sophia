        "fields": {
          "notes": "При описании творящих ценности философов §211 представляет существующее и прошлое как средства, орудие и молот. Исследовательское прочтение выделяет перенос от практического формирования к определению будущих целей.",
          "semantic_content": {
            "figure_account": "The passage presents what is and has been as means, tools and hammer for the value-creating philosopher.",
            "language": "en",
            "mapping_basis": "Availability for active shaping is the proposed figurative transfer from tools to the treatment of the existing and the past.",
            "script": "Latn",
            "source_domain": "Practical means and shaping tools, including a hammer.",
            "target_domain": "The ideal philosopher's use of prior work and what exists in creating values and determining future ends."
          },
