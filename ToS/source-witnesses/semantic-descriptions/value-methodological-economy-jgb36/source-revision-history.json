        "fields": {
          "notes": "§36 связывает испытание единого вида причинности с требованием метода: дополнительные виды не принимаются, пока не испытан один. Здесь описана ценность методической экономии в этом рассуждении; успешность предложенного объяснения остаётся открытой.",
          "semantic_content": {
            "language": "en",
            "script": "Latn",
            "valuation_context": "The methodological argument within JGB 36.",
            "value_account": "Exhausting the explanatory trial of one causal kind before multiplying kinds is presented as a methodological demand."
          },
          "semantic_scope": {
            "identity_criterion": "Identity follows this passage’s methodological preference; other simplicity criteria have their own referents.",
            "language": "en",
            "scope_note": "The normative preference for not multiplying kinds of causality before the single-kind trial in JGB 36.",
            "script": "Latn"
          }
