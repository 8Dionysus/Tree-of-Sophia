        "fields": {
          "notes": "Часть поэмы Парменида, выделенная по обозначению исследуемого источника.",
          "semantic_content": {
            "boundary_basis": "Исследовательская граница следует обозначению в исследуемом источнике; авторская разбивка остаётся открытой.",
            "fragment_account": "Часть поэмы, представленная под номером (8); текущая запись описывает её по обозначению источника.",
            "language": "ru",
            "script": "Cyrl"
          },
          "semantic_scope": {
            "identity_criterion": "Предметом остаётся выделяемая часть поэмы при уточнении её описания. Другие границы или отождествление с иной нумерацией требуют отдельного основания.",
            "language": "ru",
            "scope_note": "Фрагмент, обозначенный (8) в исследуемом представлении; точные древние границы не установлены.",
            "script": "Cyrl"
          }
