        "fields": {
          "qualifiers": {
            "assessment_limit": "Предварительное исследовательское утверждение, не результат независимой содержательной оценки.",
            "relation_basis": "Явное называние учителя в источнике.",
            "social_scope": "Филологическое обучение, не всё интеллектуальное становление.",
            "source_locator": {
              "locator": "Абзац об учёбе в Бонне и переходе в Лейпциг.",
              "reading_date": "2026-09-07",
              "source_language": "de",
              "url": "https://unigeschichte.unibas.ch/fakultaeten-und-faecher/philhist-fakultaet/philosophie/friedrich-nietzsche"
            },
            "statement": "Базельский исторический очерк называет Ричля учителем Ницше в его филологическом обучении. Утверждение ограничено этой сообщённой связью; остальные источники философии Ницше требуют отдельного исследования.",
            "statement_language": "ru",
            "statement_script": "Cyrl",
            "time_scope_note": "Студенческие годы в Бонне и Лейпциге; точные границы этих отношений здесь не установлены."
          }
        },
