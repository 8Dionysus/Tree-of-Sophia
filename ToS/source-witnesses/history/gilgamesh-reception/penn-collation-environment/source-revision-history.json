        "fields": {
          "semantic_content": {
            "environment_account": "Сообщённые условия критического сопоставления издания с оригинальной табличкой; точная дата сверки и другие области среды не установлены.",
            "language": "ru",
            "scientific_technological_account": "Джастроу описывает музейный доступ к оригиналу, сверку с участием Кьеры и публикацию исправлений; обсуждаемое издание Лэнгдона включало копию, фотографию, транслитерацию и перевод. Правильность чтений требует текстологической оценки.",
            "script": "Cyrl"
          },
          "semantic_scope": {
            "identity_criterion": "Конфигурация источников и способов сверки в описанном Джастроу исследовании; уточнение описания сохраняет этот предмет.",
            "language": "ru",
            "scope_note": "Условия описанной критической работы с пенсильванской табличкой.",
