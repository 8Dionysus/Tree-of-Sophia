        "fields": {
          "notes": "В описании Metropolitan Museum клинопись характеризуется клиновидными знаками; её развитие рассматривается исторически. Запись охватывает традицию письма прежде всего в сумеро-аккадских свидетельствах.",
          "semantic_content": {
            "language": "en",
            "script": "Latn",
            "script_account": "A historically variable writing tradition characterized by wedge-shaped signs; the present research scope is centered on Sumerian and Akkadian witnesses.",
            "sign_inventory_scope": "A historically changing writing tradition. Specific period, region, allograph, and sign-value inventories have their own source accounts."
          },
          "semantic_scope": {
            "identity_criterion": "Исторические варианты рассматриваются внутри заявленной широкой традиции; отдельная система письма или иной критерий охвата требует собственного предмета.",
            "language": "ru",
            "scope_note": "Широкая традиция клинописи; конкретные репертуары и варианты требуют самостоятельного сопоставления.",
            "script": "Cyrl"
          }
