        "fields": {
          "notes": "Документация ORACC ATF задаёт запись графем клинописной транслитерации, варианты Unicode/ASCII и знаки повреждения или сомнения. Использованные разделы прочитаны через индексированный текст; непосредственная загрузка страниц не удалась.",
          "semantic_content": {
            "coverage_and_loss": "Word boundaries in transliteration follow the notation convention and require linguistic assessment. Unidentified or uncertain signs and variant readings remain explicit; reconstruction retains these uncertainties.",
            "language": "en",
            "mapping_convention": "Source-described Latin-based grapheme notation with additional numbers and editorial metacharacters; input language tags are separate from translation language.",
            "script": "Latn"
          },
          "semantic_scope": {
            "identity_criterion": "Исправление описания конвенции сохраняет её ID; несовместимый вариант или новая конвенция нуждаются в явно отделённом предмете и отношении.",
            "language": "ru",
            "scope_note": "Конвенция ATF, описанная в индексированных разделах ORACC Characters и Words; варианты CDLI/ORACC требуют собственного сопоставления.",
            "script": "Cyrl"
          }
        },
