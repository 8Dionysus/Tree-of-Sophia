{"command_id":"jgb-freedom:20260907:thesis:ultimate-responsibility-requires-self-origination-jgb21","expected_configuration":"sha256:8ac01a01dd996c5451aa6ce7f63891bdf1af4259a24e69245b58197b91138ce4","expected_dependencies":"sha256:9863b16e8f17574bbe581f28873a685137ab85cb0d77b8e5c244d16169da1cab","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.thesis.ultimate-responsibility-requires-self-origination-jgb21.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.thesis.ultimate-responsibility-requires-self-origination-jgb21.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.thesis.ultimate-responsibility-requires-self-origination-jgb21.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Связь между метафизическим требованием полной собственной ответственности и самопричинением, сформулированная в §21. Она используется как посылка реконструкции и не распространяется автоматически на любые практические смыслы ответственности.","preferred_label":"Предельная ответственность предполагает самооснование — JGB 21","record_id":"tos.thesis.ultimate-responsibility-requires-self-origination-jgb21","record_type":"thesis","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_description_record_v1","semantic_content":{"assertion_force":"asserted_connection_in_source","language":"en","proposition":"The metaphysical demand for ultimate responsibility described in JGB 21 requires being the origin of oneself.","script":"Latn"},"semantic_scope":{"identity_criterion":"Retain this conditional proposition under source-grounded clarification; broadening it to every responsibility claim changes the referent.","language":"en","scope_note":"The passage's connection between metaphysically ultimate responsibility and self-origination; not ordinary legal or practical responsibility.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-21"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md","status":"unverified","value":"Ultimate responsibility requires self-origination — JGB 21"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
