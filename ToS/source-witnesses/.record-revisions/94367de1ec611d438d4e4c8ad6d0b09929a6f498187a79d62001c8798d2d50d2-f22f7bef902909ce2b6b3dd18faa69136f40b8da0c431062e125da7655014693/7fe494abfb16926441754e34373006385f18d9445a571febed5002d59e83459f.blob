{"command_id":"jgb-freedom:20260907:conception:metaphysical-self-origination-jgb21","expected_configuration":"sha256:dbe887e70959b1e5ac90b192b007ebffc68c642569d2e1ac3e78641a8a475c50","expected_dependencies":"sha256:775c59e6f50d227f365f1136ee9d8c20c9e6fb80b0452158107016a4b01a4ef6","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.conception.metaphysical-self-origination-jgb21.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.conception.metaphysical-self-origination-jgb21.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.conception.metaphysical-self-origination-jgb21.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Трактовка свободы как предельной ответственности за собственные действия, которую §21 связывает с самопричинением и критикует. Запись описывает мишень критики, а не убеждение Ницше и не определение любой свободы.","preferred_label":"Метафизическая свобода как самооснование — мишень JGB 21","record_id":"tos.conception.metaphysical-self-origination-jgb21","record_type":"conception","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_semantic_description_record_v1","semantic_scope":{"identity_criterion":"The same critical target in this passage remains the referent through corrected descriptions. A distinct doctrine or an attributed believer would require separate identity and evidence.","language":"en","scope_note":"The metaphysical sense of ultimate self-responsibility as reconstructed from the target of criticism in JGB 21, not every historical doctrine of free will.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://ww