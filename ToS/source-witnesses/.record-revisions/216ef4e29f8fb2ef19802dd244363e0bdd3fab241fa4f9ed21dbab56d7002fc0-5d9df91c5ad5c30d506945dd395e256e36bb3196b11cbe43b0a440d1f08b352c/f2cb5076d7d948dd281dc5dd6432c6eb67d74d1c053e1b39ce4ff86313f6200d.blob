{"command_id":"jgb-practice:20260907:ontological-commitment:conditional-force-will-to-power-jgb36","expected_configuration":"sha256:095229bb17e2b1115e2b325872ea4c040ea63fc5b252e3490e7ec6d506138a2d","expected_dependencies":"sha256:67ae7b9b14b230dcedcf3d16f85930209097672d990f8b64e242c635c7e7e32a","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.ontological-commitment.conditional-force-will-to-power-jgb36.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.ontological-commitment.conditional-force-will-to-power-jgb36.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.ontological-commitment.conditional-force-will-to-power-jgb36.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Финал §36 допускает определение действующей силы как воли к власти при условии, что жизнь влечений и органические функции удастся объяснить из этой основной формы воли. Запись сохраняет условность итогового хода; она не удостоверяет успех объяснения и не делает это онтологией общего ядра.","preferred_label":"Действующая сила как воля к власти — условное обязательство JGB 36","record_id":"tos.ontological-commitment.conditional-force-will-to-power-jgb36","record_type":"ontological-commitment","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_practice_record_v1","semantic_content":{"commitment_account":"Characterize all effective force, and the world considered from within, as will to power if the proposed reductions of drives and organic functions succeed.","commitment_force":"Conditional on the successful explanatory reductions stated in JGB 36; not established actuality or a ToS ontological rule.","language":"en","script":"Latn"},"semantic_scope":{"identity_criterion":"Retain this commitment while its characterization and antecedent conditions remain those of the passage; unconditional adoption would require a separately scoped account and evidence.","language":"en","scope_note":"The ontological characterization proposed at the conditional end of JGB 36, not a timeless complete doctrine.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-practice-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-36"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-practice-source-reading.md","status":"unverified","value":"Effective force as will to power — conditional commitment in JGB 36"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
