{"command_id":"jgb-practice:20260907:thought-move:extend-will-trial-to-mechanical-jgb36","expected_configuration":"sha256:6cc5b27bca6c2a94541de9d6306d24bad7cbbd793c1914732d79426526cf23e2","expected_dependencies":"sha256:429560a1d941ca356f54cfa0433d1ed5d73a94fa99e0bd69a090e55273ae0122","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.thought-move.extend-will-trial-to-mechanical-jgb36.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.thought-move.extend-will-trial-to-mechanical-jgb36.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.thought-move.extend-will-trial-to-mechanical-jgb36.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Ход §36 переносит испытание волевой причинности на механические события и спрашивает, можно ли понять их из того же порядка реальности, что и аффекты. Речь не о сведении материи к обману или представлению; перенос остаётся предложенным испытанием, а не установленным объяснением.","preferred_label":"Распространить условное испытание на механическое — ход JGB 36","record_id":"tos.thought-move.extend-will-trial-to-mechanical-jgb36","record_type":"thought-move","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_practice_record_v1","semantic_content":{"context_requirement":"The opening supposition about the given reality of drives and the conditional acknowledgment of will-causality in JGB 36 remain in force.","language":"en","movement_account":"Extend the hypothetical sole-will-causality trial to mechanical occurrences, treating them as potentially of the same reality rank as affect rather than mere illusion.","script":"Latn"},"semantic_scope":{"identity_criterion":"Retain this move while it extends that trial across the specified explanatory domains; a record correction is not another historical transition.","language":"en","scope_note":"The extension of the hypothetical will-causality trial to mechanical occurrences in JGB 36.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-practice-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-36"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-practice-source-reading.md","status":"unverified","value":"Extend the conditional trial to the mechanical — move in JGB 36"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
