{"command_id":"foundation-duden-lexical:subject-3","expected_configuration":"sha256:94fa30216afcdfff2138f1c341aa2510822e8bcfb36863372e920677a36f65ff","expected_dependencies":"sha256:b805560f447c3e5e3f822e41835a68a7a79a7c06f2fe86ab1cbde453056a620e","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.sid-abe6b5c9d58c4bd59aedbf8dc9bc19a3"},{"field_id":"metadata.source-note","form_id":"tos.form.sid-f2de7f1bb16f4717a09374014532dd55"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"und","script":"Latn"}},"identity_status":"provisional","notes":"Предварительное описание источником обозначенного греческого референта. Метка und выражает неустановленный в пакете точный языковой охват, а не отсутствие сообщённой источником греческой атрибуции.","preferred_label":"philosophía","record_id":"tos.lexeme.sid-30290680bc434a34b4ffe7609d7dd064","record_type":"lexeme","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_lexical_description_record_v1","semantic_content":{"grammatical_account":"Источник даёт этимологическое обозначение; отдельная морфологическая парадигма и историческая разновидность греческого в этом пакете не установлены.","language":"ru","lexical_account":"Греческое звено сообщаемой Duden цепочки, сохранённое в исходном латинографическом обозначении. Греческая письменная форма и полный семантический диапазон не реконструируются.","script":"Cyrl"},"semantic_scope":{"identity_criterion":"Именно греческий этимологический референт, названный в данном источнике; не латинская лексема philosophia и не точный токен древнего свидетеля.","language":"ru","scope_note":"Референт, обозначенный Duden как греческий и записанный philosophía латиницей. Точный исторический этап языка и его стандартная языковая метка здесь не установлены.","script":"Cyrl"},"source_refs":["ToS/review-ledger/2026-09-08-duden-lexical-source-reading.md"],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
