        "fields": {
          "qualifiers": {
            "relation_basis": "A denial or mechanistic opposite of the specified freedom contributes to investigating its conditions. Membership records that research relation, with truth and endorsement assessed separately.",
            "relation_basis_language": "en",
            "relation_basis_script": "Latn",
            "scope": "Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.",
