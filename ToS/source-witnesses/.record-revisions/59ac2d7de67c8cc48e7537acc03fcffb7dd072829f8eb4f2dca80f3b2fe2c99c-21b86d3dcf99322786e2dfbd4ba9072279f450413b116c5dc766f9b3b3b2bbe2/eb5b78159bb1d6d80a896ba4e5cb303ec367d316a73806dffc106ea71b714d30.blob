{"claims":[{"assertion_layer":"bibliographic_assertion","claim_id":"tos.claim.nietzsche-letter-705.sender","claim_type":"relation","claim_version":1,"epistemic_status":"reported","evidence_refs":["ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_LETTER_705_SOURCE_READING_V1.md"],"maker":{"agent_ref":"model:codex","maker_type":"model"},"object":"tos.agent.friedrich-nietzsche","predicate":"correspondence_sender","provenance_event_ref":"tos.event.source-creation.nietzsche-letter-705-claims.2026-09-07","qualifiers":{"attribution":"eKGWB BVN-1886,705: editorial correspondence identification and closing signature","does_not_establish":["physical_handwriting_attribution","dispatch","delivery","actual_reading"],"evidence_posture":"source-reading note with public source locator; not immutable capture of the external text","provenance_scope":"serialization-only; upstream source reading is not independently execution-attested","source_url":"https://www.nietzschesource.org/texts/eKGWB/BVN-1886","statement":"В eKGWB письмо № 705 представлено как письмо Фридриха Ницше; его опубликованный текст завершается подписью Ницше. Утверждение относится к указанному отправителю, а не к почерку или факту доставки.","statement_language":"ru"},"review_status":"unreviewed","schema_version":"tos_source_relation_claim_v1","subject_ref":"tos.letter.nietzsche-naumann-1886-705","visibility":"public_metadata_only"},{"assertion_layer":"scholarly_report","claim_id":"tos.claim.jenseits-1886-commission.letter-705","claim_type":"relation","claim_version":1,"epistemic_status":"reported","evidence_refs":["ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_HISTORICAL_EPISODE_RESEARCH.md","ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_LETTER_705_SOURCE_READING_V1.md"],"maker":{"agent_ref":"model:codex","maker_type":"model"},"object":"tos.letter.nietzsche-naumann-1886-705","predicate":"historical_document","provenance_event_ref":"tos.event.source-creation.nietzsche-letter-705-claims.2026-09-07","qualifiers":{"attribution":"Andreas Urs Sommer 2016, p. 6, citing KSB 7 / KGB III/3 no. 705 p. 193","does_not_establish":["independent_source_corroboration","actual_printing_rate","printing_completion","public_release"],"evidence_dependence":"commentary cites the letter; note and commentary are not independent witnesses of the episode","provenance_scope":"serialization-only; upstream source reading is not independently execution-attested","source_url":"https://digi.hadw-bw.de/view/nietzsche_kom5_1/0026","statement":"Зоммер ссылается на письмо № 705 при описании согласия Ницше с предложением Науманна и заказа работ 3 июня 1886 года. Прочитанный текст письма просит ускорить печать; характеристика немедленного начала принадлежит комментарию.","statement_language":"ru"},"review_status":"unreviewed","schema_version":"tos_source_relation_claim_v1","subject_ref":"tos.historical-event.friedrich-nietzsche.jenseits-1886-commission","visibility":"public_metadata_only"},{"assertion_layer":"scholarly_report","claim_id":"tos.claim.nietzsche-letter-705.concerns-jenseits","claim_type":"relation","claim_version":1,"epistemic_status":"reported","evidence_refs":["ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_HISTORICAL_EPISODE_RESEARCH.md","ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_LETTER_705_SOURCE_READING_V1.md"],"maker":{"agent_ref":"model:codex","maker_type":"model"},"object":"tos.work.friedrich-nietzsche.jenseits-von-gut-und-boese","predicate":"document_concerns_work","provenance_event_ref":"tos.event.source-creation.nietzsche-letter-705-claims.2026-09-07","qualifiers":{"attribution":"Andreas Urs Sommer 2016, p. 6","does_not_establish":["verbatim_work_mention","quotation","causal_influence","public_release"],"evidence_dependence":"scholarly identification of the letter's unnamed print project; not a second independent historical witness","provenance_scope":"serialization-only; upstream source reading is not independently execution-attested","source_url":"https://digi.hadw-bw.de/view/nietzsche_kom5_1/0026","statement":"В комментарии Зоммера письмо № 705 соотнесено с изготовлением «По ту сторону добра и зла». В прочитанном тексте самого письма название книги не указано; связь сохраняется как атрибутированное исследовательское утверждение.","statement_language":"ru","work_explicitly_named_in_letter":false},"review_status":"unreviewed","schema_version":"tos_source_relation_claim_v1","subject_ref":"tos.letter.nietzsche-naumann-1886-705","visibility":"public_metadata_only"}],"command_id":"tos-letter-705-relations-20260907-v1","expected_configuration":"sha256:3d755166568c8f164ff34c65f8c1390fedfe09a6e81605a771db88f1c186b7f1","expected_dependencies":"sha256:bed6a7de57c2cb290f8014f8285555a925c078cb46c4c33d6712e2a7ff9e9ded","expected_inputs":{"evidence":{"ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_HISTORICAL_EPISODE_RESEARCH.md":{"evidence_kind":"repo_path","source_line":null,"source_ref":"ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_HISTORICAL_EPISODE_RESEARCH.md","source_sha256":"sha256:d42bd276dc0b323e98283fa7f8e7514ed9267212aa2a5352ba9da54256e475b2"},"ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_LETTER_705_SOURCE_READING_V1.md":{"evidence_kind":"repo_path","source_line":null,"source_ref":"ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_LETTER_705_SOURCE_READING_V1.md","source_sha256":"sha256:1b04b5277aa74df1b4697bcc4ad69eb13914bb576702c9be8367f46413f1d7ed"}},"objects":{"tos.agent.friedrich-nietzsche":{"canonical_record_sha256":"sha256:06afae0fb80e928f4817d84029ecdc69b63873bd5417233bf9f128c29ec07c33","record_version":2,"schema_version":"tos_corpus_record_v1","source_ref":"ToS/source-witnesses/agents/friedrich-nietzsche/agent.json","source_sha256":"sha256:49352dc6ae11c5d0ba800e737a7a407b7813f3585850eacbeacd1fdf059f8aab"},"tos.historical-event.friedrich-nietzsche.jenseits-1886-commission":{"canoni