e_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.thesis.metaphysical-freedom-rejected-jgb21","predicate":"step_has_premise","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"This is a reconstruction of the move warned against, not an attribution of that move to Nietzsche or a historical reader.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"В гипотетическом оспариваемом переходе отказ от абсолютной свободы берётся как посылка.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.inference-step.reversal-overreading-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-reversal-conclusion","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.thesis.unfree-will-follows-jgb21","predicate":"step_has_conclusion","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"The conclusion is the hypothetical overreading, with no additional premise supplied. Its role is recorded in order to challenge it.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Гипотетический переход пытается получить механистическую несвободу как вывод; этот шаг не признан обоснованным.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.inference-step.reversal-overreading-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-addressed-objection","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.inference-step.reversal-overreading-jgb21","predicate":"objection_to_step","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"The section asks the reader to discard the inverse notion as well. The target is the exact reconstructed reversal, not the whole preceding criticism.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Возражение §21 адресуется переходу от критики метафизической свободы к её механистической противоположности.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.objection.against-reversal-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-objection-to-overreading","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.thesis.unfree-will-follows-jgb21","predicate":"objection_to_thesis","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"This target records the proposition challenged by the explicit warning; it does not turn the challenge into a universal agency theory.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Возражение также оспаривает вывод о доказанной несвободе; наличие возражения само по себе не доказывает общий положительный ответ.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.objection.against-reversal-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-objection-to-conception","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.conception.unfree-will-reversal-jgb21","predicate":"objection_to_conception","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"The source distinguishes conventional causal concepts from reified causal necessity; the scope is this criticized conception.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Возражение касается механистически овеществлённой несвободы в §21, не любой теории причинности.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.objection.against-reversal-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-contradiction-attribution","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.agent.friedrich-nietzsche","predicate":"thought_attributed_to","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"This is an explicit source characterization, not the researcher's authority to certify its logical truth.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Характеристика самопричинения как противоречия атрибутируется автору §21; истинность характеристики здесь не проверена.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.thesis.self-origination-contradiction-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-dependence-attribution","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.agent.friedrich-nietzsche","predicate":"thought_attributed_to","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"The section makes this connection in its criticism; practical responsibility in all contexts is outside the attribution.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Связь метафизической предельной ответственности с самопричинением атрибутируется §21 Ницше с сохранением узкого смысла ответственности.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.thesis.ultimate-responsibility-requires-self-origination-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-objection-attribution","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.agent.friedrich-nietzsche","predicate":"thought_attributed_to","pr