-jgb21","predicate":"step_has_premise","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"The passage connects the criticized metaphysical demand to self-origination; the reconstruction makes its premise role explicit.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Связь предельной ответственности с самопричинением используется как другая посылка этого шага.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.inference-step.anti-self-origination-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-rejection-conclusion","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.thesis.metaphysical-freedom-rejected-jgb21","predicate":"step_has_conclusion","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"The concluding role is reconstructed from the two stated connections; it is not a machine-proved consequence or rejection of all agency.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed