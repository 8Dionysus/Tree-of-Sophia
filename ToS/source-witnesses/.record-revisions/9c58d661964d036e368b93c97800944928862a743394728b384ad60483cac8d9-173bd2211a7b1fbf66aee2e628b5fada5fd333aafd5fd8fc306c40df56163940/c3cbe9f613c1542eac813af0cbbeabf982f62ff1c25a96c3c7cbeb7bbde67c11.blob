 or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"§21 обсуждает механистическую несвободу как отвергаемую противоположность, не как подтверждённую теорию.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.conception.unfree-will-reversal-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-affect-attribution","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.agent.friedrich-nietzsche","predicate":"conception_attributed_to","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"The attribution is limited to the authorial account in JGB 19; the researcher making this Claim is a different actor.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-19","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 19","statement":"Описание командующего аффекта атрибутируется Ницше в границах §19, без утверждения о неизменности всей его позиции.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.conception.commanding-affect-jgb19","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-fr