sserted.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Гипотетическое признание несвободы после критики абсолютной свободы представляет оспариваемую инверсию, а не убеждение автора.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.conception.unfree-will-reversal-jgb21","visibility":"public_metadata_only"},{"assertion_layer":"semantic_interpretation","claim_id":"tos.claim.jgb-freedom-argument-step","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.inference-step.anti-self-origination-jgb21","predicate":"argument_has_step","provenance_event_ref":"tos.event.jgb-freedom-claims-create-20260907","qualifiers":{"relation_basis":"Step zero is the single transition made explicit in this partial reconstruction, not a historical date or proof of completeness.","relation_basis_language":"en","relation_basis_script":"Latn","scope":"Provisional passage-bound research reading; no logical validity, complete reconstruction, calibrated assessment, admission or canon claim.","source_locator":"http://www.nietzschesource.org/eKGWB/JGB-21","source_representation_sha256":"143d6330c94bf00b135f887eeed5f20f6caee6a98174746227af255583ae8b20","source_section":"JGB 21","statement":"Реконструкция анти-самопричинного довода включает один явно выделенный шаг; полнота формализации не утверждается.","statement_language":"ru","statement_script":"Cyrl","step_