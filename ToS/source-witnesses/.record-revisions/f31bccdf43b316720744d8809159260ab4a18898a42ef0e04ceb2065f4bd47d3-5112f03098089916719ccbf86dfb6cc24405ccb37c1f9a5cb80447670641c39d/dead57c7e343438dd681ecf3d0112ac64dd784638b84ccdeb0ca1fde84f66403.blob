  "semantic_content": {
    "language": "en",
    "presupposition_account": "The question isolates the strong demand described in the passage. It does not assume that this demand is coherent or that ordinary responsibility has the same requirement.",
    "question_text": "In the metaphysical sense criticized in JGB 21, does the demand for ultimate personal responsibility require being the cause of oneself?",
    "script": "Latn"
  },
  "semantic_scope": {
    "identity_criterion": "Retain the question while the demand concerns ultimate responsibility in this specified sense; weakening the demand or asking about legal accountability changes the question.",
    "language": "en",
    "scope_note": "The relation stated between ultimate responsibility and self-origination in the first part of JGB 21.",
    "script": "Latn"
  },
