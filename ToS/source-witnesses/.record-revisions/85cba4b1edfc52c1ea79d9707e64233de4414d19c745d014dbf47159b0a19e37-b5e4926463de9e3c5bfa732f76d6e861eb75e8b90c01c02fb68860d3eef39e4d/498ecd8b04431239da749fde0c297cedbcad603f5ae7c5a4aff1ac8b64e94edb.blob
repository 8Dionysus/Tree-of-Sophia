{"command_id":"jgb-freedom:20260907:argument:anti-self-origination-jgb21","expected_configuration":"sha256:8edaddff486efaad8505aa904d106557cbe86fa211dedc9a4a19dcd53e8def42","expected_dependencies":"sha256:6e9d7a72da7a860072abb7d65d401ae7df3770675d7aa1c9e168570630329054","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.argument.anti-self-origination-jgb21.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.argument.anti-self-origination-jgb21.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.argument.anti-self-origination-jgb21.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Частичная реконструкция довода §21: метафизически предельная ответственность требует самопричинения; самопричинение объявляется противоречивым; отсюда критикуемый смысл свободы отвергается. Формальная расстановка посылок и вывода — исследовательская работа, не данная автором система аксиом.","preferred_label":"Реконструкция довода против метафизического самооснования — JGB 21","record_id":"tos.argument.anti-self-origination-jgb21","record_type":"argument","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_description_record_v1","semantic_content":{"coverage":"partial","language":"en","reconstruction_note":"A partial reconstruction makes explicit the dependence of the criticized metaphysical freedom on self-origination and the passage's rejection of self-origination. The structure does not establish the premises' truth or a complete formal proof.","script":"Latn"},"semantic_scope":{"identity_criterion":"The same passage-bound reasoning remains the referent despite improved description. A different argument or a broader reconstruction must not overwrite it.","language":"en","scope_note":"The opening anti-self-origination reasoning in JGB 21, not the entire section or a formalization of all Nietzschean arguments.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-21"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md","status":"unverified","value":"Reconstructed argument against metaphysical self-origination — JGB 21"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
