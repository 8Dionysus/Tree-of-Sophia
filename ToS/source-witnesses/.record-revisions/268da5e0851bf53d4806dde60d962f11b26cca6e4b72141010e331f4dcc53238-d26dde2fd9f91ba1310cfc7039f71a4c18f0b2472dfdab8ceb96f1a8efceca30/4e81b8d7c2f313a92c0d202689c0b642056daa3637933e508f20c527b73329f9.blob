{"command_id":"jgb-inquiry:20260907:opposition:metaphysical-and-mechanistic-freedom-jgb21","expected_configuration":"sha256:9b1ee8f369e973ec30ef33d967f7abf3e71b5aaa347657fda8d464bfd1cb678e","expected_dependencies":"sha256:21448bd28553ba55ebcc3c3ed918e683e20e49356249176f97f85948b859fda7","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.opposition.metaphysical-and-mechanistic-freedom-jgb21.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.opposition.metaphysical-and-mechanistic-freedom-jgb21.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.opposition.metaphysical-and-mechanistic-freedom-jgb21.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Оппозиция двух определённых трактовок, обсуждаемых в §21. Их противопоставление не делает их исчерпывающей альтернативой: текст предупреждает против перехода от критики одной к принятию другой. Члены оппозиции задаются отдельными утверждениями с основаниями, а не различием цвета или положения на сцене.","preferred_label":"Метафизически свободная и механистически несвободная воля — оппозиция JGB 21","record_id":"tos.opposition.metaphysical-and-mechanistic-freedom-jgb21","record_type":"opposition","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_topic_record_v1","semantic_content":{"differentiation_criterion":"Contrast ultimate metaphysical self-origination with a mechanistic account of unfree willing.","language":"en","opposition_basis":"JGB 21 explicitly treats unfree will as a reversal to be rejected as well. Opposition is recorded without assuming exhaustive alternatives or establishing formal contradiction.","script":"Latn"},"semantic_scope":{"identity_criterion":"Retain the opposition while these two specified notions and their inversion remain the subject; a different sense of freedom or a different contrast is another object.","language":"en","scope_note":"The opposed notions singled out in JGB 21; neither is accepted by being a term of the opposition.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-21"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","status":"unverified","value":"Metaphysically free and mechanistically unfree will — an opposition in JGB 21"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
