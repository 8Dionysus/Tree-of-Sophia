{"command_id":"jgb-inquiry:20260907:problem-family:agency-responsibility-jgb","expected_configuration":"sha256:7530997159d98de8495cb3c39397d0542c48996568e7ea2c2e8f7d33d801e96b","expected_dependencies":"sha256:48274f7d2a53cc3bee650599585010f8bb0094de9999cee2492f78b071ea5faa","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.problem-family.agency-responsibility-jgb.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.problem-family.agency-responsibility-jgb.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.problem-family.agency-responsibility-jgb.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Открытое исследовательское семейство, связывающее две различные проблемы: состав переживания воли в §19 и метафизическое требование ответственности в §21. Объединение обосновано их отношением к действию и свободе; оно не объявляет оба параграфа одним аргументом, одной эпохой изменения позиции или исчерпывающей теорией Ницше.","preferred_label":"Вопросы агентности и ответственности — исследовательское семейство JGB 19/21","record_id":"tos.problem-family.agency-responsibility-jgb","record_type":"problem-family","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_topic_record_v1","semantic_content":{"grouping_basis":"The member problems examine different conditions under which willing and action are attributed to a subject: experienced command/obedience and ultimate responsibility. Their relation is proposed by the researcher, not asserted as an authorial hierarchy.","language":"en","script":"Latn"},"semantic_scope":{"identity_criterion":"Retain this grouping while its criterion connects inquiry into agency and responsibility without erasing member differences; changing that criterion creates a new grouping.","language":"en","scope_note":"A research grouping of the two specified problems in JGB 19 and 21; not an authorial taxonomy or exhaustive philosophical family.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-19","http://www.nietzschesource.org/eKGWB/JGB-21"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","status":"unverified","value":"Agency and responsibility — a research problem family for JGB 19/21"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
