  "semantic_content": {
    "language": "en",
    "script": "Latn",
    "script_account": "A writing tradition used for many languages and notation systems, not the Latin language.",
    "sign_inventory_scope": "The broad Latin-script tradition with extensions. A code chart describes encoding coverage, not the complete historical identity or meaning of every written form."
  },
  "semantic_scope": {
    "identity_criterion": "Смена набора кодовых позиций или шрифта не создаёт новую традицию; самостоятельные алфавиты и конвенции могут получать собственные предметы.",
    "language": "ru",
    "scope_note": "Широкая латинская традиция письма как возможная основа транслитерационной записи; дополнительные метасимволы схемы остаются отдельными.",
    "script": "Cyrl"
  },
