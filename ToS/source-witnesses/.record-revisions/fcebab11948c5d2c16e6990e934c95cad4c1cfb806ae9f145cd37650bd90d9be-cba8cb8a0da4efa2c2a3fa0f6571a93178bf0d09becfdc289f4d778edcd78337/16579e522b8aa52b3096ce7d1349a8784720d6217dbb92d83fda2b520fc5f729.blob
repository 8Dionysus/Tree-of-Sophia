  "semantic_scope": {
    "identity_criterion": "Retain this referent while accounts address the recurring problem of freedom and its conditions, including denials of particular senses. A shared word alone does not establish membership; a different problem needs a distinct referent.",
    "language": "en",
    "scope_note": "Questions concerning what counts as freedom of agency or willing, its conditions, constraints and relation to responsibility; the initial evidence is limited to JGB 19 and 21.",
