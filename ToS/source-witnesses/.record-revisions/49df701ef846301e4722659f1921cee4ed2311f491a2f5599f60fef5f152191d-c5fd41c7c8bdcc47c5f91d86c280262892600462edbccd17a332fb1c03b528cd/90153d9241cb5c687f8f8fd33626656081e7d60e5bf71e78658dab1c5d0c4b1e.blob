  "semantic_content": {
    "assertion_force": "Hypothetically granted opening condition; not accepted truth.",
    "language": "en",
    "proposition": "Suppose that no reality other than our world of drives and passions is given to us for this inquiry.",
    "script": "Latn"
  },
  "semantic_scope": {
    "identity_criterion": "Retain the proposition while its modal force and given-to-us scope concern this opening supposition; changing it into an unconditional ontological claim changes the subject under examination.",
    "language": "en",
    "scope_note": "The opening given-reality supposition of JGB 36; being given to us is not silently replaced by an exhaustive inventory of existence.",
    "script": "Latn"
  },
