            "https://ores.klassik-stiftung.de/ords/f?p=406:2:::::P2_ID:4752",
            "ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_LETTER_705_SOURCE_READING_V1.md"
          ]
