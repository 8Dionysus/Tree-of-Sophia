        "fields": {
          "qualifiers": {
            "relation_basis": "The passage identifies unfree will as the reversal and criticizes its reification of cause and effect. This grounds its term role; formal contradiction requires separate assessment.",
            "relation_basis_language": "en",
            "relation_basis_script": "Latn",
            "scope": "Provisional passage-bound research; no calibrated assessment, admission, logical validity, exhaustive taxonomy or canon assertion.",
            "source_locator": "http://www.nietzschesource.org/eKGWB/JGB-21",
