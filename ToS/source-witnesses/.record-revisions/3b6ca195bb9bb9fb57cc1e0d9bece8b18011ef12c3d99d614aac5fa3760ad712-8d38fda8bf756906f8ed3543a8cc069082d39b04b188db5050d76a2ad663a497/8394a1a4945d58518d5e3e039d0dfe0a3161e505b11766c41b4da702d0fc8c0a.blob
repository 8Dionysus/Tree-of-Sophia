{"command_id":"foundation-v1:letter-705:initial-metadata:20260907","expected_configuration":"sha256:66bdfe6ce7e1fa37e4b44b267327d038a3344d790da63be2d90ed5b57cfb805e","expected_dependencies":"sha256:856cb2bdd1bfc9f75369c401583046f579a8bc3874635f136c6fc83147568592","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.nietzsche-naumann-letter-705-name-ru"},{"field_id":"metadata.source-note","form_id":"tos.form.nietzsche-naumann-letter-705-note-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.nietzsche-naumann-letter-705-heading-de"}],"operation":"source.create","record":{"external_identifiers":[{"scheme":"eKGWB","source_ref":"https://www.nietzschesource.org/texts/eKGWB/BVN-1886","status":"unverified","value":"BVN-1886,705"}],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Описательная запись письма, обозначенного в eKGWB № 705: адресат указан как Константин Георг Науманн в Лейпциге, датировка текста — Наумбург-на-Заале, 3 июня 1886 года. Ницше обсуждает расчёт стоимости и бумагу, просит ускорить печать и связывает спешку с планируемой летней работой. Название книги в прочитанном тексте не указано; связь с «По ту сторону добра и зла» здесь атрибутирована комментарию Андреаса Урса Зоммера (2016, с. 6). Это интеллектуальный документ, не его бумажный носитель, скан или печатное издание. Идентификация, отношения и датировка требуют своих проверяемых утверждений; наличие этой записи не устанавливает получение письма, действительный темп печати, причинное влияние или права использования. Русское описание составлено по указанным источникам; немецкая форма воспроизводит редакционный заголовок eKGWB.","preferred_label":"Письмо Ницше Науманну, № 705 в eKGWB","record_id":"tos.letter.nietzsche-naumann-1886-705","record_type":"letter","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_document_record_v1","source_refs":["https://www.nietzschesource.org/texts/eKGWB/BVN-1886","https://digi.hadw-bw.de/view/nietzsche_kom5_1/0026","ToS/research-packets/foundation-laboratory-2026-07/JENSEITS_1886_LETTER_705_SOURCE_READING_V1.md"],"variant_labels":[{"language":"de","script":"Latn","source_ref":"https://www.nietzschesource.org/texts/eKGWB/BVN-1886","status":"unverified","value":"An Constantin Georg Naumann in Leipzig"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
