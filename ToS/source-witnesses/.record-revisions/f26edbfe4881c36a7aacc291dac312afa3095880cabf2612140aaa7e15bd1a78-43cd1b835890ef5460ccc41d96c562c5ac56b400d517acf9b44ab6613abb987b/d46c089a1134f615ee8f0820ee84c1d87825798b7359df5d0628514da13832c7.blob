{"command_id":"jgb-inquiry:20260907:problem:ultimate-responsibility-jgb21","expected_configuration":"sha256:86a648066f4e6325c49d5bec4be51dcf5b17ab93b2e08f02cc860d3715e615d3","expected_dependencies":"sha256:910b8e75d9cbea48623d33aa2f871dc5c32d43f83dbcd162936ebf760ea095e6","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.problem.ultimate-responsibility-jgb21.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.problem.ultimate-responsibility-jgb21.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.problem.ultimate-responsibility-jgb21.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Проблема исследователя: как §21 связывает требование последней ответственности с самопричинением и что именно отрицается этой критикой. Формулировка выделяет трудность чтения, а не приписывает Ницше дословный исследовательский вопрос или готовое решение всех вопросов ответственности.","preferred_label":"Предельная ответственность и самопричинение — проблема чтения JGB 21","record_id":"tos.problem.ultimate-responsibility-jgb21","record_type":"problem","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_topic_record_v1","semantic_content":{"inquiry_stakes":"Avoid confusing a critique of a specified metaphysical requirement with denial of every sense of agency or responsibility.","language":"en","problem_statement":"How the demand for ultimate personal responsibility is connected to self-origination in JGB 21, and what the criticism does and does not reject.","script":"Latn"},"semantic_scope":{"identity_criterion":"Keep the inquiry referent while asking about this relation and its limits, not every moral or legal responsibility problem.","language":"en","scope_note":"The relation between ultimate responsibility, self-origination and the scope of the rejection in JGB 21.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-21"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","status":"unverified","value":"Ultimate responsibility and self-origination — a problem in reading JGB 21"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
