{"command_id":"jgb-inquiry:20260907:distinction:experienced-and-metaphysical-freedom-jgb","expected_configuration":"sha256:097f05c798507fb57ea06a3b42db380c2f71c41899cf909808909056c3a936ee","expected_dependencies":"sha256:6cd91dd43032deb0cedf363f2d6655f33ac9043ff9d54c55405d5bc16aa65967","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.distinction.experienced-and-metaphysical-freedom-jgb.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.distinction.experienced-and-metaphysical-freedom-jgb.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.distinction.experienced-and-metaphysical-freedom-jgb.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Различение исследователя между описанием переживаемой свободы в §19 и метафизическим самооснованием, критикуемым в §21. Оно сопоставляет разные смысловые задачи двух мест, не объявляя их логически несовместимыми, стадиями развития автора или дословно сформулированной им классификацией.","preferred_label":"Переживаемая свобода и метафизическое самооснование — исследовательское различение","record_id":"tos.distinction.experienced-and-metaphysical-freedom-jgb","record_type":"distinction","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_topic_record_v1","semantic_content":{"differentiation_criterion":"Distinguish an account of experienced command, obedience and attributed success from a demand for ultimate self-origination. Difference of explanatory task does not alone establish logical incompatibility.","language":"en","script":"Latn"},"semantic_scope":{"identity_criterion":"Retain the distinction while the criterion separates experienced attribution of agency from ultimate metaphysical self-origination; a different comparison needs another distinction.","language":"en","scope_note":"A comparison of the specified JGB 19 and JGB 21 conceptions, not a universal partition of freedom.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-19","http://www.nietzschesource.org/eKGWB/JGB-21"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","status":"unverified","value":"Experienced freedom and metaphysical self-origination — a research distinction"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
