  "semantic_content": {
    "category_account": "Cause and effect are described in JGB 21 as conventional conceptual devices for designation and communication, contrasted with reified causal forces. The record describes that philosophical use without adopting it as a core ontological rule.",
    "language": "en",
    "script": "Latn"
  },
  "semantic_scope": {
    "identity_criterion": "Retain the referent while describing this passage's use and limits of causal concepts. A different causal theory is not a corrected version of this category account.",
    "language": "en",
    "scope_note": "The category of cause and effect as discussed against reification in JGB 21, not a universal ToS theory of causality.",
    "script": "Latn"
  },
