            "source_section": "JGB 36",
            "statement": "Метод испытания одной причинности использует условное полагание волевой причинности единственной. Достаточность этой причинности остаётся предметом испытания.",
            "statement_language": "ru",
            "statement_script": "Cyrl"
          }
