{"command_id":"jgb-practice:20260907:thought-operation:provisionally-posit-will-causality-jgb36","expected_configuration":"sha256:53fa8b3c8c04615662e4a87486bafc421a76692d6e0422db9465eabfe1cb9cd0","expected_dependencies":"sha256:d47a1ac435758c36946d1147a1e19ec3787ac27000bd44bb3e5d6a589b0e4e5f","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.thought-operation.provisionally-posit-will-causality-jgb36.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.thought-operation.provisionally-posit-will-causality-jgb36.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.thought-operation.provisionally-posit-will-causality-jgb36.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Описанная операция — принять для испытания гипотезу единственной волевой причинности, если воля признаётся действующей. Это условное допущение в ходе мысли: оно не устанавливает истинность гипотезы и не запускает вычислительную операцию.","preferred_label":"Гипотетически положить волевую причинность единственной — JGB 36","record_id":"tos.thought-operation.provisionally-posit-will-causality-jgb36","record_type":"thought-operation","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_practice_record_v1","semantic_content":{"language":"en","operation_account":"Provisionally posit will-causality as the only kind for the proposed inquiry, without asserting that this positing proves its adequacy.","prerequisites":["Acknowledge will as causally effective within the trial.","Keep the sole-causality proposal hypothetical rather than inferred fact."],"script":"Latn"},"semantic_scope":{"identity_criterion":"Retain the operation while its task is provisionally granting sole will-causality under the stated condition; asserting its truth would be a distinct judgment.","language":"en","scope_note":"The hypothetical positing operation within JGB 36, not the whole method or the actuality of its premise.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-practice-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-36"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-practice-source-reading.md","status":"unverified","value":"Provisionally posit will-causality alone — JGB 36"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
