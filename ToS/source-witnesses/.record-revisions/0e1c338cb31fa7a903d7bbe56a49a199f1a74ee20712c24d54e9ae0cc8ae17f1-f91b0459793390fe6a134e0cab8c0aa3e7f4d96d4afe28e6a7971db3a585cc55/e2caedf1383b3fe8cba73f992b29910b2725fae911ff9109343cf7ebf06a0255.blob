{"command_id":"social-research:20260907:community:vienna-circle-schlick","expected_configuration":"sha256:f56a87f7bd030206f9f96f6dd01b4b0c0e890304054cd2120442b2b161f0f1cb","expected_dependencies":"sha256:2b2088e5a6398cd9a2add30b88379edba4cd2f225edc9ab3702c79b583575bd3","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.community.vienna-circle-schlick.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.community.vienna-circle-schlick.name-de"},{"field_id":"metadata.source-note","form_id":"tos.form.community.vienna-circle-schlick.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Сообщество регулярного философского обсуждения, описанное венским университетским очерком. Оно не отождествляется с логическим эмпиризмом как интеллектуальным направлением, Обществом Эрнста Маха или позднейшим Институтом Венского кружка.","preferred_label":"Венский кружок Шлика","record_id":"tos.community.vienna-circle-schlick","record_type":"community","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_social_body_record_v1","semantic_content":{"community_practice":"Повторяющиеся совместные обсуждения научного мировоззрения; применение категории «сообщество» — предварительная исследовательская классификация.","group_account":"Круг участников совместного философского обсуждения, описанный источником как исторический коллектив.","language":"ru","membership_boundary":"Источник различает ядро и периферию; запись не задаёт исчерпывающего состава и не делает любого последователя участником.","script":"Cyrl"},"semantic_scope":{"identity_criterion":"Сохраняется этот круг совместного обсуждения; одно сходство идей или имени позднейшей организации не доказывает его продолжение.","language":"ru","scope_note":"Исторический кружок регулярных встреч, а не вся последующая международная рецепция.","script":"Cyrl"},"source_refs":["ToS/review-ledger/2026-09-07-social-source-reading.md","https://geschichte.univie.ac.at/de/artikel/der-wiener-kreis"],"variant_labels":[{"language":"de","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-social-source-reading.md","status":"unverified","value":"Wiener Kreis"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
