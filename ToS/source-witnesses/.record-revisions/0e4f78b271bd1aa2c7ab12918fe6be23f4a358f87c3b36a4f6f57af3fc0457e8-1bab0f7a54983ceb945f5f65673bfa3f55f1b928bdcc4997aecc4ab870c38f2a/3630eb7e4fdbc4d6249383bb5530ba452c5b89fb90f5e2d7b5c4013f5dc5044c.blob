{"command_id":"lexical:20260908:subject:willing-jgb19","expected_configuration":"sha256:121d057e5de84e896976eebfe47318397b1eff5b5b10d2dd9d1bd76ec2241111","expected_dependencies":"sha256:41edd0be07cc9a3a3c5b7db29c39f95c517864f5e8f011808fec8d3c17a5ae20","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.lexical.willing-jgb19.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.lexical.willing-jgb19.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.lexical.willing-jgb19.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Предварительное толкование исследуемой лексемы как обозначения воления в JGB 19. Это ограниченное языковое чтение, не готовая словарная статья и не принятие всей философской трактовки командования, повиновения и свободы.","preferred_label":"Воление — контекстное значение в JGB 19","record_id":"tos.sense.willing-jgb19","record_type":"sense","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_lexical_description_record_v1","semantic_content":{"interpretation_context":"Немецкий текст JGB 19. Употребления, атрибуции и подробная философская трактовка остаются отдельными предметами исследования.","language":"ru","script":"Cyrl","semantic_range":"Чтение не распространяется автоматически на всякое немецкое употребление, свободную волю, политическую свободу или все концепции Ницше; иные значения не отрицаются.","sense_account":"Значение, в котором исследуемое слово отсылает к волению, обсуждаемому в данном разделе."},"semantic_scope":{"identity_criterion":"Исправляется описание того же ограниченного чтения; конкурирующий смысл, изменение контекста или философская концепция не подменяют его незаметно.","language":"ru","scope_note":"Предложенное контекстное лексическое чтение JGB 19, а не универсальное понятие воли.","script":"Cyrl"},"source_refs":["ToS/review-ledger/2026-09-08-jgb-lexical-source-reading.md","http://www.nietzschesource.org/eKGWB/JGB-19"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-08-jgb-lexical-source-reading.md","status":"unverified","value":"Willing — situated lexical reading in JGB 19"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
