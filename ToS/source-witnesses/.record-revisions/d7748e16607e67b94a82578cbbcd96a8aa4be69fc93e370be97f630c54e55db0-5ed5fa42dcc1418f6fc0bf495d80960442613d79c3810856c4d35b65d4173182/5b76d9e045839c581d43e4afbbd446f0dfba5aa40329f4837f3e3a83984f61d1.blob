{"command_id":"jgb-inquiry:20260907:position:critical-double-refusal-jgb21","expected_configuration":"sha256:1d4bb73befa7d9e5ad71df7bf90f96d8b597f24cd509b2b2a524841d2a3b0d79","expected_dependencies":"sha256:cada69f61dbc2a45ecd67a691348960d95a976a31946746ba30bf72344f4c2c6","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.position.critical-double-refusal-jgb21.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.position.critical-double-refusal-jgb21.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.position.critical-double-refusal-jgb21.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Ограниченная позиция, реконструируемая по §21: критика самопричинения не ведёт к принятию механистически несвободной воли. Запись не сводит всю философию автора к этой позиции и не принимает его дальнейшие типологии сильной и слабой воли или социальные обобщения.","preferred_label":"Критика метафизической свободы и её механистического обращения — JGB 21","record_id":"tos.position.critical-double-refusal-jgb21","record_type":"position","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_topic_record_v1","semantic_content":{"language":"en","script":"Latn","stance_account":"Reject the metaphysical self-origination demand while also refusing to substitute a reified mechanistic opposite. This passage-bound reconstruction does not endorse all of the section's psychological or social judgments."},"semantic_scope":{"identity_criterion":"Retain the stance referent while describing this bounded double refusal; a later different stance or a comprehensive theory is another referent, not a metadata correction.","language":"en","scope_note":"The two critical moves within JGB 21, without a claim about Nietzsche's complete or unchanging position.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-21"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-inquiry-source-reading.md","status":"unverified","value":"Critique of metaphysical freedom and its mechanistic reversal — JGB 21"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
