{"command_id":"jgb-freedom:20260907:thesis:metaphysical-freedom-rejected-jgb21","expected_configuration":"sha256:b8cf656a07ffa4ecab8aef28406f52313435f9814d8fc5976ac14246fb4e287c","expected_dependencies":"sha256:4c966acaaf8077356393fd71ae71dc4045a1197b9d1383ce6c2956f4730fe9f7","expected_revision":null,"expected_source":null,"forms":[{"field_id":"metadata.preferred-name","form_id":"tos.form.thesis.metaphysical-freedom-rejected-jgb21.name-ru"},{"field_id":"metadata.variant-name:0","form_id":"tos.form.thesis.metaphysical-freedom-rejected-jgb21.name-en"},{"field_id":"metadata.source-note","form_id":"tos.form.thesis.metaphysical-freedom-rejected-jgb21.note-ru"}],"operation":"source.create","record":{"external_identifiers":[],"field_languages":{"notes":{"language":"ru","script":"Cyrl"},"preferred_label":{"language":"ru","script":"Cyrl"}},"identity_status":"provisional","notes":"Вывод, реконструируемый из связи двух посылок §21: критикуемый метафизический смысл свободы не выдерживает возражения о самопричинении. Это не безусловный вывод об отсутствии всякой агентности или о доказанности противоположного детерминизма.","preferred_label":"Отказ от метафизической свободы, не от всех её смыслов — JGB 21","record_id":"tos.thesis.metaphysical-freedom-rejected-jgb21","record_type":"thesis","record_version":1,"same_as_posture":"no_equivalence_claim","schema_version":"tos_thought_description_record_v1","semantic_content":{"assertion_force":"research_reconstruction_of_source_conclusion","language":"en","proposition":"The criticized metaphysical conception of free will is untenable under the passage's self-origination objection.","script":"Latn"},"semantic_scope":{"identity_criterion":"The same bounded conclusion remains the referent. A claim that all agency is impossible or that determinism is proven is a different thesis.","language":"en","scope_note":"The proposed conclusion of the anti-self-origination reconstruction in JGB 21, bounded to the criticized metaphysical sense.","script":"Latn"},"source_refs":["ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md","ToS/source-witnesses/works/friedrich-nietzsche/jenseits-von-gut-und-boese/work.json","http://www.nietzschesource.org/eKGWB/JGB-21"],"variant_labels":[{"language":"en","script":"Latn","source_ref":"ToS/review-ledger/2026-09-07-jgb-freedom-source-reading.md","status":"unverified","value":"Rejection of metaphysical freedom, not every sense — JGB 21"}],"visibility":"public_metadata_only"},"schema_version":"tos_local_source_command_v1"}
