{"claims":[{"assertion_layer":"scholarly_report","claim_id":"tos.claim.linguistic.penn-language","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-08-linguistic-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.language.akkadian","predicate":"inscription_language","provenance_event_ref":"tos.event.create-linguistic-claims-20260908","qualifiers":{"attestation_scope":"Только надпись описанного CBS7771; не доказательство единственного языка всех слоёв, диалекта или места создания.","relation_basis":"The explicitly named Inscription Language field on the Penn object page.","source_wording":{"language":"en","script":"Latn","text":"Akkadian Language"},"statement":"Penn Museum указывает аккадский язык надписи CBS 07771; это сообщение каталога, не проведённый здесь разбор древнего текста.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.artifact.old-babylonian.uncertain.penn-cbs-07771","visibility":"public_metadata_only"},{"assertion_layer":"scholarly_report","claim_id":"tos.claim.linguistic.louvre-language","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-08-linguistic-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.language.sumerian","predicate":"inscription_language","provenance_event_ref":"tos.event.create-linguistic-claims-20260908","qualifiers":{"attestation_scope":"Надпись AO 5473 в описании Лувра; не самостоятельная лингвистическая проверка, идентификация диалекта или утверждение о всех произведениях сборника.","relation_basis":"The Langue field under Inscriptions in the Louvre object description.","source_wording":{"language":"fr","script":"Latn","text":"sumérien"},"statement":"Лувр указывает шумерский язык надписи AO 5473; атрибуция сохранена как сообщение каталога.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.artifact.sumerian.uncertain.louvre-ao-05473","visibility":"public_metadata_only"},{"assertion_layer":"scholarly_report","claim_id":"tos.claim.linguistic.louvre-script","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-08-linguistic-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.script.cuneiform-writing-tradition","predicate":"inscription_script","provenance_event_ref":"tos.event.create-linguistic-claims-20260908","qualifiers":{"attestation_scope":"Общая письменность указанной надписи; не единый набор знаков всех эпох и не тождество языка с письменностью.","relation_basis":"The Écriture field under Inscriptions in the Louvre object description.","source_wording":{"language":"fr","script":"Latn","text":"cunéiforme"},"statement":"Лувр относит письмо надписи AO 5473 к клинописи; конкретный репертуар и значения знаков здесь не устанавливаются.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.artifact.sumerian.uncertain.louvre-ao-05473","visibility":"public_metadata_only"},{"assertion_layer":"scholarly_report","claim_id":"tos.claim.linguistic.oldbab-dialect","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-08-linguistic-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.language.akkadian","predicate":"dialect_of","provenance_event_ref":"tos.event.create-linguistic-claims-20260908","qualifiers":{"attestation_scope":"Лингвистический предмет главы, с отделением древнеассирийского и сохранением внутренних различий; не классификация всех табличек данного периода.","relation_basis":"Streck 2021, chapter 13, §1 explicitly describes Old Babylonian as a traditionally named period/dialect of Akkadian.","source_wording":{"language":"en","script":"Latn","text":"Old Babylonian"},"statement":"Streck описывает старовавилонское как традиционно выделяемый диалект аккадского; связь ограничена областью его языкового исследования.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.linguistic-variety.old-babylonian","visibility":"public_metadata_only"},{"assertion_layer":"scholarly_report","claim_id":"tos.claim.linguistic.oldbab-stage","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-08-linguistic-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.language.akkadian","predicate":"historical_language_stage_of","provenance_event_ref":"tos.event.create-linguistic-claims-20260908","qualifiers":{"attestation_scope":"Только историко-языковая область §1; абсолютные даты, распространение на отдельные надписи и единообразие разновидности не выводятся.","relation_basis":"Streck's introduction scopes its Akkadian-language history between the fall of Ur III and end of Babylon I, excluding Old Assyrian.","source_wording":{"language":"en","script":"Latn","text":"Old Babylonian"},"statement":"В описании истории аккадского у Streck старовавилонская разновидность относится к выделенному историческому отрезку; это не тождество языка с археологической датировкой.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.linguistic-variety.old-babylonian","visibility":"public_metadata_only"},{"assertion_layer":"scholarly_report","claim_id":"tos.claim.linguistic.atf-source-writing","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-08-linguistic-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.script.cuneiform-writing-tradition","predicate":"transliteration_source_script","provenance_event_ref":"tos.event.create-linguistic-claims-20260908","qualifiers":{"attestation_scope":"Описанная конвенция записи графем, не полный охват всех клинописных систем и не действительная транслитерация Penn или Louvre.","relation_basis":"The indexed ATF Inline Tutorial explicitly describes cuneiform transliteration character conventions and graphemes; direct page retrieval failed.","source_wording":{"language":"en","script":"Latn","text":"ATF Inline Tutorial"},"statement":"Документация ORACC ATF описывает запись графем клинописной транслитерации; эта связь не запускает преобразование и не удостоверяет чтения.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.transliteration-scheme.oracc-atf","visibility":"public_metadata_only"},{"assertion_layer":"scholarly_report","claim_id":"tos.claim.linguistic.atf-notation","claim_type":"relation","claim_version":1,"epistemic_status":"uncertain","evidence_refs":["ToS/review-ledger/2026-09-08-linguistic-source-reading.md"],"maker":{"agent_ref":"agent:codex-tos-foundation","maker_type":"model"},"object":"tos.script.latin-writing-tradition","predicate":"transliteration_notation_script","provenance_event_ref":"tos.event.create-linguistic-claims-20260908","qualifiers":{"attestation_scope":"Основа буквенной нотации в прочитанных индексированных разделах; не латинский язык, не перевод и не утверждение, что все символы ATF имеют Script=Latin.","relation_basis":"A limited inference from the tutorial's Latin-letter transliteration character table, read alongside Unicode §7.1; not an explicit all-characters script declaration.","source_wording":{"language":"en","script":"Latn","text":"Unicode-ATF"},"statement":"Показанные в документации ORACC ATF буквенные обозначения имеют латинскую основу; числа и редакционные метасимволы остаются отдельной частью записи.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_semantic_relation_claim_v1","subject_ref":"tos.transliteration-scheme.oracc-atf","visibility":"public_metadata_only"}],"command_id":"linguistic:20260908:claims","expected_configuration":"sha256:db7db9a0eee5892885ef8b0825f712bec05e90b357adc05edd3eeded6ea0f7ef","expected_dependencies":"sha256:0ca2eea45c40b24a1caa92573fb177751450ed8caf17654ec9074c6d64a4aaff","expected_inputs":{"evidence":{"ToS/review-ledger/2026-09-08-linguistic-source-reading.md":{"evidence_kind":"repo_path","source_line":null,"source_ref":"ToS/review-ledger/2026-09-08-linguistic-source-reading.md","source_sha256":"sha256:baf20a5de2a69535baad82ca3ea75124a91f8bf221351ccd46d30028e3a6b0c4"}},"objects":{"tos.artifact.old-babylonian.uncertain.penn-cbs-07771":{"canonical_record_sha256":"sha256:1a702f567cd7ef4f41cfd830b91d557f5ac3f3c7db0fde96a64dbf3ff12005dd","record_version":1,"schema_version":"tos_artifact_source_witness_v1","source_ref":"ToS/source-witnesses/artifacts/old-babylonian/uncertain/penn-cbs-07771/artifact-witness.json","source_sha256":"sha256:60c5c31c846c1e38eeb6e571dc15c85aa4f3cbb26a31edeaa8fd70bc47a2b6ef"},"tos.artifact.sumerian.uncertain.louvre-ao-05473":{"canonical_record_sha256":"sha256:fec719fad9c9b7bffaeed6eba3b14d5abd40d9ff5f1b92dfc7d512807d87f8fc","record_version":1,"schema_version":"tos_artifact_source_witness_v1","source_ref":"ToS/source-witnesses/artifacts/sumerian/uncertain/louvre-ao-05473/artifact-witness.json","source_sha256":"sha256:58caa50da8c0aef45e190b07c8c5efad2493290b52ff7f65bf983010eb3e322d"},"tos.language.akkadian":{"canonical_record_sha256":"sha256:15aa92c20ec9683893484bc7ecd07a6cb984e062e829dcc52108861a90436d3d","record_version":1,"schema_version":"tos_linguistic_