{
  "sn35.113:0.1": "Saṁyutta Nikāya 35.113 ",
  "sn35.113:0.2": "11. Yogakkhemivagga ",
  "sn35.113:0.3": "Upassutisutta ",
  "sn35.113:1.1": "Ekaṁ samayaṁ bhagavā nātike viharati giñjakāvasathe. ",
  "sn35.113:1.2": "Atha kho bhagavā rahogato paṭisallīno imaṁ dhammapariyāyaṁ abhāsi: ",
  "sn35.113:1.3": "“cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn35.113:1.4": "Phassapaccayā vedanā; ",
  "sn35.113:1.5": "vedanāpaccayā taṇhā; ",
  "sn35.113:1.6": "taṇhāpaccayā upādānaṁ; ",
  "sn35.113:1.7": "upādānapaccayā bhavo; ",
  "sn35.113:1.8": "bhavapaccayā jāti; ",
  "sn35.113:1.9": "jātipaccayā jarāmaraṇaṁ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.113:1.10": "Evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn35.113:1.11": "Jivhañca paṭicca rase ca uppajjati …pe… ",
  "sn35.113:1.12": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn35.113:1.13": "Phassapaccayā vedanā; ",
  "sn35.113:1.14": "vedanāpaccayā taṇhā; ",
  "sn35.113:1.15": "taṇhāpaccayā upādānaṁ; ",
  "sn35.113:1.16": "upādānapaccayā bhavo; ",
  "sn35.113:1.17": "bhavapaccayā jāti; ",
  "sn35.113:1.18": "jātipaccayā jarāmaraṇaṁ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.113:1.19": "Evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn35.113:2.1": "Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṁ. T