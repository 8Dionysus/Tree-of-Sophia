{
  "sn35.101:0.1": "Saṁyutta Nikāya 35.101 ",
  "sn35.101:0.2": "10. Saḷavagga ",
  "sn35.101:0.3": "Paṭhamanatumhākasutta ",
  "sn35.101:1.1": "“Yaṁ, bhikkhave, na tumhākaṁ, taṁ pajahatha. ",
  "sn35.101:1.2": "Taṁ vo pahīnaṁ hitāya sukhāya bhavissati. ",
  "sn35.101:1.3": "Kiñca, bhikkhave, na tumhākaṁ? ",
  "sn35.101:1.4": "Cakkhu, bhikkhave, na tumhākaṁ. ",
  "sn35.101:1.5": "Taṁ pajahatha. ",
  "sn35.101:1.6": "Taṁ vo pahīnaṁ hitāya sukhāya bhavissati. ",
  "sn35.101:1.7": "Rūpā na tumhākaṁ. ",
  "sn35.101:1.8": "Te pajahatha. ",
  "sn35.101:1.9": "Te vo pahīnā hitāya sukhāya bhavissanti. ",
  "sn35.101:1.10": "Cakkhuviññāṇaṁ na tumhākaṁ. ",
  "sn35.101:1.11": "Taṁ pajahatha. ",
  "sn35.101:1.12": "Taṁ vo pahīnaṁ hitāya sukhāya bhavissati. ",
  "sn35.101:1.13": "Cakkhusamphasso na tumhākaṁ. ",
  "sn35.101:1.14": "Taṁ pajahatha. ",
  "sn35.101:1.15": "So vo pahīno hitāya sukhāya bhavissati. ",
  "sn35.101:1.16": "Yampidaṁ cakkhusamphassapaccayā uppajjati vedayitaṁ sukhaṁ vā dukkhaṁ vā adukkhamasukhaṁ vā tampi na tumhākaṁ. ",
  "sn35.101:1.17": "Taṁ pajahatha. ",
  "sn35.101:1.18": "Taṁ vo pahīnaṁ hitāya sukhāya bhavissati. ",
  "sn35.101:1.19": "…pe… ",
  "sn35.101:2.1": "Jivhā na tumhākaṁ. ",
  "sn35.101:2.2": "Taṁ pajahatha. ",
  "sn35.101:2.3": "Sā vo pahīnā hitāya sukhāya bhavissati. ",
  "sn35.101:2.4": "Rasā na tumhākaṁ. ",
  "sn35.101:2.5": "Te pajahatha. ",
  "sn35.101:2.6": "Te 