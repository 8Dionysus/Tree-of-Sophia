{
  "sn35.106:0.1": "Saṁyutta Nikāya 35.106 ",
  "sn35.106:0.2": "11. Yogakkhemivagga ",
  "sn35.106:0.3": "Dukkhasamudayasutta ",
  "sn35.106:1.1": "“Dukkhassa, bhikkhave, samudayañca atthaṅgamañca desessāmi. ",
  "sn35.106:1.2": "Taṁ suṇātha. ",
  "sn35.106:1.3": "Katamo ca, bhikkhave, dukkhassa samudayo? ",
  "sn35.106:1.4": "Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn35.106:1.5": "Phassapaccayā vedanā; ",
  "sn35.106:1.6": "vedanāpaccayā taṇhā. ",
  "sn35.106:1.7": "Ayaṁ dukkhassa samudayo …pe… ",
  "sn35.106:1.8": "jivhañca paṭicca rase ca uppajjati jivhāviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn35.106:1.9": "Phassapaccayā vedanā; ",
  "sn35.106:1.10": "vedanāpaccayā taṇhā. ",
  "sn35.106:1.11": "Ayaṁ dukkhassa samudayo …pe… manañca paṭicca dhamme ca uppajjati manoviññāṇaṁ. ",
  "sn35.106:1.12": "Tiṇṇaṁ saṅgati phasso. ",
  "sn35.106:1.13": "Phassapaccayā vedanā; ",
  "sn35.106:1.14": "vedanāpaccayā taṇhā. ",
  "sn35.106:1.15": "Ayaṁ kho, bhikkhave, dukkhassa samudayo. ",
  "sn35.106:2.1": "Katamo ca, bhikkhave, dukkhassa atthaṅgamo? ",
  "sn35.106:2.2": "Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn35.106:2.3": "Phassapaccayā vedanā; ",
  "sn35.106:2.4": "vedanāpaccayā taṇhā. ",
  "sn35.106:2.5": "Tassāyeva taṇhāya asesavirāganirodhā upādānanirodho; ",
  "sn35.106:2.6": "upādānanirodhā b