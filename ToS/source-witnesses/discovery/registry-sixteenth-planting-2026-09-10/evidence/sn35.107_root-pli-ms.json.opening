{
  "sn35.107:0.1": "Saṁyutta Nikāya 35.107 ",
  "sn35.107:0.2": "11. Yogakkhemivagga ",
  "sn35.107:0.3": "Lokasamudayasutta ",
  "sn35.107:1.1": "“Lokassa, bhikkhave, samudayañca atthaṅgamañca desessāmi. ",
  "sn35.107:1.2": "Taṁ suṇātha. ",
  "sn35.107:1.3": "Katamo ca, bhikkhave, lokassa samudayo? ",
  "sn35.107:1.4": "Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn35.107:1.5": "Phassapaccayā vedanā; ",
  "sn35.107:1.6": "vedanāpaccayā taṇhā; ",
  "sn35.107:1.7": "taṇhāpaccayā upādānaṁ; ",
  "sn35.107:1.8": "upādānapaccayā bhavo; ",
  "sn35.107:1.9": "bhavapaccayā jāti; ",
  "sn35.107:1.10": "jātipaccayā jarāmaraṇaṁ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.107:1.11": "Ayaṁ kho, bhikkhave, lokassa samudayo …pe… ",
  "sn35.107:1.12": "jivhañca paṭicca rase ca uppajjati jivhāviññāṇaṁ …pe… ",
  "sn35.107:1.13": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn35.107:1.14": "Phassapaccayā vedanā; ",
  "sn35.107:1.15": "vedanāpaccayā taṇhā; ",
  "sn35.107:1.16": "taṇhāpaccayā upādānaṁ; ",
  "sn35.107:1.17": "upādānapaccayā bhavo; ",
  "sn35.107:1.18": "bhavapaccayā jāti; ",
  "sn35.107:1.19": "jātipaccayā jarāmaraṇaṁ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.107:1.20": "Ayaṁ kho, bhikkhave, lokassa samudayo. ",
  "sn35.107:2.1": "Katamo ca, bhikkhave, lokassa atthaṅgamo? ",
  "s