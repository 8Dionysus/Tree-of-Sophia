{
  "mn114:0.1": "Majjhima Nikāya 114 ",
  "mn114:0.2": "Sevitabbāsevitabbasutta ",
  "mn114:1.1": "Evaṁ me sutaṁ—",
  "mn114:1.2": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "mn114:1.3": "Tatra kho bhagavā bhikkhū āmantesi: ",
  "mn114:1.4": "“bhikkhavo”ti. ",
  "mn114:1.5": "“Bhadante”ti te bhikkhū bhagavato paccassosuṁ. ",
  "mn114:1.6": "Bhagavā etadavoca: ",
  "mn114:2.1": "“sevitabbāsevitabbaṁ vo, bhikkhave, dhammapariyāyaṁ desessāmi. ",
  "mn114:2.2": "Taṁ suṇātha, sādhukaṁ manasi karotha, bhāsissāmī”ti. ",
  "mn114:2.3": "“Evaṁ, bhante”ti kho te bhikkhū bhagavato paccassosuṁ. ",
  "mn114:2.4": "Bhagavā etadavoca: ",
  "mn114:3.1": "“Kāyasamācārampāhaṁ, bhikkhave, duvidhena vadāmi—",
  "mn114:3.2": "sevitabbampi, asevitabbampi; ",
  "mn114:3.3": "tañca aññamaññaṁ kāyasamācāraṁ. ",
  "mn114:3.4": "Vacīsamācārampāhaṁ, bhikkhave, duvidhena vadāmi—",
  "mn114:3.5": "sevitabbampi, asevitabbampi; ",
  "mn114:3.6": "tañca aññamaññaṁ vacīsamācāraṁ. ",
  "mn114:3.7": "Manosamācārampāhaṁ, bhikkhave, duvidhena vadāmi—",
  "mn114:3.8": "sevitabbampi, asevitabbampi; ",
  "mn114:3.9": "tañca aññamaññaṁ manosamācāraṁ. ",
  "mn114:3.10": "Cittuppādampāhaṁ, bhikkhave, duvidhena vadāmi—",
  "mn114:3.11": "sevitabbampi, asevitabbampi; ",
  "mn114:3.12": "tañca aññamaññaṁ cittuppādaṁ. ",
  "mn114:3.13": "Saññāpaṭilābhampāhaṁ, bhik