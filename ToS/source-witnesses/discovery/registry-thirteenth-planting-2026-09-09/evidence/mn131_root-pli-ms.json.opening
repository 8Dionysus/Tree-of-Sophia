{
  "mn131:0.1": "Majjhima Nikāya 131 ",
  "mn131:0.2": "Bhaddekarattasutta ",
  "mn131:1.1": "Evaṁ me sutaṁ—",
  "mn131:1.2": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "mn131:1.3": "Tatra kho bhagavā bhikkhū āmantesi: ",
  "mn131:1.4": "“bhikkhavo”ti. ",
  "mn131:1.5": "“Bhadante”ti te bhikkhū bhagavato paccassosuṁ. ",
  "mn131:1.6": "Bhagavā etadavoca: ",
  "mn131:2.1": "“bhaddekarattassa vo, bhikkhave, uddesañca vibhaṅgañca desessāmi. ",
  "mn131:2.2": "Taṁ suṇātha, sādhukaṁ manasi karotha, bhāsissāmī”ti. ",
  "mn131:2.3": "“Evaṁ, bhante”ti kho te bhikkhū bhagavato paccassosuṁ. ",
  "mn131:2.4": "Bhagavā etadavoca: ",
  "mn131:3.1": "“Atītaṁ nānvāgameyya, ",
  "mn131:3.2": "nappaṭikaṅkhe anāgataṁ; ",
  "mn131:3.3": "Yadatītaṁ pahīnaṁ taṁ, ",
  "mn131:3.4": "appattañca anāgataṁ. ",
  "mn131:3.5": "Paccuppannañca yo dhammaṁ, ",
  "mn131:3.6": "Tattha tattha vipassati; ",
  "mn131:3.7": "Asaṁhīraṁ asaṅkuppaṁ, ",
  "mn131:3.8": "Taṁ vidvā manubrūhaye. ",
  "mn131:3.9": "Ajjeva kiccamātappaṁ, ",
  "mn131:3.10": "ko jaññā maraṇaṁ suve; ",
  "mn131:3.11": "Na hi no saṅgaraṁ tena, ",
  "mn131:3.12": "mahāsenena maccunā. ",
  "mn131:3.13": "Evaṁvihāriṁ ātāpiṁ, ",
  "mn131:3.14": "ahorattamatanditaṁ; ",
  "mn131:3.15": "Taṁ ve bhaddekarattoti, ",
  "mn131:3.16": "santo ācikkhate muni. ",
  "mn131:4.1": "Kathañca, bhikkhave, atītaṁ anvāgam