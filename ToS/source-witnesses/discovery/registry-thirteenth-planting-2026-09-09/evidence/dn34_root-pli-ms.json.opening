{
  "dn34:0.1": "Dīgha Nikāya 34 ",
  "dn34:0.2": "Dasuttarasutta ",
  "dn34:1.1.1": "Evaṁ me sutaṁ—",
  "dn34:1.1.2": "ekaṁ samayaṁ bhagavā campāyaṁ viharati gaggarāya pokkharaṇiyā tīre mahatā bhikkhusaṅghena saddhiṁ pañcamattehi bhikkhusatehi. ",
  "dn34:1.1.3": "Tatra kho āyasmā sāriputto bhikkhū āmantesi: ",
  "dn34:1.1.4": "“āvuso bhikkhave”ti. ",
  "dn34:1.1.5": "“Āvuso”ti kho te bhikkhū āyasmato sāriputtassa paccassosuṁ. ",
  "dn34:1.1.6": "Āyasmā sāriputto etadavoca: ",
  "dn34:1.1.7": "“Dasuttaraṁ pavakkhāmi, ",
  "dn34:1.1.8": "dhammaṁ nibbānapattiyā; ",
  "dn34:1.1.9": "Dukkhassantakiriyāya, ",
  "dn34:1.1.10": "sabbaganthappamocanaṁ. ",
  "dn34:1.2.0": "1. Eko dhammo ",
  "dn34:1.2.1": "Eko, āvuso, dhammo bahukāro, eko dhammo bhāvetabbo, eko dhammo pariññeyyo, eko dhammo pahātabbo, eko dhammo hānabhāgiyo, eko dhammo visesabhāgiyo, eko dhammo duppaṭivijjho, eko dhammo uppādetabbo, eko dhammo abhiññeyyo, eko dhammo sacchikātabbo. ",
  "dn34:1.2.2": "Katamo eko dhammo bahukāro? ",
  "dn34:1.2.3": "Appamādo kusalesu dhammesu. ",
  "dn34:1.2.4": "Ayaṁ eko dhammo bahukāro. ",
  "dn34:1.2.5": "Katamo eko dhammo bhāvetabbo? ",
  "dn34:1.2.6": "Kāyagatāsati sātasahagatā. ",
  "dn34:1.2.7": "Ayaṁ eko dhammo bhāvetabbo. ",
  "dn34:1.2.8": "Katamo eko dhammo pariññeyyo? ",
  "dn34:1.2.9": "Phasso sāsavo upādāniyo. ",
  "dn34:1.2.10": "Ayaṁ eko dhammo pariññeyyo. ",
  "dn34:1.2.11": "Katamo eko dhammo pahātabbo? "