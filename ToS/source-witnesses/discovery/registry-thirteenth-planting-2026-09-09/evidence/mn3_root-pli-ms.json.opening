{
  "mn3:0.1": "Majjhima Nikāya 3 ",
  "mn3:0.2": "Dhammadāyādasutta ",
  "mn3:1.1": "Evaṁ me sutaṁ—",
  "mn3:1.2": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "mn3:1.3": "Tatra kho bhagavā bhikkhū āmantesi: ",
  "mn3:1.4": "“bhikkhavo”ti. ",
  "mn3:1.5": "“Bhadante”ti te bhikkhū bhagavato paccassosuṁ. ",
  "mn3:1.6": "Bhagavā etadavoca: ",
  "mn3:2.1": "“Dhammadāyādā me, bhikkhave, bhavatha, mā āmisadāyādā. ",
  "mn3:2.2": "Atthi me tumhesu anukampā: ",
  "mn3:2.3": "‘kinti me sāvakā dhammadāyādā bhaveyyuṁ, no āmisadāyādā’ti. ",
  "mn3:2.4": "Tumhe ca me, bhikkhave, āmisadāyādā bhaveyyātha no dhammadāyādā, tumhepi tena ādiyā bhaveyyātha: ",
  "mn3:2.5": "‘āmisadāyādā satthusāvakā viharanti, no dhammadāyādā’ti; ",
  "mn3:2.6": "ahampi tena ādiyo bhaveyyaṁ: ",
  "mn3:2.7": "‘āmisadāyādā satthusāvakā viharanti, no dhammadāyādā’ti. ",
  "mn3:2.8": "Tumhe ca me, bhikkhave, dhammadāyādā bhaveyyātha, no āmisadāyādā, tumhepi tena na ādiyā bhaveyyātha: ",
  "mn3:2.9": "‘dhammadāyādā satthusāvakā viharanti, no āmisadāyādā’ti; ",
  "mn3:2.10": "ahampi tena na ādiyo bhaveyyaṁ: ",
  "mn3:2.11": "‘dhammadāyādā satthusāvakā viharanti, no āmisadāyādā’ti. ",
  "mn3:2.12": "Tasmātiha me, bhikkhave, dhammadāyādā bhavatha, mā āmisadāyādā. ",
  "mn3:2.13": "Atthi me tumhesu anukampā: ",
  "mn3:2.14": "‘kinti me sāvakā dhammadāyādā bhav