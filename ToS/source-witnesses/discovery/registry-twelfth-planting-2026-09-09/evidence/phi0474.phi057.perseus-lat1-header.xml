      <encodingDesc>
        <refsDecl n="CTS">
          <cRefPattern n="section"
            matchPattern="(\w+).(\w+).(\w+)"
            replacementPattern="#xpath(/tei:TEI/tei:text/tei:body/tei:div/tei:div[@n='$1']/tei:div[@n='$2']/tei:div[@n='$3'])">
            <p>This pointer pattern extracts section</p>
          </cRefPattern>
          <cRefPattern n="letter"
            matchPattern="(\w+).(\w+)"
            replacementPattern="#xpath(/tei:TEI/tei:text/tei:body/tei:div/tei:div[@n='$1']/tei:div[@n='$2'])">
            <p>This pointer pattern extracts letter</p>
          </cRefPattern>
          <cRefPattern n="book"
            matchPattern="(\w+)"
            replacementPattern="#xpath(/tei:TEI/tei:text/tei:body/tei:div/tei:div[@n='$1'])">
            <p>This pointer pattern extracts book</p>
          </cRefPattern>
         </refsDecl>
         <refsDecl n="TEI.2">
            <refState delim="." unit="book"/>
            <refState delim="." unit="letter"/>
            <refState unit="section"/>
         </refsDecl>
            <refsDecl xml:id="CTS">
              <citeStructure match="/TEI/text/body" use="@xml:base">
                <citeStructure unit="book" delim=":" match="div/div[@subtype='book']" use="@n">
                  <citeStructure unit="section" delim="." match="div/div[@subtype='section']" use="@n"/>
                </citeStructure>
              </citeStructure>
            </refsDecl>
</encodingDesc>
