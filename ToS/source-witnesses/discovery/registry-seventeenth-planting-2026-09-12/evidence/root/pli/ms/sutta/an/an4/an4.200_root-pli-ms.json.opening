{
  "an4.200:0.1": "Aṅguttara Nikāya 4.200 ",
  "an4.200:0.2": "20. Mahāvagga ",
  "an4.200:0.3": "Pemasutta ",
  "an4.200:1.1": "“Cattārimāni, bhikkhave, pemāni jāyanti. ",
  "an4.200:1.2": "Katamāni cattāri? ",
  "an4.200:1.3": "Pemā pemaṁ jāyati, ",
  "an4.200:1.4": "pemā doso jāyati, ",
  "an4.200:1.5": "dosā pemaṁ jāyati, ",
  "an4.200:1.6": "dosā doso jāyati. ",
  "an4.200:2.1": "Kathañca, bhikkhave, pemā pemaṁ jāyati? ",
  "an4.200:2.2": "Idha, bhikkhave, puggalo puggalassa iṭṭho hoti kanto manāpo. ",
  "an4.200:2.3": "Taṁ pare iṭṭhena kantena manāpena samudācaranti. ",
  "an4.200:2.4": "Tassa evaṁ hoti: ",
  "an4.200:2.5": "‘yo kho myāyaṁ puggalo iṭṭho kanto manāpo, taṁ pare iṭṭhena kantena manāpena samudācarantī’ti. ",
  "an4.200:2.6": "So tesu pemaṁ janeti. ",
  "an4.200:2.7": "Evaṁ kho, bhikkhave, pemā pemaṁ jāyati. ",
  "an4.200:3.1": "Kathañca, bhikkhave, pemā doso jāyati? ",
  "an4.200:3.2": "Idha, bhikkhave, puggalo puggalassa iṭṭho hoti kanto manāpo. ",
  "an4.200:3.3": "Taṁ pare aniṭṭhena akantena amanāpena samudācaranti. ",
  "an4.200:3.4": "Tassa evaṁ hoti: ",
  "an4.200:3.5": "‘yo kho myāyaṁ puggalo iṭṭho kanto manāpo, taṁ pare aniṭṭhena akantena amanāpena samudācarantī’ti. ",
  "an4.200:3.6": "So tesu dosaṁ janeti. ",
  "an4.200:3.7": "Evaṁ kho, bhikkhave, pemā doso jāyati. ",
  "an4.200:4.1": "Kathañca, bhikkhave, dosā pemaṁ jāyati? ",
  "an4.200:4.2": "Idha, bhikkhave