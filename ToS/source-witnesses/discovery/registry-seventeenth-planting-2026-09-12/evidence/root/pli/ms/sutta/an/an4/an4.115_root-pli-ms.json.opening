{
  "an4.115:0.1": "Aṅguttara Nikāya 4.115 ",
  "an4.115:0.2": "12. Kesivagga ",
  "an4.115:0.3": "Ṭhānasutta ",
  "an4.115:1.1": "“Cattārimāni, bhikkhave, ṭhānāni. ",
  "an4.115:1.2": "Katamāni cattāri? ",
  "an4.115:1.3": "Atthi, bhikkhave, ṭhānaṁ amanāpaṁ kātuṁ; ",
  "an4.115:1.4": "tañca kayiramānaṁ anatthāya saṁvattati. ",
  "an4.115:1.5": "Atthi, bhikkhave, ṭhānaṁ amanāpaṁ kātuṁ; ",
  "an4.115:1.6": "tañca kayiramānaṁ atthāya saṁvattati. ",
  "an4.115:1.7": "Atthi, bhikkhave, ṭhānaṁ manāpaṁ kātuṁ; ",
  "an4.115:1.8": "tañca kayiramānaṁ anatthāya saṁvattati. ",
  "an4.115:1.9": "Atthi, bhikkhave, ṭhānaṁ manāpaṁ kātuṁ; ",
  "an4.115:1.10": "tañca kayiramānaṁ atthāya saṁvattati. ",
  "an4.115:2.1": "Tatra, bhikkhave, yamidaṁ ṭhānaṁ amanāpaṁ kātuṁ; ",
  "an4.115:2.2": "tañca kayiramānaṁ anatthāya saṁvattati—",
  "an4.115:2.3": "idaṁ, bhikkhave, ṭhānaṁ ubhayeneva na kattabbaṁ maññati. ",
  "an4.115:2.4": "Yampidaṁ ṭhānaṁ amanāpaṁ kātuṁ; ",
  "an4.115:2.5": "imināpi naṁ na kattabbaṁ maññati. ",
  "an4.115:2.6": "Yampidaṁ ṭhānaṁ kayiramānaṁ anatthāya saṁvattati; ",
  "an4.115:2.7": "imināpi naṁ na kattabbaṁ maññati. ",
  "an4.115:2.8": "Idaṁ, bhikkhave, ṭhānaṁ ubhayeneva na kattabbaṁ maññati. ",
  "an4.115:3.1": "Tatra, bhikkhave, yamidaṁ ṭhānaṁ amanāpaṁ kātuṁ; ",
  "an4.115:3.2": "tañca kayiramānaṁ atthāya saṁvattati—",
