{
  "an1.394:0.1": "Aṅguttara Nikāya 1 ",
  "an1.394:0.2": "29. Aparaaccharāsaṅghātavagga ",
  "an1.394:1.0": "394 ",
  "an1.394:1.1": "“Accharāsaṅghātamattampi ce, bhikkhave, bhikkhu paṭhamaṁ jhānaṁ bhāveti, ayaṁ vuccati, bhikkhave: ",
  "an1.394:1.2": "‘bhikkhu arittajjhāno viharati, satthusāsanakaro ovādapatikaro, amoghaṁ raṭṭhapiṇḍaṁ bhuñjati’. ",
  "an1.394:1.3": "Ko pana vādo ye naṁ bahulīkarontī”ti. ",
  "an1.395:1.0": "395–401 ",
  "an1.395:1.1": "“Accharāsaṅghātamattampi ce, bhikkhave, bhikkhu dutiyaṁ jhānaṁ bhāveti …pe… ",
  "an1.396:1.1": "tatiyaṁ jhānaṁ bhāveti …pe… ",
  "an1.397:1.1": "catutthaṁ jhānaṁ bhāveti …pe… ",
  "an1.398:1.1": "mettaṁ cetovimuttiṁ bhāveti …pe… ",
  "an1.399:1.1": "karuṇaṁ cetovimuttiṁ bhāveti …pe… ",
  "an1.400:1.1": "muditaṁ cetovimuttiṁ bhāveti …pe… ",
  "an1.401:1.1": "upekkhaṁ cetovimuttiṁ bhāveti …pe…. ",
  "an1.402:1.0": "402–405 ",
  "an1.402:1.1": "Kāye kāyānupassī viharati ātāpī sampajāno satimā vineyya loke abhijjhādomanassaṁ …pe… ",
  "an1.403:1.1": "vedanāsu vedanānupassī viharati … ",
  "an1.404:1.1": "citte cittānupassī viharati … ",
  "an1.405:1.1": "dhammesu dhammānupassī viharati ātāpī sampajāno satimā vineyya loke abhijjhādomanassaṁ. ",
  "an1.406:1.0": "406–409 ",
  "an1.406:1.1": "Anuppannānaṁ pāpakānaṁ akusalānaṁ dhammānaṁ anuppādāya chandaṁ janeti vāyamati vīriyaṁ ārab