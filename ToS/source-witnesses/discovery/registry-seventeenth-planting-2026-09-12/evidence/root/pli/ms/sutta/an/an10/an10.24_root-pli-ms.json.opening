{
  "an10.24:0.1": "Aṅguttara Nikāya 10.24 ",
  "an10.24:0.2": "3. Mahāvagga ",
  "an10.24:0.3": "Mahācundasutta ",
  "an10.24:1.1": "Ekaṁ samayaṁ āyasmā mahācundo cetīsu viharati sahajātiyaṁ. ",
  "an10.24:1.2": "Tatra kho āyasmā mahācundo bhikkhū āmantesi: ",
  "an10.24:1.3": "“āvuso bhikkhave”ti. ",
  "an10.24:1.4": "“Āvuso”ti kho te bhikkhū āyasmato mahācundassa paccassosuṁ. ",
  "an10.24:1.5": "Āyasmā mahācundo etadavoca: ",
  "an10.24:2.1": "“Ñāṇavādaṁ, āvuso, bhikkhu vadamāno: ",
  "an10.24:2.2": "‘jānāmimaṁ dhammaṁ, passāmimaṁ dhamman’ti. ",
  "an10.24:2.3": "Tañce, āvuso, bhikkhuṁ lobho abhibhuyya tiṭṭhati, ",
  "an10.24:2.4": "doso … ",
  "an10.24:2.5": "moho … ",
  "an10.24:2.6": "kodho … ",
  "an10.24:2.7": "upanāho … ",
  "an10.24:2.8": "makkho … ",
  "an10.24:2.9": "paḷāso … ",
  "an10.24:2.10": "macchariyaṁ … ",
  "an10.24:2.11": "pāpikā issā … ",
  "an10.24:2.12": "pāpikā icchā abhibhuyya tiṭṭhati, so evamassa veditabbo: ",
  "an10.24:2.13": "‘nāyamāyasmā tathā pajānāti yathā pajānato lobho na hoti, tathāhimaṁ āyasmantaṁ lobho abhibhuyya tiṭṭhati; ",
  "an10.24:2.14": "nāyamāyasmā tathā pajānāti yathā pajānato doso na hoti … ",
  "an10.24:2.15": "moho … ",
  "an10.24:2.16": "kodho … ",
  "an10.24:2.17": "upanāho … ",
  "an10.24:2.18": "makkho … ",
  "an10.24:2.19": "paḷāso … ",
  "an10.24:2.20": "macchariyaṁ … ",
  "an10.24:2.21": "pāpikā issā 