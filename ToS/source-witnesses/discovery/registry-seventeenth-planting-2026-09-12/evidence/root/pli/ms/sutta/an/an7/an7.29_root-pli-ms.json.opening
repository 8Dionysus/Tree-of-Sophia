{
  "an7.29:0.1": "Aṅguttara Nikāya 7.29 ",
  "an7.29:0.2": "3. Vajjisattakavagga ",
  "an7.29:0.3": "Dutiyaparihānisutta ",
  "an7.29:1.1": "“Sattime, bhikkhave, dhammā upāsakassa parihānāya saṁvattanti. ",
  "an7.29:1.2": "Katame satta? ",
  "an7.29:1.3": "Bhikkhudassanaṁ hāpeti, ",
  "an7.29:1.4": "saddhammassavanaṁ pamajjati, ",
  "an7.29:1.5": "adhisīle na sikkhati, ",
  "an7.29:1.6": "appasādabahulo hoti, ",
  "an7.29:1.7": "bhikkhūsu theresu ceva navesu ca majjhimesu ca upārambhacitto dhammaṁ suṇāti randhagavesī, ",
  "an7.29:1.8": "ito bahiddhā dakkhiṇeyyaṁ gavesati, ",
  "an7.29:1.9": "tattha ca pubbakāraṁ karoti. ",
  "an7.29:1.10": "Ime kho, bhikkhave, satta dhammā upāsakassa parihānāya saṁvattanti. ",
  "an7.29:2.1": "Sattime, bhikkhave, dhammā upāsakassa aparihānāya saṁvattanti. ",
  "an7.29:2.2": "Katame satta? ",
  "an7.29:2.3": "Bhikkhudassanaṁ na hāpeti, ",
  "an7.29:2.4": "saddhammassavanaṁ nappamajjati, ",
  "an7.29:2.5": "adhisīle sikkhati, ",
  "an7.29:2.6": "pasādabahulo hoti, ",
  "an7.29:2.7": "bhikkhūsu theresu ceva navesu ca majjhimesu ca anupārambhacitto dhammaṁ suṇāti na randhagavesī, ",
  "an7.29:2.8": "na ito bahiddhā dakkhiṇeyyaṁ gavesati, ",
  "an7.29:2.9": "idha ca pubbakāraṁ karoti. ",
  "an7.29:2.10": "Ime kho, bhikkhave, satta dhammā upāsakassa aparihānāya saṁvattantī”ti. ",
  "an7.29:2.11": "Idamavoca bhagavā. ",
  "an7.29:2.12": "Idaṁ vatvāna sugato athāparaṁ etadavoca satthā: ",
  "an7.2