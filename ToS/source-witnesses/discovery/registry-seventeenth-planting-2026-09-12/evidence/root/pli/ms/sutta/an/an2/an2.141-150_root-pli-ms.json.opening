{
  "an2.141:0.1": "Aṅguttara Nikāya 2 ",
  "an2.141:0.2": "13. Dānavagga ",
  "an2.141:1.0": "141 ",
  "an2.141:1.1": "“Dvemāni, bhikkhave, dānāni. ",
  "an2.141:1.2": "Katamāni dve? ",
  "an2.141:1.3": "Āmisadānañca dhammadānañca. ",
  "an2.141:1.4": "Imāni kho, bhikkhave, dve dānāni. ",
  "an2.141:1.5": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ dānānaṁ yadidaṁ dhammadānan”ti. ",
  "an2.142:1.0": "142 ",
  "an2.142:1.1": "“Dveme, bhikkhave, yāgā. ",
  "an2.142:1.2": "Katame dve? ",
  "an2.142:1.3": "Āmisayāgo ca dhammayāgo ca. ",
  "an2.142:1.4": "Ime kho, bhikkhave, dve yāgā. ",
  "an2.142:1.5": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ yāgānaṁ yadidaṁ dhammayāgo”ti. ",
  "an2.143:1.0": "143 ",
  "an2.143:1.1": "“Dveme, bhikkhave, cāgā. ",
  "an2.143:1.2": "Katame dve? ",
  "an2.143:1.3": "Āmisacāgo ca dhammacāgo ca. ",
  "an2.143:1.4": "Ime kho, bhikkhave, dve cāgā. ",
  "an2.143:1.5": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ cāgānaṁ yadidaṁ dhammacāgo”ti. ",
  "an2.144:1.0": "144 ",
  "an2.144:1.1": "“Dveme, bhikkhave, pariccāgā. ",
  "an2.144:1.2": "Katame dve? ",
  "an2.144:1.3": "Āmisapariccāgo ca dhammapariccāgo ca. ",
  "an2.144:1.4": "Ime kho, bhikkhave, dve pariccāgā. ",
  "an2.144:1.5": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ pariccāgānaṁ yadidaṁ dhammapariccāgo”ti. ",
  "an2.145:1.0": "145 ",
  "an2.145:1.1": "“Dveme, bhikkhave, bhogā. ",
  "an2.145:1.2": "Katame dve? ",
  "an2.145:1.3": "Āmisabhogo ca 