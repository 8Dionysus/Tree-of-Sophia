{
  "an4.101:0.1": "Aṅguttara Nikāya 4.101 ",
  "an4.101:0.2": "11. Valāhakavagga ",
  "an4.101:0.3": "Paṭhamavalāhakasutta ",
  "an4.101:1.1": "Evaṁ me sutaṁ—",
  "an4.101:1.2": "ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "an4.101:1.3": "Tatra kho bhagavā bhikkhū āmantesi: ",
  "an4.101:1.4": "“bhikkhavo”ti. ",
  "an4.101:1.5": "“Bhadante”ti te bhikkhū bhagavato paccassosuṁ. ",
  "an4.101:1.6": "Bhagavā etadavoca: ",
  "an4.101:2.1": "“Cattārome, bhikkhave, valāhakā. ",
  "an4.101:2.2": "Katame cattāro? ",
  "an4.101:2.3": "Gajjitā no vassitā, ",
  "an4.101:2.4": "vassitā no gajjitā, ",
  "an4.101:2.5": "neva gajjitā no vassitā, ",
  "an4.101:2.6": "gajjitā ca vassitā ca. ",
  "an4.101:2.7": "Ime kho, bhikkhave, cattāro valāhakā. ",
  "an4.101:2.8": "Evamevaṁ kho, bhikkhave, cattāro valāhakūpamā puggalā santo saṁvijjamānā lokasmiṁ. ",
  "an4.101:2.9": "Katame cattāro? ",
  "an4.101:2.10": "Gajjitā no vassitā, ",
  "an4.101:2.11": "vassitā no gajjitā, ",
  "an4.101:2.12": "neva gajjitā no vassitā, ",
  "an4.101:2.13": "gajjitā ca vassitā ca. ",
  "an4.101:3.1": "Kathañca, bhikkhave, puggalo gajjitā hoti no vassitā? ",
  "an4.101:3.2": "Idha, bhikkhave, ekacco puggalo bhāsitā hoti, no kattā. ",
  "an4.101:3.3": "Evaṁ kho, bhikkhave, puggalo gajjitā hoti, no vassitā. ",
  "an4.101:3.4": "Seyyathāpi so, bhikkhave, valāhako gajjitā, no vassitā; ",
  "an4.101:3.5": "tathūpamāhaṁ, b