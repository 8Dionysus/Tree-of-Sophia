{
  "an2.64:0.1": "Aṅguttara Nikāya 2 ",
  "an2.64:0.2": "7. Sukhavagga ",
  "an2.64:1.0": "64 ",
  "an2.64:1.1": "“Dvemāni, bhikkhave, sukhāni. ",
  "an2.64:1.2": "Katamāni dve? ",
  "an2.64:1.3": "Gihisukhañca pabbajitasukhañca. ",
  "an2.64:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.64:1.5": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ sukhānaṁ yadidaṁ pabbajitasukhan”ti. ",
  "an2.65:1.0": "65 ",
  "an2.65:1.1": "“Dvemāni, bhikkhave, sukhāni. ",
  "an2.65:1.2": "Katamāni dve? ",
  "an2.65:1.3": "Kāmasukhañca nekkhammasukhañca. ",
  "an2.65:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.65:1.5": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ sukhānaṁ yadidaṁ nekkhammasukhan”ti. ",
  "an2.66:1.0": "66 ",
  "an2.66:1.1": "“Dvemāni, bhikkhave, sukhāni. ",
  "an2.66:1.2": "Katamāni dve? ",
  "an2.66:1.3": "Upadhisukhañca nirupadhisukhañca. ",
  "an2.66:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.66:1.5": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ sukhānaṁ yadidaṁ nirupadhisukhan”ti. ",
  "an2.67:1.0": "67 ",
  "an2.67:1.1": "“Dvemāni, bhikkhave, sukhāni. ",
  "an2.67:1.2": "Katamāni dve? ",
  "an2.67:1.3": "Sāsavasukhañca anāsavasukhañca. ",
  "an2.67:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.67:1.5": "Etadaggaṁ, bhikkhave, imesaṁ dvinnaṁ sukhānaṁ yadidaṁ anāsavasukhan”ti. ",
  "an2.68:1.0": "68 ",
  "an2.68:1.1": "“Dvemāni, bhikkhave, sukhāni. ",
  "an2.68:1.2": "Katamāni dve? ",
  "an2.68:1.3": "Sāmi