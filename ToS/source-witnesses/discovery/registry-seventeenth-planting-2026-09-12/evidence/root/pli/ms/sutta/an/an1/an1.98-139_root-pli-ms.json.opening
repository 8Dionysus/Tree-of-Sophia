{
  "an1.98:0.1": "Aṅguttara Nikāya 1 ",
  "an1.98:0.2": "10. Dutiyapamādādivagga ",
  "an1.98:1.0": "98 ",
  "an1.98:1.1": "“Ajjhattikaṁ, bhikkhave, aṅganti karitvā nāññaṁ ekaṅgampi samanupassāmi yaṁ evaṁ mahato anatthāya saṁvattati yathayidaṁ, bhikkhave, pamādo. ",
  "an1.98:1.2": "Pamādo, bhikkhave, mahato anatthāya saṁvattatī”ti. ",
  "an1.98:1.3": "Paṭhamaṁ. ",
  "an1.99:1.0": "99 ",
  "an1.99:1.1": "“Ajjhattikaṁ, bhikkhave, aṅganti karitvā nāññaṁ ekaṅgampi samanupassāmi yaṁ evaṁ mahato atthāya saṁvattati yathayidaṁ, bhikkhave, appamādo. ",
  "an1.99:1.2": "Appamādo, bhikkhave, mahato atthāya saṁvattatī”ti. ",
  "an1.99:1.3": "Dutiyaṁ. ",
  "an1.100:1.0": "100 ",
  "an1.100:1.1": "“Ajjhattikaṁ, bhikkhave, aṅganti karitvā nāññaṁ ekaṅgampi samanupassāmi yaṁ evaṁ mahato anatthāya saṁvattati yathayidaṁ, bhikkhave, kosajjaṁ. ",
  "an1.100:1.2": "Kosajjaṁ, bhikkhave, mahato anatthāya saṁvattatī”ti. ",
  "an1.100:1.3": "Tatiyaṁ. ",
  "an1.101:1.0": "101 ",
  "an1.101:1.1": "“Ajjhattikaṁ, bhikkhave, aṅganti karitvā nāññaṁ ekaṅgampi samanupassāmi yaṁ evaṁ mahato atthāya saṁvattati yathayidaṁ, bhikkhave, vīriyārambho. ",
  "an1.101:1.2": "Vīriyārambho, bhikkhave, mahato atthāya saṁvattatī”ti. ",
  "an1.101:1.3": "Catutthaṁ. ",
  "an1.102-109:1.0": "102–109 ",
  "an1.102-109:1.1": "“Ajjhattikaṁ, bhikkhave, aṅganti karitvā nāññaṁ ekaṅgampi samanupassāmi ya�