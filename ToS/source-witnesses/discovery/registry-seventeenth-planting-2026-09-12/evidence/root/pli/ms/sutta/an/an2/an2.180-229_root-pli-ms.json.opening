{
  "an2.180-184:0.1": "Aṅguttara Nikāya 2 ",
  "an2.180-184:0.2": "16. Kodhapeyyāla ",
  "an2.180-184:1.0": "180–184 ",
  "an2.180-184:1.1": "“Dveme, bhikkhave, dhammā. ",
  "an2.180-184:1.2": "Katame dve? ",
  "an2.180-184:1.3": "Kodho ca upanāho ca … makkho ca paḷāso ca … issā ca macchariyañca … māyā ca sāṭheyyañca … ahirikañca anottappañca. ",
  "an2.180-184:1.4": "Ime kho, bhikkhave, dve dhammā”. ",
  "an2.185-189:1.0": "185–189 ",
  "an2.185-189:1.1": "“Dveme, bhikkhave, dhammā. ",
  "an2.185-189:1.2": "Katame dve? ",
  "an2.185-189:1.3": "Akkodho ca anupanāho ca … amakkho ca apaḷāso ca … anissā ca amacchariyañca … amāyā ca asāṭheyyañca … hirī ca ottappañca. ",
  "an2.185-189:1.4": "Ime kho, bhikkhave, dve dhammā”. ",
  "an2.190-194:1.0": "190–194 ",
  "an2.190-194:1.1": "“Dvīhi, bhikkhave, dhammehi samannāgato dukkhaṁ viharati. ",
  "an2.190-194:1.2": "Katamehi dvīhi? ",
  "an2.190-194:1.3": "Kodhena ca upanāhena ca … makkhena ca paḷāsena ca … issāya ca macchariyena ca … māyāya ca sāṭheyyena ca … ahirikena ca anottappena ca. ",
  "an2.190-194:1.4": "Imehi kho, bhikkhave, dvīhi dhammehi samannāgato dukkhaṁ viharati”. ",
  "an2.195-199:1.0": "195–199 ",
  "an2.195-199:1.1": "“Dvīhi, bhikkhave, dhammehi samannāgato sukhaṁ viharati. ",
  "an2.195-199:1.2": "Katamehi dvīhi? ",
  "an2.195-199:1.3": "Akkodhena ca anupanāhena ca … amakkhena ca apaḷāsena ca … anissāya ca amacchariyena ca … amāyāy