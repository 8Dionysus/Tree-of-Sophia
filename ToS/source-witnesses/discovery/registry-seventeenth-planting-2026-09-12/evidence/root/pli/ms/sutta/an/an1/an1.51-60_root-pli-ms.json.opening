{
  "an1.51:0.1": "Aṅguttara Nikāya 1 ",
  "an1.51:0.2": "6. Accharāsaṅghātavagga ",
  "an1.51:1.0": "51 ",
  "an1.51:1.1": "“Pabhassaramidaṁ, bhikkhave, cittaṁ. ",
  "an1.51:1.2": "Tañca kho āgantukehi upakkilesehi upakkiliṭṭhaṁ. ",
  "an1.51:1.3": "Taṁ assutavā puthujjano yathābhūtaṁ nappajānāti. ",
  "an1.51:1.4": "Tasmā ‘assutavato puthujjanassa cittabhāvanā natthī’ti vadāmī”ti. ",
  "an1.51:1.5": "Paṭhamaṁ. ",
  "an1.52:1.0": "52 ",
  "an1.52:1.1": "“Pabhassaramidaṁ, bhikkhave, cittaṁ. ",
  "an1.52:1.2": "Tañca kho āgantukehi upakkilesehi vippamuttaṁ. ",
  "an1.52:1.3": "Taṁ sutavā ariyasāvako yathābhūtaṁ pajānāti. ",
  "an1.52:1.4": "Tasmā ‘sutavato ariyasāvakassa cittabhāvanā atthī’ti vadāmī”ti. ",
  "an1.52:1.5": "Dutiyaṁ. ",
  "an1.53:1.0": "53 ",
  "an1.53:1.1": "“Accharāsaṅghātamattampi ce, bhikkhave, bhikkhu mettācittaṁ āsevati; ",
  "an1.53:1.2": "ayaṁ vuccati, bhikkhave: ",
  "an1.53:1.3": "‘bhikkhu arittajjhāno viharati satthusāsanakaro ovādapatikaro, amoghaṁ raṭṭhapiṇḍaṁ bhuñjati’. ",
  "an1.53:1.4": "Ko pana vādo ye naṁ bahulīkarontī”ti. ",
  "an1.53:1.5": "Tatiyaṁ. ",
  "an1.54:1.0": "54 ",
  "an1.54:1.1": "“Accharāsaṅghātamattampi ce, bhikkhave, bhikkhu mettācittaṁ bhāveti; ",
  "an1.54:1.2": "ayaṁ vuccati, bhikkhave: ",
  "an1.54:1.3": "‘bhikkhu arittajjhāno viharati satthusāsanakaro ovādapatikaro, amoghaṁ raṭṭhapiṇḍaṁ bhuñjati’. ",
  "an1.