{
  "an4.96:0.1": "Aṅguttara Nikāya 4.96 ",
  "an4.96:0.2": "10. Asuravagga ",
  "an4.96:0.3": "Rāgavinayasutta ",
  "an4.96:1.1": "“Cattārome, bhikkhave, puggalā santo saṁvijjamānā lokasmiṁ. ",
  "an4.96:1.2": "Katame cattāro? ",
  "an4.96:1.3": "Attahitāya paṭipanno no parahitāya, ",
  "an4.96:1.4": "parahitāya paṭipanno no attahitāya, ",
  "an4.96:1.5": "nevattahitāya paṭipanno no parahitāya, ",
  "an4.96:1.6": "attahitāya ceva paṭipanno parahitāya ca. ",
  "an4.96:2.1": "Kathañca, bhikkhave, puggalo attahitāya paṭipanno hoti no parahitāya? ",
  "an4.96:2.2": "Idha, bhikkhave, ekacco puggalo attanā rāgavinayāya paṭipanno hoti, no paraṁ rāgavinayāya samādapeti; ",
  "an4.96:2.3": "attanā dosavinayāya paṭipanno hoti, no paraṁ dosavinayāya samādapeti; ",
  "an4.96:2.4": "attanā mohavinayāya paṭipanno hoti, no paraṁ mohavinayāya samādapeti. ",
  "an4.96:2.5": "Evaṁ kho, bhikkhave, puggalo attahitāya paṭipanno hoti, no parahitāya. ",
  "an4.96:3.1": "Kathañca, bhikkhave, puggalo parahitāya paṭipanno hoti, no attahitāya? ",
  "an4.96:3.2": "Idha, bhikkhave, ekacco puggalo attanā na rāgavinayāya paṭipanno hoti, paraṁ rāgavinayāya samādapeti; ",
  "an4.96:3.3": "attanā na dosavinayāya paṭipanno hoti, paraṁ dosavinayāya samādapeti; ",
  "an4.96:3.4": "attanā na mohavinayāya paṭipanno hoti, paraṁ mohavinayāya samādapeti. ",
  "an4.96:3.5": "Evaṁ kho, bhikkhave, puggalo parahitāya paṭipanno hoti, no attahitāya. ",
 