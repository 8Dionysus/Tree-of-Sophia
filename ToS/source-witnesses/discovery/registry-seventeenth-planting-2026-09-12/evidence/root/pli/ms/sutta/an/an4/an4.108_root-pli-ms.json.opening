{
  "an4.108:0.1": "Aṅguttara Nikāya 4.108 ",
  "an4.108:0.2": "11. Valāhakavagga ",
  "an4.108:0.3": "Balībaddasutta ",
  "an4.108:1.1": "“Cattārome, bhikkhave, balībaddā. ",
  "an4.108:1.2": "Katame cattāro? ",
  "an4.108:1.3": "Sagavacaṇḍo no paragavacaṇḍo, ",
  "an4.108:1.4": "paragavacaṇḍo no sagavacaṇḍo, ",
  "an4.108:1.5": "sagavacaṇḍo ca paragavacaṇḍo ca, ",
  "an4.108:1.6": "neva sagavacaṇḍo no paragavacaṇḍo—",
  "an4.108:1.7": "Ime kho, bhikkhave, cattāro balībaddā. ",
  "an4.108:1.8": "Evamevaṁ kho, bhikkhave, cattāro balībaddūpamā puggalā santo saṁvijjamānā lokasmiṁ. ",
  "an4.108:1.9": "Katame cattāro? ",
  "an4.108:1.10": "Sagavacaṇḍo no paragavacaṇḍo, ",
  "an4.108:1.11": "paragavacaṇḍo no sagavacaṇḍo, ",
  "an4.108:1.12": "sagavacaṇḍo ca paragavacaṇḍo ca, ",
  "an4.108:1.13": "neva sagavacaṇḍo no paragavacaṇḍo. ",
  "an4.108:2.1": "Kathañca, bhikkhave, puggalo sagavacaṇḍo hoti, no paragavacaṇḍo? ",
  "an4.108:2.2": "Idha, bhikkhave, ekacco puggalo sakaparisaṁ ubbejetā hoti, no paraparisaṁ. ",
  "an4.108:2.3": "Evaṁ kho, bhikkhave, puggalo sagavacaṇḍo hoti, no paragavacaṇḍo. ",
  "an4.108:2.4": "Seyyathāpi so, bhikkhave, balībaddo sagavacaṇḍo, no paragavacaṇḍo; ",
  "an4.108:2.5": "tathūpamāhaṁ, bhikkhave, imaṁ puggalaṁ vadāmi. ",
  "an4.108:3.1": "Kathañca, bhikkhave, puggalo paragavacaṇḍo hoti, no sagavacaṇḍo? ",
  "an4.108:3.2": "Idha, bhikkhave, eka