{
  "an2.21:0.1": "Aṅguttara Nikāya 2 ",
  "an2.21:0.2": "3. Bālavagga ",
  "an2.21:1.0": "21 ",
  "an2.21:1.1": "“Dveme, bhikkhave, bālā. ",
  "an2.21:1.2": "Katame dve? ",
  "an2.21:1.3": "Yo ca accayaṁ accayato na passati, yo ca accayaṁ desentassa yathādhammaṁ nappaṭiggaṇhāti. ",
  "an2.21:1.4": "Ime kho, bhikkhave, dve bālāti. ",
  "an2.21:2.1": "Dveme, bhikkhave, paṇḍitā. ",
  "an2.21:2.2": "Katame dve? ",
  "an2.21:2.3": "Yo ca accayaṁ accayato passati, yo ca accayaṁ desentassa yathādhammaṁ paṭiggaṇhāti. ",
  "an2.21:2.4": "Ime kho, bhikkhave, dve paṇḍitā”ti. ",
  "an2.22:1.0": "22 ",
  "an2.22:1.1": "“Dveme, bhikkhave, tathāgataṁ abbhācikkhanti. ",
  "an2.22:1.2": "Katame dve? ",
  "an2.22:1.3": "Duṭṭho vā dosantaro, saddho vā duggahitena. ",
  "an2.22:1.4": "Ime kho, bhikkhave, dve tathāgataṁ abbhācikkhantī”ti. ",
  "an2.23:1.0": "23 ",
  "an2.23:1.1": "“Dveme, bhikkhave, tathāgataṁ abbhācikkhanti. ",
  "an2.23:1.2": "Katame dve? ",
  "an2.23:1.3": "Yo ca abhāsitaṁ alapitaṁ tathāgatena bhāsitaṁ lapitaṁ tathāgatenāti dīpeti, yo ca bhāsitaṁ lapitaṁ tathāgatena abhāsitaṁ alapitaṁ tathāgatenāti dīpeti. ",
  "an2.23:1.4": "Ime kho, bhikkhave, dve tathāgataṁ abbhācikkhantīti. ",
  "an2.23:2.1": "Dveme, bhikkhave, tathāgataṁ nābbhācikkhanti. ",
  "an2.23:2.2": "Katame dve? ",
  "an2.23:2.3": "Yo ca abhāsitaṁ alapitaṁ tathāgatena abhāsitaṁ alapitaṁ tathāgatenāti dīpeti, yo ca bhāsitaṁ la