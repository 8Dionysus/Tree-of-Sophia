{
  "an2.98:0.1": "Aṅguttara Nikāya 2 ",
  "an2.98:0.2": "10. Bālavagga ",
  "an2.98:1.0": "98 ",
  "an2.98:1.1": "“Dveme, bhikkhave, bālā. ",
  "an2.98:1.2": "Katame dve? ",
  "an2.98:1.3": "Yo ca anāgataṁ bhāraṁ vahati, yo ca āgataṁ bhāraṁ na vahati. ",
  "an2.98:1.4": "Ime kho, bhikkhave, dve bālā”ti. ",
  "an2.99:1.0": "99 ",
  "an2.99:1.1": "“Dveme, bhikkhave, paṇḍitā. ",
  "an2.99:1.2": "Katame dve? ",
  "an2.99:1.3": "Yo ca anāgataṁ bhāraṁ na vahati, yo ca āgataṁ bhāraṁ vahati. ",
  "an2.99:1.4": "Ime kho, bhikkhave, dve paṇḍitā”ti. ",
  "an2.100:1.0": "100 ",
  "an2.100:1.1": "“Dveme, bhikkhave, bālā. ",
  "an2.100:1.2": "Katame dve? ",
  "an2.100:1.3": "Yo ca akappiye kappiyasaññī, yo ca kappiye akappiyasaññī. ",
  "an2.100:1.4": "Ime kho, bhikkhave, dve bālā”ti. ",
  "an2.101:1.0": "101 ",
  "an2.101:1.1": "“Dveme, bhikkhave, paṇḍitā. ",
  "an2.101:1.2": "Katame dve? ",
  "an2.101:1.3": "Yo ca akappiye akappiyasaññī, yo ca kappiye kappiyasaññī. ",
  "an2.101:1.4": "Ime kho, bhikkhave, dve paṇḍitā”ti. ",
  "an2.102:1.0": "102 ",
  "an2.102:1.1": "“Dveme, bhikkhave, bālā. ",
  "an2.102:1.2": "Katame dve? ",
  "an2.102:1.3": "Yo ca anāpattiyā āpattisaññī, yo ca āpattiyā anāpattisaññī. ",
  "an2.102:1.4": "Ime kho, bhikkhave, dve bālā”ti. ",
  "an2.103:1.0": "103 ",
  "an2.103:1.1": "“Dveme, bhikkhave, paṇḍitā. ",
  "an2.103:1.2": "Katame dve? ",
  "an2.103:1.3": "Yo ca anāpattiyā anāpattisañ