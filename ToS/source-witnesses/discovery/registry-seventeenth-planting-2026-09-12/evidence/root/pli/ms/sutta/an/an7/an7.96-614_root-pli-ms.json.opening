{
  "an7.96-614:0.1": "Aṅguttara Nikāya 7 ",
  "an7.96-614:0.2": "10. Āhuneyyavagga ",
  "an7.96-614:0.3": "~ ",
  "an7.96-614:1.1": "“Sattime, bhikkhave, puggalā āhuneyyā pāhuneyyā …pe… anuttaraṁ puññakkhettaṁ lokassa. ",
  "an7.96-614:1.2": "Katame satta? ",
  "an7.96-614:1.3": "Idha, bhikkhave, ekacco puggalo cakkhusmiṁ dukkhānupassī viharati …pe… ",
  "an7.96-614:1.4": "cakkhusmiṁ anattānupassī viharati …pe… ",
  "an7.96-614:1.5": "cakkhusmiṁ khayānupassī viharati …pe… ",
  "an7.96-614:1.6": "cakkhusmiṁ vayānupassī viharati …pe… ",
  "an7.96-614:1.7": "cakkhusmiṁ virāgānupassī viharati …pe… ",
  "an7.96-614:1.8": "cakkhusmiṁ nirodhānupassī viharati …pe… ",
  "an7.96-614:1.9": "cakkhusmiṁ paṭinissaggānupassī viharati …pe…. ",
  "an7.96-614:2.1": "Sotasmiṁ …pe… ",
  "an7.96-614:2.2": "ghānasmiṁ … ",
  "an7.96-614:2.3": "jivhāya … ",
  "an7.96-614:2.4": "kāyasmiṁ … ",
  "an7.96-614:2.5": "manasmiṁ …pe…. ",
  "an7.96-614:3.1": "Rūpesu …pe… ",
  "an7.96-614:3.2": "saddesu … ",
  "an7.96-614:3.3": "gandhesu … ",
  "an7.96-614:3.4": "rasesu … ",
  "an7.96-614:3.5": "phoṭṭhabbesu … ",
  "an7.96-614:3.6": "dhammesu …pe…. ",
  "an7.96-614:4.1": "Cakkhuviññāṇe …pe… ",
  "an7.96-614:4.2": "sotaviññāṇe … ",
  "an7.96-614:4.3": "ghānaviññāṇe … ",
  "an7.96-614:4.4": "jivhāviññāṇe … ",
  "an7.96-614:4.5": "kāyaviññāṇe … ",
  "an7.96-614:4.6": "manoviññāṇ