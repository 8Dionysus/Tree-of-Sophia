{
  "an2.118:0.1": "Aṅguttara Nikāya 2 ",
  "an2.118:0.2": "11. Āsāduppajahavagga ",
  "an2.118:1.0": "118 ",
  "an2.118:1.1": "“Dvemā, bhikkhave, āsā duppajahā. ",
  "an2.118:1.2": "Katamā dve? ",
  "an2.118:1.3": "Lābhāsā ca jīvitāsā ca. ",
  "an2.118:1.4": "Imā kho, bhikkhave, dve āsā duppajahā”ti. ",
  "an2.119:1.0": "119 ",
  "an2.119:1.1": "“Dveme, bhikkhave, puggalā dullabhā lokasmiṁ. ",
  "an2.119:1.2": "Katame dve? ",
  "an2.119:1.3": "Yo ca pubbakārī, yo ca kataññū katavedī. ",
  "an2.119:1.4": "Ime kho, bhikkhave, dve puggalā dullabhā lokasmin”ti. ",
  "an2.120:1.0": "120 ",
  "an2.120:1.1": "“Dveme, bhikkhave, puggalā dullabhā lokasmiṁ. ",
  "an2.120:1.2": "Katame dve? ",
  "an2.120:1.3": "Titto ca tappetā ca. ",
  "an2.120:1.4": "Ime kho, bhikkhave, dve puggalā dullabhā lokasmin”ti. ",
  "an2.121:1.0": "121 ",
  "an2.121:1.1": "“Dveme, bhikkhave, puggalā duttappayā. ",
  "an2.121:1.2": "Katame dve? ",
  "an2.121:1.3": "Yo ca laddhaṁ laddhaṁ nikkhipati, yo ca laddhaṁ laddhaṁ vissajjeti. ",
  "an2.121:1.4": "Ime kho, bhikkhave, dve puggalā duttappayā”ti. ",
  "an2.122:1.0": "122 ",
  "an2.122:1.1": "“Dveme, bhikkhave, puggalā sutappayā. ",
  "an2.122:1.2": "Katame dve? ",
  "an2.122:1.3": "Yo ca laddhaṁ laddhaṁ na nikkhipati, yo ca laddhaṁ laddhaṁ na vissajjeti. ",
  "an2.122:1.4": "Ime kho, bhikkhave, dve puggalā sutappayā”ti. ",
  "an2.123:1.0": "123 ",
  "an2.123:1.1": "“Dveme, bhikkhave, paccayā rāgassa uppād�