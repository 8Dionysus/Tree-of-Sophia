{
  "sn36.22:0.1": "Saṁyutta Nikāya 36.22 ",
  "sn36.22:0.2": "3. Aṭṭhasatapariyāyavagga ",
  "sn36.22:0.3": "Aṭṭhasatasutta ",
  "sn36.22:1.1": "“Aṭṭhasatapariyāyaṁ vo, bhikkhave, dhammapariyāyaṁ desessāmi. ",
  "sn36.22:1.2": "Taṁ suṇātha. ",
  "sn36.22:1.3": "Katamo ca, bhikkhave, aṭṭhasatapariyāyo, dhammapariyāyo? ",
  "sn36.22:1.4": "Dvepi mayā, bhikkhave, vedanā vuttā pariyāyena; ",
  "sn36.22:1.5": "tissopi mayā vedanā vuttā pariyāyena; ",
  "sn36.22:1.6": "pañcapi mayā vedanā vuttā pariyāyena; ",
  "sn36.22:1.7": "chapi mayā vedanā vuttā pariyāyena; ",
  "sn36.22:1.8": "aṭṭhārasāpi mayā vedanā vuttā pariyāyena; ",
  "sn36.22:1.9": "chattiṁsāpi mayā vedanā vuttā pariyāyena; ",
  "sn36.22:1.10": "aṭṭhasatampi mayā vedanā vuttā pariyāyena. ",
  "sn36.22:2.1": "Katamā ca, bhikkhave, dve vedanā? ",
  "sn36.22:2.2": "Kāyikā ca cetasikā ca—",
  "sn36.22:2.3": "imā vuccanti, bhikkhave, dve vedanā. ",
  "sn36.22:2.4": "Katamā ca, bhikkhave, tisso vedanā? ",
  "sn36.22:2.5": "Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā—",
  "sn36.22:2.6": "imā vuccanti, bhikkhave, tisso vedanā. ",
  "sn36.22:2.7": "Katamā ca, bhikkhave, pañca vedanā? ",
  "sn36.22:2.8": "Sukhindriyaṁ, dukkhindriyaṁ, somanassindriyaṁ, domanassindriyaṁ, upekkhindriyaṁ—",
  "sn36.22:2.9": "imā vuccanti, bhikkhave, pañca vedanā. ",
  "sn36.22:2.10": "Katamā ca, bhikkhave, cha vedanā? ",
  "sn36.22:2.11": "Cakkhusamphassajā ve