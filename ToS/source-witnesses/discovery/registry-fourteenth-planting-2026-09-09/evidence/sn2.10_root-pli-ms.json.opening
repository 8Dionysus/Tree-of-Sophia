{
  "sn2.10:0.1": "Saṁyutta Nikāya 2.10 ",
  "sn2.10:0.2": "1. Paṭhamavagga ",
  "sn2.10:0.3": "Sūriyasutta ",
  "sn2.10:1.1": "Sāvatthinidānaṁ. ",
  "sn2.10:1.2": "Tena kho pana samayena sūriyo devaputto rāhunā asurindena gahito hoti. ",
  "sn2.10:1.3": "Atha kho sūriyo devaputto bhagavantaṁ anussaramāno tāyaṁ velāyaṁ imaṁ gāthaṁ abhāsi: ",
  "sn2.10:2.1": "“Namo te buddha vīratthu, ",
  "sn2.10:2.2": "vippamuttosi sabbadhi; ",
  "sn2.10:2.3": "Sambādhapaṭipannosmi, ",
  "sn2.10:2.4": "tassa me saraṇaṁ bhavā”ti. ",
  "sn2.10:3.1": "Atha kho bhagavā sūriyaṁ devaputtaṁ ārabbha rāhuṁ asurindaṁ gāthāhi ajjhabhāsi: ",
  "sn2.10:4.1": "“Tathāgataṁ arahantaṁ, ",
  "sn2.10:4.2": "sūriyo saraṇaṁ gato; ",
  "sn2.10:4.3": "Rāhu sūriyaṁ pamuñcassu, ",
  "sn2.10:4.4": "buddhā lokānukampakā. ",
  "sn2.10:5.1": "Yo andhakāre tamasi pabhaṅkaro, ",
  "sn2.10:5.2": "Verocano maṇḍalī uggatejo; ",
  "sn2.10:5.3": "Mā rāhu gilī caramantalikkhe, ",
  "sn2.10:5.4": "Pajaṁ mamaṁ rāhu pamuñca sūriyan”ti. ",
  "sn2.10:6.1": "Atha kho rāhu asurindo sūriyaṁ devaputtaṁ muñcitvā taramānarūpo yena vepacitti asurindo tenupasaṅkami; upasaṅkamitvā saṁviggo lomahaṭṭhajāto ekamantaṁ aṭṭhāsi. ",
  "sn2.10:6.2": "Ekamantaṁ ṭhitaṁ kho rāhuṁ asurindaṁ vepacitti asurindo gāthāya ajjhabhāsi: ",
  "sn2.10:7.1": "“Kiṁ nu santaramānova, ",
  "sn2.10:7.2": "rāhu sūriyaṁ pamuñcasi; ",
  "sn2.10:7.3": "Saṁvi