{
  "sn10.12:0.1": "Saṁyutta Nikāya 10.12 ",
  "sn10.12:0.2": "1. Indakavagga ",
  "sn10.12:0.3": "Āḷavakasutta ",
  "sn10.12:1.1": "Evaṁ me sutaṁ—",
  "sn10.12:1.2": "ekaṁ samayaṁ bhagavā āḷaviyaṁ viharati āḷavakassa yakkhassa bhavane. ",
  "sn10.12:1.3": "Atha kho āḷavako yakkho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṁ etadavoca: ",
  "sn10.12:1.4": "“nikkhama, samaṇā”ti. ",
  "sn10.12:1.5": "“Sādhāvuso”ti bhagavā nikkhami. ",
  "sn10.12:1.6": "“Pavisa, samaṇā”ti. ",
  "sn10.12:1.7": "“Sādhāvuso”ti bhagavā pāvisi. ",
  "sn10.12:1.8": "Dutiyampi kho āḷavako yakkho bhagavantaṁ etadavoca: ",
  "sn10.12:1.9": "“nikkhama, samaṇā”ti. ",
  "sn10.12:1.10": "“Sādhāvuso”ti bhagavā nikkhami. ",
  "sn10.12:1.11": "“Pavisa, samaṇā”ti. ",
  "sn10.12:1.12": "“Sādhāvuso”ti bhagavā pāvisi. ",
  "sn10.12:1.13": "Tatiyampi kho āḷavako yakkho bhagavantaṁ etadavoca: ",
  "sn10.12:1.14": "“nikkhama, samaṇā”ti. ",
  "sn10.12:1.15": "“Sādhāvuso”ti bhagavā nikkhami. ",
  "sn10.12:1.16": "“Pavisa, samaṇā”ti. ",
  "sn10.12:1.17": "“Sādhāvuso”ti bhagavā pāvisi. ",
  "sn10.12:1.18": "Catutthampi kho āḷavako yakkho bhagavantaṁ etadavoca: ",
  "sn10.12:1.19": "“nikkhama, samaṇā”ti. ",
  "sn10.12:1.20": "“Na khvāhaṁ taṁ, āvuso, nikkhamissāmi. ",
  "sn10.12:1.21": "Yaṁ te karaṇīyaṁ taṁ karohī”ti. ",
  "sn10.12:1.22": "“Pañhaṁ taṁ, samaṇa, pucchissāmi. ",
 