{
  "sn1.32:0.1": "Saṁyutta Nikāya 1.32 ",
  "sn1.32:0.2": "4. Satullapakāyikavagga ",
  "sn1.32:0.3": "Maccharisutta ",
  "sn1.32:1.1": "Ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn1.32:1.2": "Atha kho sambahulā satullapakāyikā devatāyo abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṁ jetavanaṁ obhāsetvā yena bhagavā tenupasaṅkamiṁsu; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhaṁsu. ",
  "sn1.32:1.3": "Ekamantaṁ ṭhitā kho ekā devatā bhagavato santike imaṁ gāthaṁ abhāsi: ",
  "sn1.32:2.1": "“Maccherā ca pamādā ca, ",
  "sn1.32:2.2": "evaṁ dānaṁ na dīyati; ",
  "sn1.32:2.3": "Puññaṁ ākaṅkhamānena, ",
  "sn1.32:2.4": "deyyaṁ hoti vijānatā”ti. ",
  "sn1.32:3.1": "Atha kho aparā devatā bhagavato santike imā gāthāyo abhāsi: ",
  "sn1.32:4.1": "“Yasseva bhīto na dadāti maccharī, ",
  "sn1.32:4.2": "Tadevādadato bhayaṁ; ",
  "sn1.32:4.3": "Jighacchā ca pipāsā ca, ",
  "sn1.32:4.4": "Yassa bhāyati maccharī; ",
  "sn1.32:4.5": "Tameva bālaṁ phusati, ",
  "sn1.32:4.6": "Asmiṁ loke paramhi ca. ",
  "sn1.32:5.1": "Tasmā vineyya maccheraṁ, ",
  "sn1.32:5.2": "dajjā dānaṁ malābhibhū; ",
  "sn1.32:5.3": "Puññāni paralokasmiṁ, ",
  "sn1.32:5.4": "patiṭṭhā honti pāṇinan”ti. ",
  "sn1.32:6.1": "Atha kho aparā devatā bhagavato santike imā gāthāyo abhāsi: ",
  "sn1.32:7.1": "“Te matesu na mīyanti, ",
  "sn1.32:7.2": "panthānaṁva sa