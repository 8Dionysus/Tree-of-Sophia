{
  "sn1.33:0.1": "Saṁyutta Nikāya 1.33 ",
  "sn1.33:0.2": "4. Satullapakāyikavagga ",
  "sn1.33:0.3": "Sādhusutta ",
  "sn1.33:1.1": "Sāvatthinidānaṁ. ",
  "sn1.33:1.2": "Atha kho sambahulā satullapakāyikā devatāyo abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṁ jetavanaṁ obhāsetvā yena bhagavā tenupasaṅkamiṁsu; upasaṅkamitvā bhagavantaṁ abhivādetvā ekamantaṁ aṭṭhaṁsu. ",
  "sn1.33:1.3": "Ekamantaṁ ṭhitā kho ekā devatā bhagavato santike imaṁ udānaṁ udānesi: ",
  "sn1.33:2.1": "“Sādhu kho mārisa dānaṁ, ",
  "sn1.33:2.2": "maccherā ca pamādā ca; ",
  "sn1.33:2.3": "Evaṁ dānaṁ na dīyati, ",
  "sn1.33:2.4": "puññaṁ ākaṅkhamānena; ",
  "sn1.33:2.5": "Deyyaṁ hoti vijānatā”ti. ",
  "sn1.33:3.1": "Atha kho aparā devatā bhagavato santike imaṁ udānaṁ udānesi: ",
  "sn1.33:4.1": "“Sādhu kho mārisa dānaṁ, ",
  "sn1.33:4.2": "Api ca appakasmimpi sāhu dānaṁ. ",
  "sn1.33:5.1": "Appasmeke pavecchanti, ",
  "sn1.33:5.2": "bahuneke na dicchare; ",
  "sn1.33:5.3": "Appasmā dakkhiṇā dinnā, ",
  "sn1.33:5.4": "sahassena samaṁ mitā”ti. ",
  "sn1.33:6.1": "Atha kho aparā devatā bhagavato santike imaṁ udānaṁ udānesi: ",
  "sn1.33:7.1": "“Sādhu kho mārisa dānaṁ, ",
  "sn1.33:7.2": "Appakasmimpi sāhu dānaṁ; ",
  "sn1.33:7.3": "Api ca saddhāyapi sāhu dānaṁ, ",
  "sn1.33:7.4": "Dānañca yuddhañca samānamāhu; ",
  "sn1.33:7.5": "Appāpi santā bahuke jinanti, ",
  "sn1.33:7.6": "Appampi ce sa