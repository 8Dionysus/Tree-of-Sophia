{
  "sn2.23:0.1": "Saṁyutta Nikāya 2.23 ",
  "sn2.23:0.2": "3. Nānātitthiyavagga ",
  "sn2.23:0.3": "Serīsutta ",
  "sn2.23:1.1": "Ekamantaṁ ṭhito kho serī devaputto bhagavantaṁ gāthāya ajjhabhāsi: ",
  "sn2.23:2.1": "“Annamevābhinandanti, ",
  "sn2.23:2.2": "ubhaye devamānusā; ",
  "sn2.23:2.3": "Atha ko nāma so yakkho, ",
  "sn2.23:2.4": "yaṁ annaṁ nābhinandatī”ti. ",
  "sn2.23:3.1": "“Ye naṁ dadanti saddhāya, ",
  "sn2.23:3.2": "vippasannena cetasā; ",
  "sn2.23:3.3": "Tameva annaṁ bhajati, ",
  "sn2.23:3.4": "asmiṁ loke paramhi ca. ",
  "sn2.23:4.1": "Tasmā vineyya maccheraṁ, ",
  "sn2.23:4.2": "dajjā dānaṁ malābhibhū; ",
  "sn2.23:4.3": "Puññāni paralokasmiṁ, ",
  "sn2.23:4.4": "patiṭṭhā honti pāṇinan”ti. ",
  "sn2.23:5.1": "“Acchariyaṁ, bhante, abbhutaṁ, bhante. ",
  "sn2.23:5.2": "Yāvasubhāsitamidaṁ, bhante, bhagavatā: ",
  "sn2.23:6.1": "‘Ye naṁ dadanti saddhāya, ",
  "sn2.23:6.2": "vippasannena cetasā; ",
  "sn2.23:6.3": "Tameva annaṁ bhajati, ",
  "sn2.23:6.4": "asmiṁ loke paramhi ca. ",
  "sn2.23:7.1": "Tasmā vineyya maccheraṁ, ",
  "sn2.23:7.2": "dajjā dānaṁ malābhibhū; ",
  "sn2.23:7.3": "Puññāni paralokasmiṁ, ",
  "sn2.23:7.4": "patiṭṭhā honti pāṇinan’ti. ",
  "sn2.23:8.1": "Bhūtapubbāhaṁ, bhante, sirī nāma rājā ahosiṁ dāyako dānapati dānassa vaṇṇavādī. ",
  "sn2.23:8.2": "Tassa mayhaṁ, bhante, catūsu dvāresu dānaṁ dīyittha samaṇabrāhmaṇakapaṇaddhikavanibba