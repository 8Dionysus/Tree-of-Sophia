{
  "sn10.5:0.1": "Saṁyutta Nikāya 10.5 ",
  "sn10.5:0.2": "1. Indakavagga ",
  "sn10.5:0.3": "Sānusutta ",
  "sn10.5:1.1": "Ekaṁ samayaṁ bhagavā sāvatthiyaṁ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn10.5:1.2": "Tena kho pana samayena aññatarissā upāsikāya sānu nāma putto yakkhena gahito hoti. ",
  "sn10.5:1.3": "Atha kho sā upāsikā paridevamānā tāyaṁ velāyaṁ imā gāthāyo abhāsi: ",
  "sn10.5:2.1": "“Cātuddasiṁ pañcadasiṁ, ",
  "sn10.5:2.2": "yā ca pakkhassa aṭṭhamī; ",
  "sn10.5:2.3": "Pāṭihāriyapakkhañca, ",
  "sn10.5:2.4": "aṭṭhaṅgasusamāgataṁ. ",
  "sn10.5:3.1": "Uposathaṁ upavasanti, ",
  "sn10.5:3.2": "brahmacariyaṁ caranti ye; ",
  "sn10.5:3.3": "Na tehi yakkhā kīḷanti, ",
  "sn10.5:3.4": "iti me arahataṁ sutaṁ; ",
  "sn10.5:3.5": "Sā dāni ajja passāmi, ",
  "sn10.5:3.6": "yakkhā kīḷanti sānunā”ti. ",
  "sn10.5:4.1": "“Cātuddasiṁ pañcadasiṁ, ",
  "sn10.5:4.2": "yā ca pakkhassa aṭṭhamī; ",
  "sn10.5:4.3": "Pāṭihāriyapakkhañca, ",
  "sn10.5:4.4": "aṭṭhaṅgasusamāgataṁ; ",
  "sn10.5:5.1": "Uposathaṁ upavasanti, ",
  "sn10.5:5.2": "brahmacariyaṁ caranti ye. ",
  "sn10.5:5.3": "Na tehi yakkhā kīḷanti, ",
  "sn10.5:5.4": "sāhu te arahataṁ sutaṁ; ",
  "sn10.5:6.1": "Sānuṁ pabuddhaṁ vajjāsi, ",
  "sn10.5:6.2": "yakkhānaṁ vacanaṁ idaṁ; ",
  "sn10.5:6.3": "Mākāsi pāpakaṁ kammaṁ, ",
  "sn10.5:6.4": "āvi vā yadi vā raho. ",
  "sn10.5:7.1": "Sace ca pāpaka�