{
  "sn14.16:0.1": "Saṁyutta Nikāya 14.16 ",
  "sn14.16:0.2": "2. Dutiyavagga ",
  "sn14.16:0.3": "Sagāthāsutta ",
  "sn14.16:1.1": "Sāvatthiyaṁ viharati. ",
  "sn14.16:1.2": "“Dhātusova, bhikkhave, sattā saṁsandanti samenti. ",
  "sn14.16:1.3": "Hīnādhimuttikā hīnādhimuttikehi saddhiṁ saṁsandanti samenti. ",
  "sn14.16:1.4": "Atītampi kho, bhikkhave, addhānaṁ dhātusova sattā saṁsandiṁsu samiṁsu. ",
  "sn14.16:1.5": "Hīnādhimuttikā hīnādhimuttikehi saddhiṁ saṁsandiṁsu samiṁsu. ",
  "sn14.16:2.1": "Anāgatampi kho, bhikkhave, addhānaṁ dhātusova sattā saṁsandissanti samessanti. ",
  "sn14.16:2.2": "Hīnādhimuttikā hīnādhimuttikehi saddhiṁ saṁsandissanti samessanti. ",
  "sn14.16:3.1": "Etarahipi kho, bhikkhave, paccuppannaṁ addhānaṁ dhātusova sattā saṁsandanti samenti. ",
  "sn14.16:3.2": "Hīnādhimuttikā hīnādhimuttikehi saddhiṁ saṁsandanti samenti. ",
  "sn14.16:4.1": "Seyyathāpi, bhikkhave, gūtho gūthena saṁsandati sameti; ",
  "sn14.16:4.2": "muttaṁ muttena saṁsandati sameti; ",
  "sn14.16:4.3": "kheḷo kheḷena saṁsandati sameti; ",
  "sn14.16:4.4": "pubbo pubbena saṁsandati sameti; ",
  "sn14.16:4.5": "lohitaṁ lohitena saṁsandati sameti; ",
  "sn14.16:4.6": "evameva kho, bhikkhave, dhātusova sattā saṁsandanti samenti. ",
  "sn14.16:4.7": "Hīnādhimuttikā hīnādhimuttikehi saddhiṁ saṁsandanti samenti. ",
  "sn14.16:4.8": "Atītampi kho addhānaṁ …pe… ",
  "sn14.16:4.9": "anāgatampi kho addhān