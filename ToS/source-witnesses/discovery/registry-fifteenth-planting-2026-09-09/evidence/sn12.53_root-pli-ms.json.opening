{
  "sn12.53:0.1": "Saṁyutta Nikāya 12.53 ",
  "sn12.53:0.2": "6. Dukkhavagga ",
  "sn12.53:0.3": "Saṁyojanasutta ",
  "sn12.53:1.1": "Sāvatthiyaṁ viharati. ",
  "sn12.53:1.2": "“Saṁyojaniyesu, bhikkhave, dhammesu assādānupassino viharato taṇhā pavaḍḍhati. ",
  "sn12.53:1.3": "Taṇhāpaccayā upādānaṁ; ",
  "sn12.53:1.4": "upādānapaccayā bhavo; ",
  "sn12.53:1.5": "bhavapaccayā jāti; ",
  "sn12.53:1.6": "jātipaccayā jarāmaraṇaṁ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn12.53:1.7": "Evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.53:2.1": "Seyyathāpi, bhikkhave, telañca paṭicca vaṭṭiñca paṭicca telappadīpo jhāyeyya. ",
  "sn12.53:2.2": "Tatra puriso kālena kālaṁ telaṁ āsiñceyya vaṭṭiṁ upasaṁhareyya. ",
  "sn12.53:2.3": "Evañhi so, bhikkhave, telappadīpo tadāhāro tadupādāno ciraṁ dīghamaddhānaṁ jaleyya. ",
  "sn12.53:2.4": "Evameva kho, bhikkhave, saṁyojaniyesu dhammesu assādānupassino viharato taṇhā pavaḍḍhati. ",
  "sn12.53:2.5": "Taṇhāpaccayā upādānaṁ; ",
  "sn12.53:2.6": "upādānapaccayā bhavo; ",
  "sn12.53:2.7": "bhavapaccayā jāti; ",
  "sn12.53:2.8": "jātipaccayā jarāmaraṇaṁ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn12.53:2.9": "Evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.53:3.1": "Saṁyojaniyesu, bhikkhave, dhammesu ādīnavānupassino viharato taṇhā nirujjhati. ",
  "sn12.53:3.2": "Taṇhānirodhā upādānanirodho; ",
  "sn