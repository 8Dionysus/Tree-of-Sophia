{
  "sn12.45:0.1": "Saṁyutta Nikāya 12.45 ",
  "sn12.45:0.2": "5. Gahapativagga ",
  "sn12.45:0.3": "Ñātikasutta ",
  "sn12.45:1.1": "Evaṁ me sutaṁ—",
  "sn12.45:1.2": "ekaṁ samayaṁ bhagavā ñātike viharati giñjakāvasathe. ",
  "sn12.45:1.3": "Atha kho bhagavā rahogato paṭisallāno imaṁ dhammapariyāyaṁ abhāsi: ",
  "sn12.45:2.1": "“Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn12.45:2.2": "Phassapaccayā vedanā, ",
  "sn12.45:2.3": "vedanāpaccayā taṇhā; ",
  "sn12.45:2.4": "taṇhāpaccayā upādānaṁ …pe… ",
  "sn12.45:2.5": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.45:3.1": "Sotañca paṭicca sadde ca …pe… ",
  "sn12.45:3.2": "ghānañca paṭicca gandhe ca … ",
  "sn12.45:3.3": "jivhañca paṭicca rase ca … ",
  "sn12.45:3.4": "kāyañca paṭicca phoṭṭhabbe ca … ",
  "sn12.45:3.5": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn12.45:3.6": "Phassapaccayā vedanā; ",
  "sn12.45:3.7": "vedanāpaccayā taṇhā; ",
  "sn12.45:3.8": "taṇhāpaccayā upādānaṁ …pe… ",
  "sn12.45:3.9": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.45:4.1": "Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṁ. Tiṇṇaṁ saṅgati phasso. ",
  "sn12.45:4.2": "Phassapaccayā vedanā; ",
  "sn12.45:4.3": "vedanāpaccayā taṇhā. ",
  "sn12.45:4.4": "Tassāyeva taṇhāya asesavirāganirodhā upādānani