{
  "sn22.90:0.1": "Saṁyutta Nikāya 22.90 ",
  "sn22.90:0.2": "9. Theravagga ",
  "sn22.90:0.3": "Channasutta ",
  "sn22.90:1.1": "Ekaṁ samayaṁ sambahulā therā bhikkhū bārāṇasiyaṁ viharanti isipatane migadāye. ",
  "sn22.90:1.2": "Atha kho āyasmā channo sāyanhasamayaṁ paṭisallānā vuṭṭhito avāpuraṇaṁ ādāya vihārena vihāraṁ upasaṅkamitvā there bhikkhū etadavoca: ",
  "sn22.90:1.3": "“ovadantu maṁ āyasmanto therā, anusāsantu maṁ āyasmanto therā, karontu me āyasmanto therā dhammiṁ kathaṁ, yathāhaṁ dhammaṁ passeyyan”ti. ",
  "sn22.90:2.1": "Evaṁ vutte, therā bhikkhū āyasmantaṁ channaṁ etadavocuṁ: ",
  "sn22.90:2.2": "“rūpaṁ kho, āvuso channa, aniccaṁ; ",
  "sn22.90:2.3": "vedanā aniccā; ",
  "sn22.90:2.4": "saññā aniccā; ",
  "sn22.90:2.5": "saṅkhārā aniccā; ",
  "sn22.90:2.6": "viññāṇaṁ aniccaṁ. ",
  "sn22.90:2.7": "Rūpaṁ anattā; ",
  "sn22.90:2.8": "vedanā … ",
  "sn22.90:2.9": "saññā … ",
  "sn22.90:2.10": "saṅkhārā … ",
  "sn22.90:2.11": "viññāṇaṁ anattā. ",
  "sn22.90:2.12": "Sabbe saṅkhārā aniccā; ",
  "sn22.90:2.13": "sabbe dhammā anattā”ti. ",
  "sn22.90:3.1": "Atha kho āyasmato channassa etadahosi: ",
  "sn22.90:3.2": "“mayhampi kho etaṁ evaṁ hoti: ",
  "sn22.90:3.3": "‘rūpaṁ aniccaṁ, vedanā … ",
  "sn22.90:3.4": "saññā … ",
  "sn22.90:3.5": "saṅkhārā … ",
  "sn22.90:3.6": "viññāṇaṁ aniccaṁ; ",
  "sn22.90:3.7": "rūpaṁ anattā, 