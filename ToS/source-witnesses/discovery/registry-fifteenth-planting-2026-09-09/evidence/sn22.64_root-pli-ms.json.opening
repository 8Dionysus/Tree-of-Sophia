{
  "sn22.64:0.1": "Saṁyutta Nikāya 22.64 ",
  "sn22.64:0.2": "7. Arahantavagga ",
  "sn22.64:0.3": "Maññamānasutta ",
  "sn22.64:1.1": "Sāvatthinidānaṁ. ",
  "sn22.64:1.2": "Atha kho aññataro bhikkhu …pe… ekamantaṁ nisinno kho so bhikkhu bhagavantaṁ etadavoca: ",
  "sn22.64:1.3": "“sādhu me, bhante, bhagavā saṅkhittena dhammaṁ desetu …pe… ātāpī pahitatto vihareyyan”ti. ",
  "sn22.64:1.4": "“Maññamāno kho, bhikkhu, baddho mārassa; ",
  "sn22.64:1.5": "amaññamāno mutto pāpimato”ti. ",
  "sn22.64:1.6": "“Aññātaṁ, bhagavā, aññātaṁ, sugatā”ti. ",
  "sn22.64:2.1": "“Yathā kathaṁ pana tvaṁ, bhikkhu, mayā saṅkhittena bhāsitassa vitthārena atthaṁ ājānāsī”ti? ",
  "sn22.64:2.2": "“Rūpaṁ kho, bhante, maññamāno baddho mārassa; ",
  "sn22.64:2.3": "amaññamāno mutto pāpimato. ",
  "sn22.64:2.4": "Vedanaṁ … ",
  "sn22.64:2.5": "saññaṁ … ",
  "sn22.64:2.6": "saṅkhāre … ",
  "sn22.64:2.7": "viññāṇaṁ maññamāno baddho mārassa; ",
  "sn22.64:2.8": "amaññamāno mutto pāpimato. ",
  "sn22.64:2.9": "Imassa khvāhaṁ, bhante, bhagavatā saṅkhittena bhāsitassa evaṁ vitthārena atthaṁ ājānāmī”ti. ",
  "sn22.64:3.1": "“Sādhu sādhu, bhikkhu. ",
  "sn22.64:3.2": "Sādhu kho tvaṁ, bhikkhu, mayā saṅkhittena bhāsitassa vitthārena atthaṁ ājānāsi. ",
  "sn22.64:3.3": "Rūpaṁ kho, bhikkhu, maññamāno baddho mārassa; ",
  "sn22.64:3.4": "amaññamāno mutto pāpimato. ",
  "sn22.64:3.5"