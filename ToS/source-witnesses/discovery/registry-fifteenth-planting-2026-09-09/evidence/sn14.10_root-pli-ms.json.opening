{
  "sn14.10:0.1": "Saṁyutta Nikāya 14.10 ",
  "sn14.10:0.2": "1. Nānattavagga ",
  "sn14.10:0.3": "Dutiyabāhiraphassanānattasutta ",
  "sn14.10:1.1": "Sāvatthiyaṁ viharati. ",
  "sn14.10:1.2": "“Dhātunānattaṁ, bhikkhave, paṭicca uppajjati saññānānattaṁ, ",
  "sn14.10:1.3": "saññānānattaṁ paṭicca uppajjati saṅkappanānattaṁ, ",
  "sn14.10:1.4": "phassa … ",
  "sn14.10:1.5": "vedanā … ",
  "sn14.10:1.6": "chanda … ",
  "sn14.10:1.7": "pariḷāha … ",
  "sn14.10:1.8": "pariyesanānānattaṁ paṭicca uppajjati lābhanānattaṁ; ",
  "sn14.10:1.9": "no lābhanānattaṁ paṭicca uppajjati pariyesanānānattaṁ, ",
  "sn14.10:1.10": "no pariyesanānānattaṁ paṭicca uppajjati pariḷāhanānattaṁ, no pariḷāhanānattaṁ paṭicca uppajjati …pe… ",
  "sn14.10:1.11": "chanda … ",
  "sn14.10:1.12": "vedanā … ",
  "sn14.10:1.13": "phassa … ",
  "sn14.10:1.14": "saṅkappa … ",
  "sn14.10:1.15": "saññānānattaṁ, no saññānānattaṁ paṭicca uppajjati dhātunānattaṁ. ",
  "sn14.10:1.16": "Katamañca, bhikkhave, dhātunānattaṁ? ",
  "sn14.10:1.17": "Rūpadhātu …pe… dhammadhātu—",
  "sn14.10:1.18": "idaṁ vuccati, bhikkhave, dhātunānattaṁ. ",
  "sn14.10:2.1": "Kathañca, bhikkhave, dhātunānattaṁ paṭicca uppajjati saññānānattaṁ, ",
  "sn14.10:2.2": "saññānānattaṁ paṭicca uppajjati saṅkappanānattaṁ? ",
  "sn14.10:2.3": "Phassa … ",
  "sn14.10:2.4": "vedanā … ",
  "sn14.10:2.5": "chanda … ",
  "sn1