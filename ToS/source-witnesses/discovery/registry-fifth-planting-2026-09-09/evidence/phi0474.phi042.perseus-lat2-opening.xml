         <head rend="align(center)"> <abbr>M.<expan> <ex>Marci</ex> </expan> </abbr>Tvlli Ciceronis Topica</head> 
         <div type="textpart" subtype="section" xml:base="urn:cts:latinLit:phi0474.phi042.perseus-lat2" n="sigla">
