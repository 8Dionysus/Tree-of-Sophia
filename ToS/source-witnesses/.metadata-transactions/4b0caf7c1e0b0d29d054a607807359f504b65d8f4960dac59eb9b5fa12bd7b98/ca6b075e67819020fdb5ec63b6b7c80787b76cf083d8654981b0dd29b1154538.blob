{"assertion_layer":"bibliographic_assertion","assessment_refs":[],"claim_id":"tos.claim.responsibility.jenseits-von-gut-und-boese.en-zimmern-gutenberg-4363.translated-by-helen-zimmern","claim_type":"relation","claim_version":1,"epistemic_status":"observed","evidence_refs":["https://www.gutenberg.org/ebooks/4363","https://www.gutenberg.org/ebooks/author/1466","https://www.gutenberg.org/cache/epub/4363/pg4363-images.html"],"maker":{"agent_ref":"model:foundation-native-growth-source-review","maker_type":"model"},"object":"tos.agent.helen-zimmern","polarity":"positive","predicate":"translated_by","provenance_event_ref":"tos.event.annotation.jenseits-zimmern-gutenberg-4363.translator-attribution.2026-09-09","qualifiers":{"attribution_scope":"Зафиксирована атрибуция Project Gutenberg, а не независимое историческое подтверждение авторства перевода. Эти страницы являются связанными материалами одного поставщика, а не тремя независимыми свидетельствами. Примечание к электронной транскрипции описывает перепечатку перевода с немецкого на английский из The Complete Works of Friedrich Nietzsche (1909–1913), с изменениями типографики, размещения сносок и орфографии. Эти электронные изменения не приписываются Helen Zimmern. Точный печатный источник и экземпляр, полнота и точность передачи, качество перевода и эквивалентность другим версиям не установлены. 9 сентября 2026 года UTC просмотрены только каталожные страницы, начальная атрибуция и примечание; полный текст и независимые биографические источники не исследовались.","statement":"Project Gutenberg приписывает Helen Zimmern перевод, лежащий в основе английской электронной текстовой реализации «Beyond Good and Evil» № 4363: её имя указано в каталожном поле Translator и в начальной атрибуции электронной книги.","statement_language":"ru","statement_script":"Cyrl"},"review_status":"unreviewed","schema_version":"tos_source_relation_claim_v1","subject_ref":"tos.expression.friedrich-nietzsche.jenseits-von-gut-und-boese.en-zimmern-gutenberg-4363","supersedes_claim_ref":null,"visibility":"public_metadata_only"}
