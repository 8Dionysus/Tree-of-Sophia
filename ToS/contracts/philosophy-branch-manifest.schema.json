{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/philosophy-branch-manifest.schema.json",
  "version": 2,
  "title": "Philosophy branch manifest v2",
  "description": "The source path identifies the branch location. Explicit children record exceptions to directory-derived children. Counts are derived from their source rows.",
  "type": "object",
  "required": ["branch_id", "role"],
  "properties": {
    "branch_id": {"type": "string", "pattern": "^philosophy\\."},
    "role": {"type": "string", "minLength": 1},
    "children": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "not": {
    "anyOf": [
      {"required": ["path"]},
      {"required": ["anchor_count"]},
      {"required": ["proposed_node_count"]},
      {"required": ["proposed_relation_count"]},
      {"required": ["row_count"]},
      {"required": ["packet_count"]},
      {"required": ["dossier_count"]},
      {"required": ["source_planting_count"]},
      {"required": ["planting_count"]}
    ]
  }
}
