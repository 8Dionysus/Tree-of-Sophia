{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/native-pg-private-text-read.schema.json",
  "title": "Protected PostgreSQL private text read selection",
  "description": "Owner-local disclosure grant for exact native TextUnit bindings and explicitly pinned private package-history revisions. It does not authorize publication, assessment, or access to unlisted package revisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner_uid",
    "issuer",
    "mandate",
    "owner_context",
    "source_domain",
    "source_contract_sha256",
    "issued_at",
    "expires_at",
    "transport_scope",
    "external_publication_authorized",
    "selections"
  ],
  "properties": {
    "schema_version": { "const": "tos_native_pg_private_text_read_v1" },
    "owner_uid": { "type": "integer", "minimum": 0 },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "scope"],
      "properties": {
        "path": { "type": "string", "minLength": 2, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/hash" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "owner_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 2, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "source_domain": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source_contract_sha256": { "$ref": "#/$defs/hash" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "transport_scope": { "const": "owner_process_only" },
    "external_publication_authorized": { "const": false },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_sha256",
          "rights_record_refs",
          "packages",
          "condition_review"
        ],
        "properties": {
          "binding_sha256": { "$ref": "#/$defs/hash" },
          "rights_record_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/ref" }
          },
          "packages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "$ref": "#/$defs/package" }
          },
          "condition_review": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "maxLength": 64 },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "revision", "package_sha256", "command_id"],
      "properties": {
        "target_ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "revision": { "type": "integer", "minimum": 1 },
        "package_sha256": { "$ref": "#/$defs/hash" },
        "command_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
