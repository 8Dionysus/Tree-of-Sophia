{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/transfer-candidate-source-structural-route.schema.json",
  "title": "Tree of Sophia transfer candidate source structural route",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "route_set_id", "status", "work_ref", "inputs", "method", "summary", "candidates", "source_text_included", "target_text_included", "effects", "provenance_event_ref", "does_not_establish", "authority_boundary"],
  "properties": {
    "$schema": {"const": "https://tree-of-sophia.local/ToS/contracts/transfer-candidate-source-structural-route.schema.json"},
    "schema_version": {"const": "tos_transfer_candidate_source_structural_route_v1"},
    "route_set_id": {"$ref": "#/$defs/tosId"}, "status": {"const": "prepared-structural-source-routes-ineligible"}, "work_ref": {"$ref": "#/$defs/tosId"},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["target_only_crosswalk", "source_numbered_unit_map", "target_numbered_unit_map", "label_correspondence"], "properties": {"target_only_crosswalk": {"$ref": "#/$defs/fileRef"}, "source_numbered_unit_map": {"$ref": "#/$defs/fileRef"}, "target_numbered_unit_map": {"$ref": "#/$defs/fileRef"}, "label_correspondence": {"$ref": "#/$defs/fileRef"}}},
    "method": {"type": "object", "additionalProperties": false, "required": ["name", "version", "local_payloads_read", "source_or_target_text_read", "route_key", "translation_alignment_inferred", "semantic_matching_used"], "properties": {"name": {"const": "target-candidate-qualified-label-to-source-structural-route"}, "version": {"const": "1"}, "local_payloads_read": {"const": false}, "source_or_target_text_read": {"const": false}, "route_key": {"const": "series_key:unit_key"}, "translation_alignment_inferred": {"const": false}, "semantic_matching_used": {"const": false}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["candidate_page_count", "structurally_source_routable_candidate_page_count", "possible_target_route_count", "source_structural_route_count", "human_review_count", "eligible_target_unit_count", "target_gold_count"], "properties": {"candidate_page_count": {"type": "integer", "minimum": 1}, "structurally_source_routable_candidate_page_count": {"type": "integer", "minimum": 1}, "possible_target_route_count": {"type": "integer", "minimum": 1}, "source_structural_route_count": {"type": "integer", "minimum": 1}, "human_review_count": {"const": 0}, "eligible_target_unit_count": {"const": 0}, "target_gold_count": {"const": 0}}},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "source_text_included": {"const": false}, "target_text_included": {"const": false},
    "effects": {"type": "object", "additionalProperties": false, "required": ["candidate_frame_changed", "exact_passage_boundary_created", "source_text_accepted", "target_text_accepted", "source_to_target_passage_alignment_created", "translation_alignment_created", "target_unit_eligible", "target_gold_created", "semantic_work_opened", "human_work_scheduled"], "properties": {"candidate_frame_changed": {"const": false}, "exact_passage_boundary_created": {"const": false}, "source_text_accepted": {"const": false}, "target_text_accepted": {"const": false}, "source_to_target_passage_alignment_created": {"const": false}, "translation_alignment_created": {"const": false}, "target_unit_eligible": {"const": false}, "target_gold_created": {"const": false}, "semantic_work_opened": {"const": false}, "human_work_scheduled": {"const": false}}},
    "provenance_event_ref": {"$ref": "#/$defs/tosId"}, "does_not_establish": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}}, "authority_boundary": {"type": "string", "minLength": 160}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "repoPath": {"type": "string", "pattern": "^ToS/[A-Za-z0-9._/-]+$"}, "tosId": {"type": "string", "pattern": "^tos\\.[A-Za-z0-9._-]+$"}, "qualifiedKey": {"type": "string", "pattern": "^[a-z0-9-]+:[1-9][0-9]*$"},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"$ref": "#/$defs/repoPath"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["qualified_unit_key", "source_anchor_ref", "source_page", "target_anchor_ref", "target_pdf_page", "basis", "status", "exact_passage_end_boundary_known", "source_to_target_passage_alignment_claimed", "translation_alignment_claimed"], "properties": {"qualified_unit_key": {"$ref": "#/$defs/qualifiedKey"}, "source_anchor_ref": {"$ref": "#/$defs/tosId"}, "source_page": {"type": "integer", "minimum": 1}, "target_anchor_ref": {"$ref": "#/$defs/tosId"}, "target_pdf_page": {"type": "integer", "minimum": 1}, "basis": {"const": "series_qualified_number_label_candidate"}, "status": {"const": "proposed"}, "exact_passage_end_boundary_known": {"const": false}, "source_to_target_passage_alignment_claimed": {"const": false}, "translation_alignment_claimed": {"const": false}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_unit_id", "candidate_anchor_ref", "target_pdf_page", "stratum", "source_route_status", "possible_source_structural_routes", "eligible_for_variant_execution", "target_gold_status"], "properties": {"candidate_unit_id": {"type": "string"}, "candidate_anchor_ref": {"$ref": "#/$defs/tosId"}, "target_pdf_page": {"type": "integer", "minimum": 1}, "stratum": {"enum": ["random", "hard"]}, "source_route_status": {"const": "structurally-routable-ineligible"}, "possible_source_structural_routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}}, "eligible_for_variant_execution": {"const": false}, "target_gold_status": {"const": "not_started"}}}
  }
}
