{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/acquisition-provenance-delta.schema.json",
  "title": "Tree of Sophia bounded acquisition provenance delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "event_ref",
    "event_version",
    "change_kind",
    "batch_id",
    "batch_revision",
    "base_revision",
    "selection_manifest_ref",
    "selection_manifest_sha256",
    "record_refs",
    "payload_file_refs",
    "item_refs",
    "supersedes_event_ref",
    "materialization",
    "admission_status"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/acquisition-provenance-delta.schema.json"
    },
    "schema_version": {"const": "tos_acquisition_provenance_delta_v1"},
    "event_ref": {
      "type": "string",
      "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "event_version": {"type": "integer", "minimum": 1},
    "change_kind": {"const": "batch_delta"},
    "batch_id": {
      "type": "string",
      "pattern": "^tos\\.acquisition-batch\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "batch_revision": {"type": "integer", "minimum": 1},
    "base_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection_manifest_ref": {"const": "manifest.json"},
    "selection_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ToS/[A-Za-z0-9._/-]+$"}
    },
    "payload_file_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tos\\.file\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "item_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tos\\.item\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "supersedes_event_ref": {
      "type": ["string", "null"],
      "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "materialization": {
      "const": "apply-selected-records-and-custody-to-the-bound-base"
    },
    "admission_status": {"const": "not-admitted"}
  }
}
