{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/native-text-layer-comparison.schema.json",
  "title": "Private exact input/output evidence for native TextLayer assessment",
  "description": "A derived source-visible comparison, not an assessment, source carrier rewrite or publication permission. Text fields are inert evidence. This bounded profile covers structural extraction from one acquired EPUB XHTML member only.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "comparison_version", "layer", "source_scope", "member", "selector", "source_member_utf8", "expected_text", "representation_text", "representation", "editorial_policy", "maker", "configuration_sha256", "input_fixity", "deterministic_match", "visibility", "publication_authorized", "performs_semantic_assessment"],
  "properties": {
    "schema_version": {"const": "tos_native_text_layer_comparison_v1"},
    "comparison_id": {"type": "string", "pattern": "^tos\\.text-comparison\\.sha256\\.[a-f0-9]{64}$"},
    "comparison_version": {"const": 1},
    "layer": {"$ref": "#/$defs/exactRef"},
    "source_scope": {"type": "object", "additionalProperties": false,
      "required": ["work_ref", "expression_ref", "edition_ref", "item_ref", "file_ref", "file_sha256"],
      "properties": {
        "work_ref": {"type": "string", "pattern": "^tos\\.work\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "expression_ref": {"type": "string", "pattern": "^tos\\.expression\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "edition_ref": {"type": "string", "pattern": "^tos\\.edition\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "item_ref": {"type": "string", "pattern": "^tos\\.item\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "file_ref": {"type": "string", "pattern": "^tos\\.file\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }},
    "member": {"type": "object", "additionalProperties": false, "required": ["member_path", "member_sha256"], "properties": {
      "member_path": {"type": "string", "minLength": 1, "maxLength": 1024},
      "member_sha256": {"$ref": "#/$defs/sha256"}
    }},
    "selector": {"type": "object", "additionalProperties": false, "required": ["type", "scheme", "value"],
      "properties": {"type": {"const": "structural"},
        "scheme": {"enum": ["tos.xhtml.element-ordinal.v1", "tos.xhtml.element-id.v1"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "source_member_utf8": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "expected_text": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "representation_text": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "representation": {"description": "Unmodified representation object of the separately validated exact source-layer record.",
      "type": "object", "required": ["content_file_id", "content_ref", "content_sha256", "language", "text_scope", "character_normalization", "publication_authorized"],
      "properties": {"content_sha256": {"$ref": "#/$defs/sha256"}, "character_normalization": {"const": "none"}, "publication_authorized": {"const": false}}},
    "editorial_policy": {"description": "Exact extraction policy document, not a quality judgment or an editable instruction.",
      "type": "object", "required": ["schema_version", "method", "unicode_normalization", "quality_assessment"],
      "properties": {"schema_version": {"const": "tos_xhtml_text_extraction_policy_v1"}, "method": {"const": "tos.xhtml.character-data.v1"},
        "unicode_normalization": {"const": "none"}, "quality_assessment": {"const": "not-performed"}}},
    "maker": {"type": "object", "additionalProperties": false,
      "required": ["maker_type", "agent_ref", "method", "version", "configuration_ref", "configuration_digest"],
      "properties": {"maker_type": {"const": "software"}, "agent_ref": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "configuration_ref": {"type": "string", "minLength": 1}, "configuration_digest": {"$ref": "#/$defs/sha256"}}},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "input_fixity": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false, "required": ["ref", "category", "sha256"], "properties": {
        "ref": {"type": "string", "minLength": 1}, "category": {"enum": ["metadata", "content", "original_payload", "source_member"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }},
    "deterministic_match": {"type": "boolean"},
    "visibility": {"const": "local_only"},
    "publication_authorized": {"const": false},
    "performs_semantic_assessment": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {
      "id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1},
      "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    }}
  }
}
