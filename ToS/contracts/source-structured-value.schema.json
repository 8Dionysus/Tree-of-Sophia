{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/source-structured-value.schema.json",
  "title": "Claim-scoped structured value with attributed source wording",
  "description": "A Claim-scoped value whose shape and meaning are owned by the relation profile. Unknown fields remain inert data; identity dependencies require an explicitly declared reference reader.",
  "type": "object",
  "required": [
    "kind",
    "source_wording"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "source_wording": {
      "type": "object",
      "required": [
        "text",
        "language",
        "script"
      ],
      "properties": {
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "language": {
          "anyOf": [
            {
              "$ref": "https://tree-of-sophia.local/ToS/contracts/corpus-record.schema.json#/$defs/languageTagOrUnd"
            },
            {
              "type": "null"
            }
          ]
        },
        "script": {
          "$ref": "https://tree-of-sophia.local/ToS/contracts/corpus-record.schema.json#/$defs/scriptTagOrNull"
        }
      }
    }
  }
}
