{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/morphology-contextual-episode-row.schema.json",
  "title": "Private Tree of Sophia morphology contextual episode row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "context_id",
    "selection_rank",
    "selection_role",
    "form_key",
    "exact_form_sha256",
    "occurrence_id",
    "item_ref",
    "part_order",
    "source_file_sha256",
    "page_resource_id",
    "section_resource_id",
    "text_node_path",
    "source_node_start_offset",
    "source_node_end_offset",
    "context_unit_kind",
    "context_node_path",
    "context_text",
    "context_sha256",
    "target_start_offset",
    "target_end_offset",
    "target_exact_form",
    "target_return_verified",
    "sentence_boundary_claimed",
    "exact_surface_mutated",
    "input_variant",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "tos_morphology_contextual_episode_row_v1"},
    "episode_id": {"const": "zarathustra-selected-form-context-b-v1"},
    "context_id": {"pattern": "^morphology-context:sha256:[0-9a-f]{64}$"},
    "selection_rank": {"enum": [1, 73, 145]},
    "selection_role": {"enum": ["first", "inclusive-median", "last"]},
    "form_key": {"pattern": "^lexical-form:sha256:[0-9a-f]{64}$"},
    "exact_form_sha256": {"$ref": "#/$defs/sha256"},
    "occurrence_id": {"pattern": "^tos\\.occurrence\\."},
    "item_ref": {"pattern": "^tos\\.item\\."},
    "part_order": {"type": "integer", "minimum": 1, "maximum": 4},
    "source_file_sha256": {"$ref": "#/$defs/sha256"},
    "page_resource_id": {"pattern": "^tei-pb-[0-9]{4}$"},
    "section_resource_id": {"pattern": "^tei-div-[0-9]{4}$"},
    "text_node_path": {"type": "string", "minLength": 10},
    "source_node_start_offset": {"type": "integer", "minimum": 0},
    "source_node_end_offset": {"type": "integer", "minimum": 1},
    "context_unit_kind": {"enum": ["paragraph", "verse-group"]},
    "context_node_path": {"type": "string", "minLength": 10},
    "context_text": {"type": "string", "minLength": 1},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "target_start_offset": {"type": "integer", "minimum": 0},
    "target_end_offset": {"type": "integer", "minimum": 1},
    "target_exact_form": {"type": "string", "minLength": 1},
    "target_return_verified": {"const": true},
    "sentence_boundary_claimed": {"const": false},
    "exact_surface_mutated": {"const": false},
    "input_variant": {"const": "unchanged-historical-context"},
    "authority": {"const": "unreviewed-source-visible-context-for-machine-proposal-only"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
