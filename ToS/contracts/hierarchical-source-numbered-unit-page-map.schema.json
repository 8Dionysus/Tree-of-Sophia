{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/hierarchical-source-numbered-unit-page-map.schema.json",
  "title": "Tree of Sophia hierarchical source numbered-unit page map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "map_id",
    "work_ref",
    "expression_ref",
    "edition_ref",
    "address_witness",
    "navigation_witness",
    "navigation_relation",
    "represented_page_range",
    "work_boundary",
    "map_authority",
    "source_text_included",
    "method",
    "series",
    "summary",
    "provenance_ref",
    "provenance_event_ref",
    "map_version",
    "supersedes_map_ref",
    "authority_boundary",
    "does_not_establish"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/hierarchical-source-numbered-unit-page-map.schema.json"
    },
    "schema_version": {
      "const": "tos_hierarchical_source_numbered_unit_page_map_v1"
    },
    "map_id": {
      "type": "string",
      "pattern": "^tos\\.hierarchical-source-numbered-unit-page-map\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "work_ref": {"$ref": "#/$defs/tosId"},
    "expression_ref": {"$ref": "#/$defs/tosId"},
    "edition_ref": {"$ref": "#/$defs/tosId"},
    "address_witness": {"$ref": "#/$defs/witnessBinding"},
    "navigation_witness": {"$ref": "#/$defs/witnessBinding"},
    "navigation_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_scope",
        "address_page_from_navigation_page_offset",
        "source_visible_compared_address_pages",
        "full_container_page_identity_claimed",
        "textual_identity_claimed"
      ],
      "properties": {
        "relation_scope": {
          "enum": [
            "same-fixity-bound-file-page-index",
            "bounded-source-visible-two-page-offset-only"
          ]
        },
        "address_page_from_navigation_page_offset": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10
        },
        "source_visible_compared_address_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "full_container_page_identity_claimed": {"const": false},
        "textual_identity_claimed": {"const": false}
      }
    },
    "represented_page_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_page", "end_page", "basis"],
      "properties": {
        "start_page": {"type": "integer", "minimum": 1},
        "end_page": {"type": "integer", "minimum": 1},
        "basis": {"type": "string", "minLength": 40}
      }
    },
    "work_boundary": {
      "anyOf": [
        {"$ref": "#/$defs/workBoundaryBinding"},
        {"type": "null"}
      ]
    },
    "map_authority": {
      "const": "machine_candidates_with_bounded_model_source_visible_gap_review_only"
    },
    "source_text_included": {"const": false},
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "maker_type",
        "local_payloads_read",
        "candidate_verification_profiles",
        "numeric_candidate_normalizations",
        "series_trials",
        "source_visible_review",
        "source_to_target_text_compared",
        "translation_alignment_inferred",
        "semantic_matching_used",
        "no_source_text_emitted"
      ],
      "properties": {
        "name": {
          "const": "series-scoped-fixed-page-number-candidate-verification-plus-source-visible-gap-review"
        },
        "version": {"const": "1"},
        "maker_type": {"const": "mixed"},
        "local_payloads_read": {"const": true},
        "candidate_verification_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "poppler-pdftotext-bbox-short-line-number-candidate-v1",
              "provider-djvu-xml-page-word-number-candidate-v1"
            ]
          }
        },
        "numeric_candidate_normalizations": {
          "const": [
            "remove non-ASCII alphanumeric characters",
            "ASCII casefold",
            "map i l x to 1, o to 0, s to 5, z to 2",
            "join at most two adjacent same-baseline PDF short-line fragments"
          ]
        },
        "series_trials": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/seriesTrial"}
        },
        "source_visible_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maker_type",
            "human_repeat_performed",
            "reviewed_address_pages",
            "override_unit_refs"
          ],
          "properties": {
            "maker_type": {"const": "model"},
            "human_repeat_performed": {"const": false},
            "reviewed_address_pages": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "override_unit_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/unitRef"}
            }
          }
        },
        "source_to_target_text_compared": {"const": false},
        "translation_alignment_inferred": {"const": false},
        "semantic_matching_used": {"const": false},
        "no_source_text_emitted": {"const": true}
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/series"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_count",
        "numbered_unit_count",
        "machine_number_candidate_count",
        "source_visible_override_unit_count",
        "source_visible_reviewed_page_count",
        "exact_start_page_candidates_materialized",
        "unresolved_unit_count",
        "start_pages_monotonic_within_series",
        "all_anchor_statuses",
        "human_review_performed",
        "accepted_german_unit_count"
      ],
      "properties": {
        "series_count": {"type": "integer", "minimum": 1},
        "numbered_unit_count": {"type": "integer", "minimum": 1},
        "machine_number_candidate_count": {"type": "integer", "minimum": 0},
        "source_visible_override_unit_count": {"type": "integer", "minimum": 0},
        "source_visible_reviewed_page_count": {"type": "integer", "minimum": 0},
        "exact_start_page_candidates_materialized": {"type": "integer", "minimum": 1},
        "unresolved_unit_count": {"const": 0},
        "start_pages_monotonic_within_series": {"const": true},
        "all_anchor_statuses": {"const": ["proposed"]},
        "human_review_performed": {"const": false},
        "accepted_german_unit_count": {"const": 0}
      }
    },
    "provenance_ref": {"$ref": "#/$defs/repoPath"},
    "provenance_event_ref": {"$ref": "#/$defs/tosId"},
    "map_version": {"type": "integer", "minimum": 1},
    "supersedes_map_ref": {
      "anyOf": [
        {"$ref": "#/$defs/repoPath"},
        {"type": "null"}
      ]
    },
    "authority_boundary": {"type": "string", "minLength": 220},
    "does_not_establish": {
      "const": [
        "source_text",
        "exact_line_boundaries",
        "exact_passage_end_boundaries",
        "accepted_german",
        "provider_ocr_correctness",
        "full_container_page_identity",
        "source_to_target_passage_alignment",
        "translation_correspondence",
        "translation_equivalence",
        "translation_quality",
        "textual_identity",
        "edition_equivalence",
        "semantics",
        "rights_clearance",
        "eligible_target_unit",
        "target_gold",
        "canon_promotion"
      ]
    }
  },
  "$defs": {
    "tosId": {"type": "string", "pattern": "^tos\\.[A-Za-z0-9._-]+$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repoPath": {"type": "string", "pattern": "^ToS/[A-Za-z0-9._/-]+$"},
    "seriesKey": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "unitKey": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "unitRef": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[1-9][0-9]*$"},
    "digestBoundRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "witnessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ref",
        "file_ref",
        "file_sha256",
        "inventory_profile",
        "inventory",
        "rights"
      ],
      "properties": {
        "item_ref": {"$ref": "#/$defs/tosId"},
        "file_ref": {"$ref": "#/$defs/tosId"},
        "file_sha256": {"$ref": "#/$defs/digest"},
        "inventory_profile": {
          "enum": ["pdf_pages_v1", "djvu_pages_v1", "djvu_xml_pages_v1"]
        },
        "inventory": {"$ref": "#/$defs/digestBoundRef"},
        "rights": {"$ref": "#/$defs/digestBoundRef"}
      }
    },
    "workBoundaryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "member_sequence",
        "start_page",
        "end_page",
        "epistemic_status",
        "review_status"
      ],
      "properties": {
        "ref": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "member_sequence": {"type": "integer", "minimum": 1},
        "start_page": {"type": "integer", "minimum": 1},
        "end_page": {"type": "integer", "minimum": 1},
        "epistemic_status": {"type": "string", "minLength": 1},
        "review_status": {"type": "string", "minLength": 1}
      }
    },
    "seriesTrial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_key",
        "expected_unit_count",
        "machine_number_candidate_count",
        "source_visible_override_unit_keys"
      ],
      "properties": {
        "series_key": {"$ref": "#/$defs/seriesKey"},
        "expected_unit_count": {"type": "integer", "minimum": 1},
        "machine_number_candidate_count": {"type": "integer", "minimum": 0},
        "source_visible_override_unit_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/unitKey"}
        }
      }
    },
    "unitStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "unit_key",
        "source_page",
        "resource_id",
        "navigation_page",
        "anchor_ref",
        "basis",
        "status",
        "human_review_performed"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "unit_key": {"$ref": "#/$defs/unitKey"},
        "source_page": {"type": "integer", "minimum": 1},
        "resource_id": {"type": "string", "pattern": "^(pdf|djvu)-page-[0-9]{4}$"},
        "navigation_page": {"type": "integer", "minimum": 1},
        "anchor_ref": {"$ref": "#/$defs/tosId"},
        "basis": {
          "enum": [
            "embedded_pdf_bbox_number_candidate",
            "provider_djvu_xml_number_candidate",
            "source_visible_gap_review"
          ]
        },
        "status": {"const": "proposed"},
        "human_review_performed": {"const": false}
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_key",
        "series_sequence",
        "series_kind",
        "start_page",
        "end_page",
        "expected_unit_count",
        "status",
        "unit_starts"
      ],
      "properties": {
        "series_key": {"$ref": "#/$defs/seriesKey"},
        "series_sequence": {"type": "integer", "minimum": 1},
        "series_kind": {
          "enum": [
            "numbered-preface",
            "numbered-essay",
            "numbered-main-sequence"
          ]
        },
        "start_page": {"type": "integer", "minimum": 1},
        "end_page": {"type": "integer", "minimum": 1},
        "expected_unit_count": {"type": "integer", "minimum": 1},
        "status": {"const": "proposed"},
        "unit_starts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/unitStart"}
        }
      }
    }
  }
}
