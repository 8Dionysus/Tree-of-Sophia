{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/edition-curation.v1.schema.json",
  "title": "Edition curation for a source item",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "curation_id", "version", "status", "owner_item_ref", "edition_ref", "manifest", "recipes"],
  "properties": {
    "$schema": {"const": "https://tree-of-sophia.local/ToS/contracts/edition-curation.v1.schema.json"},
    "schema_version": {"const": "tos_edition_curation_v1"},
    "curation_id": {"$ref": "#/$defs/id"},
    "version": {"const": 1},
    "status": {"const": "historical-constants"},
    "owner_item_ref": {"$ref": "#/$defs/id"},
    "edition_ref": {"$ref": "#/$defs/id"},
    "manifest": {"$ref": "#/$defs/relativePath"},
    "recipes": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/numbered"}, {"$ref": "#/$defs/markers"}]}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^tos\\.[a-z0-9][a-z0-9.-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "locator": {
      "type": "object", "additionalProperties": false, "required": ["role"],
      "properties": {"role": {"type": "string", "minLength": 1}, "item_relative_path": {"$ref": "#/$defs/relativePath"}, "repository_path": {"$ref": "#/$defs/relativePath"}},
      "oneOf": [{"required": ["item_relative_path"]}, {"required": ["repository_path"]}]
    },
    "keyList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "numbered": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "work_ref", "expression_ref", "edition_ref", "map_id", "event_id", "locators", "page_overrides"],
      "properties": {
        "stage": {"const": "numbered-structure"},
        "work_ref": {"$ref": "#/$defs/id"}, "expression_ref": {"$ref": "#/$defs/id"}, "edition_ref": {"$ref": "#/$defs/id"}, "map_id": {"$ref": "#/$defs/id"}, "event_id": {"$ref": "#/$defs/id"},
        "locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "source_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tools": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}},
        "page_overrides": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "page"], "properties": {"key": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}}}},
        "gap_review_keys": {"$ref": "#/$defs/keyList"}, "ocr_disambiguation_keys": {"$ref": "#/$defs/keyList"},
        "ocr_substitutions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["digit", "allowed_characters"], "properties": {"digit": {"type": "string", "pattern": "^[0-9]$"}, "allowed_characters": {"type": "string", "minLength": 1}}}},
        "ocr_allowed_characters": {"type": "string", "minLength": 1}
      }
    },
    "pixelBox": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 4},
    "lineBox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "markers": {
      "type": "object", "additionalProperties": false, "required": ["stage", "marker_returns"],
      "properties": {
        "stage": {"const": "source-passage-marker-returns"},
        "marker_returns": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["key", "pixel_bbox", "record_order", "line_bbox"],
          "properties": {
            "key": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": ["string", "integer"]}},
            "image_object_number": {"type": "integer", "minimum": 0}, "image_object_generation": {"type": "integer", "minimum": 0},
            "image_width_pixels": {"type": "integer", "minimum": 1}, "image_height_pixels": {"type": "integer", "minimum": 1},
            "leaf_number": {"type": "integer", "minimum": 0}, "member_path": {"$ref": "#/$defs/relativePath"},
            "pixel_bbox": {"$ref": "#/$defs/pixelBox"}, "record_order": {"type": "integer", "minimum": 0}, "line_bbox": {"$ref": "#/$defs/lineBox"}
          },
          "oneOf": [{"required": ["image_object_number", "image_object_generation", "image_width_pixels", "image_height_pixels"]}, {"required": ["leaf_number", "member_path"]}]
        }}
      }
    }
  }
}
