{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/chronology-version-record.schema.json",
  "title": "chronology-version source metadata (not access or policy admission)",
  "allOf": [
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/source-metadata-record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "semantic_content"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_chronology_version_record_v1"
        },
        "record_type": {
          "const": "chronology-version"
        },
        "record_id": {
          "type": "string",
          "pattern": "^tos\\.chronology-version\\."
        },
        "semantic_content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source_snapshot",
            "system_as_of",
            "attributed_knowledge",
            "source_publication_as_of",
            "selection_mode",
            "members",
            "policies"
          ],
          "properties": {
            "schema_version": {
              "const": "tos_frozen_chronology_v1"
            },
            "source_snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "system_as_of": {
              "$ref": "#/$defs/cutoff"
            },
            "attributed_knowledge": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "knower",
                    "cutoff"
                  ],
                  "properties": {
                    "knower": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "cutoff": {
                      "$ref": "#/$defs/cutoff"
                    }
                  }
                }
              ]
            },
            "source_publication_as_of": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/cutoff"
                }
              ]
            },
            "selection_mode": {
              "const": "ExplicitExactMembers"
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/exactRef"
              }
            },
            "policies": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence",
                "selection"
              ],
              "properties": {
                "evidence": {
                  "$ref": "#/$defs/policyEnvelope"
                },
                "selection": {
                  "$ref": "#/$defs/policyEnvelope"
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "trs"
      ],
      "properties": {
        "value": {
          "not": {
            "type": "null"
          }
        },
        "trs": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/exactRef"
            }
          ]
        }
      }
    },
    "policyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "policy_version",
        "kind",
        "profile",
        "rules",
        "basis"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_chronology_source_policy_v1"
        },
        "policy_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "Evidence",
            "Selection"
          ]
        },
        "profile": {
          "enum": [
            "ExactPinnedMemberEvidence-v1",
            "ExplicitExactMembers-v1"
          ]
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "membership",
            "history",
            "ordering"
          ],
          "properties": {
            "membership": {
              "const": "PresentInPinnedCut"
            },
            "history": {
              "const": "ExactRevisionOnly"
            },
            "ordering": {
              "const": "DeclaredSequence"
            }
          }
        },
        "basis": {}
      }
    },
    "policyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "reference",
        "scope"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/policyDefinition"
        },
        "reference": {
          "$ref": "#/$defs/exactRef"
        },
        "scope": {
          "const": "InlineSourceDefinitionNotAuthorization"
        }
      }
    }
  }
}
