{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/source-resource-inventory.schema.json",
  "title": "Tree of Sophia source resource inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "item_id",
    "generated_from_manifest_ref",
    "inventory_authority",
    "source_text_included",
    "files",
    "generator",
    "provenance_event_ref",
    "inventory_version"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/source-resource-inventory.schema.json"
    },
    "schema_version": {"const": "tos_source_resource_inventory_v1"},
    "item_id": {"$ref": "#/$defs/tosId"},
    "generated_from_manifest_ref": {"$ref": "#/$defs/repoRelativePath"},
    "inventory_authority": {"const": "mechanical_metadata_only"},
    "source_text_included": {"const": false},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileInventory"}
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "build_source_resource_inventories.py"},
        "version": {"const": "1"}
      }
    },
    "provenance_event_ref": {"$ref": "#/$defs/tosId"},
    "inventory_version": {"type": "integer", "minimum": 1},
    "supersedes_inventory_ref": {
      "anyOf": [
        {"$ref": "#/$defs/repoRelativePath"},
        {"type": "null"}
      ]
    },
    "authority_boundary": {
      "const": "resource enumeration, geometry, ordering, counts, and one-way fingerprints only; no source text, bibliographic acceptance, textual acceptance, rights clearance, translation, semantics, or canon authority"
    }
  },
  "$defs": {
    "tosId": {
      "type": "string",
      "pattern": "^tos\\.(agent|work|expression|edition|collection|item|file|passage|region|anchor|occurrence|annotation|claim|rights|review|event)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "normalization", "sha256", "character_count"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "normalization": {"enum": ["unicode-nfc-whitespace-collapse", "xml-character-data-preserved", "unicode-codepoints-preserved"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "character_count": {"type": "integer", "minimum": 0}
      }
    },
    "jsonValueCounts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Counts include each object and array container. String counts are values; object keys are counted separately. No source keys or values are included.",
      "required": ["object_count", "array_count", "string_count", "number_count", "boolean_count", "null_count", "object_key_count"],
      "properties": {
        "object_count": {"type": "integer", "minimum": 0},
        "array_count": {"type": "integer", "minimum": 0},
        "string_count": {"type": "integer", "minimum": 0},
        "number_count": {"type": "integer", "minimum": 0},
        "boolean_count": {"type": "integer", "minimum": 0},
        "null_count": {"type": "integer", "minimum": 0},
        "object_key_count": {"type": "integer", "minimum": 0}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_index": {"type": "integer", "minimum": 1},
        "leaf_number": {"type": "integer", "minimum": 0},
        "width_points": {"type": "number", "exclusiveMinimum": 0},
        "height_points": {"type": "number", "exclusiveMinimum": 0},
        "width_pixels": {"type": "integer", "minimum": 1},
        "height_pixels": {"type": "integer", "minimum": 1},
        "resolution_dpi": {"type": "integer", "minimum": 1},
        "rotation_degrees": {"type": "integer"},
        "member_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "container_order": {"type": "integer", "minimum": 1},
        "spine_index": {"type": "integer", "minimum": 1},
        "tei_path": {"type": "string", "minLength": 1},
        "tei_depth": {"type": "integer", "minimum": 1},
        "tei_page_label": {"type": "string", "minLength": 1},
        "tei_facs_ref": {"type": "string", "minLength": 1},
        "tei_n": {"type": "string", "minLength": 1},
        "tei_type": {"type": "string", "minLength": 1},
        "osis_id": {"type": "string", "pattern": "^[1-4]?[A-Za-z]+\\.[0-9]+(?:\\.[0-9]+[a-z]?)?$"},
        "chapter_index": {"type": "integer", "minimum": 1},
        "verse_index": {"type": "integer", "minimum": 1},
        "json_member_index": {"type": "integer", "minimum": 1},
        "json_value_type": {"enum": ["object", "array", "string", "number", "boolean", "null"]},
        "parent_resource_id": {"type": "string", "minLength": 1}
      },
      "minProperties": 1
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "resource_kind", "locator"],
      "properties": {
        "resource_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "resource_kind": {
          "enum": [
            "pdf_page",
            "djvu_page",
            "epub_member",
            "tei_page_break",
            "tei_division",
            "ocr_page",
            "image_page",
            "scan_data_page",
            "osis_chapter",
            "osis_verse",
            "json_container",
            "json_member"
          ]
        },
        "locator": {"$ref": "#/$defs/locator"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"},
        "byte_size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "structural_role": {
          "enum": [
            "page",
            "spine_resource",
            "navigation",
            "package_metadata",
            "container_metadata",
            "auxiliary_resource",
            "page_break",
            "division",
            "contents",
            "chapter",
            "verse",
            "member"
          ]
        },
        "image_resource_count": {"type": "integer", "minimum": 0},
        "paragraph_count": {"type": "integer", "minimum": 0},
        "line_count": {"type": "integer", "minimum": 0},
        "word_count": {"type": "integer", "minimum": 0},
        "verse_count": {"type": "integer", "minimum": 0},
        "json_value_counts": {"$ref": "#/$defs/jsonValueCounts"},
        "label_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "content_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_count"],
      "properties": {
        "resource_count": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 1},
        "image_resource_count": {"type": "integer", "minimum": 0},
        "distinct_page_geometry_count": {"type": "integer", "minimum": 1},
        "member_count": {"type": "integer", "minimum": 1},
        "spine_item_count": {"type": "integer", "minimum": 0},
        "xhtml_count": {"type": "integer", "minimum": 0},
        "page_break_count": {"type": "integer", "minimum": 0},
        "division_count": {"type": "integer", "minimum": 0},
        "max_division_depth": {"type": "integer", "minimum": 0},
        "paragraph_count": {"type": "integer", "minimum": 0},
        "line_count": {"type": "integer", "minimum": 0},
        "word_count": {"type": "integer", "minimum": 0},
        "chapter_count": {"type": "integer", "minimum": 1},
        "verse_count": {"type": "integer", "minimum": 1},
        "top_level_member_count": {"type": "integer", "minimum": 0},
        "json_value_counts": {"$ref": "#/$defs/jsonValueCounts"}
      }
    },
    "fileInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "file_sha256",
        "media_type",
        "profile",
        "summary",
        "resources"
      ],
      "properties": {
        "file_id": {"$ref": "#/$defs/tosId"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"},
        "profile": {
          "enum": [
            "pdf_pages_v1",
            "djvu_pages_v1",
            "epub_resources_v1",
            "tei_structure_v1",
            "djvu_xml_pages_v1",
            "abbyy_xml_pages_v1",
            "jp2_zip_pages_v1",
            "scandata_pages_v1",
            "osis_structure_v1",
            "json_members_v1"
          ]
        },
        "summary": {"$ref": "#/$defs/summary"},
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/resource"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"profile": {"const": "osis_structure_v1"}}},
          "then": {
            "properties": {
              "summary": {"required": ["chapter_count", "verse_count", "word_count"]},
              "resources": {"items": {"properties": {
                "resource_kind": {"enum": ["osis_chapter", "osis_verse"]},
                "content_fingerprint": {"properties": {"normalization": {"const": "xml-character-data-preserved"}}}
              }}}
            }
          }
        },
        {
          "if": {"properties": {"profile": {"const": "json_members_v1"}}},
          "then": {
            "properties": {
              "summary": {"required": ["top_level_member_count", "json_value_counts"]},
              "resources": {"items": {"properties": {
                "resource_kind": {"enum": ["json_container", "json_member"]},
                "label_fingerprint": {"properties": {"normalization": {"const": "unicode-codepoints-preserved"}}},
                "content_fingerprint": {"properties": {"normalization": {"const": "unicode-codepoints-preserved"}}}
              }}}
            }
          }
        }
      ]
    }
  }
}
