{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/experimental-translation-episode.schema.json",
  "title": "Tree of Sophia private experimental translation episode receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "episode_id",
    "status",
    "work_ref",
    "target",
    "admission",
    "method_freeze",
    "private_run",
    "content_boundary",
    "outcome",
    "measurements",
    "rights_and_visibility",
    "gate_effects",
    "provenance_event_ref",
    "authority_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/experimental-translation-episode.schema.json"
    },
    "schema_version": {"const": "tos_experimental_translation_episode_v1"},
    "episode_id": {
      "type": "string",
      "pattern": "^tos\\.experimental-translation-episode\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "failed-and-retained",
        "frozen-ai-only-experimental-candidate"
      ]
    },
    "work_ref": {"$ref": "#/$defs/tosId"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_unit_id", "context_anchor_ref", "critical_locator_siglum"],
      "properties": {
        "review_unit_id": {
          "type": "string",
          "pattern": "^tos-translation-source-review-v[0-9]+-[0-9]{3}$"
        },
        "context_anchor_ref": {"$ref": "#/$defs/tosId"},
        "critical_locator_siglum": {"type": "string", "minLength": 1}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_witness_decision",
        "current_source_return_overlay",
        "ordered_research_refresh"
      ],
      "properties": {
        "citation_witness_decision": {"$ref": "#/$defs/digestBoundRef"},
        "current_source_return_overlay": {"$ref": "#/$defs/digestBoundRef"},
        "ordered_research_refresh": {"$ref": "#/$defs/digestBoundRef"},
        "specialized_mt_challenger_admission": {
          "$ref": "#/$defs/digestBoundRef"
        }
      }
    },
    "method_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_owner",
        "owner_revision",
        "profile_id",
        "profile_sha256",
        "prompt_id",
        "runner",
        "model",
        "runtime",
        "decoding"
      ],
      "properties": {
        "runtime_owner": {"const": "abyss-stack"},
        "owner_revision": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"},
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "runner": {
          "oneOf": [
            {"$ref": "#/$defs/llamaRunner"},
            {"$ref": "#/$defs/ovmsRunner"}
          ]
        },
        "model": {
          "oneOf": [
            {"$ref": "#/$defs/singleFileModel"},
            {"$ref": "#/$defs/directoryTreeModel"},
            {"$ref": "#/$defs/specializedMtModel"}
          ]
        },
        "runtime": {
          "oneOf": [
            {"$ref": "#/$defs/llamaRuntime"},
            {"$ref": "#/$defs/ovmsRuntime"},
            {"$ref": "#/$defs/specializedMtRuntime"}
          ]
        },
        "decoding": {
          "oneOf": [
            {"$ref": "#/$defs/generativeDecoding"},
            {"$ref": "#/$defs/specializedMtDecoding"}
          ]
        }
      }
    },
    "private_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_receipt",
        "local_source_artifact_sha256",
        "source_text_sha256",
        "candidate_artifact"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "run_receipt": {"$ref": "#/$defs/privateDigestRef"},
        "local_source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_text_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_artifact": {
          "oneOf": [
            {"$ref": "#/$defs/privateDigestRef"},
            {"type": "null"}
          ]
        }
      }
    },
    "content_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text_tracked",
        "candidate_text_tracked",
        "private_paths_tracked",
        "recognized_comparator_revealed"
      ],
      "properties": {
        "source_text_tracked": {"const": false},
        "candidate_text_tracked": {"const": false},
        "private_paths_tracked": {"const": false},
        "recognized_comparator_revealed": {"const": false}
      }
    },
    "outcome": {
      "oneOf": [
        {"$ref": "#/$defs/failureOutcome"},
        {"$ref": "#/$defs/triageOutcome"},
        {"$ref": "#/$defs/uncertainOutcome"}
      ]
    },
    "measurements": {
      "oneOf": [
        {"$ref": "#/$defs/llamaMeasurements"},
        {"$ref": "#/$defs/ovmsMeasurements"},
        {"$ref": "#/$defs/specializedMtMeasurements"}
      ]
    },
    "rights_and_visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "use",
        "source_or_candidate_sharing_authorized",
        "publication_authorized",
        "commercial_use_authorized"
      ],
      "properties": {
        "environment": {"const": "local-only"},
        "use": {"const": "private-non-commercial-research"},
        "source_or_candidate_sharing_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "commercial_use_authorized": {"const": false}
      }
    },
    "gate_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimental_episodes_recorded",
        "infrastructure_failures_retained",
        "ai_only_experimental_candidates_recorded",
        "ai_human_tasks_created",
        "accepted_german_units",
        "accepted_translation_packets",
        "semantic_tasks_opened",
        "graph_or_canon_promotion_authorized"
      ],
      "properties": {
        "experimental_episodes_recorded": {"const": 1},
        "infrastructure_failures_retained": {"type": "integer", "minimum": 0, "maximum": 1},
        "ai_only_experimental_candidates_recorded": {"type": "integer", "minimum": 0, "maximum": 1},
        "ai_human_tasks_created": {"const": 0},
        "accepted_german_units": {"const": 0},
        "accepted_translation_packets": {"const": 0},
        "semantic_tasks_opened": {"const": 0},
        "graph_or_canon_promotion_authorized": {"const": false}
      }
    },
    "provenance_event_ref": {"$ref": "#/$defs/tosId"},
    "authority_boundary": {
      "const": "a private experimental translation episode may preserve method, failure, Russian-surface triage, speed, resource, and fixity evidence; it cannot establish German correctness, translation fidelity, etymology, semantics, publication permission, graph truth, or canon authority"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed-and-retained"}}},
      "then": {
        "properties": {
          "private_run": {
            "properties": {"candidate_artifact": {"type": "null"}}
          },
          "outcome": {"$ref": "#/$defs/failureOutcome"},
          "gate_effects": {
            "properties": {
              "infrastructure_failures_retained": {"const": 1},
              "ai_only_experimental_candidates_recorded": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "frozen-ai-only-experimental-candidate"}}},
      "then": {
        "properties": {
          "private_run": {
            "properties": {
              "candidate_artifact": {"$ref": "#/$defs/privateDigestRef"}
            }
          },
          "outcome": {
            "oneOf": [
              {"$ref": "#/$defs/triageOutcome"},
              {"$ref": "#/$defs/uncertainOutcome"}
            ]
          },
          "gate_effects": {
            "properties": {
              "infrastructure_failures_retained": {"const": 0},
              "ai_only_experimental_candidates_recorded": {"const": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method_freeze": {
            "properties": {
              "model": {
                "properties": {
                  "model_id": {"const": "google/madlad400-3b-mt"}
                },
                "required": ["model_id"]
              }
            },
            "required": ["model"]
          }
        },
        "required": ["method_freeze"]
      },
      "then": {
        "properties": {
          "admission": {
            "required": ["specialized_mt_challenger_admission"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": {
              "kind": {
                "const": "candidate-retained-after-ai-surface-and-source-aware-inspection"
              }
            },
            "required": ["kind"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "admission": {
            "required": ["specialized_mt_challenger_admission"]
          },
          "method_freeze": {
            "properties": {
              "model": {"$ref": "#/$defs/specializedMtModel"},
              "runtime": {"$ref": "#/$defs/specializedMtRuntime"},
              "decoding": {"$ref": "#/$defs/specializedMtDecoding"}
            }
          },
          "measurements": {"$ref": "#/$defs/specializedMtMeasurements"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tosId": {
      "type": "string",
      "pattern": "^tos\\.(agent|work|expression|edition|collection|item|file|passage|region|anchor|occurrence|annotation|claim|rights|review|event)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "repoRef": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))ToS/[A-Za-z0-9._/-]+$"
    },
    "digestBoundRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/repoRef"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "privateDigestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^tos\\.private\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "llamaRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_ref", "module_sha256", "cli_ref", "cli_sha256"],
      "properties": {
        "module_ref": {"type": "string", "pattern": "^mechanics/[A-Za-z0-9._/-]+$"},
        "module_sha256": {"$ref": "#/$defs/sha256"},
        "cli_ref": {"type": "string", "pattern": "^mechanics/[A-Za-z0-9._/-]+$"},
        "cli_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ovmsRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_ref",
        "module_sha256",
        "base_module_ref",
        "base_module_sha256"
      ],
      "properties": {
        "module_ref": {"type": "string", "pattern": "^mechanics/[A-Za-z0-9._/-]+$"},
        "module_sha256": {"$ref": "#/$defs/sha256"},
        "base_module_ref": {"type": "string", "pattern": "^mechanics/[A-Za-z0-9._/-]+$"},
        "base_module_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "singleFileModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "upstream_revision",
        "artifact_size_bytes",
        "artifact_sha256",
        "quantization"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "upstream_revision": {"type": "string", "minLength": 1},
        "artifact_size_bytes": {"type": "integer", "minimum": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "quantization": {"type": "string", "minLength": 1}
      }
    },
    "directoryTreeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "upstream_revision",
        "artifact_kind",
        "artifact_file_count",
        "artifact_size_bytes",
        "artifact_tree_sha256",
        "primary_weight_sha256",
        "quantization"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "upstream_revision": {"type": "string", "minLength": 1},
        "artifact_kind": {"const": "directory-tree"},
        "artifact_file_count": {"type": "integer", "minimum": 1},
        "artifact_size_bytes": {"type": "integer", "minimum": 1},
        "artifact_tree_sha256": {"$ref": "#/$defs/sha256"},
        "primary_weight_sha256": {"$ref": "#/$defs/sha256"},
        "quantization": {"type": "string", "minLength": 1}
      }
    },
    "specializedMtModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "upstream_revision",
        "license",
        "provenance_posture",
        "artifact_kind",
        "artifact_file_count",
        "artifact_size_bytes",
        "artifact_set_sha256",
        "primary_weight_sha256"
      ],
      "properties": {
        "model_id": {"const": "google/madlad400-3b-mt"},
        "upstream_revision": {"type": "string", "minLength": 1},
        "license": {"const": "Apache-2.0"},
        "provenance_posture": {
          "const": "upstream-namespace-community-conversion-disclosed"
        },
        "artifact_kind": {"const": "multi-file-model-set"},
        "artifact_file_count": {"type": "integer", "minimum": 1},
        "artifact_size_bytes": {"type": "integer", "minimum": 1},
        "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
        "primary_weight_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "llamaRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "runtime_revision",
        "backend",
        "device",
        "launcher_sha256",
        "binary_sha256",
        "context_tokens",
        "gpu_layers",
        "threads"
      ],
      "properties": {
        "runtime_id": {"type": "string", "minLength": 1},
        "runtime_revision": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1},
        "launcher_sha256": {"$ref": "#/$defs/sha256"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "context_tokens": {"type": "integer", "minimum": 1},
        "gpu_layers": {"type": "integer", "minimum": 0},
        "threads": {"type": "integer", "minimum": 1}
      }
    },
    "ovmsRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_mode",
        "runtime_id",
        "backend",
        "device",
        "image_ref",
        "image_id",
        "context_tokens",
        "threads",
        "cache_size_gib",
        "container_network",
        "model_mount_read_only",
        "model_view_kind",
        "model_view_file_count",
        "model_view_size_bytes",
        "model_view_sha256",
        "runtime_userns",
        "runtime_process_uid",
        "runtime_process_gid",
        "runtime_graph_filename",
        "runtime_model_projection_file_count",
        "runtime_model_projection_sha256",
        "runtime_metadata_mount_writable",
        "container_name_prefix",
        "smoke_timeout_seconds",
        "candidate_timeout_seconds",
        "jinja_chat_template",
        "generation_schema_mode"
      ],
      "properties": {
        "runtime_mode": {"const": "ovms-container-cpu"},
        "runtime_id": {"type": "string", "minLength": 1},
        "backend": {"const": "OpenVINO Model Server container"},
        "device": {"const": "CPU"},
        "image_ref": {"type": "string", "pattern": "^docker\\.io/openvino/model_server@sha256:[a-f0-9]{64}$"},
        "image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "context_tokens": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1},
        "cache_size_gib": {"type": "integer", "minimum": 1},
        "container_network": {"const": "none"},
        "model_mount_read_only": {"const": true},
        "model_view_kind": {"const": "verified-byte-copy-no-git"},
        "model_view_file_count": {"type": "integer", "minimum": 1},
        "model_view_size_bytes": {"type": "integer", "minimum": 1},
        "model_view_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_userns": {"const": "keep-id:uid=5000,gid=5000"},
        "runtime_process_uid": {"const": 5000},
        "runtime_process_gid": {"const": 5000},
        "runtime_graph_filename": {"const": "graph.pbtxt"},
        "runtime_model_projection_file_count": {"type": "integer", "minimum": 1},
        "runtime_model_projection_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_metadata_mount_writable": {"const": true},
        "container_name_prefix": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*-$"},
        "smoke_timeout_seconds": {"type": "integer", "minimum": 1},
        "candidate_timeout_seconds": {"type": "integer", "minimum": 1},
        "jinja_chat_template": {"const": true},
        "generation_schema_mode": {"type": "string", "minLength": 1}
      }
    },
    "specializedMtRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_mode",
        "runtime_id",
        "backend",
        "device",
        "runtime_manifest_sha256",
        "runtime_artifact_set_sha256",
        "runtime_artifact_file_count",
        "runtime_size_bytes",
        "source_free_smoke_sha256",
        "network_namespace"
      ],
      "properties": {
        "runtime_mode": {"const": "candle-cpu-local"},
        "runtime_id": {"const": "madlad-candle-0.11.0-cpu"},
        "backend": {"const": "Candle 0.11.0 GGUF T5"},
        "device": {"const": "CPU"},
        "runtime_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_artifact_set_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_artifact_file_count": {"type": "integer", "minimum": 1},
        "runtime_size_bytes": {"type": "integer", "minimum": 1},
        "source_free_smoke_sha256": {"$ref": "#/$defs/sha256"},
        "network_namespace": {
          "const": "new-user-and-network-namespace-no-loopback"
        }
      }
    },
    "generativeDecoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "top_p", "seed", "max_tokens"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": "integer"},
        "max_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "specializedMtDecoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "repeat_penalty",
        "max_source_tokens",
        "max_new_tokens"
      ],
      "properties": {
        "temperature": {"const": 0.0},
        "repeat_penalty": {"const": 1.0},
        "max_source_tokens": {"type": "integer", "minimum": 1},
        "max_new_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "failureOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidate_present",
        "failure_class",
        "observed_issue_ids",
        "private_failure_evidence",
        "corrected_after_no_candidate",
        "corrective_followup_run_id"
      ],
      "properties": {
        "kind": {"const": "infrastructure-failure-before-candidate"},
        "candidate_present": {"const": false},
        "failure_class": {"const": "runtime-contract-incompatibility-before-generation"},
        "observed_issue_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "private_failure_evidence": {"$ref": "#/$defs/privateDigestRef"},
        "corrected_after_no_candidate": {"const": true},
        "corrective_followup_run_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    },
    "triageOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidate_present",
        "ai_triage",
        "scope",
        "run_integrity_verified",
        "output_contract_valid",
        "source_echo_exact",
        "russian_surface_posture",
        "observed_issue_ids",
        "useful_uncertainty_preserved",
        "disposition",
        "human_review_created"
      ],
      "properties": {
        "kind": {"const": "candidate-rejected-by-ai-russian-surface-triage"},
        "candidate_present": {"const": true},
        "ai_triage": {"$ref": "#/$defs/privateDigestRef"},
        "scope": {"const": "russian-surface-only-no-german-competence-claim"},
        "run_integrity_verified": {"const": true},
        "output_contract_valid": {"const": true},
        "source_echo_exact": {"const": true},
        "russian_surface_posture": {"const": "obvious-defects"},
        "observed_issue_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "useful_uncertainty_preserved": {"type": "boolean"},
        "disposition": {"const": "reject-before-human-review"},
        "human_review_created": {"const": false}
      }
    },
    "uncertainOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidate_present",
        "surface_floor",
        "scope",
        "run_integrity_verified",
        "output_contract_valid",
        "source_identity_exact",
        "russian_surface_posture",
        "surface_finding_count",
        "source_aware_risk_ids",
        "useful_uncertainty_preserved",
        "disposition",
        "human_review_created"
      ],
      "properties": {
        "kind": {
          "const": "candidate-retained-after-ai-surface-and-source-aware-inspection"
        },
        "candidate_present": {"const": true},
        "surface_floor": {"$ref": "#/$defs/privateDigestRef"},
        "scope": {
          "const": "russian-surface-plus-ai-source-aware-risk-screen-no-human-german-competence"
        },
        "run_integrity_verified": {"const": true},
        "output_contract_valid": {"const": true},
        "source_identity_exact": {"const": true},
        "russian_surface_posture": {"const": "uncertain"},
