{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeofsophia.local/ToS/contracts/human-form-template.schema.json",
  "title": "Owner-admitted finite human-form template",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "template_id", "template_version", "language", "script", "roles", "segments"],
  "properties": {
    "schema_version": {"const": "tos_human_form_template_v1"},
    "template_id": {"type": "string", "pattern": "^tos\\.form-template\\.[a-z0-9][a-z0-9._-]*$"},
    "template_version": {"type": "integer", "minimum": 1},
    "language": {"type": ["string", "null"], "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[iIxX](?:-[A-Za-z0-9]{1,8})+)$(?![\\s\\S])"},
    "script": {"type": ["string", "null"], "pattern": "^[A-Za-z]{4}$(?![\\s\\S])"},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["name", "caption", "hover", "statement", "grounds", "history", "technical"]}},
    "segments": {"type": "array", "minItems": 1, "maxItems": 256,
      "items": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["literal"],
         "properties": {"literal": {"type": "string", "maxLength": 16384}}},
        {"type": "object", "additionalProperties": false, "required": ["slot", "format"],
         "properties": {"slot": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])"},
                        "format": {"enum": ["text", "json"]}}}
      ]}}
  }
}
