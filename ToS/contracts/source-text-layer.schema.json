{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/source-text-layer.schema.json",
  "title": "Tree of Sophia source text layer",
  "description": "Additive source-text contract that preserves immutable representations, explicit correction and normalization lineage, uncertainty, review scope, competence, downstream admission, rights, and source return without overwriting prior layers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "layer_id",
    "layer_role",
    "source_binding",
    "representation",
    "derivation",
    "editorial_policy",
    "uncertainty",
    "admission",
    "provenance_event_ref",
    "authority_boundary",
    "layer_version",
    "supersedes_layer_ref"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/source-text-layer.schema.json"
    },
    "schema_version": {"const": "tos_source_text_layer_v1"},
    "layer_id": {"$ref": "#/$defs/textLayerId"},
    "layer_role": {
      "enum": [
        "raw_ocr",
        "machine_transcription",
        "diplomatic_transcription",
        "reviewed_source_text",
        "normalized_text"
      ]
    },
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "representation": {"$ref": "#/$defs/representation"},
    "derivation": {"$ref": "#/$defs/derivation"},
    "editorial_policy": {"$ref": "#/$defs/editorialPolicy"},
    "uncertainty": {"$ref": "#/$defs/uncertainty"},
    "admission": {"$ref": "#/$defs/admission"},
    "provenance_event_ref": {"$ref": "#/$defs/eventId"},
    "authority_boundary": {
      "const": "a source text layer is one immutable, source-returnable representation with explicit derivation, uncertainty, review, competence, rights, and use scope; mechanical validation, model output, normalization, or agreement with another layer does not make it accepted source text, translation evidence, linguistic truth, semantic evidence, graph truth, canon authority, or publication permission"
    },
    "layer_version": {"type": "integer", "minimum": 1},
    "supersedes_layer_ref": {
      "oneOf": [
        {"$ref": "#/$defs/textLayerId"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"layer_version": {"minimum": 2}},
        "required": ["layer_version"]
      },
      "then": {
        "properties": {
          "supersedes_layer_ref": {"$ref": "#/$defs/textLayerId"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "derivation": {
            "properties": {
              "method": {"const": "identity_copy"}
            },
            "required": ["method"]
          }
        }
      },
      "then": {
        "properties": {
          "derivation": {
            "properties": {
              "input_layers": {"minItems": 1, "maxItems": 1},
              "change_payload": {"$ref": "#/$defs/noChanges"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"layer_role": {"const": "normalized_text"}},
        "required": ["layer_role"]
      },
      "then": {
        "properties": {
          "representation": {
            "properties": {
              "character_normalization": {
                "enum": ["NFC", "NFD", "NFKC", "NFKD", "editorial"]
              }
            }
          },
          "admission": {
            "properties": {
              "accepted_uses": {
                "not": {
                  "contains": {
                    "enum": ["source_fidelity", "diplomatic_transcription"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission": {
            "properties": {
              "review_status": {
                "enum": ["rejected", "ambiguous", "deferred", "superseded"]
              }
            },
            "required": ["review_status"]
          }
        }
      },
      "then": {
        "properties": {
          "admission": {
            "properties": {
              "accepted_uses": {"maxItems": 0},
              "promotion_authorized": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "derivation": {
            "properties": {
              "method": {
                "enum": ["correction", "unicode_normalization", "editorial_normalization"]
              }
            },
            "required": ["method"]
          }
        }
      },
      "then": {
        "properties": {
          "derivation": {
            "properties": {
              "input_layers": {"minItems": 1},
              "change_payload": {
                "oneOf": [
                  {"$ref": "#/$defs/explicitChanges"},
                  {"$ref": "#/$defs/withheldChanges"}
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "derivation": {
            "properties": {
              "method": {"enum": ["ocr", "model_transcription", "manual_transcription"]}
            },
            "required": ["method"]
          }
        }
      },
      "then": {
        "properties": {
          "derivation": {
            "properties": {
              "input_layers": {"maxItems": 0},
              "change_payload": {"$ref": "#/$defs/noChanges"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission": {
            "properties": {"review_status": {"const": "unreviewed"}},
            "required": ["review_status"]
          }
        }
      },
      "then": {
        "properties": {
          "admission": {
            "properties": {
              "review_ref": {"type": "null"},
              "human_review_performed": {"const": false},
              "accepted_uses": {"maxItems": 0},
              "promotion_authorized": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission": {
            "properties": {
              "review_status": {"enum": ["accepted", "accepted_with_limits"]}
            },
            "required": ["review_status"]
          }
        }
      },
      "then": {
        "properties": {
          "admission": {
            "properties": {
              "review_ref": {"$ref": "#/$defs/reviewId"},
              "human_review_performed": {"const": true},
              "accepted_uses": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission": {
            "properties": {
              "accepted_uses": {
                "contains": {
                  "enum": ["translation_source", "linguistic_analysis", "semantic_analysis"]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "admission": {
            "properties": {
              "human_language_competence": {"const": "evidence_attested"},
              "language_competence_evidence_refs": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission": {
            "properties": {
              "accepted_uses": {"contains": {"const": "publication"}}
            }
          }
        }
      },
      "then": {
        "properties": {
          "representation": {
            "properties": {
              "publication_authorized": {"const": true},
              "publication_authority_refs": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "representation": {
            "properties": {"publication_authorized": {"const": true}},
            "required": ["publication_authorized"]
          }
        }
      },
      "then": {
        "properties": {
          "representation": {
            "properties": {
              "rights_record_refs": {"minItems": 1},
              "publication_authority_refs": {"minItems": 1}
            }
          }
        }
      },
      "else": {
        "properties": {
          "representation": {
            "properties": {
              "publication_authority_refs": {"maxItems": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "textLayerId": {
      "type": "string",
      "pattern": "^tos\\.text-layer\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "workId": {
      "type": "string",
      "pattern": "^tos\\.work\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "expressionId": {
      "type": "string",
      "pattern": "^tos\\.expression\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "editionId": {
      "type": "string",
      "pattern": "^tos\\.edition\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^tos\\.item\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "fileId": {
      "type": "string",
      "pattern": "^tos\\.file\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "anchorId": {
      "type": "string",
      "pattern": "^tos\\.anchor\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^tos\\.review\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "boundedRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!~[\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "digestBoundRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/boundedRef"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;[^\\r\\n]+)?$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^(und|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$"
    },
    "anchorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "anchor_record_ref", "anchor_record_sha256"],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/anchorId"},
        "anchor_record_ref": {"$ref": "#/$defs/boundedRef"},
        "anchor_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_ref",
        "expression_ref",
        "edition_ref",
        "item_ref",
        "source_file_ref",
        "source_file_sha256",
        "anchor_contract",
        "anchors"
      ],
      "properties": {
        "work_ref": {"$ref": "#/$defs/workId"},
        "expression_ref": {"$ref": "#/$defs/expressionId"},
        "edition_ref": {"$ref": "#/$defs/editionId"},
        "item_ref": {"$ref": "#/$defs/itemId"},
        "source_file_ref": {"$ref": "#/$defs/fileId"},
        "source_file_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_contract": {"const": "tos_source_anchor_v2"},
        "anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchorBinding"}
        }
      }
    },
    "textSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "position_unit", "interval"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "position_unit": {"const": "unicode_code_point"},
        "interval": {"const": "half_open"}
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_file_id",
        "content_ref",
        "content_sha256",
        "media_type",
        "charset",
        "language",
        "text_scope",
        "character_normalization",
        "line_break_posture",
        "storage",
        "content_visibility",
        "tracked_content",
        "publication_authorized",
        "rights_record_refs",
        "publication_authority_refs"
      ],
      "properties": {
        "content_file_id": {"$ref": "#/$defs/fileId"},
        "content_ref": {"$ref": "#/$defs/boundedRef"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"$ref": "#/$defs/mediaType"},
        "charset": {"const": "UTF-8"},
        "language": {"$ref": "#/$defs/languageTag"},
        "text_scope": {"$ref": "#/$defs/textSpan"},
        "character_normalization": {
          "enum": ["none", "NFC", "NFD", "NFKC", "NFKD", "editorial"]
        },
        "line_break_posture": {
          "enum": ["source_preserved", "logical_reflow", "not_applicable"]
        },
        "storage": {"enum": ["tracked", "ignored_local"]},
        "content_visibility": {
          "enum": ["public", "public_metadata_only", "local_only", "restricted", "unknown"]
        },
        "tracked_content": {"type": "boolean"},
        "publication_authorized": {"type": "boolean"},
        "rights_record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digestBoundRef"}
        },
        "publication_authority_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digestBoundRef"}
        }
      }
    },
    "inputLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_id", "record_ref", "record_sha256", "content_sha256"],
      "properties": {
        "layer_id": {"$ref": "#/$defs/textLayerId"},
        "record_ref": {"$ref": "#/$defs/boundedRef"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_type", "agent_ref", "method", "version", "configuration_digest"],
      "properties": {
        "maker_type": {"enum": ["human", "software", "model", "mixed"]},
        "agent_ref": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration_ref": {
          "oneOf": [
            {"$ref": "#/$defs/boundedRef"},
            {"type": "null"}
          ]
        },
        "configuration_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit_id",
        "operation",
        "input_span",
        "output_span",
        "input_exact",
        "input_sha256",
        "output_exact",
        "output_sha256",
        "reason",
        "responsibility",
        "confidence",
        "evidence_anchor_refs",
        "status"
      ],
      "properties": {
        "edit_id": {"type": "string", "pattern": "^edit-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "operation": {
          "enum": [
            "insert",
            "delete",
            "replace",
            "unicode_normalization",
            "whitespace",
            "punctuation",
            "structure"
          ]
        },
        "input_span": {"$ref": "#/$defs/textSpan"},
        "output_span": {"$ref": "#/$defs/textSpan"},
        "input_exact": {"type": "string"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "output_exact": {"type": "string"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1},
        "responsibility": {"$ref": "#/$defs/maker"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_anchor_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchorId"}
        },
        "status": {"enum": ["proposed", "verified"]}
      }
    },
    "noChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "none"}}
    },
    "explicitChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operations"],
      "properties": {
        "kind": {"const": "explicit_operations"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/edit"}
        }
      }
    },
    "withheldChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation_count", "operations_sha256", "private_ref"],
      "properties": {
        "kind": {"const": "withheld_operations_receipt"},
        "operation_count": {"type": "integer", "minimum": 1},
        "operations_sha256": {"$ref": "#/$defs/sha256"},
        "private_ref": {"$ref": "#/$defs/boundedRef"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "input_layers",
        "maker",
        "preservation_goal",
        "loss_posture",
        "silent_changes_allowed",
        "change_payload"
      ],
      "properties": {
        "method": {
          "enum": [
            "ocr",
            "model_transcription",
            "manual_transcription",
            "correction",
            "unicode_normalization",
            "editorial_normalization",
            "identity_copy"
          ]
        },
        "input_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/inputLayer"}
        },
        "maker": {"$ref": "#/$defs/maker"},
        "preservation_goal": {
          "enum": ["source_near", "historical_language", "normalized_for_search", "editorial_reading"]
        },
        "loss_posture": {
          "enum": ["unknown", "preservation_intended", "normalization_intended", "lossy_for_declared_use"]
        },
        "silent_changes_allowed": {"const": false},
        "change_payload": {
          "oneOf": [
            {"$ref": "#/$defs/noChanges"},
            {"$ref": "#/$defs/explicitChanges"},
            {"$ref": "#/$defs/withheldChanges"}
          ]
        }
      }
    },
    "editorialPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "policy_sha256",
        "transcription_goal",
        "historical_language_preserved",
        "printing_errors_silently_corrected",
        "typography_posture",
        "layout_posture",
        "unicode_normalization",
        "uncertainty_representation",
        "method_declared"
      ],
      "properties": {
        "policy_ref": {"$ref": "#/$defs/boundedRef"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "transcription_goal": {
          "enum": ["machine_candidate", "diplomatic", "reviewed_reading", "normalized_access"]
        },
        "historical_language_preserved": {"type": "boolean"},
        "printing_errors_silently_corrected": {"const": false},
        "typography_posture": {"enum": ["preserve", "encode_explicitly", "normalize_declared", "not_applicable"]},
        "layout_posture": {"enum": ["preserve", "encode_explicitly", "logical_reflow", "not_applicable"]},
        "unicode_normalization": {"enum": ["none", "NFC", "NFD", "NFKC", "NFKD", "editorial"]},
        "uncertainty_representation": {"const": "explicit-never-silent"},
        "method_declared": {"const": true}
      }
    },
    "readingAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_sha256", "value_in_record", "value", "status"],
      "properties": {
        "value_sha256": {"$ref": "#/$defs/sha256"},
        "value_in_record": {"type": "boolean"},
        "value": {"type": ["string", "null"]},
        "status": {"enum": ["possible", "preferred", "rejected"]}
      }
    },
    "uncertaintyAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_id", "anchor_ref", "kind", "alternatives", "resolution"],
      "properties": {
        "annotation_id": {"type": "string", "pattern": "^tos\\.annotation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "anchor_ref": {"$ref": "#/$defs/anchorId"},
        "kind": {"enum": ["illegible", "damaged", "omitted", "ambiguous_glyph", "ambiguous_reading", "editorial_choice"]},
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/readingAlternative"}
        },
        "resolution": {"enum": ["unresolved", "proposed", "reviewed"]}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "annotations"],
      "properties": {
        "status": {"enum": ["none", "annotated", "unresolved"]},
        "annotations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uncertaintyAnnotation"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "none"}},
            "required": ["status"]
          },
          "then": {"properties": {"annotations": {"maxItems": 0}}},
          "else": {"properties": {"annotations": {"minItems": 1}}}
        }
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanical_status",
        "review_status",
        "review_ref",
        "human_review_performed",
        "human_language_competence",
        "language_competence_evidence_refs",
        "accepted_uses",
        "automatic_validation_complete",
        "model_output_is_ground_truth",
        "validator_proves_content_truth",
        "routine_human_task_created",
        "promotion_authorized"
      ],
      "properties": {
        "mechanical_status": {"enum": ["materialized", "fixity_verified", "unresolved", "rejected", "superseded"]},
        "review_status": {"enum": ["unreviewed", "accepted", "accepted_with_limits", "rejected", "ambiguous", "deferred", "superseded"]},
        "review_ref": {
          "oneOf": [
            {"$ref": "#/$defs/reviewId"},
            {"type": "null"}
          ]
        },
        "human_review_performed": {"type": "boolean"},
        "human_language_competence": {"enum": ["not_assessed", "evidence_attested", "blocked", "not_required"]},
        "language_competence_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/boundedRef"}
        },
        "accepted_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_fidelity",
              "diplomatic_transcription",
              "citation",
              "translation_source",
              "linguistic_analysis",
              "semantic_analysis",
              "search_projection",
              "publication"
            ]
          }
        },
        "automatic_validation_complete": {"type": "boolean"},
        "model_output_is_ground_truth": {"const": false},
        "validator_proves_content_truth": {"const": false},
        "routine_human_task_created": {"const": false},
        "promotion_authorized": {"type": "boolean"}
      }
    }
  }
}
