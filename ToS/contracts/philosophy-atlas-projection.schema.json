{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/philosophy-atlas-projection.schema.json",
  "title": "Tree of Sophia philosophy atlas projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "owner_repo",
    "surface_kind",
    "source_atlas_ref",
    "content_language_contract",
    "runtime_projection_boundary",
    "validation_refs",
    "counts",
    "nodes",
    "edges",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "tos_philosophy_atlas_projection_v1"
    },
    "schema_ref": {
      "const": "ToS/contracts/philosophy-atlas-projection.schema.json"
    },
    "owner_repo": {
      "const": "Tree-of-Sophia"
    },
    "surface_kind": {
      "const": "derived_philosophy_atlas_projection"
    },
    "source_atlas_ref": {
      "const": "ToS/philosophy/atlas/atlas.manifest.json"
    },
    "content_language_contract": {
      "$ref": "#/$defs/content_language_contract"
    },
    "runtime_projection_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_owner", "runtime_scope", "tos_authority_scope"],
      "properties": {
        "runtime_owner": {
          "const": "abyss-stack"
        },
        "runtime_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tos_authority_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "authoredSourceProperties": {
      "description": "Lossless public philosophy input, not a native Corpus Record. JSONL source_row is a parsed-record ordinal, source_line a physical line; file and canonical record digests remain distinct.",
      "type": "object",
      "properties": {
        "source_record": {"type": "object"},
        "source_backlogs": {"$ref": "#/$defs/dossierSourceBacklogs"},
        "source_record_ref": {"type": "string", "pattern": "^ToS/philosophy/"},
        "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_format": {"enum": ["json", "jsonl"]},
        "source_row": {"type": "integer", "minimum": 1},
        "source_line": {"type": "integer", "minimum": 1},
        "source_pointer": {"const": ""},
        "endpoint_alias_source": {"$ref": "#/$defs/authoredSourceProperties"},
        "endpoint_alias_pointers": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/aliases/[0-9]+$"}}
      },
      "dependentRequired": {
        "source_record": ["source_record_ref", "source_file_sha256", "source_record_sha256", "source_format"],
        "source_format": ["source_record"],
        "source_backlogs": ["source_record"],
        "endpoint_alias_source": ["endpoint_alias_ref", "endpoint_alias_pointers"]
      },
      "allOf": [
        {
          "if": {"required": ["source_format"], "properties": {"source_format": {"const": "jsonl"}}},
          "then": {"required": ["source_row", "source_line"], "not": {"required": ["source_pointer"]}}
        },
        {
          "if": {"required": ["source_format"], "properties": {"source_format": {"const": "json"}}},
          "then": {"required": ["source_pointer"], "not": {"anyOf": [{"required": ["source_row"]}, {"required": ["source_line"]}]}}
        }
      ]
    },
    "dossierSourceBacklogs": {
      "description": "Complete source rows grouped under an existing dossier, not new graph identities or semantic assertions. Family source refs follow the authored dossier manifest. Empty records means no rows for this dossier, not a missing source file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_anchor_backlog", "term_index", "transmission_backlog"],
      "properties": {
        "source_anchor_backlog": {"$ref": "#/$defs/dossierBacklogFamily"},
        "term_index": {"$ref": "#/$defs/dossierBacklogFamily"},
        "transmission_backlog": {"$ref": "#/$defs/dossierBacklogFamily"}
      }
    },
    "dossierBacklogFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_file_sha256", "record_count", "records"],
      "properties": {
        "source_ref": {"type": "string", "pattern": "^ToS/philosophy/.*[.]jsonl$"},
        "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0},
        "records": {"type": "array", "items": {"$ref": "#/$defs/backlogSourceRecord"}}
      }
    },
    "backlogSourceRecord": {
      "description": "An occurrence at an exact byte-snapshot JSONL locator. Identical records on different lines remain distinct occurrences; the locator is not a stable source identity.",
      "allOf": [{"$ref": "#/$defs/authoredSourceProperties"}],
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record", "source_record_ref", "source_file_sha256", "source_record_sha256", "source_format", "source_row", "source_line"],
      "properties": {
        "source_record": {}, "source_record_ref": {}, "source_file_sha256": {},
        "source_record_sha256": {}, "source_format": {"const": "jsonl"},
        "source_row": {}, "source_line": {}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "label", "multilingual", "source_ref", "properties"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "node_type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "multilingual": {
          "$ref": "#/$defs/multilingual_label"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "$ref": "#/$defs/authoredSourceProperties"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_id", "predicate_id", "to_id", "source_ref", "properties"],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "$ref": "#/$defs/authoredSourceProperties"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "path", "message"],
      "properties": {
        "level": {
          "enum": ["warning", "error"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_language_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_ref",
        "display_languages",
        "required_translation_languages",
        "original_language_rule",
        "downstream_consumer_rule",
        "language_registry_ref",
        "text_bearing_nodes_contract_ref",
        "text_bearing_node_rule"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_multilingual_content_contract_v1"
        },
        "source_ref": {
          "const": "ToS/philosophy/atlas/multilingual/content-labels.json"
        },
        "display_languages": {
          "$ref": "#/$defs/string_array"
        },
        "required_translation_languages": {
          "$ref": "#/$defs/string_array"
        },
        "original_language_rule": {
          "type": "string",
          "minLength": 1
        },
        "downstream_consumer_rule": {
          "type": "string",
          "minLength": 1
        },
        "language_registry_ref": {
          "const": "ToS/philosophy/atlas/multilingual/language-registry.json"
        },
        "text_bearing_nodes_contract_ref": {
          "const": "ToS/philosophy/atlas/multilingual/text-bearing-nodes.contract.json"
        },
        "text_bearing_node_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "multilingual_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "label", "language", "translation_status", "source_ref"],
      "properties": {
        "schema_version": {
          "const": "tos_multilingual_label_v1"
        },
        "label": {
          "$ref": "#/$defs/localized_label"
        },
        "language": {
          "$ref": "#/$defs/language_identity"
        },
        "translation_status": {
          "$ref": "#/$defs/translation_status"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localized_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "ru", "en"],
      "properties": {
        "original": {
          "type": ["string", "null"]
        },
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "language_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_language", "original_script", "transliteration"],
      "properties": {
        "original_language": {
          "type": ["string", "null"]
        },
        "original_script": {
          "type": ["string", "null"]
        },
        "transliteration": {
          "type": ["string", "null"]
        }
      }
    },
    "translation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "ru", "en"],
      "properties": {
        "original": {
          "enum": ["source", "pending", "not_applicable"]
        },
        "ru": {
          "enum": ["source", "reviewed", "draft"]
        },
        "en": {
          "enum": ["source", "reviewed", "draft"]
        }
      }
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
