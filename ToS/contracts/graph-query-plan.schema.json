{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/graph-query-plan.schema.json",
  "title": "Tree of Sophia frozen graph projection query plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "plan_id",
    "claim_set_ref",
    "claim_set_sha256",
    "frozen_at",
    "frozen_before_variant_outputs",
    "maker",
    "graph_layers",
    "allowed_predicates",
    "queries",
    "human_judgment_status",
    "authority_boundary"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "schema_version": {"const": "tos_graph_query_plan_v1"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "claim_set_ref": {"$ref": "#/$defs/repoRelativePath"},
    "claim_set_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "frozen_before_variant_outputs": {"const": true},
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_type", "agent_ref", "method"],
      "properties": {
        "maker_type": {"enum": ["human", "model", "mixed"]},
        "agent_ref": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "graph_layers": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["bibliographic", "textual", "provenance", "interpretive"]}
    },
    "allowed_predicates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
    },
    "queries": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "question",
          "operation",
          "parameters",
          "expected_claim_refs",
          "expected_node_refs",
          "review_status"
        ],
        "properties": {
          "query_id": {"type": "string", "pattern": "^tos-graph-query-[0-9]{3}$"},
          "question": {"type": "string", "minLength": 1},
          "operation": {
            "enum": [
              "subject_predicate",
              "claim_family",
              "path",
              "layer_inventory",
              "review_inventory",
              "traceability_inventory"
            ]
          },
          "parameters": {"type": "object"},
          "expected_claim_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/claimId"}
          },
          "expected_node_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "review_status": {"const": "model-proposed-awaiting-human"}
        }
      }
    },
    "human_judgment_status": {"const": "not_started"},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claimId": {
      "type": "string",
      "pattern": "^tos\\.claim\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    }
  }
}
