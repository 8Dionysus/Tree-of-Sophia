{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/pwe-scope.schema.json",
  "title": "PWE selected native pwe-scope",
  "allOf": [
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/source-metadata-record.schema.json"
    },
    {
      "required": [
        "body"
      ],
      "properties": {
        "record_type": {
          "const": "pwe-scope"
        },
        "schema_version": {
          "const": "tos_pwe_scope_v1"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "interpretation"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "interpretation": {
              "const": "source-owned-pwe-scope-v1"
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$comment": "Candidate native source route. Authored instances, exact pins, current protected assessment and registration are separate inputs. A declaration issues neither source truth nor admission nor coverage."
}
