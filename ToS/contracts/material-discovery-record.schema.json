{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/material-discovery-record.schema.json",
  "title": "Tree of Sophia material discovery run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "discovery_id",
    "protocol_ref",
    "target",
    "channels",
    "channel_comparison",
    "selected_result_ids",
    "rejected_result_ids",
    "rights_inference_from_availability_prohibited",
    "general_web_search_is_last_resort",
    "technical_access_bypass_used",
    "maker",
    "started_at",
    "ended_at",
    "status",
    "provenance_event_refs",
    "record_version"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/material-discovery-record.schema.json"
    },
    "schema_version": {"const": "tos_material_discovery_record_v1"},
    "discovery_id": {
      "type": "string",
      "pattern": "^tos\\.discovery\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "protocol_ref": {
      "const": "ToS/source-witnesses/discovery/DISCOVERY_PROTOCOL.md"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_kind",
        "known_tos_refs",
        "description",
        "required_properties",
        "acceptable_substitutions",
        "languages",
        "formats",
        "purpose_ref"
      ],
      "properties": {
        "target_kind": {
          "enum": ["work", "expression", "edition", "item", "artifact", "scholarly-composite", "translation", "critical-edition", "lexical-resource", "research-publication"]
        },
        "known_tos_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tosId"}
        },
        "description": {"type": "string", "minLength": 1},
        "required_properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "acceptable_substitutions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "formats": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "purpose_ref": {"type": "string", "minLength": 1},
        "constraint_refinements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/constraintRefinement"}
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/channel"}
    },
    "channel_comparison": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/channelComparison"}
    },
    "selected_result_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/resultId"}
    },
    "rejected_result_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/resultId"}
    },
    "rights_inference_from_availability_prohibited": {"const": true},
    "general_web_search_is_last_resort": {"const": true},
    "technical_access_bypass_used": {"const": false},
    "maker": {"$ref": "#/$defs/maker"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["planned", "executed", "reconciled", "incomplete", "superseded"]},
    "provenance_event_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tosId"}
    },
    "record_version": {"type": "integer", "minimum": 1},
    "supersedes_discovery_ref": {
      "oneOf": [
        {"type": "string", "pattern": "^tos\\.discovery\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "tosId": {
      "type": "string",
      "pattern": "^tos\\.(agent|work|expression|edition|collection|item|artifact|composite|file|passage|region|anchor|occurrence|annotation|claim|rights|review|event)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "constraintRefinement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_field",
        "candidate_values",
        "discovery_field",
        "discovery_values",
        "review_status",
        "reviewed_at",
        "reviewer_ref"
      ],
      "properties": {
        "candidate_field": {
          "enum": ["required_properties", "acceptable_substitutions", "formats"]
        },
        "candidate_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "discovery_field": {
          "enum": ["required_properties", "acceptable_substitutions", "formats"]
        },
        "discovery_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "review_status": {"const": "reviewed"},
        "reviewed_at": {"type": "string", "format": "date"},
        "reviewer_ref": {"type": "string", "minLength": 1}
      }
    },
    "resultId": {
      "type": "string",
      "pattern": "^tos-discovery-result\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_type", "agent_ref"],
      "properties": {
        "maker_type": {"enum": ["human", "model", "mixed", "software"]},
        "agent_ref": {"type": "string", "minLength": 1}
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "rank",
        "title_as_displayed",
        "result_url",
        "originating_record_url",
        "identifiers",
        "available_formats",
        "declared_rights",
        "availability",
        "machine_interface",
        "decision",
        "rationale",
        "acquisition",
        "snapshot"
      ],
      "properties": {
        "result_id": {"$ref": "#/$defs/resultId"},
        "rank": {"type": "integer", "minimum": 1},
        "title_as_displayed": {"type": "string", "minLength": 1},
        "result_url": {"type": "string", "format": "uri"},
        "originating_record_url": {
          "oneOf": [{"type": "string", "format": "uri"}, {"type": "null"}]
        },
        "identifiers": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "available_formats": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "declared_rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement", "scope", "evidence_url", "tos_conclusion"],
          "properties": {
            "statement": {"type": ["string", "null"]},
            "scope": {"enum": ["metadata", "content", "digital-object", "unknown"]},
            "evidence_url": {
              "oneOf": [{"type": "string", "format": "uri"}, {"type": "null"}]
            },
            "tos_conclusion": {"const": "evidence-only-not-a-rights-conclusion"}
          }
        },
        "availability": {
          "enum": ["open-download", "open-view", "metadata-only", "subscription", "permission-required", "unavailable", "unknown"]
        },
        "machine_interface": {
          "enum": ["api", "bulk-data", "iiif", "html", "manual-only", "none", "unknown"]
        },
        "decision": {"enum": ["select", "reject", "defer", "needs-reconciliation"]},
        "rationale": {"type": "string", "minLength": 1},
        "acquisition": {"$ref": "#/$defs/acquisition"},
        "snapshot": {"$ref": "#/$defs/snapshot"}
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloaded", "acquired_at", "byte_size", "sha256", "event_ref"],
      "properties": {
        "downloaded": {"type": "boolean"},
        "acquired_at": {"type": ["string", "null"], "format": "date-time"},
        "byte_size": {"type": ["integer", "null"], "minimum": 1},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "event_ref": {"oneOf": [{"$ref": "#/$defs/tosId"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"downloaded": {"const": true}}, "required": ["downloaded"]},
          "then": {
            "properties": {
              "acquired_at": {"type": "string", "format": "date-time"},
              "byte_size": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "event_ref": {"$ref": "#/$defs/tosId"}
            }
          },
          "else": {
            "properties": {
              "acquired_at": {"type": "null"},
              "byte_size": {"type": "null"},
              "sha256": {"type": "null"},
              "event_ref": {"type": "null"}
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "format", "sha256", "reason"],
      "properties": {
        "state": {"enum": ["captured", "not-needed", "not-permitted", "not-captured"]},
        "format": {"type": ["string", "null"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "captured"}}, "required": ["state"]},
          "then": {
            "properties": {
              "format": {"enum": ["WARC", "WACZ", "static-snapshot"]},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {
            "properties": {"format": {"type": "null"}, "sha256": {"type": "null"}}
          }
        }
      ]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "sequence",
        "channel_type",
        "role",
        "source_name",
        "endpoint_url",
        "interface_type",
        "interface_version",
        "exact_query",
        "queried_at",
        "elapsed_seconds",
        "result_order_preserved",
        "results"
      ],
      "properties": {
        "channel_id": {"type": "string", "pattern": "^channel-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "sequence": {"type": "integer", "minimum": 1},
        "channel_type": {
          "enum": ["national-catalog", "university-catalog", "publisher-catalog", "specialized-scholarly-project", "collection-aggregator", "identifier-registry", "open-library", "meta-search", "general-web-search"]
        },
        "role": {"enum": ["originating-record", "lead-only", "digital-object-record", "scholarly-index", "mixed"]},
        "source_name": {"type": "string", "minLength": 1},
        "endpoint_url": {"type": "string", "format": "uri"},
        "interface_type": {"enum": ["web", "api", "bulk", "iiif", "manual"]},
        "interface_version": {"type": ["string", "null"]},
        "exact_query": {"type": "string", "minLength": 1},
        "queried_at": {"type": "string", "format": "date-time"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "result_order_preserved": {"const": true},
        "results": {"type": "array", "items": {"$ref": "#/$defs/result"}}
      }
    },
    "channelComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "completeness",
        "metadata_precision",
        "rights_clarity",
        "machine_interface_quality",
        "human_minutes",
        "machine_seconds",
        "notes"
      ],
      "properties": {
        "channel_id": {"type": "string", "pattern": "^channel-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "completeness": {"$ref": "#/$defs/rating"},
        "metadata_precision": {"$ref": "#/$defs/rating"},
        "rights_clarity": {"$ref": "#/$defs/rating"},
        "machine_interface_quality": {"$ref": "#/$defs/rating"},
        "human_minutes": {"type": "number", "minimum": 0},
        "machine_seconds": {"type": "number", "minimum": 0},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "rating": {"enum": ["unknown", "poor", "limited", "adequate", "strong"]}
  }
}
