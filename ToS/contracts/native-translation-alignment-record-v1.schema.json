{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/native-translation-alignment-record-v1.schema.json",
  "title": "Native translation-alignment owner record v1",
  "description": "Immutable native translation-alignment record using the referenced v1 mapping, qualification, side and rights grammars. Alignment has a stable unversioned subject ID. Record versions track its description; Claim versions track qualifications of one correspondence; remapping creates a new Claim. This proposal route preserves legacy review and publication states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "record_id",
    "record_version",
    "predecessor",
    "change_kind",
    "alignment_id",
    "granularity",
    "claim",
    "source_side",
    "target_side",
    "native_bindings",
    "competing_records",
    "rights_and_visibility",
    "status",
    "execution_posture",
    "assessment_posture",
    "publication_authorized",
    "authority_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/native-translation-alignment-record-v1.schema.json"
    },
    "schema_version": {
      "const": "tos_native_translation_alignment_record_v1"
    },
    "record_id": {
      "$ref": "#/$defs/recordId"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "change_kind": {
      "enum": [
        "initial",
        "describe",
        "remap",
        "competing"
      ]
    },
    "alignment_id": {
      "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignmentId"
    },
    "granularity": {
      "$ref": "translation-alignment-packet-v1.schema.json#/properties/granularity"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_version",
        "predecessor",
        "mapping",
        "qualifications"
      ],
      "properties": {
        "claim_id": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/claimId"
        },
        "claim_version": {
          "type": "integer",
          "minimum": 1
        },
        "predecessor": {
          "oneOf": [
            {
              "$ref": "#/$defs/claimRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "mapping": {
          "$ref": "#/$defs/mapping"
        },
        "qualifications": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "translation_techniques",
            "epistemic_status",
            "certainty",
            "status_reason",
            "maker",
            "evidence"
          ],
          "properties": {
            "translation_techniques": {
              "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/translation_techniques"
            },
            "epistemic_status": {
              "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/epistemic_status"
            },
            "certainty": {
              "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/certainty"
            },
            "status_reason": {
              "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/status_reason"
            },
            "maker": {
              "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/maker"
            },
            "evidence": {
              "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/evidence"
            }
          }
        }
      }
    },
    "source_side": {
      "$ref": "translation-alignment-packet-v1.schema.json#/$defs/sourceSide"
    },
    "target_side": {
      "$ref": "translation-alignment-packet-v1.schema.json#/$defs/targetSide"
    },
    "native_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "native-text-unit-binding.schema.json"
          }
        },
        "target": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "native-text-unit-binding.schema.json"
          }
        }
      }
    },
    "competing_records": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/recordRef"
      }
    },
    "rights_and_visibility": {
      "$ref": "translation-alignment-packet-v1.schema.json#/$defs/rightsAndVisibility"
    },
    "status": {
      "const": "proposed"
    },
    "execution_posture": {
      "const": "supplied_mapping_captured_exact_sources_verified_not_aligner_execution"
    },
    "assessment_posture": {
      "const": "unassessed_translation_proposal"
    },
    "publication_authorized": {
      "const": false
    },
    "authority_boundary": {
      "$ref": "translation-alignment-packet-v1.schema.json#/$defs/authorityBoundary"
    }
  },
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^tos\\.translation-alignment-record\\.sid-[a-f0-9]{32}$"
    },
    "recordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "record_id",
        "record_version",
        "sha256"
      ],
      "properties": {
        "record_ref": {
          "$ref": "native-text-unit-binding.schema.json#/$defs/metadataRef"
        },
        "record_id": {
          "$ref": "#/$defs/recordId"
        },
        "record_version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "claimRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_version",
        "sha256"
      ],
      "properties": {
        "claim_id": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/claimId"
        },
        "claim_version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "correspondence_shape",
        "order_posture",
        "ordered_source_anchor_refs",
        "ordered_target_anchor_refs"
      ],
      "properties": {
        "direction": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/direction"
        },
        "correspondence_shape": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/correspondence_shape"
        },
        "order_posture": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/order_posture"
        },
        "ordered_source_anchor_refs": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/ordered_source_anchor_refs"
        },
        "ordered_target_anchor_refs": {
          "$ref": "translation-alignment-packet-v1.schema.json#/$defs/alignment/properties/ordered_target_anchor_refs"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "granularity": {
            "enum": [
              "phrase",
              "token",
              "morpheme",
              "mixed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source_side": {
            "properties": {
              "tokenization": {
                "$ref": "translation-alignment-packet-v1.schema.json#/$defs/frozenAnalysisBinding"
              }
            }
          },
          "target_side": {
            "properties": {
              "tokenization": {
                "$ref": "translation-alignment-packet-v1.schema.json#/$defs/frozenAnalysisBinding"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_kind": {
            "enum": [
              "initial",
              "competing"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "record_version": {
            "const": 1
          },
          "predecessor": {
            "type": "null"
          },
          "claim": {
            "properties": {
              "claim_version": {
                "const": 1
              },
              "predecessor": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_kind": {
            "enum": [
              "describe",
              "remap"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "record_version": {
            "minimum": 2
          },
          "predecessor": {
            "$ref": "#/$defs/recordRef"
          },
          "claim": {
            "properties": {
              "predecessor": {
                "$ref": "#/$defs/claimRef"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_kind": {
            "const": "describe"
          }
        }
      },
      "then": {
        "properties": {
          "claim": {
            "properties": {
              "claim_version": {
                "minimum": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_kind": {
            "const": "remap"
          }
        }
      },
      "then": {
        "properties": {
          "claim": {
            "properties": {
              "claim_version": {
                "const": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_kind": {
            "const": "competing"
          }
        }
      },
      "then": {
        "properties": {
          "competing_records": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
