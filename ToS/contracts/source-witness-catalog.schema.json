{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/source-witness-catalog.schema.json",
  "title": "Tree of Sophia source-witness catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner_repo",
    "source_root",
    "generated_by",
    "record_schema_ref",
    "claim_schema_ref",
    "record_files",
    "claim_file",
    "counts",
    "catalog_sha256",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "tos_source_witness_catalog_v3"},
    "owner_repo": {"const": "Tree-of-Sophia"},
    "source_root": {"const": "ToS/source-witnesses"},
    "generated_by": {"const": "scripts/build_source_witness_catalog.py"},
    "record_schema_ref": {"const": "ToS/contracts/corpus-record.schema.json"},
    "claim_schema_ref": {"const": "ToS/contracts/claim-packet.schema.json"},
    "extension_schema_refs": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ToS/contracts/[a-z][a-z0-9-]*\\.schema\\.json$"}},
    "record_files": {
      "type": "object",
      "description": "Extra families must match the source-owned profile's catalog filename; schema validation alone does not prove that binding.",
      "additionalProperties": {"type": "string", "pattern": "^ToS/source-witnesses/catalog/[a-z][a-z0-9-]*\\.jsonl$"},
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "required": ["agent", "place", "organization", "work", "expression", "edition", "collection", "item", "link"],
      "properties": {
        "agent": {"const": "ToS/source-witnesses/catalog/agents.jsonl"},
        "place": {"const": "ToS/source-witnesses/catalog/places.jsonl"},
        "organization": {"const": "ToS/source-witnesses/catalog/organizations.jsonl"},
        "work": {"const": "ToS/source-witnesses/catalog/works.jsonl"},
        "expression": {"const": "ToS/source-witnesses/catalog/expressions.jsonl"},
        "edition": {"const": "ToS/source-witnesses/catalog/editions.jsonl"},
        "collection": {"const": "ToS/source-witnesses/catalog/collections.jsonl"},
        "item": {"const": "ToS/source-witnesses/catalog/items.jsonl"},
        "link": {"const": "ToS/source-witnesses/catalog/links.jsonl"},
        "historical-event": {"const": "ToS/source-witnesses/catalog/historical-events.jsonl"},
        "historical-process": {"const": "ToS/source-witnesses/catalog/historical-processes.jsonl"},
        "historical-state": {"const": "ToS/source-witnesses/catalog/historical-states.jsonl"},
        "artifact": {"const": "ToS/source-witnesses/catalog/artifacts.jsonl"}
      }
    },
    "claim_file": {"const": "ToS/source-witnesses/catalog/claims.jsonl"},
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0},
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "required": [
        "agent",
        "place",
        "organization",
        "work",
        "expression",
        "edition",
        "collection",
        "item",
        "link",
        "object_total",
        "claim",
        "total"
      ],
      "properties": {
        "agent": {"type": "integer", "minimum": 0},
        "place": {"type": "integer", "minimum": 0},
        "organization": {"type": "integer", "minimum": 0},
        "work": {"type": "integer", "minimum": 0},
        "expression": {"type": "integer", "minimum": 0},
        "edition": {"type": "integer", "minimum": 0},
        "collection": {"type": "integer", "minimum": 0},
        "item": {"type": "integer", "minimum": 0},
        "link": {"type": "integer", "minimum": 0},
        "historical-event": {"type": "integer", "minimum": 0},
        "historical-process": {"type": "integer", "minimum": 0},
        "historical-state": {"type": "integer", "minimum": 0},
        "artifact": {"type": "integer", "minimum": 0},
        "object_total": {"type": "integer", "minimum": 1},
        "claim": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1}
      }
    },
    "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority_boundary": {"const": "generated navigation over tracked object and claim records; not bibliographic, textual, rights, review, or semantic authority"}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_id",
        "record_type",
        "preferred_label",
        "identity_status",
        "source_record_ref",
        "record_sha256",
        "links"
      ],
      "properties": {
        "schema_version": {"const": "tos_source_witness_catalog_entry_v1"},
        "source_schema_ref": {"type": "string", "pattern": "^ToS/contracts/[a-z][a-z0-9-]*\\.schema\\.json$"},
        "label_source_pointer": {"const": "/custody/inventory_numbers/0"},
        "record_id": {"type": "string", "minLength": 1},
        "record_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "preferred_label": {"type": "string", "minLength": 1},
        "identity_status": {"enum": ["provisional", "verified", "disputed", "superseded", null]},
        "source_record_ref": {"type": "string", "pattern": "^ToS/source-witnesses/.+\\.json$"},
        "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "links": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "items": {"type": "string", "minLength": 1}}
            ]
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"record_type": {"const": "artifact"}}},
        "then": {
          "required": ["source_schema_ref", "label_source_pointer"],
          "properties": {
            "identity_status": {"type": "null"},
            "record_id": {"pattern": "^tos\\.artifact\\."},
            "source_schema_ref": {"enum": ["ToS/contracts/artifact-source-witness.schema.json", "ToS/contracts/artifact-source-witness-v2.schema.json"]}
          }
        },
        "else": {
          "properties": {"identity_status": {"type": "string"}},
          "not": {"required": ["label_source_pointer"]}
        }
      }, {
        "if": {"properties": {"record_type": {"not": {"enum": ["agent", "place", "organization", "work", "expression", "edition", "collection", "item", "link"]}}}},
        "then": {"required": ["source_schema_ref"]}
      }]
    },
    "claim_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "claim_id",
        "claim_type",
        "assertion_layer",
        "subject_ref",
        "predicate",
        "object",
        "evidence_refs",
        "maker",
        "provenance_event_ref",
        "epistemic_status",
        "review_status",
        "review_refs",
        "visibility",
        "claim_version",
        "source_claim_file_ref",
        "source_claim_line",
        "claim_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_source_witness_claim_catalog_entry_v1"
        },
        "source_schema_ref": {"const": "ToS/contracts/historical-claim.schema.json"},
        "claim_id": {"$ref": "#/$defs/tosId"},
        "claim_type": {
          "enum": [
            "bibliographic",
            "textual",
            "linguistic",
            "translation",
            "semantic",
            "relation",
            "rights",
            "lived_witness",
            "canon"
          ]
        },
        "assertion_layer": {
          "enum": [
            "forensic_observation",
            "bibliographic_assertion",
            "textual_observation",
            "linguistic_analysis",
            "translation_alignment",
            "translation_judgment",
            "semantic_interpretation",
            "scholarly_report",
            "lived_witness",
            "canon_judgment"
          ]
        },
        "subject_ref": {"$ref": "#/$defs/tosId"},
        "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "object": {
          "oneOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "boolean"},
            {"type": "object", "minProperties": 1},
            {"type": "array", "minItems": 1}
          ]
        },
        "qualifiers": {
          "type": "object",
          "minProperties": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "maker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maker_type", "agent_ref"],
          "properties": {
            "maker_type": {
              "enum": [
                "human",
                "software",
                "model",
                "mixed",
                "imported_source"
              ]
            },
            "agent_ref": {"type": "string", "minLength": 1}
          }
        },
        "provenance_event_ref": {"$ref": "#/$defs/tosId"},
        "epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "reported",
            "interpreted",
            "uncertain",
            "disputed"
          ]
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "accepted",
            "accepted_with_limits",
            "rejected",
            "ambiguous",
            "deferred",
            "superseded"
          ]
        },
        "review_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tosId"}
        },
        "visibility": {
          "enum": [
            "local_only",
            "research_group",
            "permission_requested",
            "public_metadata_only",
            "public"
          ]
        },
        "claim_version": {"type": "integer", "minimum": 1},
        "supersedes_claim_ref": {
          "anyOf": [
            {"$ref": "#/$defs/tosId"},
            {"type": "null"}
          ]
        },
        "source_claim_file_ref": {
          "type": "string",
          "pattern": "^ToS/source-witnesses/.+/(membership|responsibility|publication|provision-activity|work-chronology|work-expression|expression-edition|edition-item|expression-derivation|object-link|historical)-claims\\.jsonl$"
        },
        "source_claim_line": {"type": "integer", "minimum": 1},
        "claim_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "tosId": {
      "type": "string",
      "pattern": "^tos\\.(agent|place|organization|work|expression|edition|collection|item|link|file|passage|region|anchor|occurrence|lexeme|annotation|sign|concept|claim|relation|rights|review|event|historical-event|historical-process|historical-state)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    }
  }
}
