{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/translation-sample-plan.schema.json",
  "title": "Tree of Sophia frozen translation sample plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "translation_sample_plan_id",
    "work_ref",
    "source_expression_ref",
    "source_item_ref",
    "source_file_ref",
    "source_file_sha256",
    "source_language",
    "target_language",
    "status",
    "frozen_at",
    "frozen_before_drafts",
    "fragment_count",
    "selector_method",
    "recognized_comparator",
    "lanes",
    "evaluation_axes",
    "etymology_protocol",
    "fragments",
    "review_status",
    "plan_version"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/translation-sample-plan.schema.json"
    },
    "schema_version": {"const": "tos_translation_sample_plan_v1"},
    "translation_sample_plan_id": {"type": "string", "pattern": "^tos\\.translation-sample-plan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "work_ref": {"$ref": "#/$defs/tosId"},
    "source_expression_ref": {"$ref": "#/$defs/tosId"},
    "source_item_ref": {"$ref": "#/$defs/tosId"},
    "source_file_ref": {"$ref": "#/$defs/tosId"},
    "source_file_sha256": {"$ref": "#/$defs/sha256"},
    "source_language": {"const": "de"},
    "target_language": {"const": "ru"},
    "status": {"enum": ["frozen", "superseded"]},
    "frozen_at": {"type": "string", "format": "date-time"},
    "frozen_before_drafts": {"const": true},
    "fragment_count": {"const": 30},
    "selector_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "segmentation", "selector_status"],
      "properties": {
        "unit": {"const": "first_complete_sentence_in_body-p-1"},
        "segmentation": {"const": "tos-local-sentence-segmentation-v1"},
        "selector_status": {"const": "proposed_until_source_visible_human_acceptance"}
      }
    },
    "recognized_comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression_ref", "item_ref", "visibility", "anchor_resolution_status", "reveal_stage"],
      "properties": {
        "expression_ref": {"$ref": "#/$defs/tosId"},
        "item_ref": {"$ref": "#/$defs/tosId"},
        "visibility": {"const": "sealed"},
        "anchor_resolution_status": {"enum": ["not_started", "in_progress", "complete"]},
        "reveal_stage": {"const": "after_human_ai_and_ai-human_independent_drafts_are_frozen"}
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_only", "ai_only", "ai_human", "recognized_comparator"],
      "properties": {
        "human_only": {"enum": ["not_started", "in_progress", "frozen"]},
        "ai_only": {"enum": ["not_started", "in_progress", "frozen"]},
        "ai_human": {"enum": ["not_started", "in_progress", "frozen"]},
        "recognized_comparator": {"enum": ["sealed", "revealed"]}
      }
    },
    "evaluation_axes": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "etymology_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_required", "allowed_statuses", "prohibition"],
      "properties": {
        "evidence_required": {"const": true},
        "allowed_statuses": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["sourced", "disputed", "unresolved", "not_applicable"]}},
        "prohibition": {"const": "no_model_memory_or_plausibility_may_be_cited_as_etymological_evidence"}
      }
    },
    "fragments": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/fragment"}},
    "review_status": {"enum": ["unreviewed", "partially_reviewed", "human_accepted", "superseded"]},
    "plan_version": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "tosId": {"type": "string", "pattern": "^tos\\.(agent|work|expression|edition|collection|item|file|passage|region|anchor|occurrence|annotation|claim|rights|review|event)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment_id", "source_anchor_ref", "container_member", "member_sha256", "page_member_index", "printed_page", "structural_context", "strata", "analysis_tags", "source_transcription_status", "human_source_acceptance"],
      "properties": {
        "fragment_id": {"type": "string", "pattern": "^tos-translation-fragment-[0-9]{3}$"},
        "source_anchor_ref": {"type": "string", "pattern": "^tos\\.anchor\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "container_member": {"type": "string", "pattern": "^EPUB/page_[0-9]+\\.html$"},
        "member_sha256": {"$ref": "#/$defs/sha256"},
        "page_member_index": {"type": "integer", "minimum": 0},
        "printed_page": {"type": "integer", "minimum": 1},
        "structural_context": {"type": "string", "minLength": 1},
        "strata": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "analysis_tags": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_transcription_status": {"enum": ["not_started", "model_draft", "human_pass_1", "human_double_checked"]},
        "human_source_acceptance": {"const": false}
      }
    }
  }
}
