{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/pwe-source-account-scenario.schema.json",
  "title": "Native positive source-account scenario Record",
  "allOf": [
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/source-metadata-record.schema.json"
    },
    {
      "required": [
        "body"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_pwe_source_account_scenario_v1"
        },
        "record_type": {
          "const": "pwe-source-account-scenario"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interpretation",
            "claim_ref",
            "context_ref",
            "scope_ref",
            "carrier_ref",
            "group_selector"
          ],
          "properties": {
            "interpretation": {
              "const": "positive-source-account-groups-v1"
            },
            "claim_ref": {
              "$ref": "https://tree-of-sophia.local/ToS/contracts/operation-binding-v1.schema.json#/$defs/exactRef"
            },
            "context_ref": {
              "$ref": "https://tree-of-sophia.local/ToS/contracts/pwe-values.schema.json#/$defs/typedRef"
            },
            "scope_ref": {
              "$ref": "https://tree-of-sophia.local/ToS/contracts/pwe-values.schema.json#/$defs/typedRef"
            },
            "carrier_ref": {
              "$ref": "https://tree-of-sophia.local/ToS/contracts/operation-binding-v1.schema.json#/$defs/exactRef"
            },
            "group_selector": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "syntax",
                "pointer"
              ],
              "properties": {
                "syntax": {
                  "const": "json-pointer"
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^/object/assignees/(?:bearers|groups/(?:0|[1-9][0-9]*))$"
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$comment": "A separately authored actual Record must be registered, selected and source-admitted. Its ID is never derived from an unnamed group. Source group conjunction yields only scoped positive source-account witnesses. No negative atom from silence, historical transfer, all-author set, exactly-one alternative or universal coverage is asserted."
}
