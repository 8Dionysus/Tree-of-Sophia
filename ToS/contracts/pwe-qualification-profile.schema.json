{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/pwe-qualification-profile.schema.json",
  "title": "PWE selected native pwe-qualification-profile",
  "allOf": [
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/source-metadata-record.schema.json"
    },
    {
      "required": [
        "body"
      ],
      "properties": {
        "record_type": {
          "const": "pwe-qualification-profile"
        },
        "schema_version": {
          "const": "tos_pwe_qualification_profile_v1"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signature_ref",
            "predicate_ref",
            "modality"
          ],
          "properties": {
            "signature_ref": {
              "$ref": "https://tree-of-sophia.local/ToS/contracts/pwe-values.schema.json#/$defs/typedRef"
            },
            "predicate_ref": {
              "$ref": "https://tree-of-sophia.local/ToS/contracts/pwe-values.schema.json#/$defs/typedRef"
            },
            "modality": {
              "enum": [
                "source-reported",
                "historical-hypothesis",
                "textual-role",
                "metadata-description"
              ]
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$comment": "Candidate native source route. Authored instances, exact pins, current protected assessment and registration are separate inputs. A declaration issues neither source truth nor admission nor coverage."
}
