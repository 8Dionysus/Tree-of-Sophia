{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/thought-description-record.schema.json",
  "title": "Source-described thesis, argument, inference step or objection",
  "description": "A substantive, correctable account of a thought object with its own continuity criterion. Premise and conclusion are contextual roles within a specified step. Partial reconstructions retain their coverage, assertion force and historical attribution.",
  "allOf": [
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/source-metadata-record.schema.json"
    },
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/semantic-description-record.schema.json#/$defs/semanticDescriptionFields"
    },
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/semantic-description-record.schema.json#/$defs/semanticContentFields"
    },
    {
      "properties": {
        "schema_version": {
          "const": "tos_thought_description_record_v1"
        },
        "record_type": {
          "enum": [
            "thesis",
            "argument",
            "inference-step",
            "objection"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "thesis"
          }
        }
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^tos\\.thesis\\."
          },
          "supersedes_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^tos\\.thesis\\."
          },
          "semantic_content": {
            "required": [
              "proposition",
              "assertion_force"
            ],
            "properties": {
              "proposition": {
                "type": "string",
                "pattern": "\\S",
                "description": "The proposition as formulated in this account, including its substantive conditions and negation. Its assertion force and assessment state remain explicit."
              },
              "assertion_force": {
                "type": "string",
                "pattern": "\\S",
                "description": "The account’s declared assertion force, such as hypothetical, asserted or denied. Truth assessment and review status have separate fields."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "argument"
          }
        }
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^tos\\.argument\\."
          },
          "supersedes_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^tos\\.argument\\."
          },
          "semantic_content": {
            "required": [
              "reconstruction_note",
              "coverage"
            ],
            "properties": {
              "reconstruction_note": {
                "type": "string",
                "pattern": "\\S",
                "description": "What reasoning this account reconstructs and what remains unresolved. Steps and supported theses are separate grounded claims."
              },
              "coverage": {
                "enum": [
                  "partial",
                  "claimed_complete",
                  "unknown"
                ],
                "description": "The declared coverage of the identified argument, with completeness, validity and soundness evaluated through source-visible assessment."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "inference-step"
          }
        }
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^tos\\.inference-step\\."
          },
          "supersedes_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^tos\\.inference-step\\."
          },
          "semantic_content": {
            "required": [
              "transition_account",
              "reasoning_mode"
            ],
            "properties": {
              "transition_account": {
                "type": "string",
                "pattern": "\\S",
                "description": "The proposed inferential transition and its limits; premises and conclusions have separate contextual role claims."
              },
              "reasoning_mode": {
                "type": "string",
                "pattern": "\\S",
                "description": "The source-declared reasoning mode, such as reductio or analogy, within the described inferential transition."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "objection"
          }
        }
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^tos\\.objection\\."
          },
          "supersedes_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^tos\\.objection\\."
          },
          "semantic_content": {
            "required": [
              "challenge_account"
            ],
            "properties": {
              "challenge_account": {
                "type": "string",
                "pattern": "\\S",
                "description": "What is challenged and why. Exact target Claims identify the challenged thesis, inference step, argument or conception; assessment evaluates the objection’s force."
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
