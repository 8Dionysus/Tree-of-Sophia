{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/provenance-event-v2.schema.json",
  "title": "Tree of Sophia immutable provenance execution event v2",
  "description": "Additive, digest-bound execution provenance for materialized transformations. It does not replace legacy tos_provenance_event_v1 records and does not make an unsigned or mechanically valid receipt true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "event_id",
    "event_version",
    "supersedes_event_ref",
    "record_binding",
    "activity",
    "entities",
    "derivations",
    "responsibility",
    "method",
    "manual_changes",
    "measurements",
    "evidence_authentication",
    "rights_and_visibility",
    "review_and_authority",
    "reproducibility",
    "authority_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/provenance-event-v2.schema.json"
    },
    "schema_version": {"const": "tos_provenance_event_v2"},
    "event_id": {"$ref": "#/$defs/eventId"},
    "event_version": {"type": "integer", "minimum": 1},
    "supersedes_event_ref": {
      "anyOf": [
        {"$ref": "#/$defs/eventId"},
        {"type": "null"}
      ]
    },
    "record_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_ref", "digest_algorithm", "digest_scope"],
      "properties": {
        "manifest_ref": {"$ref": "#/$defs/repoRelativePath"},
        "digest_algorithm": {"const": "sha256"},
        "digest_scope": {"const": "exact_event_record_bytes"}
      }
    },
    "activity": {"$ref": "#/$defs/activity"},
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "byproducts"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/entityBinding"}
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/entityBinding"}
        },
        "byproducts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/entityBinding"}
        }
      }
    },
    "derivations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/derivation"}
    },
    "responsibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/responsibility"}
    },
    "method": {"$ref": "#/$defs/method"},
    "manual_changes": {"$ref": "#/$defs/manualChanges"},
    "measurements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "evidence_authentication": {"$ref": "#/$defs/evidenceAuthentication"},
    "rights_and_visibility": {"$ref": "#/$defs/rightsVisibility"},
    "review_and_authority": {"$ref": "#/$defs/reviewAuthority"},
    "reproducibility": {"$ref": "#/$defs/reproducibility"},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_role", "claims_not_established"],
      "properties": {
        "validator_role": {
          "const": "mechanics_and_closure_only_not_truth"
        },
        "claims_not_established": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 7,
          "items": {
            "enum": [
              "execution_truth",
              "content_truth",
              "source_fidelity",
              "translation_quality",
              "semantic_correctness",
              "rights_clearance",
              "human_review",
              "publication_authority",
              "canon_authority"
            ]
          },
          "allOf": [
            {"contains": {"const": "execution_truth"}},
            {"contains": {"const": "content_truth"}},
            {"contains": {"const": "source_fidelity"}},
            {"contains": {"const": "translation_quality"}},
            {"contains": {"const": "semantic_correctness"}},
            {"contains": {"const": "rights_clearance"}},
            {"contains": {"const": "human_review"}},
            {"contains": {"const": "publication_authority"}}
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"event_version": {"const": 1}}},
      "then": {"properties": {"supersedes_event_ref": {"type": "null"}}},
      "else": {
        "properties": {
          "supersedes_event_ref": {"$ref": "#/$defs/eventId"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity": {
            "properties": {
              "status": {"enum": ["completed", "completed_with_warnings"]}
            }
          }
        }
      },
      "then": {
        "properties": {
          "entities": {
            "properties": {
              "outputs": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity": {
            "properties": {
              "status": {"enum": ["failed", "stopped"]}
            }
          }
        }
      },
      "then": {
        "properties": {
          "entities": {
            "properties": {
              "outputs": {"maxItems": 0}
            }
          },
          "activity": {
            "properties": {
              "terminal_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity": {
            "properties": {
              "event_type": {"enum": ["model_inference", "agent_decision"]}
            }
          }
        }
      },
      "then": {
        "properties": {
          "method": {
            "properties": {
              "model_invocations": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manual_changes": {
            "properties": {"status": {"const": "recorded"}}
          }
        }
      },
      "then": {
        "properties": {
          "manual_changes": {
            "properties": {"change_receipts": {"minItems": 1}}
          }
        }
      },
      "else": {
        "properties": {
          "manual_changes": {
            "properties": {"change_receipts": {"maxItems": 0}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rights_and_visibility": {
            "properties": {"publication_authorized": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "rights_and_visibility": {
            "properties": {
              "rights_record_bindings": {"minItems": 1},
              "publication_authority_bindings": {"minItems": 1},
              "content_visibility": {"enum": ["public_content", "public_synthetic"]}
            }
          }
        }
      },
      "else": {
        "properties": {
          "rights_and_visibility": {
            "properties": {
              "publication_authority_bindings": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_and_authority": {
            "properties": {"human_review_status": {"const": "performed"}}
          }
        }
      },
      "then": {
        "properties": {
          "review_and_authority": {
            "properties": {"review_bindings": {"minItems": 1}}
          },
          "responsibility": {
            "contains": {
              "type": "object",
              "properties": {
                "agent_kind": {"const": "human"},
                "role": {"const": "reviewer"},
                "human_evidence_status": {"const": "attested"}
              },
              "required": ["agent_kind", "role", "human_evidence_status"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "review_and_authority": {
            "properties": {
              "accepted_uses": {"maxItems": 0},
              "promotion_authorized": {"const": false},
              "review_bindings": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_authentication": {
            "properties": {"signature_status": {"const": "signed_verified"}}
          }
        }
      },
      "then": {
        "properties": {
          "evidence_authentication": {
            "properties": {
              "signature_bindings": {"minItems": 1},
              "verification_status": {"const": "signature_verified"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "eventId": {
      "type": "string",
      "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/repoRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "started_at",
        "ended_at",
        "status",
        "terminal_reason",
        "exit_code",
        "warnings"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "acquisition",
            "fixity_verification",
            "forensic_inspection",
            "render",
            "native_extraction",
            "ocr",
            "correction",
            "normalization",
            "segmentation",
            "alignment",
            "translation",
            "annotation",
            "indexing",
            "retrieval",
            "graph_projection",
            "model_inference",
            "agent_decision",
            "human_review",
            "export",
            "migration",
            "identity_copy",
            "synthetic_negative_control"
          ]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "status": {
          "enum": [
            "completed",
            "completed_with_warnings",
            "failed",
            "stopped",
            "superseded"
          ]
        },
        "terminal_reason": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "exit_code": {
          "anyOf": [
            {"type": "integer"},
            {"type": "null"}
          ]
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "entityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_ref",
        "role",
        "sha256",
        "size_bytes",
        "media_type",
        "availability",
        "content_disclosure",
        "fixity_verified",
        "fixity_verified_at"
      ],
      "properties": {
        "entity_ref": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "availability": {
          "enum": [
            "tracked",
            "ignored_local",
            "owner_local",
            "external",
            "withheld",
            "ephemeral"
          ]
        },
        "content_disclosure": {
          "enum": [
            "public_content",
            "public_metadata_only",
            "private_content",
            "withheld_digest_only",
            "synthetic_public"
          ]
        },
        "fixity_verified": {"type": "boolean"},
        "fixity_verified_at": {
          "anyOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation_id",
        "input_entity_ref",
        "output_entity_ref",
        "relation",
        "influence_asserted",
        "description"
      ],
      "properties": {
        "derivation_id": {
          "type": "string",
          "pattern": "^tos\\.derivation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "input_entity_ref": {"type": "string", "minLength": 1},
        "output_entity_ref": {"type": "string", "minLength": 1},
        "relation": {
          "enum": [
            "was_derived_from",
            "revision_of",
            "quotation_of",
            "selection_from",
            "aggregation_from",
            "identity_copy_of"
          ]
        },
        "influence_asserted": {"const": true},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_ref",
        "agent_kind",
        "role",
        "responsibility_posture",
        "evidence_binding",
        "human_evidence_status"
      ],
      "properties": {
        "agent_ref": {"type": "string", "minLength": 1},
        "agent_kind": {
          "enum": ["human", "software", "model", "service", "organization", "mixed"]
        },
        "role": {
          "enum": [
            "operator",
            "executor",
            "authorizer",
            "reviewer",
            "observer",
            "software_instrument",
            "model_instrument"
          ]
        },
        "responsibility_posture": {
          "enum": ["performed", "authorized", "reviewed", "observed", "instrumental"]
        },
        "evidence_binding": {
          "anyOf": [
            {"$ref": "#/$defs/binding"},
            {"type": "null"}
          ]
        },
        "human_evidence_status": {
          "enum": ["attested", "unattested", "not_applicable"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"agent_kind": {"const": "human"}}},
          "then": {
            "properties": {
              "human_evidence_status": {"enum": ["attested", "unattested"]}
            }
          },
          "else": {
            "properties": {"human_evidence_status": {"const": "not_applicable"}}
          }
        }
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure",
        "command_capture",
        "configuration_binding",
        "software_components",
        "model_invocations",
        "environment"
      ],
      "properties": {
        "procedure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "purpose"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "purpose": {"type": "string", "minLength": 1}
          }
        },
        "command_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disclosure", "argv", "argv_sha256", "withholding_reason"],
          "properties": {
            "disclosure": {"enum": ["inline", "withheld_digest_only"]},
            "argv": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string"}
                },
                {"type": "null"}
              ]
            },
            "argv_sha256": {"$ref": "#/$defs/sha256"},
            "withholding_reason": {
              "anyOf": [
                {"type": "string", "minLength": 1},
                {"type": "null"}
              ]
            }
          },
          "allOf": [
            {
              "if": {"properties": {"disclosure": {"const": "inline"}}},
              "then": {
                "properties": {
                  "argv": {"type": "array", "minItems": 1},
                  "withholding_reason": {"type": "null"}
                }
              },
              "else": {
                "properties": {
                  "argv": {"type": "null"},
                  "withholding_reason": {"type": "string", "minLength": 1}
                }
              }
            }
          ]
        },
        "configuration_binding": {"$ref": "#/$defs/binding"},
        "software_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "role",
              "artifact_ref",
              "artifact_sha256",
              "verification_status"
            ],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "artifact_ref": {"type": "string", "minLength": 1},
              "artifact_sha256": {"$ref": "#/$defs/sha256"},
              "verification_status": {"enum": ["verified", "declared_only", "unavailable"]}
            }
          }
        },
        "model_invocations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/modelInvocation"}
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "runtime_version",
            "runtime_artifact_sha256",
            "backend",
            "hardware_target",
            "unicode_version",
            "environment_profile_binding"
          ],
          "properties": {
            "runtime": {"type": "string", "minLength": 1},
            "runtime_version": {"type": "string", "minLength": 1},
            "runtime_artifact_sha256": {"$ref": "#/$defs/sha256"},
            "backend": {"type": "string", "minLength": 1},
            "hardware_target": {"type": "string", "minLength": 1},
            "unicode_version": {"type": "string", "minLength": 1},
            "environment_profile_binding": {"$ref": "#/$defs/binding"}
          }
        }
      }
    },
    "modelInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "provider",
        "model_id",
        "revision",
        "weights_sha256",
        "quantization",
        "quantizer_or_converter",
        "prompt_capture",
        "seed",
        "decoding_configuration_binding",
        "input_sha256",
        "output_sha256",
        "response_status"
      ],
      "properties": {
        "invocation_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "weights_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "quantization": {"type": "string", "minLength": 1},
        "quantizer_or_converter": {"type": "string", "minLength": 1},
        "prompt_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disclosure", "text", "sha256", "withholding_reason"],
          "properties": {
            "disclosure": {"enum": ["inline", "withheld_digest_only"]},
            "text": {
              "anyOf": [
                {"type": "string"},
                {"type": "null"}
              ]
            },
            "sha256": {"$ref": "#/$defs/sha256"},
            "withholding_reason": {
              "anyOf": [
                {"type": "string", "minLength": 1},
                {"type": "null"}
              ]
            }
          }
        },
        "seed": {
          "anyOf": [
            {"type": "integer"},
            {"type": "null"}
          ]
        },
        "decoding_configuration_binding": {"$ref": "#/$defs/binding"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "response_status": {"enum": ["completed", "failed", "stopped", "no_output"]}
      }
    },
    "manualChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "change_receipts", "statement"],
      "properties": {
        "status": {"enum": ["none_declared", "recorded", "unknown"]},
        "change_receipts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["change_id", "actor_ref", "binding", "review_status"],
            "properties": {
              "change_id": {"type": "string", "minLength": 1},
              "actor_ref": {"type": "string", "minLength": 1},
              "binding": {"$ref": "#/$defs/binding"},
              "review_status": {"enum": ["unreviewed", "reviewed", "rejected", "superseded"]}
            }
          }
        },
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "status", "value", "unit", "method", "evidence_binding"],
      "properties": {
        "metric": {
          "enum": [
            "wall_duration_ms",
            "cpu_time_ms",
            "peak_memory_bytes",
            "peak_swap_bytes",
            "energy_joules",
            "input_bytes",
            "output_bytes",
            "human_active_seconds",
            "custom"
          ]
        },
        "status": {"enum": ["measured", "not_measured", "unavailable", "not_applicable"]},
        "value": {
          "anyOf": [
            {"type": "number"},
            {"type": "null"}
          ]
        },
        "unit": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "method": {"type": "string", "minLength": 1},
        "evidence_binding": {
          "anyOf": [
            {"$ref": "#/$defs/binding"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "measured"}}},
          "then": {
            "properties": {
              "value": {"type": "number"},
              "unit": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "value": {"type": "null"},
              "unit": {"type": "null"}
            }
          }
        }
      ]
    },
    "evidenceAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_posture",
        "signature_status",
        "signature_bindings",
        "verification_status",
        "producer_control_boundary"
      ],
      "properties": {
        "capture_posture": {
          "enum": ["self_declared", "tool_captured", "owner_captured", "signed_attestation"]
        },
        "signature_status": {
          "enum": ["unsigned", "signed_unverified", "signed_verified", "verification_failed"]
        },
        "signature_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/binding"}
        },
        "verification_status": {
          "enum": ["unverified", "mechanically_verified", "signature_verified", "verification_failed"]
        },
        "producer_control_boundary": {"type": "string", "minLength": 1}
      }
    },
    "rightsVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_record_bindings",
        "intended_uses",
        "content_visibility",
        "publication_authorized",
        "publication_authority_bindings"
      ],
      "properties": {
        "rights_record_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/binding"}
        },
        "intended_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "synthetic_contract_test",
              "local_research",
              "preservation",
              "indexing",
              "retrieval",
              "annotation",
              "translation_experiment",
              "public_metadata",
              "publication"
            ]
          }
        },
        "content_visibility": {
          "enum": ["public_content", "public_synthetic", "tracked_public_metadata", "local_only", "withheld"]
