{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/scholarly-composite-claim.schema.json",
  "title": "Source-attributed scholarly composition relation",
  "allOf": [
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/source-claim-record.schema.json"
    },
    {
      "required": [
        "qualifiers"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_scholarly_composite_claim_v1"
        },
        "claim_type": {
          "const": "relation"
        },
        "object": {
          "type": "string",
          "pattern": "^tos\\.[a-z][a-z0-9-]*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "qualifiers": {
          "type": "object",
          "required": [
            "statement",
            "statement_language",
            "statement_script",
            "scope_note"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "pattern": "\\S"
            },
            "statement_language": {
              "anyOf": [
                {
                  "$ref": "https://tree-of-sophia.local/ToS/contracts/corpus-record.schema.json#/$defs/languageTagOrUnd"
                },
                {
                  "type": "null"
                }
              ]
            },
            "statement_script": {
              "$ref": "https://tree-of-sophia.local/ToS/contracts/corpus-record.schema.json#/$defs/scriptTagOrNull"
            },
            "scope_note": {
              "type": "string",
              "pattern": "\\S",
              "description": "The attributed editorial, reconstruction or containment scope and its limits. This Claim does not establish an ancient original, exact textual equality, exhaustive membership, authenticity or admission."
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
