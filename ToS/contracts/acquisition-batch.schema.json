{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/acquisition-batch.schema.json",
  "title": "Tree of Sophia bounded source acquisition batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "batch_id",
    "batch_revision",
    "prepared_at",
    "base_revision",
    "selection",
    "provenance_delta"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/acquisition-batch.schema.json"
    },
    "schema_version": {"const": "tos_acquisition_batch_v1"},
    "batch_id": {
      "type": "string",
      "pattern": "^tos\\.acquisition-batch\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "batch_revision": {"type": "integer", "minimum": 1},
    "prepared_at": {"type": "string", "format": "date-time"},
    "base_revision": {"$ref": "#/$defs/sha256"},
    "selection": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/selection"}
    },
    "provenance_delta": {"$ref": "#/$defs/provenanceDelta"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tosId": {
      "type": "string",
      "pattern": "^tos\\.(agent|work|expression|edition|collection|item|file|passage|region|anchor|occurrence|annotation|claim|rights|review|event)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "tosItemId": {
      "type": "string",
      "pattern": "^tos\\.item\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "repoRef": {
      "type": "string",
      "pattern": "^ToS/[A-Za-z0-9._/-]+$"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "source_id", "source_url"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_url": {"$ref": "#/$defs/sourceUrl"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "kind"],
      "properties": {
        "ref": {"$ref": "#/$defs/repoRef"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "kind": {
          "enum": [
            "work",
            "expression",
            "edition",
            "item",
            "rights",
            "provenance",
            "claim",
            "discovery",
            "manifest"
          ]
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "posture"],
      "properties": {
        "ref": {"$ref": "#/$defs/repoRef"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "posture": {
          "enum": [
            "local_only",
            "controlled_research",
            "metadata_only",
            "public_payload"
          ]
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ref",
        "file_ref",
        "item_root_ref",
        "relative_path",
        "byte_size",
        "sha256",
        "provider_url",
        "provider_revision",
        "provider_source_id",
        "media_type"
      ],
      "properties": {
        "item_ref": {"$ref": "#/$defs/tosItemId"},
        "file_ref": {"$ref": "#/$defs/tosId"},
        "item_root_ref": {"$ref": "#/$defs/repoRef"},
        "relative_path": {
          "type": "string",
          "pattern": "^payload/(?!\\.\\.?$)[A-Za-z0-9._-]+$"
        },
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "git_blob_sha1": {"$ref": "#/$defs/sha1"},
        "provider_url": {"$ref": "#/$defs/sourceUrl"},
        "provider_revision": {"type": "string", "minLength": 1},
        "provider_source_id": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ref",
        "item_root_ref",
        "provider",
        "records",
        "rights",
        "payload_files"
      ],
      "properties": {
        "item_ref": {"$ref": "#/$defs/tosItemId"},
        "item_root_ref": {"$ref": "#/$defs/repoRef"},
        "provider": {"$ref": "#/$defs/provider"},
        "records": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/record"}
        },
        "rights": {"$ref": "#/$defs/rights"},
        "payload_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/payload"}
        }
      }
    },
    "provenanceDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ref",
        "event_version",
        "change_kind",
        "base_revision",
        "record_refs",
        "payload_file_refs"
      ],
      "properties": {
        "event_ref": {
          "type": "string",
          "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "event_version": {"type": "integer", "minimum": 1},
        "change_kind": {"const": "batch_delta"},
        "base_revision": {"$ref": "#/$defs/sha256"},
        "record_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repoRef"}
        },
        "payload_file_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tosId"}
        },
        "supersedes_event_ref": {
          "type": ["string", "null"],
          "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    }
  }
}
