{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/lexical-recurrence-plan.schema.json",
  "title": "Tree of Sophia exact-form recurrence observation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "plan_id",
    "work_ref",
    "status",
    "frozen_at",
    "frozen_before_output",
    "research_question",
    "research_ref",
    "source_projection",
    "observation_unit",
    "segmentation",
    "method_views",
    "calculation_law",
    "output",
    "content_exposure",
    "semantic_boundary",
    "provenance_event_ref",
    "plan_version",
    "authority_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/lexical-recurrence-plan.schema.json"
    },
    "schema_version": {"const": "tos_lexical_recurrence_plan_v1"},
    "plan_id": {
      "type": "string",
      "pattern": "^lexical-recurrence-plan:[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "work_ref": {"$ref": "#/$defs/workId"},
    "status": {"const": "frozen-before-output"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "frozen_before_output": {"const": true},
    "research_question": {"type": "string", "minLength": 1},
    "research_ref": {"$ref": "#/$defs/repoRelativePath"},
    "source_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "schema_version",
        "source_item_count",
        "exact_form_row_count",
        "token_occurrence_count"
      ],
      "properties": {
        "ref": {"$ref": "#/$defs/repoRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "tos_lexical_index_projection_v1"},
        "source_item_count": {"const": 4},
        "exact_form_row_count": {"const": 11352},
        "token_occurrence_count": {"const": 86287}
      }
    },
    "observation_unit": {"const": "one-row-per-exact-form-hash"},
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "section", "page", "cross_item_labels_collapsed"],
      "properties": {
        "part": {"const": "one-source-item-per-published-part"},
        "section": {"const": "tracked-tei-division-resource-within-source-item"},
        "page": {"const": "tracked-tei-page-break-resource-within-source-item"},
        "cross_item_labels_collapsed": {"const": false}
      }
    },
    "method_views": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/frequencyView"},
        {"$ref": "#/$defs/rangeView"},
        {"$ref": "#/$defs/tupleView"}
      ],
      "items": false
    },
    "calculation_law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dp_formula",
        "part_total_unit",
        "scale",
        "rounding",
        "missing_part_observed_share",
        "composite_score_created"
      ],
      "properties": {
        "dp_formula": {
          "const": "0.5 * sum(abs(part_token_share - form_occurrence_share))"
        },
        "part_total_unit": {"const": "exact-token-occurrences"},
        "scale": {"const": 1000000},
        "rounding": {"const": "nearest-integer-ties-to-even"},
        "missing_part_observed_share": {"const": 0},
        "composite_score_created": {"const": false}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "schema_ref", "provenance_ref", "row_order", "recorded_at"],
      "properties": {
        "ref": {"$ref": "#/$defs/repoRelativePath"},
        "schema_ref": {"$ref": "#/$defs/repoRelativePath"},
        "provenance_ref": {"$ref": "#/$defs/repoRelativePath"},
        "row_order": {"const": "exact-form-sha256-ascending"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "content_exposure": {"$ref": "#/$defs/contentExposure"},
    "semantic_boundary": {"$ref": "#/$defs/semanticBoundary"},
    "provenance_event_ref": {"$ref": "#/$defs/eventId"},
    "plan_version": {"const": 1},
    "authority_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "frequencyView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "method", "fields", "semantic_sufficiency"],
      "properties": {
        "label": {"const": "A"},
        "method": {"const": "absolute-frequency"},
        "fields": {"const": ["occurrence_count"]},
        "semantic_sufficiency": {"const": false}
      }
    },
    "rangeView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "method", "fields", "semantic_sufficiency"],
      "properties": {
        "label": {"const": "B"},
        "method": {"const": "structural-range"},
        "fields": {"const": ["part_range", "section_range", "page_range"]},
        "semantic_sufficiency": {"const": false}
      }
    },
    "tupleView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "method",
        "fields",
        "single_score",
        "semantic_sufficiency"
      ],
      "properties": {
        "label": {"const": "C"},
        "method": {"const": "tupleized-part-size-aware-dispersion"},
        "fields": {
          "const": [
            "occurrence_count",
            "part_range",
            "section_range",
            "page_range",
            "part_dp_millionths",
            "maximum_part_share_millionths",
            "source_editorial_occurrence_count",
            "unsectioned_occurrence_count"
          ]
        },
        "single_score": {"const": false},
        "semantic_sufficiency": {"const": false}
      }
    },
    "contentExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked_exact_strings",
        "tracked_sequence",
        "tracked_context",
        "tracked_occurrence_positions",
        "tracked_form_hashes",
        "dictionary_recovery_possible",
        "confidentiality_claimed"
      ],
      "properties": {
        "tracked_exact_strings": {"const": false},
        "tracked_sequence": {"const": false},
        "tracked_context": {"const": false},
        "tracked_occurrence_positions": {"const": false},
        "tracked_form_hashes": {"const": true},
        "dictionary_recovery_possible": {"const": true},
        "confidentiality_claimed": {"const": false}
      }
    },
    "semanticBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepts_source_text",
        "creates_occurrence_authority",
        "creates_morphology",
        "creates_lemma",
        "creates_lexeme",
        "creates_sign_candidate",
        "creates_sign",
        "creates_concept",
        "opens_initial_sign_packet",
        "opens_human_backlog"
      ],
      "properties": {
        "accepts_source_text": {"const": false},
        "creates_occurrence_authority": {"const": false},
        "creates_morphology": {"const": false},
        "creates_lemma": {"const": false},
        "creates_lexeme": {"const": false},
        "creates_sign_candidate": {"const": false},
        "creates_sign": {"const": false},
        "creates_concept": {"const": false},
        "opens_initial_sign_packet": {"const": false},
        "opens_human_backlog": {"const": false}
      }
    },
    "workId": {
      "type": "string",
      "pattern": "^tos\\.work\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    }
  }
}
