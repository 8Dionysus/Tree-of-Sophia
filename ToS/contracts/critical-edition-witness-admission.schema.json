{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/critical-edition-witness-admission.schema.json",
  "title": "Tree of Sophia critical-edition witness admission packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "packet_id",
    "status",
    "work_ref",
    "reference_register",
    "source_review_plan",
    "assisted_review_plan_ref",
    "reference_identity",
    "target",
    "locator_evidence",
    "local_structural_context",
    "rights_gate",
    "content_boundary",
    "provenance",
    "gate_effects",
    "authority_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/critical-edition-witness-admission.schema.json"
    },
    "schema_version": {
      "const": "tos_critical_edition_witness_admission_v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^tos\\.critical-edition-witness\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "metadata_registered_rights_review_pending",
        "citation_witness_admitted",
        "superseded"
      ]
    },
    "work_ref": {
      "type": "string",
      "pattern": "^tos\\.work\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "reference_register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "reference_id"],
      "properties": {
        "ref": {"$ref": "#/$defs/repoRef"},
        "reference_id": {
          "type": "string",
          "pattern": "^tos-ref\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    },
    "source_review_plan": {"$ref": "#/$defs/digestBoundRef"},
    "assisted_review_plan_ref": {"$ref": "#/$defs/repoRef"},
    "reference_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "edition_siglum",
        "author",
        "editors",
        "digital_editor",
        "publisher",
        "scholarly_posture"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "edition_siglum": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "editors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "digital_editor": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "scholarly_posture": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_unit_id",
        "context_anchor_ref",
        "structural_context",
        "critical_locator_siglum",
        "critical_locator_url",
        "alignment_state"
      ],
      "properties": {
        "review_unit_id": {
          "type": "string",
          "pattern": "^tos-translation-source-review-v2-[0-9]{3}$"
        },
        "context_anchor_ref": {
          "type": "string",
          "pattern": "^tos\\.anchor\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "structural_context": {"type": "string", "minLength": 1},
        "critical_locator_siglum": {"type": "string", "minLength": 1},
        "critical_locator_url": {"type": "string", "format": "uri"},
        "alignment_state": {
          "const": "local_structure_compatible_exact_critical_passage_unverified"
        }
      }
    },
    "locator_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_at",
        "stable_url_policy_ref",
        "exact_locator_corroboration_refs",
        "direct_fetch_state",
        "direct_fetch_note"
      ],
      "properties": {
        "checked_at": {"type": "string", "format": "date-time"},
        "stable_url_policy_ref": {"type": "string", "format": "uri"},
        "exact_locator_corroboration_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "direct_fetch_state": {
          "enum": ["confirmed", "temporarily_unavailable", "not_attempted"]
        },
        "direct_fetch_note": {"type": "string", "minLength": 1}
      }
    },
    "local_structural_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "checked_at",
        "maker",
        "source_expression_ref",
        "epub_witness",
        "visual_witness",
        "comparison",
        "limits"
      ],
      "properties": {
        "state": {
          "const": "local_section_boundary_observed_critical_text_not_compared"
        },
        "checked_at": {"type": "string", "format": "date-time"},
        "maker": {"const": "model:codex"},
        "source_expression_ref": {"$ref": "#/$defs/tosId"},
        "epub_witness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_ref",
            "file_ref",
            "file_sha256",
            "section_start_member",
            "next_section_boundary_member"
          ],
          "properties": {
            "item_ref": {"$ref": "#/$defs/tosId"},
            "file_ref": {"$ref": "#/$defs/tosId"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "section_start_member": {"$ref": "#/$defs/containerMember"},
            "next_section_boundary_member": {"$ref": "#/$defs/containerMember"}
          }
        },
        "visual_witness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_ref",
            "file_ref",
            "file_sha256",
            "section_start_anchor_ref",
            "section_start_pdf_page",
            "next_section_pdf_page",
            "rendered_pages_persisted"
          ],
          "properties": {
            "item_ref": {"$ref": "#/$defs/tosId"},
            "file_ref": {"$ref": "#/$defs/tosId"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "section_start_anchor_ref": {"$ref": "#/$defs/tosId"},
            "section_start_pdf_page": {"type": "integer", "minimum": 1},
            "next_section_pdf_page": {"type": "integer", "minimum": 1},
            "rendered_pages_persisted": {"const": false}
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical_locator_scope",
            "local_correspondence",
            "exact_critical_text_compared",
            "exact_passage_alignment_claimed",
            "german_linguistic_correctness_assessed",
            "human_review_performed",
            "source_unit_selected_for_review"
          ],
          "properties": {
            "critical_locator_scope": {"const": "Zarathustra's Vorrede, section 1"},
            "local_correspondence": {"const": "structure-compatible"},
            "exact_critical_text_compared": {"const": false},
            "exact_passage_alignment_claimed": {"const": false},
            "german_linguistic_correctness_assessed": {"const": false},
            "human_review_performed": {"const": false},
            "source_unit_selected_for_review": {"const": false}
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "rights_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_evidence_ref",
        "declared_license",
        "license_uri",
        "web_consultation_posture",
        "human_bibliographic_review",
        "human_rights_review",
        "citation_witness_admission_authorized",
        "content_storage_authorized",
        "derivative_use_authorized",
        "blocking_reasons"
      ],
      "properties": {
        "rights_evidence_ref": {"type": "string", "format": "uri"},
        "declared_license": {"const": "CC-BY-NC-ND-4.0"},
        "license_uri": {
          "const": "https://creativecommons.org/licenses/by-nc-nd/4.0/"
        },
        "web_consultation_posture": {
          "const": "open_scholarly_consultation_with_exact_citation"
        },
        "human_bibliographic_review": {"type": "boolean"},
        "human_rights_review": {"type": "boolean"},
        "citation_witness_admission_authorized": {"type": "boolean"},
        "content_storage_authorized": {"type": "boolean"},
        "derivative_use_authorized": {"const": false},
        "blocking_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "content_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text_stored",
        "source_text_quoted",
        "source_text_sha256",
        "transformation_performed",
        "local_payload_created"
      ],
      "properties": {
        "source_text_stored": {"const": false},
        "source_text_quoted": {"const": false},
        "source_text_sha256": {"type": "null"},
        "transformation_performed": {"const": false},
        "local_payload_created": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ref",
        "prepared_at",
        "maker",
        "method",
        "observations",
        "inferences"
      ],
      "properties": {
        "event_ref": {
          "type": "string",
          "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "prepared_at": {"type": "string", "format": "date-time"},
        "maker": {"const": "model:codex"},
        "method": {"type": "string", "minLength": 1},
        "observations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "inferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "gate_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_task_created",
        "human_debt_units",
        "source_unit_selected_for_review",
        "accepted_german_unit_created",
        "critical_edition_unit_admitted",
        "translation_lanes_opened",
        "recognized_translation_revealed",
        "promotion_authorized"
      ],
      "properties": {
        "human_task_created": {"const": false},
        "human_debt_units": {"const": 0},
        "source_unit_selected_for_review": {"const": false},
        "accepted_german_unit_created": {"const": false},
        "critical_edition_unit_admitted": {"type": "boolean"},
        "translation_lanes_opened": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["ai_only", "ai_human", "human_only"]}
        },
        "recognized_translation_revealed": {"const": false},
        "promotion_authorized": {"const": false}
      }
    },
    "authority_boundary": {
      "const": "metadata and critical locator only: this packet is not source text, passage alignment, rights clearance, accepted German, translation evidence, semantic evidence, or promotion authority"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tosId": {
      "type": "string",
      "pattern": "^tos\\.(agent|work|expression|edition|collection|item|file|passage|region|anchor|occurrence|annotation|claim|rights|review|event)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "repoRef": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))ToS/[A-Za-z0-9._/-]+$"
    },
    "digestBoundRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/repoRef"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "containerMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^EPUB/page_[0-9]+\\.html$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "metadata_registered_rights_review_pending"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "rights_gate": {
            "properties": {
              "human_bibliographic_review": {"const": false},
              "human_rights_review": {"const": false},
              "citation_witness_admission_authorized": {"const": false},
              "content_storage_authorized": {"const": false}
            }
          },
          "gate_effects": {
            "properties": {
              "critical_edition_unit_admitted": {"const": false},
              "translation_lanes_opened": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "citation_witness_admitted"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "rights_gate": {
            "properties": {
              "human_bibliographic_review": {"const": true},
              "human_rights_review": {"const": true},
              "citation_witness_admission_authorized": {"const": true},
              "content_storage_authorized": {"const": false}
            }
          },
          "gate_effects": {
            "properties": {
              "critical_edition_unit_admitted": {"const": true}
            }
          }
        }
      }
    }
  ]
}
