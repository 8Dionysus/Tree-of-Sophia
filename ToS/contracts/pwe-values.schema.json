{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/pwe-values.schema.json",
  "title": "Native PWE qualified account values",
  "oneOf": [
    {
      "$ref": "#/$defs/nameAssignment"
    },
    {
      "$ref": "#/$defs/responsibilityAccount"
    },
    {
      "$ref": "#/$defs/identityCorrespondence"
    }
  ],
  "$defs": {
    "exactRef": {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/operation-binding-v1.schema.json#/$defs/exactRef"
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "bound"
            },
            "value": {
              "$ref": "#/$defs/typedRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "source_wording",
            "missing_binding"
          ],
          "properties": {
            "state": {
              "const": "unresolved"
            },
            "source_wording": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 16384
            },
            "missing_binding": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 16384
            }
          }
        }
      ]
    },
    "sourceWording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "language",
        "script"
      ],
      "properties": {
        "text": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[iIxX](?:-[A-Za-z0-9]{1,8})+)$"
        },
        "script": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z]{4}$"
        }
      }
    },
    "assignees": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "bearer"
          ],
          "properties": {
            "mode": {
              "const": "single"
            },
            "bearer": {
              "$ref": "#/$defs/typedRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "bearers"
          ],
          "properties": {
            "mode": {
              "const": "joint"
            },
            "bearers": {
              "type": "array",
              "minItems": 2,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/typedRef"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "groups",
            "exhaustiveness",
            "mutual_exclusivity"
          ],
          "properties": {
            "mode": {
              "const": "alternatives"
            },
            "groups": {
              "type": "array",
              "minItems": 2,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/typedRef"
                }
              }
            },
            "exhaustiveness": {
              "enum": [
                "source-claimed-exhaustive",
                "partial",
                "unknown"
              ]
            },
            "mutual_exclusivity": {
              "enum": [
                "source-claimed-exclusive",
                "not-exclusive",
                "unknown"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "account"
          ],
          "properties": {
            "mode": {
              "const": "unestablished"
            },
            "account": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 16384
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "bearer",
            "identification_account"
          ],
          "properties": {
            "mode": {
              "const": "identified-anonymous"
            },
            "bearer": {
              "$ref": "#/$defs/typedRef"
            },
            "identification_account": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 16384
            }
          }
        }
      ]
    },
    "nameAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_wording",
        "subject",
        "scope",
        "world",
        "members",
        "endpoints",
        "basis",
        "limitations",
        "supersedes_proposition",
        "subject_role",
        "name",
        "name_function",
        "assignment",
        "named_bearer",
        "account",
        "qualification",
        "source_locations"
      ],
      "properties": {
        "kind": {
          "const": "name-assignment"
        },
        "source_wording": {
          "$ref": "#/$defs/sourceWording"
        },
        "subject": {
          "$ref": "#/$defs/typedRef"
        },
        "scope": {
          "$ref": "#/$defs/binding"
        },
        "world": {
          "$ref": "#/$defs/binding"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "input",
              "inspection"
            ],
            "properties": {
              "role": {
                "enum": [
                  "source-record",
                  "source-occurrence",
                  "criterion",
                  "scope",
                  "world",
                  "method",
                  "counterevidence"
                ]
              },
              "input": {
                "$ref": "#/$defs/binding"
              },
              "inspection": {
                "enum": [
                  "source-content-read",
                  "metadata-read",
                  "citation-only",
                  "not-read"
                ]
              }
            }
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "supersedes_proposition": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject_role": {
          "enum": [
            "named-referent",
            "containing-object"
          ]
        },
        "name": {
          "$ref": "#/$defs/sourceWording"
        },
        "name_function": {
          "enum": [
            "source-name",
            "pseudonym",
            "collective-pseudonym",
            "signature",
            "title",
            "transliteration",
            "editorial-label",
            "rejected-normalization"
          ]
        },
        "assignment": {
          "enum": [
            "name-used-by",
            "signature-in"
          ]
        },
        "named_bearer": {
          "$ref": "#/$defs/binding"
        },
        "account": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typedRef"
          }
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "source_locations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/originAddress"
          }
        }
      }
    },
    "responsibilityAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_wording",
        "subject",
        "scope",
        "world",
        "members",
        "endpoints",
        "basis",
        "limitations",
        "supersedes_proposition",
        "role",
        "attribution_mode",
        "assignees",
        "responsibility_scope",
        "role_basis",
        "qualification",
        "source_locations"
      ],
      "properties": {
        "kind": {
          "const": "responsibility-account"
        },
        "source_wording": {
          "$ref": "#/$defs/sourceWording"
        },
        "subject": {
          "$ref": "#/$defs/typedRef"
        },
        "scope": {
          "$ref": "#/$defs/binding"
        },
        "world": {
          "$ref": "#/$defs/binding"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "input",
              "inspection"
            ],
            "properties": {
              "role": {
                "enum": [
                  "source-record",
                  "source-occurrence",
                  "criterion",
                  "scope",
                  "world",
                  "method",
                  "counterevidence"
                ]
              },
              "input": {
                "$ref": "#/$defs/binding"
              },
              "inspection": {
                "enum": [
                  "source-content-read",
                  "metadata-read",
                  "citation-only",
                  "not-read"
                ]
              }
            }
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "supersedes_proposition": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "author",
            "translator",
            "expression-editor",
            "edition-editor",
            "compiler",
            "copyist",
            "speaker",
            "addressee",
            "publisher",
            "rights-holder"
          ]
        },
        "attribution_mode": {
          "enum": [
            "source-attribution",
            "historical-responsibility",
            "literary-authorization",
            "textual-role",
            "modern-compilation"
          ]
        },
        "assignees": {
          "$ref": "#/$defs/assignees"
        },
        "responsibility_scope": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "role_basis": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typedRef"
          }
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "source_locations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/originAddress"
          }
        }
      }
    },
    "identityCorrespondence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_wording",
        "subject",
        "scope",
        "world",
        "members",
        "endpoints",
        "basis",
        "limitations",
        "supersedes_proposition",
        "left",
        "right",
        "identity_level",
        "criterion",
        "asserted_outcome",
        "grounds",
        "counterreading",
        "similarity_method",
        "qualification",
        "source_locations"
      ],
      "properties": {
        "kind": {
          "const": "identity-correspondence"
        },
        "source_wording": {
          "$ref": "#/$defs/sourceWording"
        },
        "subject": {
          "$ref": "#/$defs/typedRef"
        },
        "scope": {
          "$ref": "#/$defs/binding"
        },
        "world": {
          "$ref": "#/$defs/binding"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "input",
              "inspection"
            ],
            "properties": {
              "role": {
                "enum": [
                  "source-record",
                  "source-occurrence",
                  "criterion",
                  "scope",
                  "world",
                  "method",
                  "counterevidence"
                ]
              },
              "input": {
                "$ref": "#/$defs/binding"
              },
              "inspection": {
                "enum": [
                  "source-content-read",
                  "metadata-read",
                  "citation-only",
                  "not-read"
                ]
              }
            }
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "supersedes_proposition": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "left": {
          "$ref": "#/$defs/typedRef"
        },
        "right": {
          "$ref": "#/$defs/typedRef"
        },
        "identity_level": {
          "enum": [
            "historical-person",
            "textual-persona",
            "collective",
            "work",
            "expression",
            "edition",
            "item",
            "artifact",
            "file",
            "textual-fragment",
            "quotation-passage",
            "composite"
          ]
        },
        "criterion": {
          "$ref": "#/$defs/binding"
        },
        "asserted_outcome": {
          "enum": [
            "candidate-match",
            "same-referent",
            "distinct-referents",
            "undetermined"
          ]
        },
        "grounds": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "counterreading": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "similarity_method": {
          "$ref": "#/$defs/binding"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typedRef"
          }
        },
        "qualification": {
          "$ref": "#/$defs/qualification"
        },
        "source_locations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/originAddress"
          }
        }
      }
    },
    "typedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind_binding",
        "record"
      ],
      "properties": {
        "kind_binding": {
          "$ref": "#/$defs/exactRef"
        },
        "record": {
          "$ref": "#/$defs/exactRef"
        }
      }
    },
    "originAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_version",
        "locator_scheme_version",
        "locator",
        "namespace_ref"
      ],
      "properties": {
        "source_version": {
          "$ref": "#/$defs/exactRef"
        },
        "locator_scheme_version": {
          "$ref": "#/$defs/exactRef"
        },
        "locator": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 16384
        },
        "namespace_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_ref",
        "predicate_ref",
        "context_ref",
        "scope_ref",
        "modality",
        "qualification_profile_ref"
      ],
      "properties": {
        "signature_ref": {
          "$ref": "#/$defs/binding"
        },
        "predicate_ref": {
          "$ref": "#/$defs/binding"
        },
        "context_ref": {
          "$ref": "#/$defs/binding"
        },
        "scope_ref": {
          "$ref": "#/$defs/binding"
        },
        "modality": {
          "enum": [
            "source-reported",
            "historical-hypothesis",
            "textual-role",
            "metadata-description"
          ]
        },
        "qualification_profile_ref": {
          "$ref": "#/$defs/binding"
        }
      }
    }
  },
  "$comment": "Named native source value grammar; no source admission or proof follows from shape. Unknown bindings remain preserved. Ordered bound exact dependencies are mandatory under pwe-exact-basis-v1; semantic consumers require their actual native role resolution."
}
