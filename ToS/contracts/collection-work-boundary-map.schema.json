{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/collection-work-boundary-map.schema.json",
  "title": "Tree of Sophia collection work-boundary map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "map_id",
    "collection_ref",
    "edition_ref",
    "item_ref",
    "file_id",
    "file_sha256",
    "resource_inventory_ref",
    "resource_inventory_sha256",
    "page_count",
    "members",
    "non_member_sections",
    "crosscheck_anchor_refs",
    "source_text_included",
    "maker",
    "review_status",
    "establishes",
    "does_not_establish",
    "provenance_event_ref",
    "map_version"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/collection-work-boundary-map.schema.json"
    },
    "schema_version": {"const": "tos_collection_work_boundary_map_v1"},
    "map_id": {
      "type": "string",
      "pattern": "^tos\\.collection-work-boundary-map\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "collection_ref": {"$ref": "#/$defs/tosId"},
    "edition_ref": {"$ref": "#/$defs/tosId"},
    "item_ref": {"$ref": "#/$defs/tosId"},
    "file_id": {"$ref": "#/$defs/tosId"},
    "file_sha256": {"$ref": "#/$defs/sha256"},
    "resource_inventory_ref": {"$ref": "#/$defs/repoRelativePath"},
    "resource_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "page_count": {"type": "integer", "minimum": 1},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/member"}
    },
    "non_member_sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonMemberSection"}
    },
    "crosscheck_anchor_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tosId"}
    },
    "source_text_included": {"const": false},
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_type", "agent_ref", "method"],
      "properties": {
        "maker_type": {"const": "model"},
        "agent_ref": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "review_status": {"const": "unreviewed"},
    "establishes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance_event_ref": {"$ref": "#/$defs/tosId"},
    "map_version": {"type": "integer", "minimum": 1},
    "supersedes_map_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^tos\\.collection-work-boundary-map\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "tosId": {
      "type": "string",
      "pattern": "^tos\\.(agent|work|expression|edition|collection|item|file|passage|region|anchor|occurrence|annotation|claim|rights|review|event)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "work_ref",
        "expression_ref",
        "membership_claim_ref",
        "translation_responsibility_claim_ref",
        "title_page_anchor_ref",
        "boundary_evidence_anchor_refs",
        "start_page",
        "end_page",
        "epistemic_status",
        "review_status"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "work_ref": {"$ref": "#/$defs/tosId"},
        "expression_ref": {"$ref": "#/$defs/tosId"},
        "membership_claim_ref": {"$ref": "#/$defs/tosId"},
        "translation_responsibility_claim_ref": {"$ref": "#/$defs/tosId"},
        "title_page_anchor_ref": {"$ref": "#/$defs/tosId"},
        "boundary_evidence_anchor_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/tosId"}
        },
        "start_page": {"type": "integer", "minimum": 1},
        "end_page": {"type": "integer", "minimum": 1},
        "epistemic_status": {"enum": ["observed", "inferred"]},
        "review_status": {"const": "unreviewed"}
      }
    },
    "nonMemberSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "start_page",
        "end_page",
        "boundary_anchor_ref",
        "epistemic_status",
        "review_status"
      ],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "start_page": {"type": "integer", "minimum": 1},
        "end_page": {"type": "integer", "minimum": 1},
        "boundary_anchor_ref": {"$ref": "#/$defs/tosId"},
        "epistemic_status": {"enum": ["observed", "inferred"]},
        "review_status": {"const": "unreviewed"}
      }
    }
  }
}
