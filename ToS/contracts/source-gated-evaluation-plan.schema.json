{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/source-gated-evaluation-plan.schema.json",
  "title": "Tree of Sophia source-gated semantic or LLM evaluation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_kind",
    "experiment_id",
    "work_ref",
    "status",
    "frozen_at",
    "frozen_before_variant_outputs",
    "source_gate",
    "human_gold_gate",
    "selection_contract",
    "task_families",
    "tasks",
    "blindness_and_authority",
    "rights_posture",
    "result",
    "provenance_event_ref",
    "plan_version"
  ],
  "properties": {
    "$schema": {
      "const": "https://tree-of-sophia.local/ToS/contracts/source-gated-evaluation-plan.schema.json"
    },
    "schema_version": {"const": "tos_source_gated_evaluation_plan_v1"},
    "plan_id": {
      "type": "string",
      "pattern": "^tos\\.evaluation-plan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "plan_kind": {"enum": ["semantic-annotation", "llm-assistance"]},
    "experiment_id": {
      "enum": ["tos-semantic-annotation-v1", "tos-llm-assistance-v1"]
    },
    "work_ref": {
      "type": "string",
      "pattern": "^tos\\.work\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "blocked-not-materialized",
        "ready",
        "running",
        "awaiting-real-human-review",
        "closed",
        "superseded"
      ]
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "frozen_before_variant_outputs": {"const": true},
    "source_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_plan_ref",
        "review_plan_sha256",
        "laboratory_plan_ref",
        "laboratory_plan_sha256",
        "required_human_accepted_units",
        "current_human_accepted_units",
        "gate_status"
      ],
      "properties": {
        "review_plan_ref": {"type": "string", "minLength": 1},
        "review_plan_sha256": {"$ref": "#/$defs/sha256"},
        "laboratory_plan_ref": {"type": "string", "minLength": 1},
        "laboratory_plan_sha256": {"$ref": "#/$defs/sha256"},
        "required_human_accepted_units": {"const": 30},
        "current_human_accepted_units": {"type": "integer", "minimum": 0, "maximum": 30},
        "gate_status": {"enum": ["blocked", "satisfied"]}
      }
    },
    "human_gold_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold_status_ref",
        "gold_status_sha256",
        "required_human_double_checked_units",
        "current_human_double_checked_units",
        "gate_status"
      ],
      "properties": {
        "gold_status_ref": {"type": "string", "minLength": 1},
        "gold_status_sha256": {"$ref": "#/$defs/sha256"},
        "required_human_double_checked_units": {"const": 15},
        "current_human_double_checked_units": {"type": "integer", "minimum": 0, "maximum": 15},
        "gate_status": {"enum": ["blocked", "satisfied"]}
      }
    },
    "selection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_total_tasks",
        "random_tasks",
        "hard_tasks",
        "content_bearing_source_required",
        "same_tasks_across_variants",
        "selection_after_output_forbidden",
        "manual_rubric_frozen_before_output",
        "task_materialization_status"
      ],
      "properties": {
        "required_total_tasks": {"const": 20},
        "random_tasks": {"const": 10},
        "hard_tasks": {"const": 10},
        "content_bearing_source_required": {"const": true},
        "same_tasks_across_variants": {"const": true},
        "selection_after_output_forbidden": {"const": true},
        "manual_rubric_frozen_before_output": {"const": true},
        "task_materialization_status": {"enum": ["blocked", "frozen"]}
      }
    },
    "task_families": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exact-occurrence-and-context",
          "morphology-and-lemma",
          "sign-candidate-and-refusal",
          "competing-reading",
          "structure-proposal",
          "alignment-proposal",
          "translation-alternative",
          "evidence-grounded-relation-proposal"
        ]
      }
    },
    "prepared_task_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_task_family",
        "bounded_question",
        "required_total_tasks",
        "random_tasks",
        "hard_tasks",
        "task_instances_materialized",
        "source_anchor_refs",
        "source_text_present",
        "same_inputs_across_variants",
        "human_only_baseline_before_suggestions",
        "required_output_fields",
        "allowed_decisions",
        "forbidden_claims",
        "execution_profile_ref",
        "profile_refresh_required_on_plan_change",
        "human_work_scheduled"
      ],
      "properties": {
        "selected_task_family": {"const": "sign-candidate-and-refusal"},
        "bounded_question": {"type": "string", "minLength": 80},
        "required_total_tasks": {"const": 20},
        "random_tasks": {"const": 10},
        "hard_tasks": {"const": 10},
        "task_instances_materialized": {"const": false},
        "source_anchor_refs": {"type": "array", "maxItems": 0},
        "source_text_present": {"const": false},
        "same_inputs_across_variants": {"const": true},
        "human_only_baseline_before_suggestions": {"const": true},
        "required_output_fields": {
          "const": [
            "task_id",
            "decision",
            "candidate_label",
            "source_anchor_refs",
            "bounded_rationale",
            "uncertainty",
            "failure_reason"
          ]
        },
        "allowed_decisions": {
          "const": ["propose", "abstain", "uncertain", "failed"]
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "contains": {"const": "canon-status"},
          "items": {
            "enum": [
              "accepted-sign",
              "accepted-concept",
              "accepted-relation",
              "accepted-translation",
              "etymological-fact-without-external-evidence",
              "canon-status"
            ]
          }
        },
        "execution_profile_ref": {
          "const": "abyss-stack:mechanics/inference-pilots/parts/tos-foundation-lab/examples/tos-llm-assistance-profile.v1.json"
        },
        "profile_refresh_required_on_plan_change": {"const": true},
        "human_work_scheduled": {"const": false}
      }
    },
    "tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    },
    "blindness_and_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blind_variant_labels",
        "recognized_comparator_sealed",
        "gold_hidden_until_outputs_frozen",
        "model_output_is_proposal_only",
        "automatic_promotion_forbidden",
        "human_acceptance_required",
        "abstention_allowed",
        "uncertainty_allowed"
      ],
      "properties": {
        "blind_variant_labels": {"const": true},
        "recognized_comparator_sealed": {"const": true},
        "gold_hidden_until_outputs_frozen": {"const": true},
        "model_output_is_proposal_only": {"const": true},
        "automatic_promotion_forbidden": {"const": true},
        "human_acceptance_required": {"const": true},
        "abstention_allowed": {"const": true},
        "uncertainty_allowed": {"const": true}
      }
    },
    "rights_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_visibility", "network_allowed", "public_text_authorized"],
      "properties": {
        "content_visibility": {"const": "local_only"},
        "network_allowed": {"const": false},
        "public_text_authorized": {"const": false}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_count",
        "run_refs",
        "human_review_receipts",
        "metric_results",
        "winner",
        "promotion_authorized",
        "conclusion"
      ],
      "properties": {
        "run_count": {"type": "integer", "minimum": 0},
        "run_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "human_review_receipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "metric_results": {"type": "array", "items": {"type": "object"}},
        "winner": {"enum": ["A", "B", "C", "no-winner", null]},
        "promotion_authorized": {"type": "boolean"},
        "conclusion": {"type": "string", "minLength": 1}
      }
    },
    "provenance_event_ref": {
      "type": "string",
      "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "plan_version": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"plan_kind": {"const": "semantic-annotation"}}},
      "then": {
        "properties": {
          "experiment_id": {"const": "tos-semantic-annotation-v1"},
          "task_families": {
            "contains": {"const": "exact-occurrence-and-context"},
            "allOf": [
              {"contains": {"const": "morphology-and-lemma"}},
              {"contains": {"const": "sign-candidate-and-refusal"}},
              {"contains": {"const": "competing-reading"}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"plan_kind": {"const": "llm-assistance"}}},
      "then": {
        "required": ["prepared_task_contract"],
        "properties": {
          "experiment_id": {"const": "tos-llm-assistance-v1"},
          "task_families": {
            "contains": {"const": "structure-proposal"},
            "allOf": [
              {"contains": {"const": "alignment-proposal"}},
              {"contains": {"const": "translation-alternative"}},
              {"contains": {"const": "sign-candidate-and-refusal"}},
              {"contains": {"const": "evidence-grounded-relation-proposal"}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "blocked-not-materialized"}}},
      "then": {
        "properties": {
          "source_gate": {"properties": {"gate_status": {"const": "blocked"}}},
          "human_gold_gate": {"properties": {"gate_status": {"const": "blocked"}}},
          "selection_contract": {"properties": {"task_materialization_status": {"const": "blocked"}}},
          "tasks": {"maxItems": 0},
          "result": {
            "properties": {
              "run_count": {"const": 0},
              "run_refs": {"maxItems": 0},
              "human_review_receipts": {"maxItems": 0},
              "metric_results": {"maxItems": 0},
              "winner": {"const": null},
              "promotion_authorized": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["ready", "running", "awaiting-real-human-review", "closed"]}
        }
      },
      "then": {
        "properties": {
          "source_gate": {
            "properties": {
              "current_human_accepted_units": {"const": 30},
              "gate_status": {"const": "satisfied"}
            }
          },
          "human_gold_gate": {
            "properties": {
              "current_human_double_checked_units": {"const": 15},
              "gate_status": {"const": "satisfied"}
            }
          },
          "selection_contract": {"properties": {"task_materialization_status": {"const": "frozen"}}},
          "tasks": {"minItems": 20, "maxItems": 20}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_family",
        "stratum",
        "source_anchor_refs",
        "accepted_source_sha256",
        "local_content_ref",
        "local_content_sha256",
        "human_gold_ref",
        "human_gold_sha256",
        "eligible_for_variant_execution"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^tos-task-[a-z0-9-]+$"},
        "task_family": {"type": "string", "minLength": 1},
        "stratum": {"enum": ["random", "hard"]},
        "source_anchor_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "accepted_source_sha256": {"$ref": "#/$defs/sha256"},
        "local_content_ref": {"type": "string", "minLength": 1},
        "local_content_sha256": {"$ref": "#/$defs/sha256"},
        "human_gold_ref": {"type": "string", "minLength": 1},
        "human_gold_sha256": {"$ref": "#/$defs/sha256"},
        "eligible_for_variant_execution": {"const": true}
      }
    }
  }
}
