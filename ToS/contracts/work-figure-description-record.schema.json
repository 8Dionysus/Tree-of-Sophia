{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/work-figure-description-record.schema.json",
  "title": "Source-qualified figure of a work-world",
  "description": "A correctable source-described figure within one work. The figure is distinct from its author and any historical bearer of the name; voice and roles are separately grounded claims.",
  "allOf": [
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/source-metadata-record.schema.json"
    },
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/semantic-description-record.schema.json#/$defs/semanticDescriptionFields"
    },
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/semantic-description-record.schema.json#/$defs/semanticContentFields"
    },
    {
      "required": [
        "work_ref"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_work_figure_description_record_v1"
        },
        "record_type": {
          "const": "work-figure"
        },
        "record_id": {
          "pattern": "^tos\\.work-figure\\."
        },
        "supersedes_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^tos\\.work-figure\\."
        },
        "work_ref": {
          "type": "string",
          "pattern": "^tos\\.work\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "semantic_content": {
          "required": [
            "figure_account",
            "work_role"
          ],
          "properties": {
            "figure_account": {
              "type": "string",
              "pattern": "\\S"
            },
            "work_role": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
