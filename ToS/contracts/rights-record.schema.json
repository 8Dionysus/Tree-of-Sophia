{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/rights-record.schema.json",
  "title": "Tree of Sophia rights and visibility record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rights_id",
    "scope_refs",
    "assessment_status",
    "jurisdictions_reviewed",
    "source_refs",
    "permissions",
    "restrictions",
    "visibility",
    "redistribution_posture",
    "derivative_posture",
    "assessed_by",
    "assessed_at",
    "rationale",
    "review_status",
    "record_version"
  ],
  "properties": {
    "schema_version": {"const": "tos_rights_record_v1"},
    "rights_id": {"type": "string", "pattern": "^tos\\.rights\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "scope_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assessment_status": {
      "enum": [
        "not_assessed",
        "copyright_not_evaluated",
        "copyright_undetermined",
        "in_copyright",
        "public_domain_reviewed",
        "licensed",
        "permission_requested",
        "permission_granted",
        "permission_denied",
        "conflicting_evidence"
      ]
    },
    "rights_statement_uri": {
      "anyOf": [
        {"type": "string", "format": "uri"},
        {"type": "null"}
      ]
    },
    "license_uri": {
      "anyOf": [
        {"type": "string", "format": "uri"},
        {"type": "null"}
      ]
    },
    "jurisdictions_reviewed": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "restrictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "visibility": {
      "enum": ["local_only", "research_group", "permission_requested", "public_metadata_only", "public_payload"]
    },
    "redistribution_posture": {
      "enum": ["not_authorized", "unknown", "metadata_only", "authorized_with_conditions", "authorized"]
    },
    "derivative_posture": {
      "enum": ["local_research_only", "unknown", "permission_required", "allowed_with_conditions", "allowed"]
    },
    "assessed_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_type", "agent_ref"],
      "properties": {
        "maker_type": {"enum": ["human", "model", "mixed", "imported_source"]},
        "agent_ref": {"type": "string", "minLength": 1}
      }
    },
    "assessed_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["unreviewed", "human_reviewed", "legal_review_requested", "superseded"]},
    "review_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "access_request_ref": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "record_version": {"type": "integer", "minimum": 1},
    "supersedes_rights_ref": {
      "anyOf": [
        {"type": "string", "pattern": "^tos\\.rights\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        {"type": "null"}
      ]
    }
  }
}
