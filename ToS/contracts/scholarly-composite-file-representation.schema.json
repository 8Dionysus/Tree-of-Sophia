{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/scholarly-composite-file-representation.schema.json",
  "title": "Tree of Sophia scholarly-composite file representation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "representation_id",
    "file_id",
    "composite_id",
    "composite_ref",
    "representation_role",
    "part_label",
    "bibliographic_part",
    "provider_records",
    "acquisition",
    "payload",
    "rights_ref",
    "discovery_ref",
    "provenance_event_ref",
    "layer_separation",
    "authority",
    "maker",
    "created_at",
    "record_version"
  ],
  "properties": {
    "$schema": {"const": "https://tree-of-sophia.local/ToS/contracts/scholarly-composite-file-representation.schema.json"},
    "schema_version": {"const": "tos_scholarly_composite_file_representation_v1"},
    "representation_id": {"type": "string", "pattern": "^tos\\.composite-representation\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "file_id": {"$ref": "#/$defs/fileId"},
    "composite_id": {"$ref": "#/$defs/compositeId"},
    "composite_ref": {"$ref": "#/$defs/repoPath"},
    "representation_role": {"enum": ["digitized_volume", "digitized_part", "provider_export", "other"]},
    "part_label": {"type": "string", "minLength": 1},
    "bibliographic_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "responsibility", "volume", "publication", "identifiers"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "volume": {"type": "string", "minLength": 1},
        "publication": {"type": "string", "minLength": 1},
        "identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "provider_records": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "role", "record_url", "api_url", "checked_at", "response_fingerprint"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "role": {"enum": ["originating-record", "holding-record", "aggregator-record", "download-interface"]},
          "record_url": {"type": "string", "format": "uri"},
          "api_url": {"type": ["string", "null"], "format": "uri"},
          "checked_at": {"type": "string", "format": "date-time"},
          "response_fingerprint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["byte_size", "sha256", "captured"],
            "properties": {
              "byte_size": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "captured": {"const": false}
            }
          }
        }
      },
      "contains": {"type": "object", "properties": {"role": {"const": "originating-record"}}, "required": ["role"]},
      "minContains": 1
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "acquired_at",
        "transport",
        "technical_access_bypass_used",
        "operator_authorization_ref",
        "license_acceptance_recorded",
        "host_preflight_decision",
        "host_preflight_scope"
      ],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "acquired_at": {"type": "string", "format": "date-time"},
        "transport": {"const": "https"},
        "technical_access_bypass_used": {"const": false},
        "operator_authorization_ref": {"type": "string", "minLength": 1},
        "license_acceptance_recorded": {"const": true},
        "host_preflight_decision": {"const": "deny-protected-project-root"},
        "host_preflight_scope": {"const": "machine-owned-storage-automation-only"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "original_basename",
        "media_type",
        "byte_size",
        "sha256",
        "container",
        "materialization_status",
        "storage_posture",
        "git_tracked",
        "fixity_verified_at"
      ],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^payload/(?!\\.\\.?$)[^/]+$"},
        "original_basename": {"type": "string", "minLength": 1},
        "media_type": {"enum": ["application/pdf", "application/xml", "text/xml", "text/html"]},
        "byte_size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "page_count": {"type": ["integer", "null"], "minimum": 1},
        "container": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_url", "media_type", "byte_size", "sha256", "member_path", "retained"],
              "properties": {
                "source_url": {"type": "string", "format": "uri"},
                "media_type": {"const": "application/zip"},
                "byte_size": {"type": "integer", "minimum": 1},
                "sha256": {"$ref": "#/$defs/sha256"},
                "member_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
                "retained": {"const": false}
              }
            }
          ]
        },
        "materialization_status": {"enum": ["not_materialized", "materialized"]},
        "storage_posture": {"enum": ["unmaterialized_payload", "tracked_repository_payload"]},
        "git_tracked": {"type": "boolean"},
        "fixity_verified_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"materialization_status": {"const": "not_materialized"}}, "required": ["materialization_status"]},
          "then": {"properties": {"storage_posture": {"const": "unmaterialized_payload"}, "git_tracked": {"const": false}}}
        },
        {
          "if": {"properties": {"materialization_status": {"const": "materialized"}}, "required": ["materialization_status"]},
          "then": {"properties": {"storage_posture": {"const": "tracked_repository_payload"}, "git_tracked": {"const": true}}}
        },
        {
          "if": {"properties": {"media_type": {"const": "application/pdf"}}, "required": ["media_type"]},
          "then": {"properties": {"page_count": {"type": "integer", "minimum": 1}, "container": {"type": "null"}}, "required": ["page_count"]},
          "else": {
            "if": {"properties": {"media_type": {"enum": ["application/xml", "text/xml"]}}, "required": ["media_type"]},
            "then": {"properties": {"page_count": {"type": "null"}, "container": {"type": "object"}}, "required": ["page_count"]},
            "else": {"properties": {"page_count": {"type": "null"}, "container": {"type": "null"}}, "required": ["page_count"]}
          }
        }
      ]
    },
    "rights_ref": {"$ref": "#/$defs/repoPath"},
    "discovery_ref": {"$ref": "#/$defs/repoPath"},
    "provenance_event_ref": {"type": "string", "pattern": "^tos\\.event\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "layer_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_is_composite_identity",
        "file_is_physical_artifact",
        "file_is_ancient_original",
        "provider_record_is_file_identity",
        "embedded_text_admitted",
        "ocr_admitted",
        "translation_admitted"
      ],
      "properties": {
        "file_is_composite_identity": {"const": false},
        "file_is_physical_artifact": {"const": false},
        "file_is_ancient_original": {"const": false},
        "provider_record_is_file_identity": {"const": false},
        "embedded_text_admitted": {"const": false},
        "ocr_admitted": {"const": false},
        "translation_admitted": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "review_status",
        "visibility",
        "source_text_admitted",
        "semantic_authority",
        "graph_authority",
        "canon_authority",
        "publication_authority"
      ],
      "properties": {
        "evidence_status": {"const": "file_source_witness"},
        "review_status": {"enum": ["unreviewed", "human_reviewed", "superseded"]},
        "visibility": {"const": "local_only"},
        "source_text_admitted": {"const": false},
        "semantic_authority": {"const": false},
        "graph_authority": {"const": false},
        "canon_authority": {"const": false},
        "publication_authority": {"const": false}
      }
    },
    "maker": {"$ref": "#/$defs/maker"},
    "created_at": {"type": "string", "format": "date-time"},
    "record_version": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileId": {"type": "string", "pattern": "^tos\\.file\\.sha256\\.[a-f0-9]{64}$"},
    "compositeId": {"type": "string", "pattern": "^tos\\.composite\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value", "source_ref"],
      "properties": {
        "scheme": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "format": "uri"}
      }
    },
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_type", "agent_ref", "human_review_performed"],
      "properties": {
        "maker_type": {"const": "model"},
        "agent_ref": {"type": "string", "minLength": 1},
        "human_review_performed": {"const": false}
      }
    }
  }
}
