{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/scoped-member-structure.schema.json",
  "title": "Claim-scoped composition and ordering value",
  "description": "A bounded source-attributed member set scoped to its Claim. Array order records serialization; the concrete relation defines membership and any explicit ordering basis.",
  "allOf": [
    {
      "$ref": "https://tree-of-sophia.local/ToS/contracts/source-structured-value.schema.json"
    }
  ],
  "required": [
    "members",
    "source_scope",
    "coverage",
    "membership_basis",
    "ordering",
    "limitations"
  ],
  "properties": {
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "source_scope": {
      "$ref": "#/$defs/nonBlank"
    },
    "coverage": {
      "enum": [
        "partial",
        "exhaustive-within-scope",
        "undetermined"
      ],
      "description": "Exhaustive is an attributed judgment only in the stated scope, never mechanical proof of a complete corpus."
    },
    "membership_basis": {
      "$ref": "#/$defs/nonBlank"
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "basis",
        "precedes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "unordered",
            "partial",
            "total"
          ]
        },
        "basis": {
          "$ref": "#/$defs/nonBlank",
          "description": "The stated basis and meaning of this editorial, physical, argumentative or research arrangement. Historical time and causation require separately grounded Claims."
        },
        "precedes": {
          "type": "array",
          "maxItems": 8128,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identity"
            }
          }
        }
      }
    },
    "limitations": {
      "$ref": "#/$defs/nonBlank"
    },
    "collection_version": {
      "$ref": "https://treeofsophia.local/ToS/contracts/knowledge-assessment.schema.json#/$defs/exactRef"
    },
    "membership_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "https://treeofsophia.local/ToS/contracts/knowledge-assessment.schema.json#/$defs/exactRef"
      }
    },
    "extensions": {
      "type": "object",
      "description": "Preserved without interpreting additional references or order rules."
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "collection-member-order"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "required": [
      "collection_version",
      "membership_versions"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "collection_version"
          ]
        },
        {
          "required": [
            "membership_versions"
          ]
        }
      ]
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "identity": {
      "type": "string",
      "pattern": "^tos\\.[a-z][a-z0-9-]*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    }
  }
}
