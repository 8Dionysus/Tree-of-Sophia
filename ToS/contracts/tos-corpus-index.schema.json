{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tree-of-sophia.local/ToS/contracts/tos-corpus-index.schema.json",
  "title": "Tree of Sophia corpus index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "owner_repo",
    "surface_kind",
    "authority_order",
    "runtime_projection_boundary",
    "validation_refs",
    "counts",
    "graph_views",
    "branches",
    "manifests",
    "nodes",
    "relation_packs",
    "relation_edges",
    "resources",
    "source_navigation",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "tos_corpus_index_v1"
    },
    "schema_ref": {
      "const": "ToS/contracts/tos-corpus-index.schema.json"
    },
    "owner_repo": {
      "const": "Tree-of-Sophia"
    },
    "surface_kind": {
      "const": "derived_corpus_index"
    },
    "authority_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authorityEntry"
      }
    },
    "runtime_projection_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_owner",
        "allowed",
        "not_allowed"
      ],
      "properties": {
        "runtime_owner": {
          "const": "abyss-stack"
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "graph_views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/graphView"
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/branch"
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifest"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relation_packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationPack"
      }
    },
    "relation_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationEdge"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "source_navigation": {
      "$ref": "#/$defs/sourceNavigation"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "authorityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "owner_branch",
        "meaning"
      ],
      "properties": {
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "owner_branch": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "graphView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "purpose",
        "layout_hint",
        "entry_surface"
      ],
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "layout_hint": {
          "type": "string",
          "minLength": 1
        },
        "entry_surface": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "owner_surface",
        "authority_layer",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "owner_surface": {
          "type": "string",
          "minLength": 1
        },
        "authority_layer": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "manifest_kind",
        "owner_branch",
        "authority_layer",
        "schema_version",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_kind": {
          "type": "string",
          "minLength": 1
        },
        "owner_branch": {
          "type": "string",
          "minLength": 1
        },
        "authority_layer": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string"
        },
        "branch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "human_forms": [
          "human_forms_source_ref",
          "human_forms_source_sha256",
          "source_record_sha256"
        ],
        "human_forms_source_ref": [
          "human_forms",
          "human_forms_source_sha256",
          "source_record_sha256"
        ],
        "human_forms_source_sha256": [
          "human_forms",
          "human_forms_source_ref",
          "source_record_sha256"
        ]
      },
      "required": [
        "node_id",
        "node_type",
        "label",
        "owner_branch",
        "authority_layer",
        "source_path",
        "source_sha256",
        "properties"
      ],
      "properties": {
        "source_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "human_forms": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        },
        "human_forms_source_ref": {
          "type": "string",
          "minLength": 1
        },
        "human_forms_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "node_type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "owner_branch": {
          "type": "string",
          "minLength": 1
        },
        "authority_layer": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "route_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "relationPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "path",
        "route_hint",
        "owner_branch",
        "authority_layer",
        "edge_count",
        "columns",
        "sha256"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "route_hint": {
          "type": "string",
          "minLength": 1
        },
        "owner_branch": {
          "type": "string",
          "minLength": 1
        },
        "authority_layer": {
          "type": "string",
          "minLength": 1
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "relationEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "pack_id",
        "from_id",
        "predicate_id",
        "to_id",
        "owner_branch",
        "authority_layer",
        "status"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string"
        },
        "predicate_id": {
          "type": "string"
        },
        "to_id": {
          "type": "string"
        },
        "owner_branch": {
          "type": "string",
          "minLength": 1
        },
        "authority_layer": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_record",
            "source_row",
            "source_file_sha256"
          ],
          "description": "The exact parsed source CSV row, including unknown columns, bound to its data-record ordinal. A physical source line is a separate locator. The row retains the edge’s source identity, meaning and review status. This binding is absent on older derived snapshots.",
          "properties": {
            "source_record": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "source_row": {
              "type": "integer",
              "minimum": 1
            },
            "source_file_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "resource_kind",
        "owner_branch",
        "authority_layer",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "resource_kind": {
          "type": "string",
          "minLength": 1
        },
        "owner_branch": {
          "type": "string",
          "minLength": 1
        },
        "authority_layer": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceNavigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority_boundary",
        "counts",
        "nodes",
        "edges",
        "rights"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_source_navigation_v1"
        },
        "authority_boundary": {
          "type": "string",
          "minLength": 1
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "edges",
            "rights"
          ],
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            },
            "rights": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceNavigationNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceNavigationEdge"
          }
        },
        "rights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceNavigationRights"
          }
        }
      }
    },
    "sourceNavigationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_kind",
        "label",
        "source_ref",
        "identity_status",
        "properties"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "node_kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "identity_status": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "description": "All exact Item-manifest sources for a shared content File; source_ref remains one compatible navigation handle.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "sourceNavigationEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "from_id",
        "predicate_id",
        "to_id",
        "edge_kind",
        "review_status",
        "source_refs"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "edge_kind": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_ref": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "$ref": "#/$defs/sourceNavigationEdgeProperties"
        }
      }
    },
    "sourceNavigationEdgeProperties": {
      "oneOf": [
        {"$ref": "#/$defs/retainedObjectLinkContext"},
        {"$ref": "#/$defs/sourceItemFileMembershipContext"}
      ]
    },
    "sourceItemFileMembershipContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_file_contexts"],
      "properties": {
        "item_file_contexts": {
          "description": "Per-Item manifest and payload context. Rights and source attribution stay with their Item owners.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceItemFileManifestContext"}
        }
      }
    },
    "sourceItemFileManifestContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_ref", "acquisition_event_ref", "payload_entries"],
      "properties": {
        "manifest_ref": {"type": "string", "minLength": 1},
        "acquisition_event_ref": {"type": "string", "minLength": 1},
        "payload_entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceItemFilePayloadEntry"}
        }
      }
    },
    "sourceItemFilePayloadEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "original_basename", "fixity_verified_at", "container_member"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "original_basename": {"type": "string", "minLength": 1},
        "fixity_verified_at": {"type": "string", "format": "date-time"},
        "container_member": {"type": "boolean"}
      }
    },
    "retainedObjectLinkContext": {
      "description": "Read-only context of one exact legacy object-Link v1 row; the source adapter validates the unchanged owner schema and its five-kind domain. No source prose or assessment is synthesized.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_claim",
        "source_claim_file_ref",
        "source_claim_line",
        "source_sha256",
        "source_schema_ref",
        "source_adapter"
      ],
      "properties": {
        "source_claim": {
          "type": "object",
          "required": [
            "schema_version",
            "claim_id"
          ],
          "properties": {
            "schema_version": {
              "const": "tos_object_link_claim_v1"
            },
            "claim_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_claim_file_ref": {
          "const": "ToS/source-witnesses/relations/object-link/object-link-claims.jsonl"
        },
        "source_claim_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_schema_ref": {
          "const": "ToS/contracts/object-link-claim.schema.json"
        },
        "source_adapter": {
          "const": "retained-object-link-v1"
        }
      }
    },
    "sourceNavigationRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_id",
        "scope_refs",
        "assessment_status",
        "review_status",
        "redistribution_posture",
        "derivative_posture",
        "server_processing_posture",
        "visibility",
        "license_uri",
        "rights_statement_uri",
        "restrictions",
        "source_ref"
      ],
      "properties": {
        "rights_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assessment_status": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        },
        "redistribution_posture": {
          "type": "string",
          "minLength": 1
        },
        "derivative_posture": {
          "type": "string",
          "minLength": 1
        },
        "server_processing_posture": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "minLength": 1
        },
        "license_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_statement_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "path",
        "message"
      ],
      "properties": {
        "level": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
