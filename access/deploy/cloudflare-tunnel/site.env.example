TOS_SITE_ROOT=/absolute/selected-tos-source
TOS_SITE_PORT=5439
TOS_ACCESS_BIN=/absolute/fresh-prefix/bin/tos
# Optional explicit helper path. When unset, the origin service keeps its
# legacy Site-checkout path under TOS_SITE_ROOT.
# TOS_ACCESS_ORIGIN_LAUNCHER=/absolute/path/to/Tree-of-Sophia/access/deploy/cloudflare-tunnel/run-origin.sh
# Optional durable PostgreSQL source-text consumer; can be used without TOS_SITE_ROOT.
# TOS_SOURCE_TEXT_SEARCH_SELECTION=/absolute/path/to/source-text-search-selection.json
# Required by that consumer and private; do not commit the real connection URL.
# TOS_SOURCE_PG_URL=postgresql://user:password@127.0.0.1/database
CLOUDFLARED_BIN=/home/example/.local/bin/cloudflared
TOS_TUNNEL_METRICS=127.0.0.1:5440
