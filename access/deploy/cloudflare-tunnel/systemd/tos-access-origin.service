[Unit]
Description=Tree of Sophia standalone access origin
Documentation=file://%h/.config/tree-of-sophia/site.env
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/tree-of-sophia/site.env
ExecStart=/usr/bin/env ${TOS_SITE_ROOT}/access/deploy/cloudflare-tunnel/run-origin.sh
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=default.target
