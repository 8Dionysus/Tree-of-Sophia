{
  "name": "tree-of-sophia-cloudflare-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ci:python": "python -m pip install -r ../../../requirements-dev.txt",
    "ci:web": "npm ci --prefix ../../web",
    "build:web": "npm --prefix ../../web run build",
    "build:data": "node scripts/build_data.mjs",
    "build": "npm run build:web && npm run build:data",
    "build:ci": "npm run ci:python && npm run ci:web && npm run build",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "load:local": "node scripts/deploy_edge.mjs --local --data-only",
    "dev": "npm run build && npm run load:local && wrangler dev",
    "test": "node --experimental-strip-types --import ../../web/src/observatory/human-forms-wasm-test-runtime.mjs --test test/*.test.ts test/*.test.mjs",
    "verify:local": "sh scripts/verify_local_native.sh",
    "deploy:edge": "node scripts/deploy_edge.mjs",
    "deploy:edge:plan": "node scripts/deploy_edge.mjs --plan",
    "load:remote": "wrangler d1 execute DB --remote --file=runtime/read-model.sql --yes",
    "check": "npm run build && npm run types && npm run typecheck && npm test",
    "check:local": "npm run check && npm run load:local && npm run verify:local",
    "verify:local:reference": "python scripts/verify_local_runtime.py"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  }
}
