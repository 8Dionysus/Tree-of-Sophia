{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tree-of-sophia-public-research",
  "main": "src/public-research-entry.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["enable_request_signal", "request_signal_passthrough"],
  "assets": {
    "directory": "./dist-public-research",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*"]
  },
  "routes": [
    { "pattern": "treeofsophia.com/*", "zone_name": "treeofsophia.com" },
    { "pattern": "www.treeofsophia.com/*", "zone_name": "treeofsophia.com" }
  ]
}
