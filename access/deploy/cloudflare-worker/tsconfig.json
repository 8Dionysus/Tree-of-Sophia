{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "ESNext.Disposable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "src/common.ts",
    "src/public-head.ts",
    "src/public-prototypes.ts",
    "src/public-research-entry.ts",
    "src/selected-temporal-runtime.ts",
    "worker-configuration.d.ts"
  ]
}
