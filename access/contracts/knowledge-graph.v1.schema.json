{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeofsophia.com/contracts/knowledge-graph.v1.schema.json",
  "title": "Tree of Sophia normalized knowledge graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_revision", "nodes", "relations", "counts", "authority_boundary"],
  "properties": {
    "schema": {"const": "tos_knowledge_graph_v1"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "counts": {"type": "object"},
    "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
  },
  "$defs": {
    "exactFormRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": {"id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"}}
    },
    "humanFormRoleSelection": {
      "type": "object", "additionalProperties": false, "required": ["state", "reason", "form", "packet"],
      "properties": {
        "state": {"enum": ["ready", "missing", "unavailable", "ambiguous", "over-budget"]},
        "reason": {"enum": ["exact-language", "less-specific-language", "automatic", "fallback", "original", "no-ready-form", "multiple-forms", "original-role-not-declared", "inspect-exact-form"]},
        "form": {"anyOf": [{"$ref": "#/$defs/exactFormRef"}, {"type": "null"}]},
        "packet": {"type": ["object", "null"], "description": "Intact ToS-owned tos_human_form_materialization_v1, including all mandatory context and separate source-snapshot admission. Source contract: ToS/contracts/human-form.schema.json#/$defs/materialization; this transport does not re-assess it."}
      },
      "allOf": [{"if": {"properties": {"state": {"const": "ready"}}},
        "then": {"properties": {"form": {"$ref": "#/$defs/exactFormRef"}, "packet": {"type": "object"}}},
        "else": {"properties": {"packet": {"type": "null"}}}}]
    },
    "humanFormSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "content_revision", "requested_language", "source_ref", "state", "roles", "candidates", "issues", "performs_translation", "performs_assessment"],
      "properties": {
        "schema_version": {"const": "tos_human_form_selection_v1"},
        "content_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "requested_language": {"type": "string", "maxLength": 128},
        "source_ref": {"type": ["string", "null"], "maxLength": 2048},
        "state": {"enum": ["available", "invalid", "over-budget"]},
        "roles": {"type": "object", "required": ["name", "caption", "hover", "statement", "grounds", "history", "technical"],
          "propertyNames": {"enum": ["name", "caption", "hover", "statement", "grounds", "history", "technical"]},
          "additionalProperties": {"$ref": "#/$defs/humanFormRoleSelection"}},
        "candidates": {"type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["form", "role", "language", "state", "source_pointer"],
          "properties": {"form": {"$ref": "#/$defs/exactFormRef"},
            "role": {"enum": [null, "name", "caption", "hover", "statement", "grounds", "history", "technical"]},
            "language": {"type": ["string", "null"]},
            "state": {"enum": ["ready", "invalid", "unavailable", "stale", "restricted", "needs-assessment", "over-budget"]},
            "source_pointer": {"type": "string", "pattern": "^/attributes/human_forms/[0-9]+$"}}
        }},
        "issues": {"type": "array", "items": {"type": "string"}},
        "performs_translation": {"const": false}, "performs_assessment": {"const": false}
      }
    },
    "sourceRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["payload", "digest", "transform_version", "field_map"],
      "properties": {"payload": {"type": "object"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transform_version": {"type": "string"}, "field_map": {"type": "object", "additionalProperties": {"type": "string"}}}
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableString": {"type": ["string", "null"]},
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "description": "Language-tag transport envelope; key syntax does not verify registration, language, translation or semantic quality. default and original are roles, not language tags.",
      "patternProperties": {
        "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[iIxX](?:-[A-Za-z0-9]{1,8})+)$(?![\\s\\S])": {"$ref": "#/$defs/nullableString"}
      },
      "required": ["default", "ru", "en", "original"],
      "properties": {
        "default": {"$ref": "#/$defs/nonEmptyString"},
        "ru": {"$ref": "#/$defs/nullableString"},
        "en": {"$ref": "#/$defs/nullableString"},
        "original": {"$ref": "#/$defs/nullableString"}
      }
    },
    "epistemic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_layer", "canon_status", "review_posture", "confidence"],
      "properties": {
        "authority_layer": {"$ref": "#/$defs/nullableString"},
        "canon_status": {"$ref": "#/$defs/nullableString"},
        "review_posture": {"$ref": "#/$defs/nullableString"},
        "confidence": {"type": ["string", "number", "null"]}
      }
    },
    "semanticMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "registry_ref"],
      "properties": {
        "status": {"enum": ["mapped", "unmapped"]},
        "source_kind_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_predicate_id": {"$ref": "#/$defs/nonEmptyString"},
        "registry_ref": {"$ref": "#/$defs/nonEmptyString"}
      },
      "oneOf": [
        {"required": ["source_kind_id"], "not": {"required": ["source_predicate_id"]}},
        {"required": ["source_predicate_id"], "not": {"required": ["source_kind_id"]}}
      ]
    },
    "nodeSemantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language_context": {"type": "object"},
        "assertion_contexts": {"type": "array", "items": {"$ref": "#/$defs/assertionContext"}},
        "type_ancestors": {"type": "array", "items": {"type": "string"}},
        "annotation": {"type": "object"},
        "claim": {"type": "object"},
        "time": {"type": "object"},
        "space": {"type": "object"},
        "responsibility": {"type": "object"}
      }
    },
    "relationSemantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assertion_contexts": {"type": "array", "items": {"$ref": "#/$defs/assertionContext"}},
        "time": {"type": "object"},
        "space": {"type": "object"},
        "responsibility": {"type": "object"}
      }
    },
    "assertionField": {
      "type": "object", "additionalProperties": false, "required": ["value", "source_pointer"],
      "properties": {"value": {}, "source_pointer": {"type": "string", "pattern": "^/"}}
    },
    "assertionContext": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "binding_role", "source_record_digest", "source_refs", "fields", "conflicts", "interpretation"],
      "properties": {
        "schema_version": {"const": "tos_assertion_context_v1"},
        "binding_role": {"enum": ["carrier", "referenced-claim"]},
        "source_record_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/assertionField"}},
        "conflicts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "lower_priority", "higher_priority"],
          "properties": {"field": {"type": "string"}, "lower_priority": {"$ref": "#/$defs/assertionField"}, "higher_priority": {"$ref": "#/$defs/assertionField"}}
        }},
        "interpretation": {"const": "source-declared-not-semantic-assessment"}
      }
    },
    "displaySelection": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "content_revision", "fields", "essential_context_pointers", "performs_translation", "is_semantic_assessment"],
      "properties": {
        "schema_version": {"const": "tos_display_selection_v1"},
        "content_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fields": {"type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false,
          "required": ["requested_language", "selected_key", "actual_language", "text", "reason", "available_keys", "content_available", "source_form_pointer"],
          "properties": {
            "requested_language": {"type": "string"}, "selected_key": {"type": ["string", "null"]},
            "actual_language": {"type": ["string", "null"]}, "text": {"type": ["string", "null"]},
            "reason": {"enum": ["exact-language", "less-specific-language", "original-role", "automatic", "fallback", "missing", "ambiguous-language-key"]},
            "available_keys": {"type": "array", "items": {"type": "string"}},
            "content_available": {"type": "boolean"}, "source_form_pointer": {"type": ["string", "null"]}
          }
        }},
        "essential_context_pointers": {"type": "array", "items": {"type": "string", "pattern": "^/semantics/assertion_contexts/"}},
        "performs_translation": {"const": false}, "is_semantic_assessment": {"const": false}
      }
    },
    "nodeDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "kind_label", "summary", "summary_state", "provenance"],
      "properties": {
        "title": {"$ref": "#/$defs/localizedText"},
        "kind_label": {"$ref": "#/$defs/localizedText"},
        "summary": {"$ref": "#/$defs/localizedText"},
        "summary_state": {
          "enum": ["authored", "source-derived", "metadata-synthesis", "missing"]
        },
        "provenance": {"type": "object"}
      }
    },
    "relationDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "inverse_label", "statement", "explanation", "explanation_state", "provenance"],
      "properties": {
        "label": {"$ref": "#/$defs/localizedText"},
        "inverse_label": {
          "anyOf": [
            {"$ref": "#/$defs/localizedText"},
            {"type": "null"}
          ]
        },
        "statement": {"$ref": "#/$defs/localizedText"},
        "explanation": {"$ref": "#/$defs/localizedText"},
        "explanation_state": {
          "enum": ["authored", "source-derived", "metadata-synthesis", "missing"]
        },
        "provenance": {"type": "object"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "entity_id", "native_id", "source_graph", "kind_id", "type_id", "type_mapping",
        "content_revision", "display", "epistemic", "graph_layers", "view_ids", "source_refs",
        "attributes", "semantics"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "entity_id": {"$ref": "#/$defs/nonEmptyString"},
        "native_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_graph": {"enum": ["philosophy", "canon", "candidate-intake", "source-navigation", "source-claims", "semantic-interchange", "repository"]},
        "kind_id": {"$ref": "#/$defs/nonEmptyString"},
        "type_id": {"$ref": "#/$defs/nonEmptyString"},
        "type_mapping": {"$ref": "#/$defs/semanticMapping"},
        "content_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "display": {"$ref": "#/$defs/nodeDisplay"},
        "display_selection": {"$ref": "#/$defs/displaySelection"},
        "human_form_selection": {"$ref": "#/$defs/humanFormSelection"},
        "epistemic": {"$ref": "#/$defs/epistemic"},
        "graph_layers": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "view_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "attributes": {"type": "object"},
        "semantics": {"$ref": "#/$defs/nodeSemantics"},
        "source_record": {"$ref": "#/$defs/sourceRecord"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "native_id", "source_graph", "from_id", "to_id", "predicate_id", "content_revision",
        "relation_type_id", "predicate_mapping", "display", "epistemic", "graph_layers", "view_ids",
        "source_refs", "attributes", "semantics"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "native_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_graph": {"enum": ["philosophy", "canon", "candidate-intake", "source-navigation", "source-claims", "semantic-interchange", "repository"]},
        "from_id": {"$ref": "#/$defs/nonEmptyString"},
        "to_id": {"$ref": "#/$defs/nonEmptyString"},
        "predicate_id": {"$ref": "#/$defs/nonEmptyString"},
        "relation_type_id": {"$ref": "#/$defs/nonEmptyString"},
        "predicate_mapping": {"$ref": "#/$defs/semanticMapping"},
        "content_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "display": {"$ref": "#/$defs/relationDisplay"},
        "display_selection": {"$ref": "#/$defs/displaySelection"},
        "human_form_selection": {"$ref": "#/$defs/humanFormSelection"},
        "epistemic": {"$ref": "#/$defs/epistemic"},
        "graph_layers": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "view_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
        "attributes": {"type": "object"},
        "semantics": {"$ref": "#/$defs/relationSemantics"},
        "source_record": {"$ref": "#/$defs/sourceRecord"}
      }
    },
    "authorityBoundary": {
      "type": "object",
      "required": ["is_source", "is_canon", "writes_to_tree", "source_owner", "note"],
      "properties": {
        "is_source": {"const": false},
        "is_canon": {"const": false},
        "writes_to_tree": {"const": false},
        "source_owner": {"const": "Tree-of-Sophia"},
        "note": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
