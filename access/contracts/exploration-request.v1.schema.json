{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeofsophia.com/contracts/exploration-request.v1.schema.json",
  "title": "Start or continue a bounded resumable neighborhood exploration",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["cursor"],
      "properties": {"cursor": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    {
      "type": "object", "additionalProperties": false, "required": ["focus_node_id"],
      "properties": {
        "focus_node_id": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"},
        "sources": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"enum": ["philosophy", "canon", "candidate-intake", "source-navigation", "source-claims", "semantic-interchange", "repository"]}},
        "direction": {"enum": ["either", "outgoing", "incoming"], "default": "either"},
        "predicate_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "profile": {"enum": ["overview", "all"], "default": "overview"},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 10, "default": 3},
        "page_nodes": {"type": "integer", "minimum": 1, "maximum": 100, "default": 40},
        "page_relations": {"type": "integer", "minimum": 1, "maximum": 100, "default": 80}
      }
    }
  ]
}
