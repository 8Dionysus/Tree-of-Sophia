{
  "schema_version": "tos_query_operations_v1",
  "owner": "Tree-of-Sophia/access/core",
  "side_effect_posture": "read-only",
  "operations": [
    {"operation_id": "tos.status", "input": {}, "result": "status packet"},
    {"operation_id": "tos.snapshot", "input": {}, "result": "current philosophy projection fingerprints for traceable local proposal binding"},
    {"operation_id": "tos.search", "input": {"mode": "philosophy|corpus", "query": "string", "limit": "1..100"}, "result": "search packet"},
    {"operation_id": "tos.source-gaps.search", "input": {"query": "string", "limit": "1..100"}, "result": "bounded public source-access gap records; not a completeness or legal conclusion"},
    {"operation_id": "tos.view.open", "input": {"mode": "philosophy|corpus", "view_id": "string", "limit": "1..1000"}, "result": "view packet"},
    {"operation_id": "tos.node.inspect", "input": {"mode": "philosophy|corpus", "node_id": "string"}, "result": "node packet"},
    {"operation_id": "tos.neighborhood", "input": {"node_id": "string", "depth": "1..3", "limit": "1..300", "layers": "string[]", "predicates": "string[]"}, "result": "neighborhood packet"},
    {
      "operation_id": "tos.epistemic.inspect",
      "input": {"mode": "philosophy|corpus", "item_id": "projection node or edge ID", "view_id": "string|null", "limit": "1..200"},
      "result": "evidence-lens-packet.v1.schema.json"
    },
    {
      "operation_id": "tos.path.find",
      "input": {
        "from_id": "string",
        "to_id": "string",
        "max_depth": "1..8",
        "direction": "outgoing|incoming|either (default outgoing)",
        "view_id": "string|null",
        "excluded_edge_ids": "string[]",
        "alternative_limit": "1..5",
        "layers": "string[]",
        "predicates": "string[]"
      },
      "result": "deterministically ordered path alternatives packet"
    },
    {
      "operation_id": "tos.zarathustra.word-analysis.prepare",
      "input": {
        "query": "German, Russian, or English concept query",
        "language": "de|ru|en",
        "rank": "1..100",
        "include_semantic_neighbors": "boolean"
      },
      "result": "capability envelope containing one exact-source local analysis task or an explicit unavailable state"
    }
  ],
  "consumers": ["native MCP", "HTTP API", "page commands"],
  "authority_limit": "Operation success proves access behavior only; source_ref routes remain authoritative."
}
