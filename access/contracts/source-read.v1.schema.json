{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeofsophia.local/access/contracts/source-read.v1.schema.json",
  "title": "Bounded owner-issued exact source read",
  "description": "A transport contract for one exact public metadata, Claim, or addressed source-slot record selected by an existing source owner. The target must come from that owner's card/catalog or typed resolver; callers must not guess a digest or derive a path. It is an access adapter: it is not source authority, a current-use grant, a text payload route, or a filesystem locator.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bareDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "metadataRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^tos\\.(?!claim\\.)[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "version": {"$ref": "#/$defs/safeInteger", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "claimRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^tos\\.claim\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "version": {"$ref": "#/$defs/safeInteger", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "catalog_root_sha256", "catalog_namespace", "source_publication"],
      "properties": {
        "source_revision": {"$ref": "#/$defs/bareDigest"},
        "catalog_root_sha256": {"$ref": "#/$defs/bareDigest"},
        "catalog_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "source_publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "token", "generation"],
          "properties": {
            "protocol": {"const": "tos_selected_source_metadata_v1"},
            "token": {"$ref": "#/$defs/digest"},
            "generation": {"$ref": "#/$defs/safeInteger"}
          }
        }
      }
    },
    "metadataTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "record_type", "record_ref", "content_revision"],
      "properties": {
        "layer": {"const": "metadata_record"},
        "record_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "record_ref": {"$ref": "#/$defs/metadataRef", "description": "Owner-issued exact id/version/digest; not a caller-invented lookup key."},
        "content_revision": {"$ref": "#/$defs/digest"}
      }
    },
    "claimTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "record_ref", "content_revision"],
      "properties": {
        "layer": {"const": "claim_record"},
        "record_ref": {"$ref": "#/$defs/claimRef", "description": "Owner-issued exact id/version/digest; not a caller-invented lookup key."},
        "content_revision": {"$ref": "#/$defs/digest"}
      }
    },
    "slotTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "slot_kind", "identity", "row_sha256", "content_revision"],
      "properties": {
        "layer": {"const": "source_slot"},
        "slot_kind": {"enum": ["claim", "provenance_event", "anchor"]},
        "identity": {"type": "string", "pattern": "^tos\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$", "description": "Owner-issued typed slot identity; it is not a filesystem locator."},
        "row_sha256": {"$ref": "#/$defs/bareDigest"},
        "content_revision": {"$ref": "#/$defs/digest"}
      }
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/metadataTarget"},
        {"$ref": "#/$defs/claimTarget"},
        {"$ref": "#/$defs/slotTarget"}
      ]
    },
    "metadataSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "record_type", "record_id"],
      "properties": {
        "layer": {"const": "metadata_record"},
        "record_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "description": "Owner-declared metadata family; it is not inferred from an ID."},
        "record_id": {"type": "string", "pattern": "^tos\\.(?!claim\\.)[a-z0-9]+(?:[.-][a-z0-9]+)*$", "description": "Stable identity looked up in the selected owner catalog; no path is accepted."}
      }
    },
    "claimSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "claim_id"],
      "properties": {
        "layer": {"const": "claim_record"},
        "claim_id": {"type": "string", "pattern": "^tos\\.claim\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$", "description": "Stable Claim identity looked up in the selected owner catalog."}
      }
    },
    "slotSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "slot_kind", "identity"],
      "properties": {
        "layer": {"const": "source_slot"},
        "slot_kind": {"enum": ["claim", "provenance_event", "anchor"]},
        "identity": {"type": "string", "pattern": "^tos\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$", "description": "Typed source-slot identity looked up in the selected owner catalog."}
      }
    },
    "selector": {
      "oneOf": [
        {"$ref": "#/$defs/metadataSelector"},
        {"$ref": "#/$defs/claimSelector"},
        {"$ref": "#/$defs/slotSelector"}
      ]
    },
    "discoveryRequest": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["target"], "properties": {"target": {"$ref": "#/$defs/target"}}},
        {"type": "object", "additionalProperties": false, "required": ["selector"], "properties": {"selector": {"$ref": "#/$defs/selector"}}}
      ]
    },
    "readRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "representation"],
      "properties": {
        "handle": {"$ref": "#/$defs/handle"},
        "representation": {"const": "record"}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "visibility", "visibility_verified", "rights_revalidated", "rights_scope", "authority"],
      "properties": {
        "scope": {"enum": ["public-metadata-record", "public-claim-record", "public-source-slot-metadata"]},
        "visibility": {"enum": ["public", "public_metadata_only"]},
        "visibility_verified": {"const": true},
        "rights_revalidated": {"const": false},
        "rights_scope": {"const": "metadata-disclosure-only"},
        "authority": {"const": "source-owner-public-metadata-contract"}
      }
    },
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issuer", "epoch", "target", "access", "handle_digest"],
      "properties": {
        "schema_version": {"const": "tos_source_read_handle_v1"},
        "issuer": {"const": "Tree-of-Sophia/source-witnesses"},
        "epoch": {"$ref": "#/$defs/epoch"},
        "target": {"$ref": "#/$defs/target"},
        "access": {"$ref": "#/$defs/access"},
        "handle_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "status": {
      "enum": ["available", "missing", "stale", "corrupt", "access-restricted", "over-budget", "unsupported"]
    },
    "commonFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grants_current_use", "performs_assessment", "writes_to_source"],
      "properties": {
        "grants_current_use": {"const": false},
        "performs_assessment": {"const": false},
        "writes_to_source": {"const": false}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"target": {"type": "null"}}, "required": ["target"]},
          "then": {
            "required": ["selector"],
            "properties": {
              "status": {"not": {"const": "available"}},
              "handle": {"type": "null"},
              "content_revision": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "available"}}, "required": ["status"]},
          "then": {"properties": {
            "target": {"$ref": "#/$defs/target"},
            "handle": {"$ref": "#/$defs/handle"},
            "content_revision": {"$ref": "#/$defs/digest"}
          }}
        }
      ],
      "required": ["schema_version", "status", "reason", "target", "handle", "source_revision", "content_revision", "provenance", "access", "grants_current_use", "performs_assessment", "writes_to_source"],
      "properties": {
        "schema_version": {"const": "tos_source_handle_discovery_v1"},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256},
        "target": {"anyOf": [{"$ref": "#/$defs/target"}, {"type": "null"}]},
        "selector": {"$ref": "#/$defs/selector"},
        "handle": {"anyOf": [{"$ref": "#/$defs/handle"}, {"type": "null"}]},
        "source_revision": {"$ref": "#/$defs/bareDigest"},
        "content_revision": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "provenance": {"anyOf": [{"type": "object"}, {"type": "null"}]},
        "access": {"anyOf": [{"$ref": "#/$defs/access"}, {"type": "null"}]},
        "grants_current_use": {"const": false},
        "performs_assessment": {"const": false},
        "writes_to_source": {"const": false}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "reason", "handle", "source_revision", "content_revision", "layer", "record_kind", "record_ref", "record", "provenance", "access", "grants_current_use", "performs_assessment", "writes_to_source"],
      "properties": {
        "schema_version": {"const": "tos_source_read_result_v1"},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256},
        "handle": {"$ref": "#/$defs/handle"},
        "source_revision": {"$ref": "#/$defs/bareDigest"},
        "content_revision": {"$ref": "#/$defs/digest"},
        "layer": {"enum": ["metadata_record", "claim_record", "source_slot"]},
        "record_kind": {"enum": ["metadata", "claim", "source_slot"]},
        "record_ref": {"anyOf": [{"$ref": "#/$defs/metadataRef"}, {"$ref": "#/$defs/claimRef"}, {"type": "null"}]},
        "record": {"anyOf": [{"type": "object"}, {"type": "null"}]},
        "provenance": {"anyOf": [{"type": "object"}, {"type": "null"}]},
        "access": {"anyOf": [{"$ref": "#/$defs/access"}, {"type": "null"}]},
        "grants_current_use": {"const": false},
        "performs_assessment": {"const": false},
        "writes_to_source": {"const": false}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/handle"},
    {"$ref": "#/$defs/discovery"},
    {"$ref": "#/$defs/result"}
  ]
}
