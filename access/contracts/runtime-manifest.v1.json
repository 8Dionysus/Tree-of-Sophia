    {"component_id": "query-core", "owner": "Tree-of-Sophia", "required": true},
    {"component_id": "cli", "owner": "Tree-of-Sophia", "required": true},
    {"component_id": "http-reader", "owner": "Tree-of-Sophia", "required": true},
    {"component_id": "native-mcp", "owner": "Tree-of-Sophia", "required": true},
    {"component_id": "web-app", "owner": "Tree-of-Sophia", "required": true},
    {"component_id": "webmcp", "owner": "Tree-of-Sophia", "required": false, "posture": "next-slice"}
  ],
  "runtime_profiles": [
    {"profile_id": "standalone", "runtime_owner": "Tree-of-Sophia", "requires_abyssos": false},
    {"profile_id": "abyssos", "runtime_owner": "abyss-stack", "requires_abyssos": true, "adapter_only": true}
