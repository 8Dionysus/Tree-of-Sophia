{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tos:stats-export-format:v1",
  "$comment": "Frozen portable v1 format grammar, embedded in native ToS. Original schema IDs and the single cross-file ref were localized; source provenance is in README.md. No external references or retrieval.",
  "$defs": {
    "port": {
      "title": "OS Abyss owner-local stats port",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_version",
        "owner_repo",
        "status",
        "owner_boundary_ref",
        "central_contract_refs",
        "evidence_posture",
        "questions",
        "measurements",
        "exports"
      ],
      "properties": {
        "schema_version": {
          "const": "aoa_stats_local_port_v1"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "owner_repo": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "deprecated"
          ]
        },
        "owner_boundary_ref": {
          "type": "string",
          "minLength": 1
        },
        "central_contract_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "aoa-stats:stats/measurement-contract/measurement-contract.schema.json",
              "aoa-stats:stats/measurement-contract/measurement-packet.schema.json"
            ]
          }
        },
        "evidence_posture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_state",
            "privacy",
            "raw_content_allowed"
          ],
          "properties": {
            "live_state": {
              "enum": [
                "reference_only",
                "live_capable",
                "mixed"
              ]
            },
            "privacy": {
              "enum": [
                "public",
                "internal",
                "sensitive"
              ]
            },
            "raw_content_allowed": {
              "const": false
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "consumer_refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^question:[a-z][a-z0-9_.-]*$"
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "consumer_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "measurement_id",
              "posture",
              "packet_refs",
              "evidence_refs"
            ],
            "properties": {
              "measurement_id": {
                "type": "string",
                "minLength": 1
              },
              "posture": {
                "enum": [
                  "declaration_only",
                  "reference",
                  "live"
                ]
              },
              "packet_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "measurement": {
      "title": "OS Abyss owner-local measurement contract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "measurement_id",
        "contract_version",
        "owner_repo",
        "question_ref",
        "semantic_class",
        "statistic",
        "object_kind",
        "unit",
        "population",
        "window",
        "dimensions",
        "aggregation",
        "missingness",
        "uncertainty",
        "provenance",
        "lifecycle",
        "privacy",
        "live_state",
        "authority_ceiling"
      ],
      "properties": {
        "schema_version": {
          "const": "aoa_stats_measurement_contract_v1"
        },
        "measurement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[a-z][a-z0-9_.-]*$"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "owner_repo": {
          "type": "string",
          "minLength": 1
        },
        "question_ref": {
          "type": "string",
          "pattern": "^question:[a-z][a-z0-9_.-]*$"
        },
        "semantic_class": {
          "enum": [
            "measure",
            "metric",
            "statistic",
            "view",
            "signal",
            "score"
          ]
        },
        "statistic": {
          "enum": [
            "count",
            "gauge",
            "rate",
            "ratio",
            "distribution",
            "quantile",
            "pass_at_k",
            "pass_all_k"
          ]
        },
        "object_kind": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "symbol",
            "quantity"
          ],
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "quantity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "definition",
            "inclusion_rule",
            "exclusion_rule",
            "sampling"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "definition": {
              "type": "string",
              "minLength": 1
            },
            "inclusion_rule": {
              "type": "string",
              "minLength": 1
            },
            "exclusion_rule": {
              "type": "string",
              "minLength": 1
            },
            "sampling": {
              "enum": [
                "census",
                "sample",
                "either"
              ]
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temporality",
            "clock"
          ],
          "properties": {
            "temporality": {
              "enum": [
                "instant",
                "interval",
                "cumulative"
              ]
            },
            "clock": {
              "enum": [
                "event_time",
                "processing_time",
                "owner_defined"
              ]
            }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "prohibited"
          ],
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "max_cardinality",
                  "sensitivity"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "max_cardinality": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sensitivity": {
                    "enum": [
                      "public",
                      "internal",
                      "sensitive"
                    ]
                  }
                }
              }
            },
            "prohibited": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              }
            }
          }
        },
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "across"
          ],
          "properties": {
            "operator": {
              "enum": [
                "none",
                "sum",
                "weighted_mean",
                "ratio_of_sums",
                "histogram_merge",
                "pass_estimate"
              ]
            },
            "across": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "population",
                  "cohort",
                  "window",
                  "dimension"
                ]
              }
            }
          }
        },
        "missingness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "zero_is_observation"
          ],
          "properties": {
            "states": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "missing",
                  "unknown",
                  "stale"
                ]
              }
            },
            "zero_is_observation": {
              "type": "boolean"
            }
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "methods"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "methods": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "binomial_exact",
                  "bootstrap",
                  "confidence_interval",
                  "standard_error",
                  "not_estimated",
                  "not_applicable"
                ]
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_refs_required",
            "source_revision_required"
          ],
          "properties": {
            "evidence_refs_required": {
              "const": true
            },
            "source_revision_required": {
              "type": "boolean"
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "compatible_with"
          ],
          "properties": {
            "status": {
              "enum": [
                "active",
                "deprecated"
              ]
            },
            "compatible_with": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "raw_content_allowed",
            "sensitive_dimensions_allowed"
          ],
          "properties": {
            "classification": {
              "enum": [
                "public",
                "internal",
                "sensitive"
              ]
            },
            "raw_content_allowed": {
              "const": false
            },
            "sensitive_dimensions_allowed": {
              "type": "boolean"
            }
          }
        },
        "live_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability"
          ],
          "properties": {
            "capability": {
              "enum": [
                "reference_only",
                "live_capable"
              ]
            }
          }
        },
        "authority_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packet": {
      "title": "OS Abyss evidence-linked measurement packet",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_ref",
        "contract_version",
        "measurement_id",
        "writer_repo",
        "observation_id",
        "observed_at",
        "object_ref",
        "population",
        "sample",
        "cohort",
        "window",
        "dimensions",
        "value",
        "uncertainty",
        "provenance",
        "reporting_rule",
        "posture",
        "progress"
      ],
      "properties": {
        "schema_version": {
          "const": "aoa_stats_measurement_packet_v1"
        },
        "contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "measurement_id": {
          "type": "string",
          "minLength": 1
        },
        "writer_repo": {
          "type": "string",
          "minLength": 1
        },
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "object_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "definition_ref",
            "size"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "definition_ref": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "sample": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "selection"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "selection": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cohort": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "start",
            "end",
            "temporality"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "temporality": {
              "enum": [
                "instant",
                "interval",
                "cumulative"
              ]
            }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "kind",
            "unit"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed",
                "missing",
                "unknown",
                "stale"
              ]
            },
            "kind": {
              "enum": [
                "count",
                "gauge",
                "rate",
                "ratio",
                "distribution",
                "quantile",
                "pass_at_k",
                "pass_all_k"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "number": {
              "type": "number"
            },
            "numerator": {
              "type": "number"
            },
            "denominator": {
              "type": "number"
            },
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "count",
                "minimum",
                "maximum",
                "quantiles"
              ],
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                },
                "quantiles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "q",
                      "value"
                    ],
                    "properties": {
                      "q": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "value": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "quantile": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "q",
                "value"
              ],
              "properties": {
                "q": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "value": {
                  "type": "number"
                }
              }
            },
            "k": {
              "type": "integer",
              "minimum": 1
            },
            "successes": {
              "type": "integer",
              "minimum": 0
            },
            "attempts": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sample_size",
            "method"
          ],
          "properties": {
            "status": {
              "enum": [
                "estimated",
                "not_estimated",
                "not_applicable"
              ]
            },
            "sample_size": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_refs",
            "derivation_ref",
            "source_revision"
          ],
          "properties": {
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "ref"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "derivation_ref": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "reporting_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "posture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freshness",
            "live_state",
            "privacy",
            "raw_content_included"
          ],
          "properties": {
            "freshness": {
              "enum": [
                "current",
                "stale",
                "unknown"
              ]
            },
            "live_state": {
              "enum": [
                "live",
                "reference"
              ]
            },
            "privacy": {
              "enum": [
                "public",
                "internal",
                "sensitive"
              ]
            },
            "raw_content_included": {
              "const": false
            }
          }
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "completed",
            "total"
          ],
          "properties": {
            "state": {
              "enum": [
                "partial",
                "terminal"
              ]
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
