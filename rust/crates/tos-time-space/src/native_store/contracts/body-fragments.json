                      "relation"
                    ],
                    "properties": {
                      "relation": {
                        "const": "During"
                      }
                    }
                  },
                  "minContains": 0,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "required": [
                      "relation"
                    ],
                    "properties": {
