        },
        "d": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,37}|1[0-6][0-9]{37}|1700[0-9]{35}|1701[0-3][0-9]{34}|170140[0-9]{33}|1701410[0-9]{32}|1701411[0-7][0-9]{31}|17014118[0-2][0-9]{30}|170141183[0-3][0-9]{29}|1701411834[0-5][0-9]{28}|170141183460[0-3][0-9]{26}|1701411834604[0-5][0-9]{25}|17014118346046[0-8][0-9]{24}|170141183460469[0-1][0-9]{23}|1701411834604692[0-2][0-9]{22}|170141183460469230[0-9]{21}|170141183460469231[0-6][0-9]{20}|1701411834604692317[0-2][0-9]{19}|170141183460469231730[0-9]{18}|170141183460469231731[0-5][0-9]{17}|1701411834604692317316[0-7][0-9]{16}|17014118346046923173168[0-6][0-9]{15}|170141183460469231731687[0-2][0-9]{14}|17014118346046923173168730[0-2][0-9]{12}|170141183460469231731687303[0-6][0-9]{11}|17014118346046923173168730370[0-9]{10}|17014118346046923173168730371[0-4][0-9]{9}|170141183460469231731687303715[0-7][0-9]{8}|1701411834604692317316873037158[0-7][0-9]{7}|17014118346046923173168730371588[0-3][0-9]{6}|1701411834604692317316873037158840[0-9]{5}|17014118346046923173168730371588410[0-4][0-9]{3}|170141183460469231731687303715884105[0-6][0-9]{2}|1701411834604692317316873037158841057[0-1][0-9]{1}|17014118346046923173168730371588410572[0-6]|170141183460469231731687303715884105727)$"
        }
      }
    },
    "tsIndex": {
      "type": "string",
      "pattern": "^(?:0|(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615))$"
    },
    "tsAllen": {
      "enum": [
        "Before",
        "Meets",
        "Overlaps",
        "Starts",
        "During",
        "Finishes",
        "Equals",
        "FinishedBy",
        "Contains",
        "StartedBy",
        "OverlappedBy",
        "MetBy",
        "After"
      ]
    },
    "tsSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
