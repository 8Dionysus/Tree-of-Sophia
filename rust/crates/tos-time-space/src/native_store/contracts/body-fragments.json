{
  "format": "ts_native_body_schema_fragments",
  "version": "1.0.0",
  "status": "common-owned native schema input; not a registered resource by itself",
  "json_schema_draft": "2020-12",
  "body_members_for_common_targets": {
    "ts-native-definition.schema.json": {
      "$ref": "#/$defs/tsDefinitionBody"
