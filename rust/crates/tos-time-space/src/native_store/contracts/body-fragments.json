      }
    },
    "tsCycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tsCycleStep"
      },
      "contains": {
        "type": "object",
        "required": [
          "strict"
        ],
        "properties": {
          "strict": {
            "const": true
          }
        }
      },
      "minContains": 1,
      "description": "Codec additionally checks closed step chain; exact source premise replay remains verify_order_cycle, not schema acceptance."
    },
    "tsOrder": {
