                    "required": [
                      "relation"
                    ],
                    "properties": {
                      "relation": {
                        "const": "Equals"
                      }
                    }
                  },
                  "minContains": 0,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "required": [
                      "relation"
                    ],
                    "properties": {
                      "relation": {
                        "const": "FinishedBy"
                      }
                    }
                  },
                  "minContains": 0,
                  "maxContains": 1
                },
                {
