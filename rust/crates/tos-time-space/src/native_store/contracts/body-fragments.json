        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "steps"
          ],
          "properties": {
            "kind": {
              "const": "StrictCycle"
            },
            "steps": {
              "$ref": "#/$defs/tsCycle"
