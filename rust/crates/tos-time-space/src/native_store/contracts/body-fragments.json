        },
        "lower_closed": {
          "type": "boolean"
        },
        "upper_closed": {
          "type": "boolean"
        }
      }
    },
    "tsWitness": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/tsRational"
      },
      "description": "Domain codec additionally requires even width and start<end for every consecutive pair; no source truth/entailment follows."
    },
