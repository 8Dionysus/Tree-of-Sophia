    {
      "operation_id": "tos.source.descend",
      "execution_version": "tos_source_navigation_read_model_v1",
      "effect": "read-only",
      "availability": "only_with_owner_selected_model_and_current_policy_fence",
      "http": {
        "method": "GET",
        "path_template": "/api/source/navigation/{node_id}"
      },
      "mcp": {
        "tool": "tos_source_descend",
        "description": "Read a bounded source-navigation descent from an exact node ID",
        "input_schema": {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "default": 8
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "default": 300
            }
          },
          "required": [
            "node_id"
          ],
          "additionalProperties": false
        }
      },
      "cli": {
        "command": "source descend"
      },
      "request": {
        "node_id": "opaque exact UTF-8 ID",
        "max_depth": "1..8; default 8",
        "limit": "1..300; default 300"
      },
      "result": "source_descend packet with exact authority_note"
    },
    {
      "operation_id": "tos.knowledge.search",
      "execution_version": "tos_knowledge_search_v1_or_indexed_v2",
      "effect": "read-only",
      "availability": "only_with_owner_selected_engine_and_current_query_fence",
      "http": {
        "method": "GET",
        "path_template": "/api/knowledge/search"
      },
      "mcp": {
        "tool": "tos_knowledge_search",
        "description": "Search selected knowledge carriers with the maintained legacy or indexed engine; compressed requires a prepared publication",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "default": "",
              "maxLength": 256
            },
            "sources": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "kind_ids": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "predicate_ids": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 40
            },
            "mode": {
              "type": "string",
              "enum": [
                "legacy",
                "indexed",
                "compressed"
              ],
              "default": "legacy"
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 65536
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "indexed"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "properties": {
                  "query": {
                    "maxLength": 256
                  },
                  "offset": {
                    "const": 0
                  },
                  "sources": {
                    "maxItems": 256,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "kind_ids": {
                    "maxItems": 256,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "predicate_ids": {
                    "maxItems": 256,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "cli": {
        "command": "knowledge search"
      },
      "request": {
        "query": "optional Unicode text; default empty; 0..256 normalized code points for legacy, 3..256 for indexed",
        "sources": "selected source-owned vocabulary IDs",
        "kind_ids": "legacy permits unknown filters (zero matches); indexed requires selected vocabulary",
        "predicate_ids": "legacy permits unknown filters (zero matches); indexed requires selected vocabulary",
        "cursor": "adapter-local continuation",
        "limit": "1..100; default 40",
        "mode": "legacy default; indexed explicit; compressed unavailable without prepared owner publication",
        "offset": "legacy 0..100000; indexed/compressed zero"
      },
      "result": "exact selected engine packet under held current authority"
    },
