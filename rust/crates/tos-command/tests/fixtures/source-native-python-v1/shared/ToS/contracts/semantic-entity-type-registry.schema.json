{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeofsophia.local/ToS/contracts/semantic-entity-type-registry.schema.json",
  "title": "Tree of Sophia semantic entity type registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "source_refs",
    "fallback_type_id",
    "types"
  ],
  "properties": {
    "schema_version": {
      "const": "tos_semantic_entity_type_registry_v1"
    },
    "registry_id": {
      "const": "tos.semantic.entity-types"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "fallback_type_id": {
      "$ref": "#/$defs/typeId"
    },
    "property_definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertyDefinition"
      }
    },
    "context_presentation": {
      "$ref": "#/$defs/contextPresentation"
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/typeEntry"
      }
    }
  },
  "$defs": {
    "contextPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "presentation_id",
        "presentation_version",
        "owner_ref",
        "purpose",
        "default_language",
        "languages",
        "max_output_bytes",
        "max_entries",
        "record_schema_versions",
        "field_rules",
        "unclassified"
      ],
      "properties": {
        "schema_version": {
          "const": "tos_context_presentation_v1"
        },
        "presentation_id": {
          "const": "tos.context-presentation.governing"
        },
        "presentation_version": {
          "type": "integer",
          "minimum": 1
        },
        "owner_ref": {
          "const": "ToS/doctrine/HUMAN_FORMS.md"
        },
        "purpose": {
          "const": "source-context-reading-not-assessment"
        },
        "default_language": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 32768
        },
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "record_schema_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tos_[a-z0-9_]+_v[0-9]+$"
          }
        },
        "field_rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "targets",
              "category",
              "label",
              "explanation",
              "value_labels"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,95}$"
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "record",
                    "assertion",
                    "language-context",
                    "subject-assessment",
                    "assessment-snapshot"
                  ]
                }
              },
              "category": {
                "enum": [
                  "governing",
                  "technical"
                ]
              },
              "label": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 8,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
                }
              },
              "explanation": {
                "anyOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 8,
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value_labels": {
                "anyOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 64,
                    "additionalProperties": {
                      "type": "object",
                      "minProperties": 1,
                      "maxProperties": 8,
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "unclassified": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "explanation"
          ],
          "properties": {
            "label": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 8,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
              }
            },
            "explanation": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 8,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
              }
            }
          }
        }
      }
    },
    "sourceRecordProfile": {
      "type": "object",
      "additionalProperties": false,
      "description": "A source-owned metadata reader contract. Source writes and admission use their separately delegated routes; other record shapes retain their native adapters.",
      "required": [
        "profile_version",
        "reader",
        "record_type",
        "id_prefix",
        "source_basename",
        "catalog_filename",
        "schemas",
        "graph_layer"
      ],
      "properties": {
        "creation_gate": {
          "enum": [
            "sign-promotion-v1"
          ],
          "description": "The exact authored Sign profile requires the separate competent-assessment promotion command. This descriptor selects a fail-closed creation boundary; it grants no promotion or current-use authority."
        },
        "native_binding_adapter": {
          "enum": [
            "source-text-unit-v1"
          ],
          "description": "An explicit return from a semantic description to its immutable native_text_binding. The public metadata reader requires separately public native packet and layer metadata; publication and linguistic assessment retain their own owner decisions."
        },
        "retained_native_adapter": {
          "enum": [
            "scholarly-composite-v1"
          ],
          "description": "Explicit coexistence with the native composite-witness adapter, preserving its shape and identity. Only the composite type may declare this route."
        },
        "identity_proposal_adapter": {
          "const": "exact-semantic-metadata-v1",
          "description": "Explicit v2 proposal eligibility for this concrete declared semantic subject and exact metadata version. Proposal operations and assessment require their respective selected grants."
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "reader": {
          "enum": [
            "corpus-metadata-v1",
            "semantic-metadata-v1"
          ]
        },
        "record_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "id_prefix": {
          "type": "string",
          "pattern": "^tos\\.[a-z][a-z0-9-]*\\.$"
        },
        "source_basename": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.json$"
        },
        "catalog_filename": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.jsonl$"
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "schema_ref",
              "schema_dependencies"
            ],
            "properties": {
              "schema_version": {
                "type": "string",
                "minLength": 1
              },
              "schema_ref": {
                "type": "string",
                "pattern": "^ToS/contracts/[a-z][a-z0-9-]*\\.schema\\.json$"
              },
              "schema_dependencies": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^ToS/contracts/[a-z][a-z0-9-]*\\.schema\\.json$"
                }
              }
            }
          }
        },
        "graph_layer": {
          "enum": [
            "historical",
            "source-profile"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "identity_proposal_adapter"
            ]
          },
          "then": {
            "properties": {
              "reader": {
                "const": "semantic-metadata-v1"
              },
              "graph_layer": {
                "const": "source-profile"
              }
            }
          }
        }
      ]
    },
    "propertyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "field",
        "labels",
        "definition",
        "value_type",
        "applies_to",
        "required",
        "inherited",
        "unit",
        "language",
        "operators"
      ],
      "properties": {
        "property_id": {
          "type": "string",
          "pattern": "^tos\\.property\\.[a-z0-9-]+$"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "$ref": "#/$defs/localizedLabel"
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "string-array"
          ]
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/typeId"
          }
        },
        "required": {
          "type": "boolean"
        },
        "inherited": {
          "type": "boolean"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "operators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "eq",
              "neq",
              "in",
              "contains",
              "prefix",
              "exists",
              "gt",
              "gte",
              "lt",
              "lte"
            ]
          }
        }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "typeId": {
      "type": "string",
      "pattern": "^tos\\.entity\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "localizedLabel": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[iIxX](?:-[A-Za-z0-9]{1,8})+)$(?![\\s\\S])": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "default",
        "ru",
        "en"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ru": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "en": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "sourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_graph",
        "source_kind_id"
      ],
      "properties": {
        "source_graph": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_kind_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "labels": {
          "$ref": "#/$defs/localizedLabel"
        }
      }
    },
    "typeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id",
        "parent_type_ids",
        "abstract",
        "object_role",
        "labels",
        "definition",
        "lifecycle",
        "owner_ref",
        "source_mappings",
        "supersedes_type_id"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "source_record_profile"
            ],
            "properties": {
              "source_record_profile": {
                "required": [
                  "identity_proposal_adapter"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "abstract": {
                "const": false
              },
              "object_role": {
                "const": "semantic"
              }
            }
          }
        }
      ],
      "properties": {
        "type_id": {
          "$ref": "#/$defs/typeId"
        },
        "source_record_profile": {
          "$ref": "#/$defs/sourceRecordProfile"
        },
        "parent_type_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typeId"
          }
        },
        "abstract": {
          "type": "boolean"
        },
        "object_role": {
          "enum": [
            "root",
            "identity",
            "semantic",
            "assertion",
            "literal",
            "evidence",
            "activity",
            "navigation",
            "projection",
            "unresolved",
            "unmapped"
          ]
        },
        "labels": {
          "$ref": "#/$defs/localizedLabel"
        },
        "definition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "lifecycle": {
          "enum": [
            "stable",
            "candidate",
            "deprecated"
          ]
        },
        "owner_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceMapping"
          }
        },
        "supersedes_type_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/typeId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
