      "required_markers": ["operation topology", "active part", "mechanics topology", "derived seams"],
      "boundary_markers": ["ToS", "runtime", "canon"],
      "on_demand_surfaces": ["mechanics/README.md", "mechanics/boundary-bridge/PARTS.md", "mechanics/boundary-bridge/PROVENANCE.md"],
      "validation_lanes": ["mechanics_topology", "mechanics_local", "route_docs"],
      "validation_paths": ["scripts/validate_mechanics_topology.py", "scripts/validate_nested_agents.py"],
      "completion_evidence": ["mechanics/AGENTS.md", "mechanics/boundary-bridge/AGENTS.md", "mechanics/topology.json", "scripts/validate_mechanics_topology.py"],
