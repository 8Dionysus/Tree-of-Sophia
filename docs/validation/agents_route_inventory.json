    {
      "id": "release_validation",
      "prompt": "Run or repair the release and validation route, preserving command authority, generated parity, and CI evidence.",
      "target": "scripts/release_check.py",
      "owner_route": "scripts/AGENTS.md",
      "required_scopes": ["lane authority", "ordered command sequence", "generated parity", "CI/PR evidence"],
      "required_markers": ["release_check", "validation_lanes.json", "script_inventory.json", "generated"],
