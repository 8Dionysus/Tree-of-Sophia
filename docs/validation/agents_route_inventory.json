      "completion_evidence": ["ToS/zarathustra/AGENTS.md", "ToS/zarathustra/public-entry/TINY_ENTRY_ROUTE.md", "scripts/validate_tiny_entry_route.py"],
      "handoff_routes": ["ToS/public-compatibility/AGENTS.md", "ToS/derived-exports/AGENTS.md"]
    },
    {
