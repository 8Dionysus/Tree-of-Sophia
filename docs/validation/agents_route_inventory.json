      "owner_route": ".agents/AGENTS.md",
      "required_scopes": ["skill discovery", "triggered body", "on-demand companion", "activation metadata", "source owner"],
      "required_markers": ["model-facing", "owning homes", "skill", "validate_nested_agents"],
