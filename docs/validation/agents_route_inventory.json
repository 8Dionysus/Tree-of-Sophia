{
  "schema_version": "tos_agents_route_inventory_v1",
  "owner_repo": "Tree-of-Sophia",
  "owner_surface": "DESIGN.AGENTS.md",
  "validator": "scripts/validate_nested_agents.py",
  "currentness": ".agents/agents-route.current.json",
  "harness": "scripts/agents_route_harness.py",
  "route_card_discovery": {
    "root_cards": ["AGENTS.md"],
    "route_roots": [
      ".agents",
      ".github",
      "ToS",
      "docs",
      "mechanics",
      "scripts",
      "tests",
      "evals",
      "memo",
      "kag",
      "stats",
      "manifests"
    ],
    "tracked_rule": "git ls-files entries whose basename is exactly AGENTS.md",
    "untracked_policy": "discovered route cards must be tracked",
    "inheritance_rule": "root AGENTS.md plus every nearest ancestor card, ordered from root to target",
    "preserved_non_cards": [
      {
        "path": "DESIGN.AGENTS.md",
        "role": "agent-surface shape reference; not an inherited route card"
      },
      {
        "path": "docs/AGENTS_ROOT_REFERENCE.md",
        "role": "preserved historical root law; not active inheritance or competing root"
      }
    ]
  },
  "influencing_surfaces": [
    {
      "path": "AGENTS.md",
      "role": "active universal repository identity, topology, owner routes, boundaries, verification, and completion"
    },
    {
      "path": "DESIGN.AGENTS.md",
      "role": "authored route-card shape and progressive-loading guidance"
    },
    {
      "path": "DESIGN.md",
      "role": "system shape and source/generated authority boundaries"
    },
    {
      "path": "README.md",
      "role": "human entrypoint and links to canonical route surfaces"
    },
    {
      "path": "CHARTER.md",
      "role": "repository purpose and contribution identity"
    },
    {
      "path": "BOUNDARIES.md",
      "role": "owner and non-owner boundary orientation"
    },
    {
      "path": "ROADMAP.md",
      "role": "current direction and next pressure"
    },
    {
      "path": "docs/AGENTS_ROOT_REFERENCE.md",
      "role": "preserved root-law provenance used only for audit"
    },
    {
      "path": ".agents/README.md",
      "role": "model-facing skill and owner-port progressive-disclosure entrypoint"
    },
    {
      "path": ".agents/agent-surface.manifest.json",
      "role": "skill, owner-port, carrier, and task-probe map"
    },
    {
      "path": ".agents/agent-surface.current.json",
      "role": "generated skill/port currentness read model"
    },
    {
      "path": "docs/validation/validation_lanes.json",
      "role": "executable validation command authority"
    },
    {
      "path": "scripts/build_agents_route_currentness.py",
      "role": "deterministic generated currentness builder for route-card hashes and stacks"
    },
    {
      "path": "scripts/validate_nested_agents.py",
      "role": "structural, inheritance, reference, and currentness validator"
    },
    {
      "path": "scripts/agents_route_harness.py",
      "role": "deterministic representative task-route and context-budget harness"
    },
    {
      "path": "tests/test_nested_agents.py",
      "role": "focused positive and negative controls for route-card guard families"
    },
    {
      "path": "docs/validation/SCRIPT_TOPOLOGY.md",
      "role": "script ownership, inventory, and command-plane boundary"
    },
    {
      "path": "docs/validation/script_inventory.json",
      "role": "deterministic script coverage and side-effect inventory"
    },
    {
      "path": ".github/workflows/repo-validation.yml",
      "role": "CI execution of the release lane"
    },
    {
      "path": ".github/pull_request_template.md",
      "role": "PR evidence and boundary reporting prompt"
    }
  ],
  "context_budget": {
    "metric": "whitespace_tokens_v1",
    "inherited_stack_max_tokens": 2800,
    "task_overrides": {
      "release_validation": 7000
    },
    "additional_context_max_tokens": 20000,
    "owner_hops_max": 8,
    "missing_task_law_max": 0,
    "boundary_deviation_max": 0,
    "completion_coverage_min": 1.0,
    "interpretation": "Deterministic route-shape and disclosure guard; it does not claim model behavior, semantic correctness, owner acceptance, or human time-to-owner."
  },
  "scope_duplication_policy": {
    "byte_identical_nested_cards": "error",
    "near_duplicate_cards": "manual review",
    "interpretation": "A repeated sentence is not automatically duplication; the guard only rejects a nested card that is byte-identical to its inherited parent."
  },
  "task_routes": [
    {
      "id": "source_witness_intake",
      "prompt": "Add or inspect one source witness and route it into the source-first tree.",
      "target": "ToS/source-witnesses/README.md",
      "owner_route": "ToS/source-witnesses/AGENTS.md",
      "required_scopes": ["work/expression/edition/item identity", "provenance", "rights", "source return"],
      "required_markers": ["primary witness", "identity ladder", "rights", "source-foundation validator"],
      "boundary_markers": ["source witness", "canon", "generated"],
      "on_demand_surfaces": ["ToS/source-witnesses/README.md", "ToS/doctrine/CORPUS_FOUNDATION.md"],
      "validation_lanes": ["source_witness_foundation", "route_docs"],
      "validation_paths": ["scripts/validate_source_witness_foundation.py", "scripts/validate_nested_agents.py"],
      "completion_evidence": ["ToS/source-witnesses/AGENTS.md", "ToS/source-witnesses/README.md", "scripts/validate_source_witness_foundation.py"],
      "handoff_routes": ["ToS/candidate-intake/AGENTS.md", "ToS/review-ledger/AGENTS.md"]
    },
    {
      "id": "corpus_identity_provenance_rights",
      "prompt": "Audit corpus identity, provenance, fixity, and rights without promoting a catalog or provider record to truth.",
      "target": "ToS/doctrine/CORPUS_FOUNDATION.md",
      "owner_route": "ToS/source-witnesses/AGENTS.md",
      "required_scopes": ["stable identity", "fixity", "provenance", "rights posture", "visibility"],
      "required_markers": ["identity ladder", "fixity", "provenance", "rights"],
      "boundary_markers": ["source-facing", "generated", "review"],
      "on_demand_surfaces": ["ToS/doctrine/CORPUS_FOUNDATION.md", "ToS/source-witnesses/README.md"],
      "validation_lanes": ["source_witness_foundation", "route_docs"],
      "validation_paths": ["scripts/build_source_witness_catalog.py", "scripts/validate_source_witness_foundation.py"],
      "completion_evidence": ["ToS/source-witnesses/AGENTS.md", "ToS/doctrine/CORPUS_FOUNDATION.md", "scripts/validate_source_witness_foundation.py"],
      "handoff_routes": ["ToS/review-ledger/AGENTS.md"]
    },
    {
      "id": "text_segmentation",
      "prompt": "Define or review a text-unit or segmentation packet while keeping frozen text, layers, gaps, and review distinct.",
      "target": "ToS/contracts/source-text-unit-packet-v1.schema.json",
      "owner_route": "ToS/contracts/AGENTS.md",
      "required_scopes": ["exact frozen text", "segmentation layer", "coverage and gaps", "review status"],
      "required_markers": ["segmentation", "exact frozen text", "source-text-unit", "review"],
      "boundary_markers": ["tokenizer", "linguistic", "semantic"],
      "on_demand_surfaces": ["ToS/research-packets/foundation-laboratory-2026-07/SOURCE_TEXT_UNIT_SEGMENTATION_RESEARCH_2026-08-11.md", "ToS/contracts/source-text-unit-packet-v1.schema.json"],
      "validation_lanes": ["source_witness_foundation", "route_docs"],
      "validation_paths": ["scripts/validate_source_witness_foundation.py", "scripts/validate_nested_agents.py"],
      "completion_evidence": ["ToS/contracts/AGENTS.md", "ToS/contracts/source-text-unit-packet-v1.schema.json", "scripts/validate_source_witness_foundation.py"],
      "handoff_routes": ["ToS/review-ledger/AGENTS.md", "ToS/derived-exports/AGENTS.md"]
    },
    {
      "id": "translation_alignment",
      "prompt": "Review a translation-alignment route and preserve competing maps, anchors, visibility, and human review boundaries.",
      "target": "ToS/contracts/translation-alignment-packet-v1.schema.json",
      "owner_route": "ToS/contracts/AGENTS.md",
      "required_scopes": ["source and target text layers", "anchor sets", "competing maps", "review and rights"],
      "required_markers": ["translation alignment", "anchor sets", "competing maps", "review"],
      "boundary_markers": ["aligner", "translation", "canon"],
      "on_demand_surfaces": ["ToS/research-packets/foundation-laboratory-2026-07/TRANSLATION_ALIGNMENT_IDENTITY_RESEARCH_2026-08-11.md", "ToS/contracts/translation-alignment-packet-v1.schema.json"],
      "validation_lanes": ["source_witness_foundation", "route_docs"],
      "validation_paths": ["scripts/validate_source_witness_foundation.py", "scripts/validate_nested_agents.py"],
      "completion_evidence": ["ToS/contracts/AGENTS.md", "ToS/contracts/translation-alignment-packet-v1.schema.json", "scripts/validate_source_witness_foundation.py"],
      "handoff_routes": ["ToS/review-ledger/AGENTS.md", "ToS/derived-exports/AGENTS.md"]
    },
    {
      "id": "semantic_claim_review_canon",
      "prompt": "Move a source-linked semantic proposal through candidate intake and review toward canon without treating a projection as acceptance.",
      "target": "ToS/candidate-intake/AGENTS.md",
      "owner_route": "ToS/candidate-intake/AGENTS.md",
      "required_scopes": ["source anchor", "proposal status", "uncertainty", "review outcome", "canon boundary"],
      "required_markers": ["provisional", "source-linked", "uncertainty", "canon"],
