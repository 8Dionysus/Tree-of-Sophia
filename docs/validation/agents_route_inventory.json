      "handoff_routes": [".github/AGENTS.md", "docs/RELEASING.md"]
    },
    {
      "id": "agent_skill",
      "prompt": "Add or refresh one agent skill package while preserving discovery metadata, on-demand companions, and the stronger skill owner.",
