      "on_demand_surfaces": ["ToS/research-packets/foundation-laboratory-2026-07/SEMANTIC_IDENTITY_ANNOTATION_RESEARCH_2026-08-11.md", "ToS/contracts/CORPUS_CONTRACTS.md", "ToS/review-ledger/AGENTS.md", "ToS/canon/AGENTS.md"],
      "validation_lanes": ["intake_contracts", "canon_contracts", "route_docs"],
      "validation_paths": ["scripts/validate_intake_pack.py", "scripts/validate_tree_node_contracts.py", "scripts/validate_nested_agents.py"],
      "completion_evidence": ["ToS/candidate-intake/AGENTS.md", "ToS/review-ledger/AGENTS.md", "ToS/canon/AGENTS.md", "scripts/validate_intake_pack.py"],
      "handoff_routes": ["ToS/review-ledger/AGENTS.md", "ToS/canon/AGENTS.md", "ToS/public-compatibility/AGENTS.md"]
    },
    {
      "id": "philosophy_graph_workbench",
      "prompt": "Prepare a philosophy graph-workbench view or proposal while keeping source-side graph preparation distinct from runtime rendering.",
      "target": "ToS/philosophy/graph-workbench/AGENTS.md",
      "owner_route": "ToS/philosophy/graph-workbench/AGENTS.md",
